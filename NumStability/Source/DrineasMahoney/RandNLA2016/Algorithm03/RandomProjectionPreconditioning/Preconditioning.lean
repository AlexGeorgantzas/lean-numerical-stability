/-- Markov high-probability consequence for one signed-Hadamard preconditioned
    row.

This is a closed finite-probability bound derived from the expectation theorem
above.  It is intentionally weaker than Tropp's SRHT row-norm concentration
lemma, because it uses only Markov's inequality. -/
theorem rademacherTraceProbability_eventProb_rowNormSq_signedHadamard_le_ge_one_sub
    {m n : ℕ} (H : Fin m → Fin m → ℝ) (U : Fin m → Fin n → ℝ)
    (hflat : HadamardFlat m H) (hU : HasOrthonormalColumns U)
    (i : Fin m) {T : ℝ} (hT : 0 < T) :
    1 - ((n : ℝ) * (m : ℝ)⁻¹) / T ≤
      (rademacherTraceProbability m).eventProb
        {ω |
          rowNormSq
            (preconditionRows
              (matMul m H (diagMatrix (rademacherSignVector ω))) U) i ≤ T} := by
  let X : RademacherTrace m → ℝ :=
    fun ω =>
      rowNormSq
        (preconditionRows
          (matMul m H (diagMatrix (rademacherSignVector ω))) U) i
  have hX_nonneg : ∀ ω, 0 ≤ X ω := by
    intro ω
    exact rowNormSq_nonneg
      (preconditionRows
        (matMul m H (diagMatrix (rademacherSignVector ω))) U) i
  have hmarkov :=
    FiniteProbability.eventProb_real_le_ge_one_sub_expectationReal_div
      (rademacherTraceProbability m) X T hX_nonneg hT
  have hmean :
      (rademacherTraceProbability m).expectationReal X =
        (n : ℝ) * (m : ℝ)⁻¹ := by
    simpa [X] using
      rademacherTraceProbability_expectationReal_rowNormSq_signedHadamard_eq
        H U hflat hU i
  simpa [X, hmean] using hmarkov

/-- Finite union-bound consequence for all signed-Hadamard preconditioned rows.

This theorem closes the Markov/union high-probability auxiliary for the SRHT
route.  It does not close the sharper Tropp row-norm flattening theorem. -/
theorem rademacherTraceProbability_eventProb_forall_rowNormSq_signedHadamard_le_ge_one_sub_sum
    {m n : ℕ} (H : Fin m → Fin m → ℝ) (U : Fin m → Fin n → ℝ)
    (hflat : HadamardFlat m H) (hU : HasOrthonormalColumns U)
    {T : ℝ} (hT : 0 < T) :
    1 - (∑ _i : Fin m, ((n : ℝ) * (m : ℝ)⁻¹) / T) ≤
      (rademacherTraceProbability m).eventProb
        {ω | ∀ i : Fin m,
          rowNormSq
            (preconditionRows
              (matMul m H (diagMatrix (rademacherSignVector ω))) U) i ≤ T} := by
  classical
  let P := rademacherTraceProbability m
  let E : Fin m → Set (RademacherTrace m) :=
    fun i =>
      {ω |
        rowNormSq
          (preconditionRows
            (matMul m H (diagMatrix (rademacherSignVector ω))) U) i ≤ T}
  let δ : Fin m → ℝ := fun _ => ((n : ℝ) * (m : ℝ)⁻¹) / T
  have hrow : ∀ i : Fin m, 1 - δ i ≤ P.eventProb (E i) := by
    intro i
    simpa [P, E, δ] using
      rademacherTraceProbability_eventProb_rowNormSq_signedHadamard_le_ge_one_sub
        H U hflat hU i hT
  have hall := FiniteProbability.eventProb_forall_ge_one_sub_sum P E δ hrow
  simpa [P, E, δ] using hall

/-- Closed-form version of the all-row Markov/union bound. -/
theorem rademacherTraceProbability_eventProb_forall_rowNormSq_signedHadamard_le_ge_one_sub
    {m n : ℕ} (H : Fin m → Fin m → ℝ) (U : Fin m → Fin n → ℝ)
    (hflat : HadamardFlat m H) (hU : HasOrthonormalColumns U)
    {T : ℝ} (hT : 0 < T) :
    1 - (m : ℝ) * (((n : ℝ) * (m : ℝ)⁻¹) / T) ≤
      (rademacherTraceProbability m).eventProb
        {ω | ∀ i : Fin m,
          rowNormSq
            (preconditionRows
              (matMul m H (diagMatrix (rademacherSignVector ω))) U) i ≤ T} := by
  simpa using
    rademacherTraceProbability_eventProb_forall_rowNormSq_signedHadamard_le_ge_one_sub_sum
      H U hflat hU hT

/-- Delta-budget form of the all-row Markov/union bound.

If the chosen threshold `T` makes the Markov/union failure budget at most
`δ`, then all row norms are at most `T` with probability at least `1 - δ`. -/
theorem rademacherTraceProbability_eventProb_forall_rowNormSq_signedHadamard_le_ge_one_sub_delta
    {m n : ℕ} (H : Fin m → Fin m → ℝ) (U : Fin m → Fin n → ℝ)
    (hflat : HadamardFlat m H) (hU : HasOrthonormalColumns U)
    {T δ : ℝ} (hT : 0 < T)
    (hbudget : (m : ℝ) * (((n : ℝ) * (m : ℝ)⁻¹) / T) ≤ δ) :
    1 - δ ≤
      (rademacherTraceProbability m).eventProb
        {ω | ∀ i : Fin m,
          rowNormSq
            (preconditionRows
              (matMul m H (diagMatrix (rademacherSignVector ω))) U) i ≤ T} := by
  have hbase :=
    rademacherTraceProbability_eventProb_forall_rowNormSq_signedHadamard_le_ge_one_sub
      H U hflat hU hT
  linarith

/-- Under the finite Rademacher sign law, the deterministic signed-orthogonal
    preprocessing prerequisites hold with probability one.

This closes the probability-space part of the SRHT route without claiming the
separate row-norm flattening concentration theorem. -/
theorem rademacherTraceProbability_eventProb_signedOrthogonalPreconditionRows_eq_one
    {m n : ℕ} (H : Fin m → Fin m → ℝ) (U : Fin m → Fin n → ℝ)
    (hH : IsOrthogonal m H) (hU : HasOrthonormalColumns U) :
    (rademacherTraceProbability m).eventProb
      {ω |
        IsOrthogonal m
          (matMul m H (diagMatrix (rademacherSignVector ω))) ∧
        HasOrthonormalColumns
          (preconditionRows
            (matMul m H (diagMatrix (rademacherSignVector ω))) U) ∧
        rowSqNormProbDen
          (preconditionRows
            (matMul m H (diagMatrix (rademacherSignVector ω))) U) =
          (n : ℝ)} = 1 := by
  classical
  apply FiniteProbability.eventProb_eq_one_of_forall
  intro ω
  refine ⟨?_, ?_, ?_⟩
  · exact signedOrthogonalPreconditioner_isOrthogonal H
      (rademacherSignVector ω) hH (rademacherSignVector_sq ω)
  · exact signedOrthogonalPreconditionRows_hasOrthonormalColumns H
      (rademacherSignVector ω) U hH (rademacherSignVector_sq ω) hU
  · exact rowSqNormProbDen_signedOrthogonalPreconditionRows_eq_nat H
      (rademacherSignVector ω) U hH (rademacherSignVector_sq ω) hU

