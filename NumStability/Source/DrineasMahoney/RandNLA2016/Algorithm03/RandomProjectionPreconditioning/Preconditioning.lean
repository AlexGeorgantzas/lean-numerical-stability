    intro i
    have hbase :=
      rademacherTraceProbability_eventProb_vecNorm2Sq_sum_mul_sign_le_ge_one_sub_sum_two_mul_exp_neg_sq_div
        (a := fun j : Fin n => fun k : Fin m => G i k * U k j)
        (T := T i) (σ := σ i) (hT i) (hσ i) (hvar i)
    simpa [P, E, δ, rowNormSq, vecNorm2Sq,
      signedMixingRows_preconditionRows_entry, mul_assoc, mul_comm,
      mul_left_comm] using hbase
  have hall := FiniteProbability.eventProb_forall_ge_one_sub_sum P E δ hE
  simpa [P, E, δ] using hall
































