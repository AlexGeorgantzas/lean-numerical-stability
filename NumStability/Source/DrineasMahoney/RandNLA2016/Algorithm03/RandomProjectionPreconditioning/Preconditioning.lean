  have hbase :=
    rademacherTraceProbability_eventProb_abs_sum_mul_sign_le_ge_one_sub_two_mul_exp_sq_bound
      (fun k : Fin m => H i k * U k j) B hlam
  have hsum :=
    signedHadamard_entry_coeff_sum_sq_eq_inv H U hflat hU i j
  simpa [signedHadamardPreconditionRows_entry, hsum] using hbase

/-- Finite-family coordinate Hoeffding bound for every signed-Hadamard
preconditioned entry. -/
theorem rademacherTraceProbability_eventProb_forall_entry_abs_signedHadamard_le_ge_one_sub_sum_exp_sq_bound
    {m n : ℕ} (H : Fin m → Fin m → ℝ) (U : Fin m → Fin n → ℝ)
    (hflat : HadamardFlat m H) (hU : HasOrthonormalColumns U)
    (B : ℝ) {lam : ℝ} (hlam : 0 < lam) :
    1 -
        (∑ _ij : Fin m × Fin n,
          2 * (Real.exp (-(lam * B)) *
            Real.exp ((lam ^ 2 * (m : ℝ)⁻¹) / 2))) ≤
