          ∑ k : Fin m, rademacherSignVector ω k * M k i j) (z a)| ≤
        T a}
  have hbase :
      1 - (∑ a : ι, 2 * Real.exp (-(T a ^ 2 / (2 * σ a ^ 2)))) ≤
        P.eventProb Escalar := by
    simpa [P, Escalar, coeff] using
      rademacherTraceProbability_eventProb_forall_abs_sum_mul_sign_le_ge_one_sub_sum_two_mul_exp_neg_sq_div
        (a := coeff) (T := T) (σ := σ) hT hσ
