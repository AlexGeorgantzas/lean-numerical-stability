        |preconditionRows
          (matMul m H (diagMatrix (rademacherSignVector ω))) U ij.1 ij.2| ≤ B}
  let δ : Fin m × Fin n → ℝ :=
    fun _ =>
      2 * (Real.exp (-(lam * B)) *
        Real.exp ((lam ^ 2 * (m : ℝ)⁻¹) / 2))
  have hE : ∀ ij : Fin m × Fin n, 1 - δ ij ≤ P.eventProb (E ij) := by
