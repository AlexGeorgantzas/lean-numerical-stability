/-- One-row high-probability signed-Hadamard row-norm tail.

The concentration statement is now unconditional relative to the local
finite-cube foundations: the required exponential-tilt flip-gradient estimate
is supplied by
`rademacherTraceProbability_flip_tilt_sq_sum_bound_signedHadamard_row_vecNorm2`.
The variance proxy is `4 / m`, giving the usual `exp(-m t^2 / 8)` tail. -/
theorem rademacherTraceProbability_eventProb_vecNorm2_signedHadamard_le_mean_add_ge_one_sub_exp_m_t_sq_div_eight
    {m n : ℕ} (H : Fin m → Fin m → ℝ) (U : Fin m → Fin n → ℝ)
    (hm : 0 < m) (hflat : HadamardFlat m H)
    (hU : HasOrthonormalColumns U) (i : Fin m) (t : ℝ) (ht : 0 < t) :
    1 - Real.exp (-((m : ℝ) * t ^ 2 / 8)) ≤
      (rademacherTraceProbability m).eventProb
        {ω |
          vecNorm2
            (fun j : Fin n =>
              preconditionRows
                (matMul m H (diagMatrix (rademacherSignVector ω))) U i j) ≤
            (rademacherTraceProbability m).expectationReal
              (fun ω =>
                vecNorm2
                  (fun j : Fin n =>
                    preconditionRows
                      (matMul m H (diagMatrix (rademacherSignVector ω))) U i j)) +
              t} := by
  classical
  let X : RademacherTrace m → ℝ :=
    fun ω =>
      vecNorm2
        (fun j : Fin n =>
          preconditionRows
            (matMul m H (diagMatrix (rademacherSignVector ω))) U i j)
  let σ : ℝ := 2 * Real.sqrt ((m : ℝ)⁻¹)
  have hmreal : 0 < (m : ℝ) := Nat.cast_pos.mpr hm
  have hinv_pos : 0 < (m : ℝ)⁻¹ := inv_pos.mpr hmreal
  have hσ : 0 < σ := by
    dsimp [σ]
    exact mul_pos (by norm_num) (Real.sqrt_pos.mpr hinv_pos)
  have hσ_sq : σ ^ 2 = 4 * (m : ℝ)⁻¹ := by
    dsimp [σ]
    rw [mul_pow, Real.sq_sqrt (inv_nonneg.mpr (Nat.cast_nonneg m))]
    ring
  have hden :
      t ^ 2 / (2 * σ ^ 2) = (m : ℝ) * t ^ 2 / 8 := by
    rw [hσ_sq]
    field_simp [ne_of_gt hmreal]
    ring
  have htail :=
    rademacherTraceProbability_eventProb_real_le_mean_add_ge_one_sub_exp_sq_of_flip_tilt_sq_sum_bound
      X σ t hσ ht
      (by
        intro lam hlam
        have hrow :=
          rademacherTraceProbability_flip_tilt_sq_sum_bound_signedHadamard_row_vecNorm2
            H U hflat hU i lam (le_of_lt hlam)
        calc
          (∑ k : Fin m,
            (rademacherTraceProbability m).expectationReal
              (fun ω =>
                (Real.exp ((lam * X ω) / 2) -
                  Real.exp ((lam * X (rademacherTraceFlip k ω)) / 2)) ^ 2))
              ≤
            (2 * (m : ℝ)⁻¹) * lam ^ 2 *
              (rademacherTraceProbability m).expectationReal
                (fun ω => Real.exp (lam * X ω)) := by
                simpa [X] using hrow
          _ =
            (σ ^ 2 / 2) * lam ^ 2 *
              (rademacherTraceProbability m).expectationReal
                (fun ω => Real.exp (lam * X ω)) := by
                rw [hσ_sq]
                ring)
  simpa [X, hden] using htail

/-- Coordinate Hoeffding bound for one signed-Hadamard preconditioned entry.

This is a weaker route than Tropp's row-norm SRHT lemma: it controls every
entry separately by the scalar Rademacher Hoeffding bound. -/
theorem rademacherTraceProbability_eventProb_entry_abs_signedHadamard_le_ge_one_sub_exp_sq_bound
    {m n : ℕ} (H : Fin m → Fin m → ℝ) (U : Fin m → Fin n → ℝ)
