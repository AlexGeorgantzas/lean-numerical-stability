        (∑ i : Fin r,
          ∑ j : Fin n, 2 * Real.exp (-(T i j ^ 2 / (2 * σ i j ^ 2)))) ≤
      (rademacherTraceProbability m).eventProb
        {ω | ∀ i : Fin r,
          rowNormSq
            (preconditionRows
              (signedMixingRows G (rademacherSignVector ω)) U) i ≤
            ∑ j : Fin n, T i j ^ 2} := by
