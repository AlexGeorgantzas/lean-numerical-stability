theorem rademacherTraceProbability_eventProb_forall_rowNormSq_signedMixingRows_entry_sq_le_uniform_ge_one_sub_sum_sum_two_mul_exp_neg_sq_div
    {r m n : ℕ} (G : Fin r → Fin m → ℝ) (U : Fin m → Fin n → ℝ)
