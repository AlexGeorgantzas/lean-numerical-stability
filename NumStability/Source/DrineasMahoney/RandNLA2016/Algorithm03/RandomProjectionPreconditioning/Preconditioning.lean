/-- Coordinate-Hoeffding row-norm bound for signed-Hadamard preprocessing.

If every entry in a preconditioned row has absolute value at most `B`, then the
row norm squared is at most `n B^2`; the probability bound is obtained by a
finite union bound over all entries.  This is weaker than Tropp's sharp
logarithmic SRHT row-norm lemma, but it is a fully proved high-probability
row-norm route. -/
theorem rademacherTraceProbability_eventProb_forall_rowNormSq_signedHadamard_le_ge_one_sub_sum_exp_sq_bound
    {m n : ℕ} (H : Fin m → Fin m → ℝ) (U : Fin m → Fin n → ℝ)
    (hflat : HadamardFlat m H) (hU : HasOrthonormalColumns U)
    {B : ℝ} (hB : 0 ≤ B) {lam : ℝ} (hlam : 0 < lam) :
    1 -
        (∑ _ij : Fin m × Fin n,
          2 * (Real.exp (-(lam * B)) *
            Real.exp ((lam ^ 2 * (m : ℝ)⁻¹) / 2))) ≤
      (rademacherTraceProbability m).eventProb
        {ω | ∀ i : Fin m,
          rowNormSq
            (preconditionRows
              (matMul m H (diagMatrix (rademacherSignVector ω))) U) i ≤
            (n : ℝ) * B ^ 2} := by
  classical
  let P := rademacherTraceProbability m
  let M : RademacherTrace m → Fin m → Fin n → ℝ :=
    fun ω =>
      preconditionRows
        (matMul m H (diagMatrix (rademacherSignVector ω))) U
  let Eentry : Set (RademacherTrace m) :=
    {ω | ∀ ij : Fin m × Fin n, |M ω ij.1 ij.2| ≤ B}
  let Erow : Set (RademacherTrace m) :=
    {ω | ∀ i : Fin m, rowNormSq (M ω) i ≤ (n : ℝ) * B ^ 2}
  have hentry :
      1 -
          (∑ _ij : Fin m × Fin n,
            2 * (Real.exp (-(lam * B)) *
              Real.exp ((lam ^ 2 * (m : ℝ)⁻¹) / 2))) ≤
        P.eventProb Eentry := by
    simpa [P, M, Eentry] using
      rademacherTraceProbability_eventProb_forall_entry_abs_signedHadamard_le_ge_one_sub_sum_exp_sq_bound
        H U hflat hU B hlam
  have hsubset : Eentry ⊆ Erow := by
    intro ω hω i
    unfold rowNormSq
    calc
      (∑ j : Fin n, M ω i j ^ 2)
          ≤ ∑ _j : Fin n, B ^ 2 := by
              apply Finset.sum_le_sum
              intro j _
              have hentry_ij : |M ω i j| ≤ B := hω (i, j)
              have hentry_abs : |M ω i j| ≤ |B| := by
                simpa [abs_of_nonneg hB] using hentry_ij
              exact (sq_le_sq).mpr hentry_abs
      _ = (n : ℝ) * B ^ 2 := by
              simp [Finset.sum_const, nsmul_eq_mul]
  exact hentry.trans (FiniteProbability.eventProb_mono P hsubset)

/-- Coordinate-Hoeffding leverage-probability bound for signed-Hadamard
preprocessing.

This converts the all-row row-norm event above into the equation-(6)
probability event `p_i <= B^2`, using the deterministic fact that signed
orthogonal preprocessing preserves orthonormal columns and hence keeps the
leverage denominator equal to `n`.  It is a rigorous scoped alternative to the
source-sharp Tropp SRHT leverage uniformization theorem. -/
theorem rademacherTraceProbability_eventProb_forall_leverageScoreProb_signedHadamard_le_ge_one_sub_sum_exp_sq_bound
    {m n : ℕ} (H : Fin m → Fin m → ℝ) (U : Fin m → Fin n → ℝ)
    (hH : IsOrthogonal m H) (hflat : HadamardFlat m H)
    (hU : HasOrthonormalColumns U) (hn : 0 < n)
    {B : ℝ} (hB : 0 ≤ B) {lam : ℝ} (hlam : 0 < lam) :
    1 -
        (∑ _ij : Fin m × Fin n,
          2 * (Real.exp (-(lam * B)) *
            Real.exp ((lam ^ 2 * (m : ℝ)⁻¹) / 2))) ≤
      (rademacherTraceProbability m).eventProb
        {ω | ∀ i : Fin m,
          leverageScoreProb
            (preconditionRows
              (matMul m H (diagMatrix (rademacherSignVector ω))) U) i ≤
            B ^ 2} := by
  classical
  let P := rademacherTraceProbability m
  let M : RademacherTrace m → Fin m → Fin n → ℝ :=
    fun ω =>
      preconditionRows
        (matMul m H (diagMatrix (rademacherSignVector ω))) U
  let Erow : Set (RademacherTrace m) :=
    {ω | ∀ i : Fin m, rowNormSq (M ω) i ≤ (n : ℝ) * B ^ 2}
  let Eprob : Set (RademacherTrace m) :=
    {ω | ∀ i : Fin m, leverageScoreProb (M ω) i ≤ B ^ 2}
  have hrow :
      1 -
          (∑ _ij : Fin m × Fin n,
            2 * (Real.exp (-(lam * B)) *
              Real.exp ((lam ^ 2 * (m : ℝ)⁻¹) / 2))) ≤
        P.eventProb Erow := by
    simpa [P, M, Erow] using
      rademacherTraceProbability_eventProb_forall_rowNormSq_signedHadamard_le_ge_one_sub_sum_exp_sq_bound
        H U hflat hU hB hlam
  have hsubset : Erow ⊆ Eprob := by
    intro ω hω i
    have hM :
        HasOrthonormalColumns (M ω) := by
      simpa [M] using
        signedOrthogonalPreconditionRows_hasOrthonormalColumns
          H (rademacherSignVector ω) U hH
          (rademacherSignVector_sq ω) hU
    have hprob_eq :
        leverageScoreProb (M ω) i =
          rowNormSq (M ω) i / (n : ℝ) := by
      simpa [leverageScore] using
        leverageScoreProb_eq_rowNormSq_div_nat (M ω) hM i
    have hn_real : 0 < (n : ℝ) := by exact_mod_cast hn
    have hdiv :
        rowNormSq (M ω) i / (n : ℝ) ≤
          ((n : ℝ) * B ^ 2) / (n : ℝ) := by
      exact div_le_div_of_nonneg_right (hω i) (le_of_lt hn_real)
    have hcancel :
          ((n : ℝ) * B ^ 2) / (n : ℝ) = B ^ 2 := by
      field_simp [ne_of_gt hn_real]
    calc
      leverageScoreProb (M ω) i
          = rowNormSq (M ω) i / (n : ℝ) := hprob_eq
      _ ≤ ((n : ℝ) * B ^ 2) / (n : ℝ) := hdiv
      _ = B ^ 2 := hcancel
  exact hrow.trans (FiniteProbability.eventProb_mono P hsubset)

/-- Delta-budget form of the coordinate-Hoeffding leverage-probability bound.

If the finite coordinate-Hoeffding failure budget is at most `δ`, then all
equation-(6) leverage probabilities of the signed-Hadamard preconditioned
matrix are at most `B^2` with probability at least `1 - δ`. -/
theorem rademacherTraceProbability_eventProb_forall_leverageScoreProb_signedHadamard_le_ge_one_sub_delta
    {m n : ℕ} (H : Fin m → Fin m → ℝ) (U : Fin m → Fin n → ℝ)
    (hH : IsOrthogonal m H) (hflat : HadamardFlat m H)
    (hU : HasOrthonormalColumns U) (hn : 0 < n)
    {B δ : ℝ} (hB : 0 ≤ B) {lam : ℝ} (hlam : 0 < lam)
    (hbudget :
      (∑ _ij : Fin m × Fin n,
        2 * (Real.exp (-(lam * B)) *
          Real.exp ((lam ^ 2 * (m : ℝ)⁻¹) / 2))) ≤ δ) :
    1 - δ ≤
      (rademacherTraceProbability m).eventProb
        {ω | ∀ i : Fin m,
          leverageScoreProb
            (preconditionRows
              (matMul m H (diagMatrix (rademacherSignVector ω))) U) i ≤
            B ^ 2} := by
  have hbase :=
    rademacherTraceProbability_eventProb_forall_leverageScoreProb_signedHadamard_le_ge_one_sub_sum_exp_sq_bound
      H U hH hflat hU hn hB hlam
  linarith

/-- Delta-budget Loewner boundedness for subsequent uniform row sampling.

On the same coordinate-Hoeffding event used to control the equation-(6)
leverage probabilities of `H D_ω U`, every one-step uniform row outer-product
estimator `m u_i u_iᵀ` is bounded by `m n B^2 I` in Loewner order.  This is a
foundation theorem for the weaker uniform-after-preconditioning route; the
remaining open step is the concentration inequality for averages of these
uniform samples. -/
theorem rademacherTraceProbability_eventProb_forall_uniformRowOuterGramSample_signedHadamard_finiteLoewnerLe_ge_one_sub_delta
    {m n : ℕ} (H : Fin m → Fin m → ℝ) (U : Fin m → Fin n → ℝ)
    (hH : IsOrthogonal m H) (hflat : HadamardFlat m H)
    (hU : HasOrthonormalColumns U) (hn : 0 < n)
    {B δ : ℝ} (hB : 0 ≤ B) {lam : ℝ} (hlam : 0 < lam)
    (hbudget :
      (∑ _ij : Fin m × Fin n,
        2 * (Real.exp (-(lam * B)) *
          Real.exp ((lam ^ 2 * (m : ℝ)⁻¹) / 2))) ≤ δ) :
    1 - δ ≤
      (rademacherTraceProbability m).eventProb
        {ω | ∀ i : Fin m,
          finiteLoewnerLe
            (fun j k : Fin n =>
              uniformRowOuterGramSample
                (preconditionRows
                  (matMul m H (diagMatrix (rademacherSignVector ω))) U) i j k)
            (fun j k : Fin n =>
              ((m : ℝ) * ((n : ℝ) * B ^ 2)) * finiteIdMatrix j k)} := by
  classical
  let P := rademacherTraceProbability m
  let M : RademacherTrace m → Fin m → Fin n → ℝ :=
    fun ω =>
      preconditionRows
        (matMul m H (diagMatrix (rademacherSignVector ω))) U
  let Eprob : Set (RademacherTrace m) :=
    {ω | ∀ i : Fin m, leverageScoreProb (M ω) i ≤ B ^ 2}
  let Eloewner : Set (RademacherTrace m) :=
    {ω | ∀ i : Fin m,
      finiteLoewnerLe
        (fun j k : Fin n => uniformRowOuterGramSample (M ω) i j k)
        (fun j k : Fin n =>
          ((m : ℝ) * ((n : ℝ) * B ^ 2)) * finiteIdMatrix j k)}
  have hprob :
      1 - δ ≤ P.eventProb Eprob := by
    simpa [P, M, Eprob] using
      rademacherTraceProbability_eventProb_forall_leverageScoreProb_signedHadamard_le_ge_one_sub_delta
        H U hH hflat hU hn hB hlam hbudget
  have hsubset : Eprob ⊆ Eloewner := by
    intro ω hω i
    have hM :
        HasOrthonormalColumns (M ω) := by
      simpa [M] using
        signedOrthogonalPreconditionRows_hasOrthonormalColumns
          H (rademacherSignVector ω) U hH
          (rademacherSignVector_sq ω) hU
    exact
      uniformRowOuterGramSample_finiteLoewnerLe_of_leverageScoreProb_le
        (M ω) hM hn i (hω i)
  exact hprob.trans (FiniteProbability.eventProb_mono P hsubset)



























































































































/-- Source-sharp all-row signed-Hadamard row-norm flattening in Euclidean norm.

This is the finite union-bound lift of the one-row Ledoux/Herbst tail.  It
matches the Tropp-style row-norm shape with failure budget
`m * exp(-m t^2 / 8)`, but keeps `t` explicit instead of choosing it from
`δ` by logarithms. -/
theorem rademacherTraceProbability_eventProb_forall_vecNorm2_signedHadamard_le_sqrt_add_ge_one_sub_m_exp_m_t_sq_div_eight
    {m n : ℕ} (H : Fin m → Fin m → ℝ) (U : Fin m → Fin n → ℝ)
    (hm : 0 < m) (hflat : HadamardFlat m H)
    (hU : HasOrthonormalColumns U) (t : ℝ) (ht : 0 < t) :
    1 - (m : ℝ) * Real.exp (-((m : ℝ) * t ^ 2 / 8)) ≤
      (rademacherTraceProbability m).eventProb
        {ω | ∀ i : Fin m,
          vecNorm2
            (fun j : Fin n =>
              preconditionRows
                (matMul m H (diagMatrix (rademacherSignVector ω))) U i j) ≤
            Real.sqrt ((n : ℝ) * (m : ℝ)⁻¹) + t} := by
  classical
  let P := rademacherTraceProbability m
  let M : RademacherTrace m → Fin m → Fin n → ℝ :=
    fun ω =>
      preconditionRows
        (matMul m H (diagMatrix (rademacherSignVector ω))) U
  let S : ℝ := Real.sqrt ((n : ℝ) * (m : ℝ)⁻¹) + t
  let δ : Fin m → ℝ := fun _ => Real.exp (-((m : ℝ) * t ^ 2 / 8))
  let E : Fin m → Set (RademacherTrace m) :=
    fun i => {ω | vecNorm2 (fun j : Fin n => M ω i j) ≤ S}
  have hrow : ∀ i : Fin m, 1 - δ i ≤ P.eventProb (E i) := by
    intro i
    have htail :=
      rademacherTraceProbability_eventProb_vecNorm2_signedHadamard_le_mean_add_ge_one_sub_exp_m_t_sq_div_eight
        H U hm hflat hU i t ht
    have hmean :
        P.expectationReal (fun ω => vecNorm2 (fun j : Fin n => M ω i j)) ≤
          Real.sqrt ((n : ℝ) * (m : ℝ)⁻¹) := by
      simpa [P, M, vecNorm2, vecNorm2Sq, rowNormSq] using
        rademacherTraceProbability_expectationReal_sqrt_rowNormSq_signedHadamard_le
          H U hflat hU i
    have hsubset :
        {ω |
          vecNorm2
            (fun j : Fin n =>
              preconditionRows
                (matMul m H (diagMatrix (rademacherSignVector ω))) U i j) ≤
            (rademacherTraceProbability m).expectationReal
              (fun ω =>
                vecNorm2
                  (fun j : Fin n =>
                    preconditionRows
                      (matMul m H (diagMatrix (rademacherSignVector ω))) U i j)) +
              t} ⊆ E i := by
      intro ω hω
      change vecNorm2 (fun j : Fin n => M ω i j) ≤ S
      have hmean_add :
          (rademacherTraceProbability m).expectationReal
              (fun ω =>
                vecNorm2
                  (fun j : Fin n =>
                    preconditionRows
                      (matMul m H (diagMatrix (rademacherSignVector ω))) U i j)) +
              t ≤ S := by
        simpa [P, M, S] using add_le_add_right hmean t
      exact hω.trans hmean_add
    exact htail.trans (FiniteProbability.eventProb_mono P hsubset)
  have hall := FiniteProbability.eventProb_forall_ge_one_sub_sum P E δ hrow
  simpa [P, M, S, E, δ, Finset.sum_const, nsmul_eq_mul] using hall

/-- Source-sharp all-row signed-Hadamard row-norm flattening in squared norm.

This is the same all-row concentration as the Euclidean-norm theorem, rewritten
for `rowNormSq`, the quantity used by leverage-score probabilities. -/
theorem rademacherTraceProbability_eventProb_forall_rowNormSq_signedHadamard_le_sqrt_add_sq_ge_one_sub_m_exp_m_t_sq_div_eight
    {m n : ℕ} (H : Fin m → Fin m → ℝ) (U : Fin m → Fin n → ℝ)
    (hm : 0 < m) (hflat : HadamardFlat m H)
    (hU : HasOrthonormalColumns U) (t : ℝ) (ht : 0 < t) :
    1 - (m : ℝ) * Real.exp (-((m : ℝ) * t ^ 2 / 8)) ≤
      (rademacherTraceProbability m).eventProb
        {ω | ∀ i : Fin m,
          rowNormSq
            (preconditionRows
              (matMul m H (diagMatrix (rademacherSignVector ω))) U) i ≤
            (Real.sqrt ((n : ℝ) * (m : ℝ)⁻¹) + t) ^ 2} := by
  classical
  let P := rademacherTraceProbability m
  let M : RademacherTrace m → Fin m → Fin n → ℝ :=
    fun ω =>
      preconditionRows
        (matMul m H (diagMatrix (rademacherSignVector ω))) U
  let S : ℝ := Real.sqrt ((n : ℝ) * (m : ℝ)⁻¹) + t
  let Evec : Set (RademacherTrace m) :=
    {ω | ∀ i : Fin m, vecNorm2 (fun j : Fin n => M ω i j) ≤ S}
  let Esq : Set (RademacherTrace m) :=
    {ω | ∀ i : Fin m, rowNormSq (M ω) i ≤ S ^ 2}
  have hvec :
      1 - (m : ℝ) * Real.exp (-((m : ℝ) * t ^ 2 / 8)) ≤
        P.eventProb Evec := by
    simpa [P, M, S, Evec] using
      rademacherTraceProbability_eventProb_forall_vecNorm2_signedHadamard_le_sqrt_add_ge_one_sub_m_exp_m_t_sq_div_eight
        H U hm hflat hU t ht
  have hS_nonneg : 0 ≤ S := by
    exact add_nonneg (Real.sqrt_nonneg _) (le_of_lt ht)
  have hsubset : Evec ⊆ Esq := by
    intro ω hω i
    have hvec_nonneg : 0 ≤ vecNorm2 (fun j : Fin n => M ω i j) :=
      vecNorm2_nonneg _
    have hsq :
        vecNorm2 (fun j : Fin n => M ω i j) ^ 2 ≤ S ^ 2 := by
      have habs :
          |vecNorm2 (fun j : Fin n => M ω i j)| ≤ |S| := by
        simpa [abs_of_nonneg hvec_nonneg, abs_of_nonneg hS_nonneg]
          using hω i
      exact (sq_le_sq).mpr habs
    have hrow :
        vecNorm2 (fun j : Fin n => M ω i j) ^ 2 =
          rowNormSq (M ω) i := by
      simpa [vecNorm2Sq, rowNormSq] using
        vecNorm2_sq (fun j : Fin n => M ω i j)
    simpa [hrow] using hsq
  exact hvec.trans (FiniteProbability.eventProb_mono P hsubset)

