/-- **Equation (9.27)**, native `Matrix`-product exact-operator-norm
denominator form for `G = L⁻¹ ΔA U⁻¹`. -/
theorem higham9_27_matrix_mul_ratio_le_exact_opNorm2_product_ratio {n : ℕ}
    (Linv ΔA Uinv : Matrix (Fin n) (Fin n) ℝ)
    (heta : opNorm2 Linv * opNorm2 ΔA * opNorm2 Uinv < 1) :
    frobNormRect ((Linv * ΔA) * Uinv) /
        (1 - opNorm2 ((Linv * ΔA) * Uinv)) ≤
      (opNorm2 Linv * frobNormRect ΔA * opNorm2 Uinv) /
