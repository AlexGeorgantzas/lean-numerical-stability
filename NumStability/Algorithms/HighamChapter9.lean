    ∀ i j : Fin n,
      ∑ k : Fin n, |L_hat i k| * |U_hat k j| = |A i j| := by
  obtain ⟨L0, U0, hLU0, hOpt0⟩ :=
    higham9_8_abs_lu_product_eq_abs_of_checkerboard_totalNonnegative_and_pos
      A hTNJ hdetJ hleadJ
