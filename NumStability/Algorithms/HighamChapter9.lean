/-! ## Theorem 9.11 (Bohte), general bandwidth `p`: the leading term
`rho <= 2^(2p-1)` of the Bohte growth bound, proved unconditionally.

Higham (2nd ed., §9.5, Theorem 9.11) states Bohte's sharp bound
`rho_np <= 2^(2p-1) - (p-1)·2^(p-2)` with "Proof. See Bohte [146, 1975]"
(source paywalled; requested).  The leading term `2^(2p-1)` is proved here
from first principles by a band-shaped active-stage invariant: the first
stage that touches a column cannot grow it (the pivot window meets that
column in at most one nonzero), and each of the remaining `2p-1` touching
stages at most doubles it.  At `p = 1` this recovers the sharp tridiagonal
constant `2`. -/

/-- **Theorem 9.11 support**, band-tracked active-stage invariant for GEPP on
a matrix of lower and upper bandwidth `p`.  For the active (trailing) stage
`S`: (1) lower bandwidth `p` is preserved; (2) pivot-window rows (`i <= p`)
have support in columns `<= 2p`; (3) window entries obey the per-column fill
bound `M·2^(2p-1-j)` (truncated subtraction; columns `>= 2p-1` are still at
the original magnitude `M`); (4) in the extreme window column `j = 2p` at
most one window row is nonzero (it is an untouched original entry); (5) rows
below the window are untouched original rows: entries `<= M` and upper
bandwidth `p`. -/
def higham9_11_BandActiveBound (n p : ℕ) (M : ℝ)
    (S : Fin n → Fin n → ℝ) : Prop :=
  (∀ i j : Fin n, j.val + p < i.val → S i j = 0) ∧
  (∀ i j : Fin n, i.val ≤ p → 2 * p < j.val → S i j = 0) ∧
  (∀ i j : Fin n, i.val ≤ p → |S i j| ≤ M * 2 ^ (2 * p - 1 - j.val)) ∧
  (∀ i i' j : Fin n, i.val ≤ p → i'.val ≤ p → j.val = 2 * p →
    S i j ≠ 0 → S i' j ≠ 0 → i = i') ∧
  (∀ i j : Fin n, p < i.val →
    |S i j| ≤ M ∧ (i.val + p < j.val → S i j = 0))

/-- **Theorem 9.11 support**, a banded matrix with entries bounded by `M`
satisfies the band-tracked active-stage invariant. -/
theorem higham9_11_bandActiveBound_of_isBanded {n p : ℕ} {M : ℝ}
    {A : Fin n → Fin n → ℝ} (hM : 0 ≤ M)
    (hband : IsBanded n p p A)
    (hbound : ∀ i j : Fin n, |A i j| ≤ M) :
    higham9_11_BandActiveBound n p M A := by
  have hMpow : ∀ k : ℕ, M ≤ M * 2 ^ k := fun k =>
    le_mul_of_one_le_right hM (one_le_pow₀ one_le_two)
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · intro i j hij
    exact hband i j (Or.inl hij)
  · intro i j hi hj
    exact hband i j (Or.inr (by omega))
  · intro i j _
    exact le_trans (hbound i j) (hMpow _)
  · intro i i' j hi hi' hj hne hne'
    have hiv : i.val = p := by
      by_contra h
      exact hne (hband i j (Or.inr (by omega)))
    have hiv' : i'.val = p := by
      by_contra h
      exact hne' (hband i' j (Or.inr (by omega)))
    exact Fin.ext (by omega)
  · intro i j hi
    refine ⟨hbound i j, fun hj => hband i j (Or.inr (by omega))⟩

/-- **Theorem 9.11 support**, a nonzero first-column pivot of a band-tracked
stage lies within the pivot window (`r <= p`). -/
theorem higham9_11_band_pivot_val_le {m p : ℕ} {M : ℝ}
    {S : Fin (m + 1) → Fin (m + 1) → ℝ} {r : Fin (m + 1)}
    (hS : higham9_11_BandActiveBound (m + 1) p M S) (hpivot : S r 0 ≠ 0) :
    r.val ≤ p := by
  by_contra h
  exact hpivot (hS.1 r 0 (by simp only [Fin.val_zero]; omega))

/-- **Theorem 9.11 support**, every entry of a band-tracked active stage is
bounded by `2^(2p-1)·M`. -/
theorem higham9_11_bandActive_entry_abs_le {n p : ℕ} {M : ℝ}
    {S : Fin n → Fin n → ℝ}
    (hM : 0 ≤ M)
    (hS : higham9_11_BandActiveBound n p M S)
    (i j : Fin n) :
    |S i j| ≤ 2 ^ (2 * p - 1) * M := by
  by_cases hi : i.val ≤ p
  · have h := hS.2.2.1 i j hi
    have hpow : (2 : ℝ) ^ (2 * p - 1 - j.val) ≤ 2 ^ (2 * p - 1) :=
      pow_le_pow_right₀ one_le_two (by omega)
    calc |S i j| ≤ M * 2 ^ (2 * p - 1 - j.val) := h
      _ ≤ M * 2 ^ (2 * p - 1) := by
          exact mul_le_mul_of_nonneg_left hpow hM
      _ = 2 ^ (2 * p - 1) * M := by ring
  · have h := (hS.2.2.2.2 i j (by omega)).1
    calc |S i j| ≤ M := h
      _ ≤ 2 ^ (2 * p - 1) * M :=
          le_mul_of_one_le_left hM (one_le_pow₀ one_le_two)

/-- **Theorem 9.11 support**, one partial-pivoting Gaussian elimination step
preserves the band-tracked active-stage invariant: after moving the
partial pivot into leading position, the first Schur complement is again
band-tracked with the same fill profile.  This is the general-bandwidth
analogue of the tridiagonal band-fill bookkeeping, and encodes the key
observation that the first stage touching a column cannot grow it. -/
theorem higham9_11_bandActive_schur_preserved {p m : ℕ}
    {S : Fin (m + 1) → Fin (m + 1) → ℝ} {M : ℝ} {r : Fin (m + 1)}
    (hM : 0 ≤ M)
    (hS : higham9_11_BandActiveBound (m + 1) p M S)
    (hchoice : higham9_1_partialPivotChoice S 0 r)
    (hpivot : S r 0 ≠ 0) :
    higham9_11_BandActiveBound m p M
      (luFirstSchurComplement
        (higham9_2_rowPermutedMatrix S (higham9_7_firstPivotRowSwap r))) := by
  obtain ⟨h1, h2, h3, h4, h5⟩ := hS
  have hrle : r.val ≤ p :=
    higham9_11_band_pivot_val_le ⟨h1, h2, h3, h4, h5⟩ hpivot
  set σ : Fin (m + 1) → Fin (m + 1) := higham9_7_firstPivotRowSwap r
    with hσdef
  have hσ0 : σ 0 = r := by
    simp [hσdef, higham9_7_firstPivotRowSwap]
  have hσ_high : ∀ x : Fin (m + 1), p < x.val → σ x = x := by
    intro x hx
    have hx0 : x ≠ 0 := by
      intro h
      subst h
      simp at hx
    have hxr : x ≠ r := by
      intro h
      subst h
      omega
    simp [hσdef, higham9_7_firstPivotRowSwap, hx0, hxr]
  have hσ_window : ∀ x : Fin (m + 1), x.val ≤ p → (σ x).val ≤ p := by
    intro x hx
    by_cases hx0 : x = 0
    · subst hx0
      rw [hσ0]
      exact hrle
    · by_cases hxr : x = r
      · have hswap : σ x = 0 := by
          simp [hσdef, higham9_7_firstPivotRowSwap, hxr, hx0]
        rw [hswap]
        simp
      · have hid : σ x = x := by
          simp [hσdef, higham9_7_firstPivotRowSwap, hx0, hxr]
        rw [hid]
        exact hx
  have hσ_ne_r : ∀ x : Fin (m + 1), x ≠ 0 → σ x ≠ r := by
    intro x hx0
    by_cases hxr : x = r
    · subst hxr
      have hσx : σ x = 0 := by
        simp [hσdef, higham9_7_firstPivotRowSwap, hx0]
      rw [hσx]
      intro h
      exact hx0 h.symm
    · have hσx : σ x = x := by
        simp [hσdef, higham9_7_firstPivotRowSwap, hx0, hxr]
      rw [hσx]
      exact hxr
  have hSchur : ∀ i j : Fin m,
      luFirstSchurComplement (higham9_2_rowPermutedMatrix S σ) i j =
        S (σ i.succ) j.succ - S (σ i.succ) 0 * S r j.succ / S r 0 := by
    intro i j
    show S (σ i.succ) j.succ - S (σ i.succ) 0 * S (σ 0) j.succ / S (σ 0) 0 = _
    rw [hσ0]
  have hmul : ∀ x : Fin (m + 1), |S x 0 / S r 0| ≤ 1 := fun x =>
    higham9_1_partialPivot_multiplier_abs_le_one S 0 r x hchoice hpivot
      (Nat.zero_le _)
  have hzero_below : ∀ x : Fin (m + 1), p < x.val → S x 0 = 0 := by
    intro x hx
    exact h1 x 0 (by simp only [Fin.val_zero]; omega)
  -- shifted rows below the window are pure shifts of untouched rows
  have hshift : ∀ i : Fin m, p < i.val + 1 →
      ∀ j : Fin m,
        luFirstSchurComplement (higham9_2_rowPermutedMatrix S σ) i j =
          S i.succ j.succ := by
    intro i hi j
    have hσs : σ i.succ = i.succ := hσ_high i.succ (by
      simp only [Fin.val_succ]
      omega)
    rw [hSchur i j, hσs, hzero_below i.succ (by
      simp only [Fin.val_succ]
      omega)]
    ring
  have hMpow : ∀ k : ℕ, M ≤ M * 2 ^ k := fun k =>
    le_mul_of_one_le_right hM (one_le_pow₀ one_le_two)
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · -- clause 1: lower bandwidth p
    intro i j hij
    have hi : p < i.val + 1 := by omega
    rw [hshift i (by omega) j]
    exact h1 i.succ j.succ (by
      simp only [Fin.val_succ]
      omega)
  · -- clause 2: window support ends at column 2p
    intro i j hi hj
    have hr_col : S r j.succ = 0 := h2 r j.succ hrle (by
      simp only [Fin.val_succ]
      omega)
    have hlead : S (σ i.succ) j.succ = 0 := by
      by_cases hip : i.val + 1 ≤ p
      · exact h2 (σ i.succ) j.succ
          (hσ_window i.succ (by simp only [Fin.val_succ]; omega)) (by
          simp only [Fin.val_succ]
          omega)
      · have hσs : σ i.succ = i.succ := hσ_high i.succ (by
          simp only [Fin.val_succ]
          omega)
        rw [hσs]
        exact (h5 i.succ j.succ (by
          simp only [Fin.val_succ]
          omega)).2 (by
          simp only [Fin.val_succ]
          omega)
    rw [hSchur i j, hr_col, hlead]
    ring
  · -- clause 3: per-column fill bound
    intro i j hi
    by_cases hip : i.val + 1 ≤ p
    · -- window rows: at most doubling, with the extreme column protected
      -- by the single-nonzero clause
      have hσw : (σ i.succ).val ≤ p :=
        hσ_window i.succ (by simp only [Fin.val_succ]; omega)
      have habs : |luFirstSchurComplement
          (higham9_2_rowPermutedMatrix S σ) i j| ≤
          |S (σ i.succ) j.succ| + |S r j.succ| := by
        rw [hSchur i j]
        have hterm : |S (σ i.succ) 0 * S r j.succ / S r 0| ≤
            |S r j.succ| := by
          have heq : S (σ i.succ) 0 * S r j.succ / S r 0 =
              S (σ i.succ) 0 / S r 0 * S r j.succ := by ring
          rw [heq, abs_mul]
          calc |S (σ i.succ) 0 / S r 0| * |S r j.succ| ≤
              1 * |S r j.succ| :=
                mul_le_mul_of_nonneg_right (hmul _) (abs_nonneg _)
            _ = |S r j.succ| := one_mul _
        calc |S (σ i.succ) j.succ - S (σ i.succ) 0 * S r j.succ / S r 0|
            ≤ |S (σ i.succ) j.succ| +
                |S (σ i.succ) 0 * S r j.succ / S r 0| := by
              simpa [sub_eq_add_neg, abs_neg] using
                abs_add_le (S (σ i.succ) j.succ)
                  (-(S (σ i.succ) 0 * S r j.succ / S r 0))
          _ ≤ |S (σ i.succ) j.succ| + |S r j.succ| := by linarith [hterm]
      by_cases hj2 : j.val + 2 ≤ 2 * p
      · -- interior columns: both terms carry the (j+1)-column bound
        have hb1 : |S (σ i.succ) j.succ| ≤
            M * 2 ^ (2 * p - 1 - (j.val + 1)) := by
          have := h3 (σ i.succ) j.succ hσw
          simpa [Fin.val_succ] using this
        have hb2 : |S r j.succ| ≤ M * 2 ^ (2 * p - 1 - (j.val + 1)) := by
          have := h3 r j.succ hrle
          simpa [Fin.val_succ] using this
        have hexp : 2 * p - 1 - j.val = (2 * p - 1 - (j.val + 1)) + 1 := by
          omega
        rw [hexp, pow_succ]
        calc |luFirstSchurComplement (higham9_2_rowPermutedMatrix S σ) i j|
            ≤ M * 2 ^ (2 * p - 1 - (j.val + 1)) +
              M * 2 ^ (2 * p - 1 - (j.val + 1)) := by
              linarith [habs, hb1, hb2]
          _ = M * (2 ^ (2 * p - 1 - (j.val + 1)) * 2) := by ring
      · by_cases hj1 : j.val + 1 = 2 * p
        · -- second-to-extreme column: at most one of the two window terms
          -- is nonzero, each bounded by `M`
          have hne : σ i.succ ≠ r := hσ_ne_r i.succ (Fin.succ_ne_zero i)
          have honeM : |S (σ i.succ) j.succ| ≤ M := by
            have := h3 (σ i.succ) j.succ hσw
            calc |S (σ i.succ) j.succ| ≤
                M * 2 ^ (2 * p - 1 - j.succ.val) := this
              _ = M := by
                  simp only [Fin.val_succ]
                  rw [show 2 * p - 1 - (j.val + 1) = 0 from by omega]
                  ring
          have hrM : |S r j.succ| ≤ M := by
            have := h3 r j.succ hrle
            calc |S r j.succ| ≤ M * 2 ^ (2 * p - 1 - j.succ.val) := this
              _ = M := by
                  simp only [Fin.val_succ]
                  rw [show 2 * p - 1 - (j.val + 1) = 0 from by omega]
                  ring
          have hcases : S (σ i.succ) j.succ = 0 ∨ S r j.succ = 0 := by
            by_contra h
            push_neg at h
            exact hne (h4 (σ i.succ) r j.succ hσw hrle (by
              simp only [Fin.val_succ]
              omega) h.1 h.2)
          have hgoal : |luFirstSchurComplement
              (higham9_2_rowPermutedMatrix S σ) i j| ≤ M := by
            rcases hcases with hz | hz
            · rw [hSchur i j, hz]
              have heq : (0 : ℝ) - S (σ i.succ) 0 * S r j.succ / S r 0 =
                  -(S (σ i.succ) 0 / S r 0 * S r j.succ) := by ring
              rw [heq, abs_neg, abs_mul]
              calc |S (σ i.succ) 0 / S r 0| * |S r j.succ| ≤ 1 * M :=
                    mul_le_mul (hmul _) hrM (abs_nonneg _) zero_le_one
                _ = M := one_mul M
            · rw [hSchur i j, hz]
              have heq : S (σ i.succ) j.succ -
                  S (σ i.succ) 0 * 0 / S r 0 = S (σ i.succ) j.succ := by
                ring
              rw [heq]
              exact honeM
          exact le_trans hgoal (hMpow _)
        · -- columns at or beyond 2p: the entry vanishes
          have hj2p : 2 * p ≤ j.val := by omega
          have hr_col : S r j.succ = 0 := h2 r j.succ hrle (by
            simp only [Fin.val_succ]
            omega)
          have hlead : S (σ i.succ) j.succ = 0 :=
            h2 (σ i.succ) j.succ hσw (by
              simp only [Fin.val_succ]
              omega)
          rw [hSchur i j, hr_col, hlead]
          have hz : (0 : ℝ) - S (σ i.succ) 0 * 0 / S r 0 = 0 := by ring
          rw [hz, abs_zero]
          exact mul_nonneg hM (by positivity)
    · -- the entrant row (`i = p`): untouched original, multiplier zero
      rw [hshift i (by omega) j]
      calc |S i.succ j.succ| ≤ M := by
            exact (h5 i.succ j.succ (by
              simp only [Fin.val_succ]
              omega)).1
        _ ≤ M * 2 ^ (2 * p - 1 - j.val) := hMpow _
  · -- clause 4: unique window nonzero in the extreme column
    intro i i' j hi hi' hj hne hne'
    have hzero_lt : ∀ x : Fin m, x.val + 1 ≤ p →
        luFirstSchurComplement (higham9_2_rowPermutedMatrix S σ) x j = 0 := by
      intro x hx
      have hσw : (σ x.succ).val ≤ p :=
        hσ_window x.succ (by simp only [Fin.val_succ]; omega)
      have hr_col : S r j.succ = 0 := h2 r j.succ hrle (by
        simp only [Fin.val_succ]
        omega)
      have hlead : S (σ x.succ) j.succ = 0 := h2 (σ x.succ) j.succ hσw (by
        simp only [Fin.val_succ]
        omega)
      rw [hSchur x j, hr_col, hlead]
      ring
    have hiv : i.val = p := by
      by_contra h
      exact hne (hzero_lt i (by omega))
    have hiv' : i'.val = p := by
      by_contra h
      exact hne' (hzero_lt i' (by omega))
    exact Fin.ext (by omega)
  · -- clause 5: rows below the window stay untouched originals
    intro i j hi
    rw [hshift i (by omega) j]
    refine ⟨(h5 i.succ j.succ (by
      simp only [Fin.val_succ]
      omega)).1, fun hj => (h5 i.succ j.succ (by
      simp only [Fin.val_succ]
      omega)).2 (by
      simp only [Fin.val_succ]
      omega)⟩

/-- **Theorem 9.11**, trace-level banded GEPP entry bound: along any explicit
recursive partial-pivoting trace whose input satisfies the band-tracked
invariant, every final upper-factor entry is bounded by `2^(2p-1)·M`. -/
theorem higham9_11_banded_PartialPivotGEPPUTrace_entry_abs_le :
    ∀ {n : ℕ} {A U : Fin n → Fin n → ℝ},
      higham9_7_PartialPivotGEPPUTrace n A U →
      ∀ (p : ℕ) (M : ℝ), 0 ≤ M →
        higham9_11_BandActiveBound n p M A →
        ∀ i j : Fin n, |U i j| ≤ 2 ^ (2 * p - 1) * M := by
  intro n A U htrace
  induction htrace with
  | done =>
      intro p M hM hA i j
      exact Fin.elim0 i
  | step hchoice hpivot _hnext ih =>
      rename_i m A r U₁
      intro p M hM hA i j
      by_cases hi : i = 0
      · subst hi
        have hrow := higham9_11_bandActive_entry_abs_le hM hA r j
        simpa [luFirstStepU, higham9_2_rowPermutedMatrix,
          higham9_7_firstPivotRowSwap] using hrow
      · by_cases hj : j = 0
        · subst hj
          have hzero : luFirstStepU
              (higham9_2_rowPermutedMatrix A (higham9_7_firstPivotRowSwap r))
              U₁ i 0 = 0 := by
            simp [luFirstStepU, hi]
          rw [hzero]
          simp only [abs_zero]
          exact mul_nonneg (by positivity) hM
        · have hA' := higham9_11_bandActive_schur_preserved hM hA
            hchoice hpivot
          have hrec := ih p M hM hA' (i.pred hi) (j.pred hj)
          simpa [luFirstStepU, hi, hj] using hrec

/-- **Theorem 9.11** (Higham, 2nd ed., §9.5, Theorem 9.11; Bohte [146, 1975],
leading term), banded GEPP entry bound: for a matrix of lower and upper
bandwidth `p`, every entry of the exact partial-pivoting upper factor is
bounded by `2^(2p-1)` times the max-entry norm of `A`. -/
theorem higham9_11_banded_GEPPUTrace_entry_abs_le_pow_mul {n : ℕ}
    (hn : 0 < n) (A U : Fin n → Fin n → ℝ) (p : ℕ)
    (hA_band : IsBanded n p p A)
    (htrace : higham9_7_PartialPivotGEPPUTrace n A U)
    (i j : Fin n) :
    |U i j| ≤ 2 ^ (2 * p - 1) * maxEntryNorm hn A := by
  apply higham9_11_banded_PartialPivotGEPPUTrace_entry_abs_le htrace
    p (maxEntryNorm hn A) (maxEntryNorm_nonneg hn A) ?_ i j
  exact higham9_11_bandActiveBound_of_isBanded (maxEntryNorm_nonneg hn A)
    hA_band (fun a b => entry_le_maxEntryNorm hn A a b)

/-- **Theorem 9.11** (Higham, 2nd ed., §9.5, Theorem 9.11; Bohte [146, 1975],
leading term), the banded GEPP growth-factor bound `rho <= 2^(2p-1)`:
Gaussian elimination with partial pivoting on a matrix of lower and upper
bandwidth `p` has max-entry growth factor at most `2^(2p-1)`, independent of
the order `n`.  This proves the leading term of the printed Bohte constant
`2^(2p-1) - (p-1)·2^(p-2)` unconditionally; at `p = 1` it recovers the sharp
tridiagonal bound `2`. -/
theorem higham9_11_banded_GEPPUTrace_growthFactorEntry_le_two_pow {n : ℕ}
    (hn : 0 < n) (A U : Fin n → Fin n → ℝ) (p : ℕ)
    (hAmax : 0 < maxEntryNorm hn A)
    (hA_band : IsBanded n p p A)
    (htrace : higham9_7_PartialPivotGEPPUTrace n A U) :
    growthFactorEntry hn A U hAmax ≤ 2 ^ (2 * p - 1) := by
  apply growthFactorEntry_le_of_entry_bound_factor hn A U (2 ^ (2 * p - 1))
    hAmax
  exact higham9_11_banded_GEPPUTrace_entry_abs_le_pow_mul hn A U p
    hA_band htrace

/-- **Theorem 9.11**, the Bohte scalar is dominated by its leading term:
`bohteBound p <= 2^(2p-1)` for `p >= 1`.  Records precisely what remains
citation-blocked: only the correction `-(p-1)·2^(p-2)` separates the proved
unconditional bound from the printed sharp constant. -/
theorem higham9_11_bohteBound_le_two_pow {p : ℕ} (hp : 1 ≤ p) :
    higham9_11_bohteBound p ≤ 2 ^ (2 * p - 1) := by
  unfold higham9_11_bohteBound
  have hnn : (0 : ℝ) ≤ ((p : ℝ) - 1) * 2 ^ (p - 2) := by
    apply mul_nonneg
    · have : (1 : ℝ) ≤ (p : ℝ) := by exact_mod_cast hp
      linarith
    · positivity
  linarith

/-- **Theorem 9.11**, consistency of the general banded bound with the sharp
tridiagonal case: at `p = 1` the unconditional bound `2^(2p-1)` equals the
printed Bohte constant `2`. -/
theorem higham9_11_banded_GEPPUTrace_growthFactorEntry_le_bohteBound_one
    {n : ℕ} (hn : 0 < n) (A U : Fin n → Fin n → ℝ)
    (hAmax : 0 < maxEntryNorm hn A)
    (hA_band : IsBanded n 1 1 A)
    (htrace : higham9_7_PartialPivotGEPPUTrace n A U) :
    growthFactorEntry hn A U hAmax ≤ higham9_11_bohteBound 1 := by
  rw [higham9_11_bohteBound_tridiagonal]
  have h := higham9_11_banded_GEPPUTrace_growthFactorEntry_le_two_pow
    hn A U 1 hAmax hA_band htrace
  norm_num at h
  exact h


