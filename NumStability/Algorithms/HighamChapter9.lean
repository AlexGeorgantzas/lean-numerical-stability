    simpa [Matrix.mul_apply, idMatrix] using h
  have hRight : IsRightInverse n A Ainv :=
    ch7_isRightInverse_of_isLeftInverse hLeft
  ext i j
  simpa [Matrix.mul_apply, idMatrix] using hRight i j

