/-- **Theorem 9.15**, normalized algebraic identity for the normwise
perturbation theorem.  With
`G = L⁻¹ ΔA U⁻¹`, `X = L⁻¹ ΔL`, and `Y = ΔU U⁻¹`, the two exact
factorizations imply `I + G = (I + X)(I + Y)`. -/
theorem higham9_15_normalized_G_factorization_matrix {n : ℕ}
    (A L U ΔA ΔL ΔU Linv Uinv : Matrix (Fin n) (Fin n) ℝ)
    (hLU : L * U = A)
    (hPert : (L + ΔL) * (U + ΔU) = A + ΔA)
    (hLinv : Linv * L = 1)
    (hUinv : U * Uinv = 1) :
    (1 + Linv * ΔL) * (1 + ΔU * Uinv) = 1 + Linv * ΔA * Uinv := by
  have hleft : 1 + Linv * ΔL = Linv * (L + ΔL) := by
    rw [mul_add, hLinv]
  have hright : 1 + ΔU * Uinv = (U + ΔU) * Uinv := by
    rw [add_mul, hUinv]
  have hbase : Linv * A * Uinv = 1 := by
    rw [← hLU]
    calc
      Linv * (L * U) * Uinv = (Linv * L) * (U * Uinv) := by
        noncomm_ring
      _ = 1 := by
        rw [hLinv, hUinv]
        simp
  calc
    (1 + Linv * ΔL) * (1 + ΔU * Uinv)
        = (Linv * (L + ΔL)) * ((U + ΔU) * Uinv) := by
          rw [hleft, hright]
    _ = Linv * ((L + ΔL) * (U + ΔU)) * Uinv := by
      noncomm_ring
    _ = Linv * (A + ΔA) * Uinv := by
      rw [hPert]
    _ = Linv * A * Uinv + Linv * ΔA * Uinv := by
      noncomm_ring
    _ = 1 + Linv * ΔA * Uinv := by
      rw [hbase]

/-- **Theorem 9.15**, normalized algebraic identity for the componentwise
Barrlund--Sun perturbation theorem.  With
`Gtilde = Lhat⁻¹ ΔA Uhat⁻¹`, `X = Lhat⁻¹ ΔL`, and `Y = ΔU Uhat⁻¹`,
the two exact factorizations imply `I - Gtilde = (I - X)(I - Y)`. -/
theorem higham9_15_normalized_Gtilde_factorization_matrix {n : ℕ}
    (A Lhat Uhat ΔA ΔL ΔU LhatInv UhatInv : Matrix (Fin n) (Fin n) ℝ)
    (hA : (Lhat - ΔL) * (Uhat - ΔU) = A)
    (hPert : Lhat * Uhat = A + ΔA)
    (hLhatInv : LhatInv * Lhat = 1)
    (hUhatInv : Uhat * UhatInv = 1) :
    (1 - LhatInv * ΔL) * (1 - ΔU * UhatInv) =
      1 - LhatInv * ΔA * UhatInv := by
  have hleft : 1 - LhatInv * ΔL = LhatInv * (Lhat - ΔL) := by
    rw [mul_sub, hLhatInv]
  have hright : 1 - ΔU * UhatInv = (Uhat - ΔU) * UhatInv := by
    rw [sub_mul, hUhatInv]
  have hA_as : A = Lhat * Uhat - ΔA := by
    calc
      A = A + ΔA - ΔA := by
        abel
      _ = Lhat * Uhat - ΔA := by
        rw [← hPert]
  have hbase : LhatInv * A * UhatInv = 1 - LhatInv * ΔA * UhatInv := by
    rw [hA_as]
    calc
      LhatInv * (Lhat * Uhat - ΔA) * UhatInv
          = LhatInv * (Lhat * Uhat) * UhatInv - LhatInv * ΔA * UhatInv := by
            noncomm_ring
      _ = (LhatInv * Lhat) * (Uhat * UhatInv) -
            LhatInv * ΔA * UhatInv := by
            noncomm_ring
      _ = 1 - LhatInv * ΔA * UhatInv := by
            rw [hLhatInv, hUhatInv]
            simp
  calc
    (1 - LhatInv * ΔL) * (1 - ΔU * UhatInv)
        = (LhatInv * (Lhat - ΔL)) * ((Uhat - ΔU) * UhatInv) := by
          rw [hleft, hright]
    _ = LhatInv * ((Lhat - ΔL) * (Uhat - ΔU)) * UhatInv := by
      noncomm_ring
    _ = LhatInv * A * UhatInv := by
      rw [hA]
    _ = 1 - LhatInv * ΔA * UhatInv := hbase

/-- **Theorem 9.15 support**: the leading `k × k` block of a product `L * X`
with lower-triangular left factor is the product of the leading blocks. -/
theorem higham9_15_leadingSubmatrix_mul_of_lower_left {n : ℕ}
    (L X : Matrix (Fin n) (Fin n) ℝ)
    (hL : ∀ i j : Fin n, i.val < j.val → L i j = 0)
    {k : ℕ} (hk : k ≤ n) :
    (L * X).submatrix (Fin.castLE hk) (Fin.castLE hk)
      = L.submatrix (Fin.castLE hk) (Fin.castLE hk)
        * X.submatrix (Fin.castLE hk) (Fin.castLE hk) := by
  classical
  set e : Fin k → Fin n := Fin.castLE hk with he
  have hinj : Function.Injective e := Fin.castLE_injective hk
  ext i j
  simp only [Matrix.submatrix_apply, Matrix.mul_apply]
  rw [show (∑ m : Fin k, L (e i) (e m) * X (e m) (e j))
        = ∑ p ∈ Finset.univ.map ⟨e, hinj⟩, L (e i) p * X p (e j) from
      (Finset.sum_map Finset.univ ⟨e, hinj⟩
        (fun p => L (e i) p * X p (e j))).symm]
  refine (Finset.sum_subset (Finset.subset_univ _) ?_).symm
  intro p _ hp
  have hpk : k ≤ p.val := by
    by_contra hlt
    push_neg at hlt
    exact hp (Finset.mem_map.mpr
      ⟨⟨p.val, hlt⟩, Finset.mem_univ _, by
        apply Fin.ext; simp [he]⟩)
  have hlt : (e i).val < p.val := by
    have h1 : (e i).val = i.val := by simp [he]
    have h2 : i.val < k := i.isLt
    omega
  rw [hL (e i) p hlt, zero_mul]

/-- **Theorem 9.15 support**: the leading `k × k` block of a product `X * U`
with upper-triangular right factor is the product of the leading blocks. -/
theorem higham9_15_leadingSubmatrix_mul_of_upper_right {n : ℕ}
    (X U : Matrix (Fin n) (Fin n) ℝ)
    (hU : ∀ i j : Fin n, j.val < i.val → U i j = 0)
    {k : ℕ} (hk : k ≤ n) :
    (X * U).submatrix (Fin.castLE hk) (Fin.castLE hk)
      = X.submatrix (Fin.castLE hk) (Fin.castLE hk)
        * U.submatrix (Fin.castLE hk) (Fin.castLE hk) := by
  classical
  set e : Fin k → Fin n := Fin.castLE hk with he
  have hinj : Function.Injective e := Fin.castLE_injective hk
  ext i j
  simp only [Matrix.submatrix_apply, Matrix.mul_apply]
  rw [show (∑ m : Fin k, X (e i) (e m) * U (e m) (e j))
        = ∑ p ∈ Finset.univ.map ⟨e, hinj⟩, X (e i) p * U p (e j) from
      (Finset.sum_map Finset.univ ⟨e, hinj⟩
        (fun p => X (e i) p * U p (e j))).symm]
  refine (Finset.sum_subset (Finset.subset_univ _) ?_).symm
  intro p _ hp
  have hpk : k ≤ p.val := by
    by_contra hlt
    push_neg at hlt
    exact hp (Finset.mem_map.mpr
      ⟨⟨p.val, hlt⟩, Finset.mem_univ _, by
        apply Fin.ext; simp [he]⟩)
  have hlt : (e j).val < p.val := by
    have h1 : (e j).val = j.val := by simp [he]
    have h2 : j.val < k := j.isLt
    omega
  rw [hU p (e j) hlt, mul_zero]

/-- **Theorem 9.15 support**: determinant of the leading block of a
unit-lower × middle × upper product. -/
theorem higham9_15_leadingSubmatrix_det_triple {n : ℕ}
    (L M U : Matrix (Fin n) (Fin n) ℝ)
    (hL_diag : ∀ i : Fin n, L i i = 1)
    (hL : ∀ i j : Fin n, i.val < j.val → L i j = 0)
    (hU : ∀ i j : Fin n, j.val < i.val → U i j = 0)
    {k : ℕ} (hk : k ≤ n) :
    ((L * M * U).submatrix (Fin.castLE hk) (Fin.castLE hk)).det
      = (M.submatrix (Fin.castLE hk) (Fin.castLE hk)).det
        * ∏ i : Fin k, U (Fin.castLE hk i) (Fin.castLE hk i) := by
  classical
  set e : Fin k → Fin n := Fin.castLE hk with he
  rw [higham9_15_leadingSubmatrix_mul_of_upper_right (L * M) U hU hk,
    higham9_15_leadingSubmatrix_mul_of_lower_left L M hL hk,
    Matrix.det_mul, Matrix.det_mul]
  have hLtri : Matrix.BlockTriangular (L.submatrix e e) OrderDual.toDual := by
    intro a b hab
    have hab' : a.val < b.val := by simpa using hab
    have : (e a).val < (e b).val := by simp [he]; exact hab'
    simp only [Matrix.submatrix_apply]
    exact hL (e a) (e b) this
  have hUtri : Matrix.BlockTriangular (U.submatrix e e) id := by
    intro a b hab
    have hab' : b.val < a.val := by simpa using hab
    have : (e b).val < (e a).val := by simp [he]; exact hab'
    simp only [Matrix.submatrix_apply]
    exact hU (e a) (e b) this
  have hLdet : (L.submatrix e e).det = 1 := by
    rw [Matrix.det_of_lowerTriangular _ hLtri]
    refine Finset.prod_eq_one ?_
    intro i _
    simp only [Matrix.submatrix_apply]
    exact hL_diag (e i)
  have hUdet : (U.submatrix e e).det
      = ∏ i : Fin k, U (e i) (e i) := by
    rw [Matrix.det_of_upperTriangular hUtri]
    exact Finset.prod_congr rfl (fun i _ => by simp only [Matrix.submatrix_apply])
  rw [hLdet, hUdet, one_mul]

/-- **Theorem 9.15 / Equation (9.27) foundation: perturbed leading minors.**
If `A = L·U` with `L` unit lower and `U` upper triangular, and `Linv`/`Uinv`
are inverse certificates, then for `G = Linv·ΔA·Uinv` the perturbed matrix
factors as `A + ΔA = L·(I + G)·U`, so every leading principal minor of
`A + ΔA` equals the corresponding leading minor of `I + G` times the product
of the first `k` pivots of `U`.

This is the existence engine of the Barrlund homotopy for (9.27): whenever
the leading minors of `I + G` are nonzero (e.g. from `‖G‖₂ < 1`) and the
pivots are nonzero, the perturbed matrix keeps nonsingular leading minors,
hence retains an LU factorization. -/
theorem higham9_15_perturbed_leading_minor_eq {n : ℕ}
    (A L U ΔA Linv Uinv : Matrix (Fin n) (Fin n) ℝ)
    (hLU : L * U = A)
    (hL_diag : ∀ i : Fin n, L i i = 1)
    (hL : ∀ i j : Fin n, i.val < j.val → L i j = 0)
    (hU : ∀ i j : Fin n, j.val < i.val → U i j = 0)
    (hLinv : Linv * L = 1)
    (hUinv : U * Uinv = 1)
    {k : ℕ} (hk : k ≤ n) :
    ((A + ΔA).submatrix (Fin.castLE hk) (Fin.castLE hk)).det
      = ((1 + Linv * ΔA * Uinv).submatrix
          (Fin.castLE hk) (Fin.castLE hk)).det
        * ∏ i : Fin k, U (Fin.castLE hk i) (Fin.castLE hk i) := by
  have hLL : L * Linv = 1 := mul_eq_one_comm.mp hLinv
  have hUU : Uinv * U = 1 := mul_eq_one_comm.mp hUinv
  have hfact : A + ΔA = L * (1 + Linv * ΔA * Uinv) * U := by
    calc A + ΔA
        = L * U + (L * Linv) * ΔA * (Uinv * U) := by
          rw [hLL, hUU, hLU]
          noncomm_ring
      _ = L * (1 + Linv * ΔA * Uinv) * U := by
          noncomm_ring
  rw [hfact]
  exact higham9_15_leadingSubmatrix_det_triple L (1 + Linv * ΔA * Uinv) U
    hL_diag hL hU hk

/-- **Theorem 9.15 support**: an operator-2-norm bound transfers to every
leading principal submatrix (zero-padding argument). -/
theorem higham9_15_opNorm2Le_leadingSubmatrix {n : ℕ}
    (M : Fin n → Fin n → ℝ) {c : ℝ} (hM : opNorm2Le M c)
    {k : ℕ} (hk : k ≤ n) :
    opNorm2Le (fun i j : Fin k => M (Fin.castLE hk i) (Fin.castLE hk j)) c := by
  classical
  intro x
  set e : Fin k → Fin n := Fin.castLE hk with he
  have hinj : Function.Injective e := Fin.castLE_injective hk
  set xhat : Fin n → ℝ :=
    fun p => if h : p.val < k then x ⟨p.val, h⟩ else 0 with hxhat
  have hxhat_e : ∀ i : Fin k, xhat (e i) = x i := by
    intro i
    have h : (e i).val < k := by simp [he]
    simp only [hxhat]
    rw [dif_pos h]
    congr 1
  have hxhat_zero : ∀ p : Fin n,
      p ∉ (Finset.univ : Finset (Fin k)).map ⟨e, hinj⟩ → xhat p = 0 := by
    intro p hp
    have hpk : k ≤ p.val := by
      by_contra hlt
      push_neg at hlt
      exact hp (Finset.mem_map.mpr
        ⟨⟨p.val, hlt⟩, Finset.mem_univ _, by
          apply Fin.ext; simp [he]⟩)
    simp only [hxhat]
    rw [dif_neg (by omega)]
  have hSq : vecNorm2Sq xhat = vecNorm2Sq x := by
    unfold vecNorm2Sq
    rw [← Finset.sum_subset
      (Finset.subset_univ ((Finset.univ : Finset (Fin k)).map ⟨e, hinj⟩))
      (fun p _ hp => by rw [hxhat_zero p hp]; ring)]
    rw [Finset.sum_map]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    simp only [Function.Embedding.coeFn_mk]
    rw [hxhat_e i]
  have hxnorm : vecNorm2 xhat = vecNorm2 x := by
    unfold vecNorm2
    rw [hSq]
  have hcoord : ∀ i : Fin k,
      matMulVec k (fun a b : Fin k => M (e a) (e b)) x i
        = matMulVec n M xhat (e i) := by
    intro i
    unfold matMulVec
    rw [← Finset.sum_subset
      (Finset.subset_univ ((Finset.univ : Finset (Fin k)).map ⟨e, hinj⟩))
      (fun p _ hp => by rw [hxhat_zero p hp]; ring)]
    rw [Finset.sum_map]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    simp only [Function.Embedding.coeFn_mk]
    rw [hxhat_e j]
  have hnormle :
      vecNorm2 (matMulVec k (fun a b : Fin k => M (e a) (e b)) x)
        ≤ vecNorm2 (matMulVec n M xhat) := by
    unfold vecNorm2
    apply Real.sqrt_le_sqrt
    unfold vecNorm2Sq
    calc (∑ i : Fin k,
            matMulVec k (fun a b : Fin k => M (e a) (e b)) x i ^ 2)
        = ∑ i : Fin k, matMulVec n M xhat (e i) ^ 2 :=
          Finset.sum_congr rfl (fun i _ => by rw [hcoord i])
      _ = ∑ p ∈ (Finset.univ : Finset (Fin k)).map ⟨e, hinj⟩,
            matMulVec n M xhat p ^ 2 := by
          rw [Finset.sum_map]
          rfl
      _ ≤ ∑ p : Fin n, matMulVec n M xhat p ^ 2 :=
          Finset.sum_le_sum_of_subset_of_nonneg
            (Finset.subset_univ _) (fun p _ _ => sq_nonneg _)
  calc vecNorm2 (matMulVec k (fun a b : Fin k => M (e a) (e b)) x)
      ≤ vecNorm2 (matMulVec n M xhat) := hnormle
    _ ≤ c * vecNorm2 xhat := hM xhat
    _ = c * vecNorm2 x := by rw [hxnorm]

/-- **Theorem 9.15 support**: `I + B` is nonsingular whenever `B` has an
operator-2-norm bound below one (no nonzero kernel vector survives the
contraction). -/
theorem higham9_15_det_one_add_ne_zero_of_opNorm2Le_lt_one {k : ℕ}
    (B : Fin k → Fin k → ℝ) {c : ℝ} (hc : c < 1)
    (hB : opNorm2Le B c) :
    ((1 : Matrix (Fin k) (Fin k) ℝ) + Matrix.of B).det ≠ 0 := by
  classical
  intro hdet
  obtain ⟨v, hv0, hv⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr hdet
  rw [Matrix.add_mulVec, Matrix.one_mulVec] at hv
  have hBv : ∀ i : Fin k, matMulVec k B v i = -(v i) := by
    intro i
    have hcoord := congrFun hv i
    simp only [Pi.add_apply, Pi.zero_apply] at hcoord
    have hmv : (Matrix.of B).mulVec v i = matMulVec k B v i := rfl
    rw [hmv] at hcoord
    linarith
  have h1 : vecNorm2 (matMulVec k B v) = vecNorm2 v := by
    unfold vecNorm2
    congr 1
    unfold vecNorm2Sq
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [hBv i]
    ring
  have h2 := hB v
  rw [h1] at h2
  have hvpos : 0 < vecNorm2 v := by
    rcases (vecNorm2_nonneg v).lt_or_eq with h | h
    · exact h
    · exact absurd (funext ((vecNorm2_eq_zero_iff v).mp h.symm)) hv0
  nlinarith

/-- **Theorem 9.15 / Equation (9.27): perturbed leading minors are
nonsingular.**  If `A = L·U` with unit-lower `L`, upper `U`, nonzero pivots,
and the normalized perturbation `G = L⁻¹·ΔA·U⁻¹` has an operator-2-norm
bound below one, then every leading principal minor of `A + ΔA` is nonzero —
so the perturbed matrix retains an LU factorization.  This is the existence
leg of the Barrlund homotopy for (9.27): applied to `t·ΔA` for `t ∈ [0, 1]`
(the hypothesis is monotone in `t`), the entire path `A + t·ΔA` keeps
nonsingular leading minors. -/
theorem higham9_15_perturbed_leading_minor_ne_zero {n : ℕ}
    (A L U ΔA Linv Uinv : Matrix (Fin n) (Fin n) ℝ)
    (hLU : L * U = A)
    (hL_diag : ∀ i : Fin n, L i i = 1)
    (hL : ∀ i j : Fin n, i.val < j.val → L i j = 0)
    (hU : ∀ i j : Fin n, j.val < i.val → U i j = 0)
    (hLinv : Linv * L = 1)
    (hUinv : U * Uinv = 1)
    (hpivnz : ∀ i : Fin n, U i i ≠ 0)
    {c : ℝ} (hc : c < 1)
    (hG : opNorm2Le (fun i j : Fin n => (Linv * ΔA * Uinv) i j) c)
    {k : ℕ} (hk : k ≤ n) :
    ((A + ΔA).submatrix (Fin.castLE hk) (Fin.castLE hk)).det ≠ 0 := by
  classical
  rw [higham9_15_perturbed_leading_minor_eq A L U ΔA Linv Uinv hLU
    hL_diag hL hU hLinv hUinv hk]
  apply mul_ne_zero
  · have hsub1 : ((1 + Linv * ΔA * Uinv).submatrix
        (Fin.castLE hk) (Fin.castLE hk))
        = 1 + Matrix.of (fun i j : Fin k =>
            (Linv * ΔA * Uinv) (Fin.castLE hk i) (Fin.castLE hk j)) := by
      ext i j
      simp only [Matrix.submatrix_apply, Matrix.add_apply, Matrix.one_apply,
        Matrix.of_apply, (Fin.castLE_injective hk).eq_iff]
    rw [hsub1]
    exact higham9_15_det_one_add_ne_zero_of_opNorm2Le_lt_one _ hc
      (higham9_15_opNorm2Le_leadingSubmatrix
        (fun i j : Fin n => (Linv * ΔA * Uinv) i j) hG hk)
  · exact Finset.prod_ne_zero_iff.mpr (fun i _ => hpivnz _)

/-- **Theorem 9.15 support (scalar)**: points satisfying the quadratic
self-majorant `s ≤ g + s²` avoid the open band between the two roots of
`x² - x + g`. -/
theorem higham9_15_selfMajorant_band_avoidance {g s : ℝ}
    (hglt : g < 1 / 4)
    (hs : s ≤ g + s ^ 2) :
    s ≤ (1 - Real.sqrt (1 - 4 * g)) / 2
      ∨ (1 + Real.sqrt (1 - 4 * g)) / 2 ≤ s := by
  set d : ℝ := Real.sqrt (1 - 4 * g) with hd
  have hd_sq : d ^ 2 = 1 - 4 * g := by
    rw [hd, Real.sq_sqrt (by linarith)]
  have hd_pos : 0 < d := by
    rw [hd]
    exact Real.sqrt_pos.mpr (by linarith)
  by_contra hcon
  push_neg at hcon
  obtain ⟨h1, h2⟩ := hcon
  -- (1 - d)/2 < s < (1 + d)/2 means (s - (1-d)/2)((1+d)/2 - s) > 0,
  -- i.e. s² - s + g < 0, contradicting s ≤ g + s².
  nlinarith [mul_pos (by linarith : 0 < s - (1 - d) / 2)
    (by linarith : 0 < (1 + d) / 2 - s)]

/-- **Theorem 9.15 support (scalar homotopy)**: a continuous self-majorized
path starting at zero stays on the small branch.  If `s : [0,1] → ℝ` is
continuous on `[0,1]`, `s 0 = 0`, and every point satisfies the quadratic
self-majorant `s t ≤ g + (s t)²` with `0 ≤ g < 1/4`, then the endpoint obeys
`s 1 ≤ (1 - √(1-4g))/2` — the small root of `x² - x + g`.

This is the connectedness/branch-selection leg of the rigorous Barrlund-type
perturbation bound for (9.27): along the homotopy `A + t·ΔA`, the combined
normalized factor-perturbation size satisfies the quadratic self-majorant,
is continuous, and starts at zero, so it can never jump across the forbidden
band to the large branch. -/
theorem higham9_15_selfMajorant_path_small_branch {g : ℝ}
    (hg0 : 0 ≤ g) (hglt : g < 1 / 4)
    (s : ℝ → ℝ)
    (hcont : ContinuousOn s (Set.Icc 0 1))
    (h0 : s 0 = 0)
    (hmaj : ∀ t ∈ Set.Icc (0 : ℝ) 1, s t ≤ g + s t ^ 2) :
    s 1 ≤ (1 - Real.sqrt (1 - 4 * g)) / 2 := by
  set d : ℝ := Real.sqrt (1 - 4 * g) with hd
  have hd_pos : 0 < d := by
    rw [hd]
    exact Real.sqrt_pos.mpr (by linarith)
  have hd_le_one : d ≤ 1 := by
    rw [hd]
    calc Real.sqrt (1 - 4 * g) ≤ Real.sqrt 1 :=
          Real.sqrt_le_sqrt (by linarith)
      _ = 1 := Real.sqrt_one
  by_contra hcon
  push_neg at hcon
  -- s 1 is above the small root; band avoidance forces it onto the large
  -- branch, so by the intermediate value theorem some point of the path sits
  -- inside the forbidden band — contradiction.
  have h1mem : (1 : ℝ) ∈ Set.Icc (0 : ℝ) 1 := by
    constructor <;> norm_num
  have h0mem : (0 : ℝ) ∈ Set.Icc (0 : ℝ) 1 := by
    constructor <;> norm_num
  have hbig : (1 + d) / 2 ≤ s 1 := by
    rcases higham9_15_selfMajorant_band_avoidance hglt (hmaj 1 h1mem) with h | h
    · exact absurd h (not_le.mpr hcon)
    · exact h
  -- the midpoint value 1/2 lies strictly inside the forbidden band
  have hmid_lo : (1 - d) / 2 < 1 / 2 := by linarith
  have hmid_hi : (1 / 2 : ℝ) < (1 + d) / 2 := by linarith
  have hs0_lt : s 0 < 1 / 2 := by
    rw [h0]; norm_num
  have hs1_ge : (1 / 2 : ℝ) ≤ s 1 := le_trans (le_of_lt hmid_hi) hbig
  -- IVT on [0,1]
  obtain ⟨t, htmem, hst⟩ :=
    intermediate_value_Icc (by norm_num : (0 : ℝ) ≤ 1) hcont
      (Set.mem_Icc.mpr ⟨le_of_lt hs0_lt, hs1_ge⟩ : (1 / 2 : ℝ) ∈ Set.Icc (s 0) (s 1))
  have hband := higham9_15_selfMajorant_band_avoidance hglt (hmaj t htmem)
  rcases hband with h | h
  · rw [hst] at h
    linarith
  · rw [hst] at h
    linarith

/-- **Theorem 9.1 / Theorem 9.15 support**: any exact LU certificate over a
matrix whose leading principal minors are all nonzero has nonzero pivots
(the product of the first `k` pivots is the `k`-th leading minor). -/
theorem higham9_1_LUFactSpec_pivots_ne_zero_of_leading_minors_ne_zero {n : ℕ}
    {A L U : Fin n → Fin n → ℝ} (hLU : LUFactSpec n A L U)
    (hminors : ∀ (k : ℕ) (hk : k ≤ n),
      Matrix.det ((Matrix.of A : Matrix (Fin n) (Fin n) ℝ).submatrix
        (Fin.castLE hk) (Fin.castLE hk)) ≠ 0)
    (i : Fin n) : U i i ≠ 0 := by
  have hk : i.val + 1 ≤ n := i.isLt
  have hdet := higham9_14_LUFactSpec_leadingSubmatrix_det_eq_prod_U_diag hLU hk
  have hne := hminors (i.val + 1) hk
  rw [hdet] at hne
  have hfac := Finset.prod_ne_zero_iff.mp hne
    (⟨i.val, by omega⟩ : Fin (i.val + 1)) (Finset.mem_univ _)
  have hcast : Fin.castLE hk (⟨i.val, by omega⟩ : Fin (i.val + 1)) = i := by
    apply Fin.ext
    simp
  rw [hcast] at hfac
  exact hfac

/-- **Theorem 9.15 / Equation (9.27)**: any exact LU certificate of the
perturbed matrix `A + ΔA` has nonzero pivots, under the Barrlund smallness
hypothesis on `G = L⁻¹·ΔA·U⁻¹`.  This composes the perturbed-leading-minor
nonsingularity with the pivot/minor product identity, and supplies the
pivot-nonzeroness hypothesis needed by uniqueness
(`higham9_1_lu_unique_of_pivots_ne_zero`) for the factorization path
`A + t·ΔA` of the Barrlund homotopy. -/
theorem higham9_15_perturbed_LUFactSpec_pivots_ne_zero {n : ℕ}
    (A L U ΔA Linv Uinv : Matrix (Fin n) (Fin n) ℝ)
    (hLU : L * U = A)
    (hL_diag : ∀ i : Fin n, L i i = 1)
    (hL : ∀ i j : Fin n, i.val < j.val → L i j = 0)
    (hU : ∀ i j : Fin n, j.val < i.val → U i j = 0)
    (hLinv : Linv * L = 1)
    (hUinv : U * Uinv = 1)
    (hpivnz : ∀ i : Fin n, U i i ≠ 0)
    {c : ℝ} (hc : c < 1)
    (hG : opNorm2Le (fun i j : Fin n => (Linv * ΔA * Uinv) i j) c)
    {L' U' : Fin n → Fin n → ℝ}
    (hLU' : LUFactSpec n (fun i j => A i j + ΔA i j) L' U')
    (i : Fin n) : U' i i ≠ 0 := by
  refine higham9_1_LUFactSpec_pivots_ne_zero_of_leading_minors_ne_zero
    hLU' (fun k hk => ?_) i
  have h := higham9_15_perturbed_leading_minor_ne_zero A L U ΔA Linv Uinv
    hLU hL_diag hL hU hLinv hUinv hpivnz hc hG hk
  exact h

/-- **Theorem 9.15 / Equation (9.27): the perturbed matrix retains an LU
factorization.**  Under Barrlund's smallness hypothesis on
`G = L⁻¹·ΔA·U⁻¹`, the matrix `A + ΔA` has an exact unit-lower/upper LU
certificate.  Applied to `t·ΔA` for `t ∈ [0,1]` (the hypothesis is monotone
in `t`), the whole Barrlund homotopy path `A + t·ΔA` carries LU
factorizations — with nonzero pivots by
`higham9_15_perturbed_LUFactSpec_pivots_ne_zero`, hence unique by
`higham9_1_lu_unique_of_pivots_ne_zero`. -/
theorem higham9_15_perturbed_lu_exists {n : ℕ}
    (A L U ΔA Linv Uinv : Matrix (Fin n) (Fin n) ℝ)
    (hLU : L * U = A)
    (hL_diag : ∀ i : Fin n, L i i = 1)
    (hL : ∀ i j : Fin n, i.val < j.val → L i j = 0)
    (hU : ∀ i j : Fin n, j.val < i.val → U i j = 0)
    (hLinv : Linv * L = 1)
    (hUinv : U * Uinv = 1)
    (hpivnz : ∀ i : Fin n, U i i ≠ 0)
    {c : ℝ} (hc : c < 1)
    (hG : opNorm2Le (fun i j : Fin n => (Linv * ΔA * Uinv) i j) c) :
    ∃ L' U' : Fin n → Fin n → ℝ,
      LUFactSpec n (fun i j => A i j + ΔA i j) L' U' :=
  higham9_1_lu_exists_of_leading_minors_ne_zero
    (fun i j => A i j + ΔA i j)
    (fun _ hk => higham9_15_perturbed_leading_minor_ne_zero A L U ΔA Linv Uinv
      hLU hL_diag hL hU hLinv hUinv hpivnz hc hG hk)

/-- **Theorem 9.15 support**: each leading principal minor is continuous
along the perturbation path `t ↦ A + t·ΔA`. -/
theorem higham9_15_leading_minor_path_continuous {n : ℕ}
    (A ΔA : Matrix (Fin n) (Fin n) ℝ) {k : ℕ} (hk : k ≤ n) :
    Continuous (fun t : ℝ =>
      ((A + t • ΔA).submatrix (Fin.castLE hk) (Fin.castLE hk)).det) := by
  apply Continuous.matrix_det
  apply continuous_matrix
  intro i j
  simp only [Matrix.submatrix_apply, Matrix.add_apply, Matrix.smul_apply,
    smul_eq_mul]
  fun_prop

/-- **Theorem 9.15 support**: the ratio of consecutive leading minors (the
`(k+1)`-st pivot of any exact LU certificate) is continuous on any parameter
set where the `k`-th leading minor does not vanish — e.g. on `[0, 1]` under
Barrlund's smallness hypothesis, by
`higham9_15_perturbed_leading_minor_ne_zero`. -/
theorem higham9_15_pivot_ratio_path_continuousOn {n : ℕ}
    (A ΔA : Matrix (Fin n) (Fin n) ℝ) {k : ℕ} (hk1 : k + 1 ≤ n) (hk : k ≤ n)
    {s : Set ℝ}
    (hden : ∀ t ∈ s,
      ((A + t • ΔA).submatrix (Fin.castLE hk) (Fin.castLE hk)).det ≠ 0) :
    ContinuousOn (fun t : ℝ =>
      ((A + t • ΔA).submatrix (Fin.castLE hk1) (Fin.castLE hk1)).det /
        ((A + t • ΔA).submatrix (Fin.castLE hk) (Fin.castLE hk)).det) s :=
  ((higham9_15_leading_minor_path_continuous A ΔA hk1).continuousOn).div
    ((higham9_15_leading_minor_path_continuous A ΔA hk).continuousOn) hden

/-- **Theorem 9.1 / Theorem 9.15 support**: in any exact LU certificate,
each pivot is the ratio of consecutive leading principal minors (when the
smaller one is nonzero).  Together with
`higham9_15_pivot_ratio_path_continuousOn` and uniqueness, the pivots of the
factorization path `A + t·ΔA` are continuous functions of `t`. -/
theorem higham9_1_pivot_eq_leading_minor_ratio {n : ℕ}
    {A L U : Fin n → Fin n → ℝ} (hLU : LUFactSpec n A L U)
    {k : ℕ} (hk1 : k + 1 ≤ n)
    (hden : Matrix.det
        ((Matrix.of A : Matrix (Fin n) (Fin n) ℝ).submatrix
          (Fin.castLE (Nat.le_of_succ_le hk1))
          (Fin.castLE (Nat.le_of_succ_le hk1))) ≠ 0) :
    U (Fin.castLE hk1 (Fin.last k)) (Fin.castLE hk1 (Fin.last k))
      = Matrix.det ((Matrix.of A : Matrix (Fin n) (Fin n) ℝ).submatrix
          (Fin.castLE hk1) (Fin.castLE hk1)) /
        Matrix.det ((Matrix.of A : Matrix (Fin n) (Fin n) ℝ).submatrix
          (Fin.castLE (Nat.le_of_succ_le hk1))
          (Fin.castLE (Nat.le_of_succ_le hk1))) := by
  rw [higham9_14_leadingSubmatrix_det_succ hLU hk1]
  rw [mul_div_assoc, div_self hden, mul_one]

/-- **Theorem 9.15 support**: the leading-rows block of a product `L * X`
with lower-triangular left factor factors through the leading block of `L`,
for an arbitrary column selection `g`. -/
theorem higham9_15_leadingRows_mul_of_lower_left {n : ℕ}
    (L X : Matrix (Fin n) (Fin n) ℝ)
    (hL : ∀ i j : Fin n, i.val < j.val → L i j = 0)
    {k : ℕ} (hk : k ≤ n) (g : Fin k → Fin n) :
    (L * X).submatrix (Fin.castLE hk) g
      = L.submatrix (Fin.castLE hk) (Fin.castLE hk)
        * X.submatrix (Fin.castLE hk) g := by
  classical
  set e : Fin k → Fin n := Fin.castLE hk with he
  have hinj : Function.Injective e := Fin.castLE_injective hk
  ext i j
  simp only [Matrix.submatrix_apply, Matrix.mul_apply]
  rw [show (∑ m : Fin k, L (e i) (e m) * X (e m) (g j))
        = ∑ p ∈ Finset.univ.map ⟨e, hinj⟩, L (e i) p * X p (g j) from
      (Finset.sum_map Finset.univ ⟨e, hinj⟩
        (fun p => L (e i) p * X p (g j))).symm]
  refine (Finset.sum_subset (Finset.subset_univ _) ?_).symm
  intro p _ hp
  have hpk : k ≤ p.val := by
    by_contra hlt
    push_neg at hlt
    exact hp (Finset.mem_map.mpr
      ⟨⟨p.val, hlt⟩, Finset.mem_univ _, by
        apply Fin.ext; simp [he]⟩)
  have hlt : (e i).val < p.val := by
    have h1 : (e i).val = i.val := by simp [he]
    have h2 : i.val < k := i.isLt
    omega
  rw [hL (e i) p hlt, zero_mul]

/-- The bordered column selector: the first `k` columns are the leading ones
and the last column is `j`. -/
def higham9_15_borderedCols {n : ℕ} {k : ℕ} (hk1 : k + 1 ≤ n)
    (j : Fin n) : Fin (k + 1) → Fin n :=
  fun c => if h : c.val < k then ⟨c.val, by omega⟩ else j

@[simp] lemma higham9_15_borderedCols_last {n : ℕ} {k : ℕ}
    (hk1 : k + 1 ≤ n) (j : Fin n) :
    higham9_15_borderedCols hk1 j (Fin.last k) = j := by
  simp [higham9_15_borderedCols]

lemma higham9_15_borderedCols_castSucc {n : ℕ} {k : ℕ}
    (hk1 : k + 1 ≤ n) (j : Fin n) (c : Fin k) :
    higham9_15_borderedCols hk1 j c.castSucc
      = ⟨c.val, by have := c.isLt; omega⟩ := by
  simp [higham9_15_borderedCols, c.isLt]

/-- **Theorem 9.15 support**: determinant of the bordered `U`-block.  Taking
the first `k + 1` rows of upper-triangular `U` with the first `k` columns and
an arbitrary bordering column `j` gives determinant
`(∏_{i<k} U i i) · U k j`. -/
theorem higham9_15_borderedU_det {n : ℕ}
    (U : Matrix (Fin n) (Fin n) ℝ)
    (hU : ∀ i j : Fin n, j.val < i.val → U i j = 0)
    {k : ℕ} (hk1 : k + 1 ≤ n) (j : Fin n) :
    (U.submatrix (Fin.castLE hk1) (higham9_15_borderedCols hk1 j)).det
      = (∏ i : Fin k, U (Fin.castLE (Nat.le_of_succ_le hk1) i)
          (Fin.castLE (Nat.le_of_succ_le hk1) i))
        * U ⟨k, hk1⟩ j := by
  classical
  have htri : Matrix.BlockTriangular
      (U.submatrix (Fin.castLE hk1) (higham9_15_borderedCols hk1 j)) id := by
    intro a b hab
    have hab' : b.val < a.val := by simpa using hab
    have hbk : b.val < k := by have := a.isLt; omega
    simp only [Matrix.submatrix_apply]
    have hcol : higham9_15_borderedCols hk1 j b = ⟨b.val, by omega⟩ := by
      simp [higham9_15_borderedCols, hbk]
    rw [hcol]
    exact hU _ _ (by simpa using hab')
  rw [Matrix.det_of_upperTriangular htri]
  rw [Fin.prod_univ_castSucc (f := fun c : Fin (k + 1) =>
    (U.submatrix (Fin.castLE hk1) (higham9_15_borderedCols hk1 j)) c c)]
  congr 1
  · refine Finset.prod_congr rfl (fun c _ => ?_)
    simp only [Matrix.submatrix_apply]
    rw [higham9_15_borderedCols_castSucc]
    rfl
  · simp only [Matrix.submatrix_apply, higham9_15_borderedCols_last]
    rfl

/-- **Theorem 9.15 support: bordered-minor identity for the `U` entries.**
For an exact LU certificate, the bordered minor of `A` (first `k + 1` rows,
first `k` columns plus column `j`) equals the product of the first `k`
pivots times `U k j`.  With the pivot product nonzero this expresses every
entry of row `k` of `U` as a ratio of minors of `A` — the Cramer-style
formula that makes the factor entries continuous along the Barrlund
homotopy path. -/
theorem higham9_15_borderedMinor_eq_pivots_mul_U {n : ℕ}
    {A L U : Fin n → Fin n → ℝ} (hLU : LUFactSpec n A L U)
    {k : ℕ} (hk1 : k + 1 ≤ n) (j : Fin n) :
    ((Matrix.of A : Matrix (Fin n) (Fin n) ℝ).submatrix
        (Fin.castLE hk1) (higham9_15_borderedCols hk1 j)).det
      = (∏ i : Fin k, U (Fin.castLE (Nat.le_of_succ_le hk1) i)
          (Fin.castLE (Nat.le_of_succ_le hk1) i))
        * U ⟨k, hk1⟩ j := by
  classical
  have hfact : (Matrix.of A : Matrix (Fin n) (Fin n) ℝ)
      = (Matrix.of L : Matrix (Fin n) (Fin n) ℝ)
        * (Matrix.of U : Matrix (Fin n) (Fin n) ℝ) := by
    ext a b
    simpa [Matrix.mul_apply] using (hLU.product_eq a b).symm
  rw [hfact, higham9_15_leadingRows_mul_of_lower_left
    (Matrix.of L) (Matrix.of U)
    (fun a b hab => hLU.L_upper_zero a b hab) hk1
    (higham9_15_borderedCols hk1 j), Matrix.det_mul]
  have hLdet : ((Matrix.of L : Matrix (Fin n) (Fin n) ℝ).submatrix
      (Fin.castLE hk1) (Fin.castLE hk1)).det = 1 := by
    have hLtri : Matrix.BlockTriangular
        ((Matrix.of L : Matrix (Fin n) (Fin n) ℝ).submatrix
          (Fin.castLE hk1) (Fin.castLE hk1)) OrderDual.toDual := by
      intro a b hab
      have hab' : a.val < b.val := by simpa using hab
      simp only [Matrix.submatrix_apply, Matrix.of_apply]
      exact hLU.L_upper_zero _ _ (by simpa using hab')
    rw [Matrix.det_of_lowerTriangular _ hLtri]
    refine Finset.prod_eq_one (fun c _ => ?_)
    simp only [Matrix.submatrix_apply, Matrix.of_apply]
    exact hLU.L_diag _
  rw [hLdet, one_mul]
  exact higham9_15_borderedU_det (Matrix.of U)
    (fun a b hab => hLU.U_lower_zero a b hab) hk1 j

/-- **Theorem 9.15 support**: the leading-columns block of a product `X * U`
with upper-triangular right factor factors through the leading block of `U`,
for an arbitrary row selection `g`. -/
theorem higham9_15_leadingCols_mul_of_upper_right {n : ℕ}
    (X U : Matrix (Fin n) (Fin n) ℝ)
    (hU : ∀ i j : Fin n, j.val < i.val → U i j = 0)
    {k : ℕ} (hk : k ≤ n) (g : Fin k → Fin n) :
    (X * U).submatrix g (Fin.castLE hk)
      = X.submatrix g (Fin.castLE hk)
        * U.submatrix (Fin.castLE hk) (Fin.castLE hk) := by
  classical
  set e : Fin k → Fin n := Fin.castLE hk with he
  have hinj : Function.Injective e := Fin.castLE_injective hk
  ext i j
  simp only [Matrix.submatrix_apply, Matrix.mul_apply]
  rw [show (∑ m : Fin k, X (g i) (e m) * U (e m) (e j))
        = ∑ p ∈ Finset.univ.map ⟨e, hinj⟩, X (g i) p * U p (e j) from
      (Finset.sum_map Finset.univ ⟨e, hinj⟩
        (fun p => X (g i) p * U p (e j))).symm]
  refine (Finset.sum_subset (Finset.subset_univ _) ?_).symm
  intro p _ hp
  have hpk : k ≤ p.val := by
    by_contra hlt
    push_neg at hlt
    exact hp (Finset.mem_map.mpr
      ⟨⟨p.val, hlt⟩, Finset.mem_univ _, by
        apply Fin.ext; simp [he]⟩)
  have hlt : (e j).val < p.val := by
    have h1 : (e j).val = j.val := by simp [he]
    have h2 : j.val < k := j.isLt
    omega
  rw [hU p (e j) hlt, mul_zero]

/-- The bordered row selector: the first `k` rows are the leading ones and
the last row is `i`. -/
def higham9_15_borderedRows {n : ℕ} {k : ℕ} (hk1 : k + 1 ≤ n)
    (i : Fin n) : Fin (k + 1) → Fin n :=
  fun r => if h : r.val < k then ⟨r.val, by omega⟩ else i

@[simp] lemma higham9_15_borderedRows_last {n : ℕ} {k : ℕ}
    (hk1 : k + 1 ≤ n) (i : Fin n) :
    higham9_15_borderedRows hk1 i (Fin.last k) = i := by
  simp [higham9_15_borderedRows]

lemma higham9_15_borderedRows_castSucc {n : ℕ} {k : ℕ}
    (hk1 : k + 1 ≤ n) (i : Fin n) (r : Fin k) :
    higham9_15_borderedRows hk1 i r.castSucc
      = ⟨r.val, by have := r.isLt; omega⟩ := by
  simp [higham9_15_borderedRows, r.isLt]

/-- **Theorem 9.15 support**: determinant of the bordered `L`-block.  Taking
the first `k + 1` columns of unit-lower-triangular `L` with the first `k`
rows and an arbitrary bordering row `i` gives determinant `L i k`. -/
theorem higham9_15_borderedL_det {n : ℕ}
    (L : Matrix (Fin n) (Fin n) ℝ)
    (hL_diag : ∀ i : Fin n, L i i = 1)
    (hL : ∀ i j : Fin n, i.val < j.val → L i j = 0)
    {k : ℕ} (hk1 : k + 1 ≤ n) (i : Fin n) :
    (L.submatrix (higham9_15_borderedRows hk1 i) (Fin.castLE hk1)).det
      = L i ⟨k, hk1⟩ := by
  classical
  have htri : Matrix.BlockTriangular
      (L.submatrix (higham9_15_borderedRows hk1 i) (Fin.castLE hk1))
      OrderDual.toDual := by
    intro a b hab
    have hab' : a.val < b.val := by simpa using hab
    have hak : a.val < k := by have := b.isLt; omega
    simp only [Matrix.submatrix_apply]
    have hrow : higham9_15_borderedRows hk1 i a = ⟨a.val, by omega⟩ := by
      simp [higham9_15_borderedRows, hak]
    rw [hrow]
    exact hL _ _ (by simpa using hab')
  rw [Matrix.det_of_lowerTriangular _ htri]
  rw [Fin.prod_univ_castSucc (f := fun r : Fin (k + 1) =>
    (L.submatrix (higham9_15_borderedRows hk1 i) (Fin.castLE hk1)) r r)]
  have hlead : (∏ r : Fin k,
      (L.submatrix (higham9_15_borderedRows hk1 i) (Fin.castLE hk1))
        r.castSucc r.castSucc) = 1 := by
    refine Finset.prod_eq_one (fun r _ => ?_)
    simp only [Matrix.submatrix_apply]
    rw [higham9_15_borderedRows_castSucc]
    exact hL_diag _
  rw [hlead, one_mul]
  simp only [Matrix.submatrix_apply, higham9_15_borderedRows_last]
  rfl

/-- **Theorem 9.15 support: bordered-minor identity for the `L` entries.**
For an exact LU certificate, the bordered minor of `A` (first `k` rows plus
row `i`, first `k + 1` columns) equals `L i k` times the product of the
first `k + 1` pivots.  With the pivot product nonzero this expresses every
entry of column `k` of `L` as a ratio of minors of `A` — the symmetric
Cramer-style formula for the lower factor along the Barrlund homotopy
path. -/
theorem higham9_15_borderedMinor_eq_L_mul_pivots {n : ℕ}
    {A L U : Fin n → Fin n → ℝ} (hLU : LUFactSpec n A L U)
    {k : ℕ} (hk1 : k + 1 ≤ n) (i : Fin n) :
    ((Matrix.of A : Matrix (Fin n) (Fin n) ℝ).submatrix
        (higham9_15_borderedRows hk1 i) (Fin.castLE hk1)).det
      = L i ⟨k, hk1⟩
        * ∏ c : Fin (k + 1), U (Fin.castLE hk1 c) (Fin.castLE hk1 c) := by
  classical
  have hfact : (Matrix.of A : Matrix (Fin n) (Fin n) ℝ)
      = (Matrix.of L : Matrix (Fin n) (Fin n) ℝ)
        * (Matrix.of U : Matrix (Fin n) (Fin n) ℝ) := by
    ext a b
    simpa [Matrix.mul_apply] using (hLU.product_eq a b).symm
  rw [hfact, higham9_15_leadingCols_mul_of_upper_right
    (Matrix.of L) (Matrix.of U)
    (fun a b hab => hLU.U_lower_zero a b hab) hk1
    (higham9_15_borderedRows hk1 i), Matrix.det_mul]
  have hUdet : ((Matrix.of U : Matrix (Fin n) (Fin n) ℝ).submatrix
      (Fin.castLE hk1) (Fin.castLE hk1)).det
      = ∏ c : Fin (k + 1), U (Fin.castLE hk1 c) (Fin.castLE hk1 c) := by
    have hUtri : Matrix.BlockTriangular
        ((Matrix.of U : Matrix (Fin n) (Fin n) ℝ).submatrix
          (Fin.castLE hk1) (Fin.castLE hk1)) id := by
      intro a b hab
      have hab' : b.val < a.val := by simpa using hab
      simp only [Matrix.submatrix_apply, Matrix.of_apply]
      exact hLU.U_lower_zero _ _ (by simpa using hab')
    rw [Matrix.det_of_upperTriangular hUtri]
    exact Finset.prod_congr rfl (fun c _ => by
      simp only [Matrix.submatrix_apply, Matrix.of_apply])
  rw [hUdet, higham9_15_borderedL_det (Matrix.of L)
    (fun a => hLU.L_diag a) (fun a b hab => hLU.L_upper_zero a b hab) hk1 i]
  rfl

/-- **Theorem 9.15 support**: any minor (arbitrary row/column selections) is
continuous along the perturbation path `t ↦ A + t·ΔA`.  Specializes to the
bordered minors of the `L`/`U` entry formulas and to the leading minors. -/
theorem higham9_15_minor_path_continuous {n : ℕ}
    (A ΔA : Matrix (Fin n) (Fin n) ℝ) {k : ℕ}
    (f g : Fin k → Fin n) :
    Continuous (fun t : ℝ => ((A + t • ΔA).submatrix f g).det) := by
  apply Continuous.matrix_det
  apply continuous_matrix
  intro i j
  simp only [Matrix.submatrix_apply, Matrix.add_apply, Matrix.smul_apply,
    smul_eq_mul]
  fun_prop

/-- **Theorem 9.15 support**: the `U`-entry path map — the bordered minor
divided by the pivot product (equivalently, by the leading minor) — is
continuous on any parameter set where the leading minor does not vanish.
By `higham9_15_borderedMinor_eq_pivots_mul_U` and
`higham9_14_LUFactSpec_leadingSubmatrix_det_eq_prod_U_diag`, this map equals
`t ↦ U(t) k j` for the unique factorization path `A + t·ΔA`. -/
theorem higham9_15_U_entry_path_continuousOn {n : ℕ}
    (A ΔA : Matrix (Fin n) (Fin n) ℝ) {k : ℕ} (hk1 : k + 1 ≤ n)
    (j : Fin n) {s : Set ℝ}
    (hden : ∀ t ∈ s,
      ((A + t • ΔA).submatrix (Fin.castLE (Nat.le_of_succ_le hk1))
        (Fin.castLE (Nat.le_of_succ_le hk1))).det ≠ 0) :
    ContinuousOn (fun t : ℝ =>
      ((A + t • ΔA).submatrix (Fin.castLE hk1)
          (higham9_15_borderedCols hk1 j)).det /
        ((A + t • ΔA).submatrix (Fin.castLE (Nat.le_of_succ_le hk1))
          (Fin.castLE (Nat.le_of_succ_le hk1))).det) s :=
  ((higham9_15_minor_path_continuous A ΔA _ _).continuousOn).div
    ((higham9_15_minor_path_continuous A ΔA _ _).continuousOn) hden

/-- **Theorem 9.15 support**: the `L`-entry path map — the bordered-rows
minor divided by the `(k+1)`-st leading minor — is continuous on any
parameter set where that leading minor does not vanish.  By
`higham9_15_borderedMinor_eq_L_mul_pivots` and the leading-minor identity,
this map equals `t ↦ L(t) i k` for the unique factorization path. -/
theorem higham9_15_L_entry_path_continuousOn {n : ℕ}
    (A ΔA : Matrix (Fin n) (Fin n) ℝ) {k : ℕ} (hk1 : k + 1 ≤ n)
    (i : Fin n) {s : Set ℝ}
    (hden : ∀ t ∈ s,
      ((A + t • ΔA).submatrix (Fin.castLE hk1)
        (Fin.castLE hk1)).det ≠ 0) :
    ContinuousOn (fun t : ℝ =>
      ((A + t • ΔA).submatrix (higham9_15_borderedRows hk1 i)
          (Fin.castLE hk1)).det /
        ((A + t • ΔA).submatrix (Fin.castLE hk1)
          (Fin.castLE hk1)).det) s :=
  ((higham9_15_minor_path_continuous A ΔA _ _).continuousOn).div
    ((higham9_15_minor_path_continuous A ΔA _ _).continuousOn) hden

/-- **Theorem 9.15 support: the `U`-entry minor-ratio formula.**  In any
exact LU certificate over a matrix whose `k`-th leading minor is nonzero,
`U k j` equals the bordered minor divided by the leading minor. -/
theorem higham9_15_U_entry_eq_minor_ratio {n : ℕ}
    {A L U : Fin n → Fin n → ℝ} (hLU : LUFactSpec n A L U)
    {k : ℕ} (hk1 : k + 1 ≤ n) (j : Fin n)
    (hden : Matrix.det
        ((Matrix.of A : Matrix (Fin n) (Fin n) ℝ).submatrix
          (Fin.castLE (Nat.le_of_succ_le hk1))
          (Fin.castLE (Nat.le_of_succ_le hk1))) ≠ 0) :
    U ⟨k, hk1⟩ j
      = ((Matrix.of A : Matrix (Fin n) (Fin n) ℝ).submatrix
          (Fin.castLE hk1) (higham9_15_borderedCols hk1 j)).det /
        ((Matrix.of A : Matrix (Fin n) (Fin n) ℝ).submatrix
          (Fin.castLE (Nat.le_of_succ_le hk1))
          (Fin.castLE (Nat.le_of_succ_le hk1))).det := by
  rw [higham9_15_borderedMinor_eq_pivots_mul_U hLU hk1 j,
    higham9_14_LUFactSpec_leadingSubmatrix_det_eq_prod_U_diag hLU
      (Nat.le_of_succ_le hk1)]
  have hprod : (∏ i : Fin k,
      U (Fin.castLE (Nat.le_of_succ_le hk1) i)
        (Fin.castLE (Nat.le_of_succ_le hk1) i)) ≠ 0 := by
    rw [← higham9_14_LUFactSpec_leadingSubmatrix_det_eq_prod_U_diag hLU
      (Nat.le_of_succ_le hk1)]
    exact hden
  rw [mul_comm, mul_div_assoc, div_self hprod, mul_one]

/-- **Theorem 9.15 support: the `L`-entry minor-ratio formula.**  In any
exact LU certificate over a matrix whose `(k+1)`-st leading minor is
nonzero, `L i k` equals the bordered-rows minor divided by that leading
minor. -/
theorem higham9_15_L_entry_eq_minor_ratio {n : ℕ}
    {A L U : Fin n → Fin n → ℝ} (hLU : LUFactSpec n A L U)
    {k : ℕ} (hk1 : k + 1 ≤ n) (i : Fin n)
    (hden : Matrix.det
        ((Matrix.of A : Matrix (Fin n) (Fin n) ℝ).submatrix
          (Fin.castLE hk1) (Fin.castLE hk1)) ≠ 0) :
    L i ⟨k, hk1⟩
      = ((Matrix.of A : Matrix (Fin n) (Fin n) ℝ).submatrix
          (higham9_15_borderedRows hk1 i) (Fin.castLE hk1)).det /
        ((Matrix.of A : Matrix (Fin n) (Fin n) ℝ).submatrix
          (Fin.castLE hk1) (Fin.castLE hk1)).det := by
  rw [higham9_15_borderedMinor_eq_L_mul_pivots hLU hk1 i,
    higham9_14_LUFactSpec_leadingSubmatrix_det_eq_prod_U_diag hLU hk1]
  have hprod : (∏ c : Fin (k + 1),
      U (Fin.castLE hk1 c) (Fin.castLE hk1 c)) ≠ 0 := by
    rw [← higham9_14_LUFactSpec_leadingSubmatrix_det_eq_prod_U_diag hLU hk1]
    exact hden
  rw [mul_div_assoc, div_self hprod, mul_one]

/-- **Theorem 9.15 support**: an `opNorm2Le` certificate is stable under
scalar scaling by `t` with `|t| ≤ 1`. -/
theorem higham9_15_opNorm2Le_smul_of_abs_le_one {n : ℕ}
    {M : Fin n → Fin n → ℝ} {c : ℝ} (hM : opNorm2Le M c)
    {t : ℝ} (ht : |t| ≤ 1) :
    opNorm2Le (fun i j => t * M i j) c := by
  intro x
  have hMx := hM x
  have hscale : matMulVec n (fun i j => t * M i j) x
      = fun i => t * matMulVec n M x i := by
    funext i
    unfold matMulVec
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl (fun j _ => by ring)
  rw [hscale]
  have habs : vecNorm2 (fun i => t * matMulVec n M x i)
      = |t| * vecNorm2 (matMulVec n M x) := by
    unfold vecNorm2 vecNorm2Sq
    rw [show (∑ i : Fin n, (t * matMulVec n M x i) ^ 2)
          = t ^ 2 * ∑ i : Fin n, matMulVec n M x i ^ 2 from by
        rw [Finset.mul_sum]
        exact Finset.sum_congr rfl (fun i _ => by ring)]
    rw [Real.sqrt_mul (sq_nonneg t), Real.sqrt_sq_eq_abs]
  rw [habs]
  calc |t| * vecNorm2 (matMulVec n M x)
      ≤ 1 * vecNorm2 (matMulVec n M x) :=
        mul_le_mul_of_nonneg_right ht (vecNorm2_nonneg _)
    _ = vecNorm2 (matMulVec n M x) := one_mul _
    _ ≤ c * vecNorm2 x := hMx

/-- **Theorem 9.15 support**: the scaled-perturbation smallness certificate
for the Barrlund homotopy path.  If `G = Linv·ΔA·Uinv` has an `opNorm2Le`
certificate below one, so does `Linv·(t•ΔA)·Uinv` for every `|t| ≤ 1`. -/
theorem higham9_15_path_G_opNorm2Le {n : ℕ}
    (ΔA Linv Uinv : Matrix (Fin n) (Fin n) ℝ) {c : ℝ}
    (hG : opNorm2Le (fun i j : Fin n => (Linv * ΔA * Uinv) i j) c)
    {t : ℝ} (ht : |t| ≤ 1) :
    opNorm2Le (fun i j : Fin n => (Linv * (t • ΔA) * Uinv) i j) c := by
  have hentry : ∀ i j : Fin n,
      (Linv * (t • ΔA) * Uinv) i j = t * (Linv * ΔA * Uinv) i j := by
    intro i j
    simp only [Matrix.mul_apply, Matrix.smul_apply, smul_eq_mul,
      Finset.mul_sum]
    refine Finset.sum_congr rfl (fun p _ => ?_)
    rw [show (∑ x, Linv i x * (t * ΔA x p))
          = t * ∑ x, Linv i x * ΔA x p from by
        rw [Finset.mul_sum]
        exact Finset.sum_congr rfl (fun q _ => by ring)]
    ring
  have hres := higham9_15_opNorm2Le_smul_of_abs_le_one hG ht
  intro x
  have := hres x
  rw [show matMulVec n (fun i j : Fin n => (Linv * (t • ΔA) * Uinv) i j) x
      = matMulVec n (fun i j => t * (Linv * ΔA * Uinv) i j) x from by
    funext i
    unfold matMulVec
    exact Finset.sum_congr rfl (fun j _ => by
      show (Linv * (t • ΔA) * Uinv) i j * x j
        = t * (Linv * ΔA * Uinv) i j * x j
      rw [hentry i j, mul_assoc])]
  exact this

/-- **Theorem 9.15 / Equation (9.27)**: existence along the whole homotopy
path, in the scaled form.  Under Barrlund's smallness certificate for
`G = Linv·ΔA·Uinv`, every `A + t·ΔA` with `|t| ≤ 1` has an exact LU
certificate. -/
theorem higham9_15_path_lu_exists {n : ℕ}
    (A L U ΔA Linv Uinv : Matrix (Fin n) (Fin n) ℝ)
    (hLU : L * U = A)
    (hL_diag : ∀ i : Fin n, L i i = 1)
    (hL : ∀ i j : Fin n, i.val < j.val → L i j = 0)
    (hU : ∀ i j : Fin n, j.val < i.val → U i j = 0)
    (hLinv : Linv * L = 1)
    (hUinv : U * Uinv = 1)
    (hpivnz : ∀ i : Fin n, U i i ≠ 0)
    {c : ℝ} (hc : c < 1)
    (hG : opNorm2Le (fun i j : Fin n => (Linv * ΔA * Uinv) i j) c)
    {t : ℝ} (ht : |t| ≤ 1) :
    ∃ L' U' : Fin n → Fin n → ℝ,
      LUFactSpec n (fun i j => A i j + (t • ΔA) i j) L' U' :=
  higham9_15_perturbed_lu_exists A L U (t • ΔA) Linv Uinv hLU
    hL_diag hL hU hLinv hUinv hpivnz hc
    (higham9_15_path_G_opNorm2Le ΔA Linv Uinv hG ht)

/-- The lower factor of the LU factorization of `A + t·ΔA`, chosen by
classical choice whenever a factorization exists (and `0` otherwise).  On
the Barrlund homotopy path the factorization exists and is unique, so this
is *the* factorization path. -/
noncomputable def higham9_15_pathL {n : ℕ}
    (A ΔA : Matrix (Fin n) (Fin n) ℝ) (t : ℝ) : Fin n → Fin n → ℝ :=
  letI := Classical.dec (∃ L' U' : Fin n → Fin n → ℝ,
    LUFactSpec n (fun i j => A i j + (t • ΔA) i j) L' U')
  if h : ∃ L' U' : Fin n → Fin n → ℝ,
      LUFactSpec n (fun i j => A i j + (t • ΔA) i j) L' U' then
    h.choose
  else 0

/-- The upper factor of the LU factorization of `A + t·ΔA`, chosen
compatibly with `higham9_15_pathL`. -/
noncomputable def higham9_15_pathU {n : ℕ}
    (A ΔA : Matrix (Fin n) (Fin n) ℝ) (t : ℝ) : Fin n → Fin n → ℝ :=
  letI := Classical.dec (∃ L' U' : Fin n → Fin n → ℝ,
    LUFactSpec n (fun i j => A i j + (t • ΔA) i j) L' U')
  if h : ∃ L' U' : Fin n → Fin n → ℝ,
      LUFactSpec n (fun i j => A i j + (t • ΔA) i j) L' U' then
    h.choose_spec.choose
  else 0

/-- The chosen path factors form an exact LU certificate whenever one
exists. -/
theorem higham9_15_pathLU_spec {n : ℕ}
    (A ΔA : Matrix (Fin n) (Fin n) ℝ) (t : ℝ)
    (h : ∃ L' U' : Fin n → Fin n → ℝ,
      LUFactSpec n (fun i j => A i j + (t • ΔA) i j) L' U') :
    LUFactSpec n (fun i j => A i j + (t • ΔA) i j)
      (higham9_15_pathL A ΔA t) (higham9_15_pathU A ΔA t) := by
  unfold higham9_15_pathL higham9_15_pathU
  rw [dif_pos h, dif_pos h]
  exact h.choose_spec.choose_spec

/-- On the Barrlund homotopy path, the chosen factors are an exact LU
certificate of `A + t·ΔA`. -/
theorem higham9_15_pathLU_spec_of_barrlund {n : ℕ}
    (A L U ΔA Linv Uinv : Matrix (Fin n) (Fin n) ℝ)
    (hLU : L * U = A)
    (hL_diag : ∀ i : Fin n, L i i = 1)
    (hL : ∀ i j : Fin n, i.val < j.val → L i j = 0)
    (hU : ∀ i j : Fin n, j.val < i.val → U i j = 0)
    (hLinv : Linv * L = 1)
    (hUinv : U * Uinv = 1)
    (hpivnz : ∀ i : Fin n, U i i ≠ 0)
    {c : ℝ} (hc : c < 1)
    (hG : opNorm2Le (fun i j : Fin n => (Linv * ΔA * Uinv) i j) c)
    {t : ℝ} (ht : |t| ≤ 1) :
    LUFactSpec n (fun i j => A i j + (t • ΔA) i j)
      (higham9_15_pathL A ΔA t) (higham9_15_pathU A ΔA t) :=
  higham9_15_pathLU_spec A ΔA t
    (higham9_15_path_lu_exists A L U ΔA Linv Uinv hLU hL_diag hL hU
      hLinv hUinv hpivnz hc hG ht)

/-- On the Barrlund homotopy path, the chosen upper factor has nonzero
pivots. -/
theorem higham9_15_pathU_pivots_ne_zero {n : ℕ}
    (A L U ΔA Linv Uinv : Matrix (Fin n) (Fin n) ℝ)
    (hLU : L * U = A)
    (hL_diag : ∀ i : Fin n, L i i = 1)
    (hL : ∀ i j : Fin n, i.val < j.val → L i j = 0)
    (hU : ∀ i j : Fin n, j.val < i.val → U i j = 0)
    (hLinv : Linv * L = 1)
    (hUinv : U * Uinv = 1)
    (hpivnz : ∀ i : Fin n, U i i ≠ 0)
    {c : ℝ} (hc : c < 1)
    (hG : opNorm2Le (fun i j : Fin n => (Linv * ΔA * Uinv) i j) c)
    {t : ℝ} (ht : |t| ≤ 1) (i : Fin n) :
    higham9_15_pathU A ΔA t i i ≠ 0 :=
  higham9_15_perturbed_LUFactSpec_pivots_ne_zero A L U (t • ΔA) Linv Uinv
    hLU hL_diag hL hU hLinv hUinv hpivnz hc
    (higham9_15_path_G_opNorm2Le ΔA Linv Uinv hG ht)
    (higham9_15_pathLU_spec_of_barrlund A L U ΔA Linv Uinv hLU hL_diag hL
      hU hLinv hUinv hpivnz hc hG ht) i

/-- On the Barrlund homotopy path, ANY exact LU certificate of `A + t·ΔA`
coincides with the chosen path factors. -/
theorem higham9_15_pathLU_unique {n : ℕ}
    (A L U ΔA Linv Uinv : Matrix (Fin n) (Fin n) ℝ)
    (hLU : L * U = A)
    (hL_diag : ∀ i : Fin n, L i i = 1)
    (hL : ∀ i j : Fin n, i.val < j.val → L i j = 0)
    (hU : ∀ i j : Fin n, j.val < i.val → U i j = 0)
    (hLinv : Linv * L = 1)
    (hUinv : U * Uinv = 1)
    (hpivnz : ∀ i : Fin n, U i i ≠ 0)
    {c : ℝ} (hc : c < 1)
    (hG : opNorm2Le (fun i j : Fin n => (Linv * ΔA * Uinv) i j) c)
    {t : ℝ} (ht : |t| ≤ 1)
    {L' U' : Fin n → Fin n → ℝ}
    (hLU' : LUFactSpec n (fun i j => A i j + (t • ΔA) i j) L' U') :
    higham9_15_pathL A ΔA t = L' ∧ higham9_15_pathU A ΔA t = U' :=
  higham9_1_lu_unique_of_pivots_ne_zero
    (higham9_15_pathLU_spec_of_barrlund A L U ΔA Linv Uinv hLU hL_diag hL
      hU hLinv hUinv hpivnz hc hG ht)
    hLU'
    (fun k => higham9_15_pathU_pivots_ne_zero A L U ΔA Linv Uinv hLU
      hL_diag hL hU hLinv hUinv hpivnz hc hG ht k)

/-- At `t = 0` the chosen path factors are the original `L` and `U`. -/
theorem higham9_15_pathLU_zero {n : ℕ}
    (A L U ΔA Linv Uinv : Matrix (Fin n) (Fin n) ℝ)
    (hLU : L * U = A)
    (hL_diag : ∀ i : Fin n, L i i = 1)
    (hL : ∀ i j : Fin n, i.val < j.val → L i j = 0)
    (hU : ∀ i j : Fin n, j.val < i.val → U i j = 0)
    (hLinv : Linv * L = 1)
    (hUinv : U * Uinv = 1)
    (hpivnz : ∀ i : Fin n, U i i ≠ 0)
    {c : ℝ} (hc : c < 1)
    (hG : opNorm2Le (fun i j : Fin n => (Linv * ΔA * Uinv) i j) c) :
    higham9_15_pathL A ΔA 0 = (fun i j => L i j)
      ∧ higham9_15_pathU A ΔA 0 = (fun i j => U i j) := by
  have hbase : LUFactSpec n (fun i j => A i j + ((0 : ℝ) • ΔA) i j)
      (fun i j => L i j) (fun i j => U i j) := by
    have hA : ∀ i j : Fin n, A i j + ((0 : ℝ) • ΔA) i j = A i j := by
      intro i j
      simp
    refine ⟨fun i => hL_diag i, fun i j hij => hL i j hij,
      fun i j hij => hU i j hij, fun i j => ?_⟩
    rw [hA i j]
    have := congrFun (congrFun hLU i) j
    simpa [Matrix.mul_apply] using this
  exact higham9_15_pathLU_unique A L U ΔA Linv Uinv hLU hL_diag hL hU
    hLinv hUinv hpivnz hc hG (by norm_num) hbase
/-- **Theorem 9.15**, strictly lower triangular projection used in the
normalized Barrlund--Sun equations. -/
noncomputable def higham9_15_strilPart {n : ℕ}
    (A : Matrix (Fin n) (Fin n) ℝ) : Matrix (Fin n) (Fin n) ℝ :=
  fun i j => if j.val < i.val then A i j else 0

/-- **Theorem 9.15**, upper triangular projection, including the diagonal,
used in the normalized Barrlund--Sun equations. -/
noncomputable def higham9_15_triuPart {n : ℕ}
    (A : Matrix (Fin n) (Fin n) ℝ) : Matrix (Fin n) (Fin n) ℝ :=
  fun i j => if i.val ≤ j.val then A i j else 0

/-- **Theorem 9.15**, the strictly lower projection is Frobenius
nonexpansive. -/
theorem higham9_15_frobNormRect_strilPart_le {n : ℕ}
    (A : Matrix (Fin n) (Fin n) ℝ) :
    frobNormRect (higham9_15_strilPart A) ≤ frobNormRect A := by
  calc
    frobNormRect (higham9_15_strilPart A)
        ≤ frobNormRect (fun i j : Fin n => |A i j|) := by
          apply frobNormRect_le_of_entry_abs_le
          · intro i j
            exact abs_nonneg (A i j)
          · intro i j
            unfold higham9_15_strilPart
            by_cases h : j.val < i.val
            · simp [h]
            · simp [h, abs_nonneg]
    _ = frobNormRect A := frobNormRect_abs A

/-- **Theorem 9.15**, the upper projection is Frobenius nonexpansive. -/
theorem higham9_15_frobNormRect_triuPart_le {n : ℕ}
    (A : Matrix (Fin n) (Fin n) ℝ) :
    frobNormRect (higham9_15_triuPart A) ≤ frobNormRect A := by
  calc
    frobNormRect (higham9_15_triuPart A)
        ≤ frobNormRect (fun i j : Fin n => |A i j|) := by
          apply frobNormRect_le_of_entry_abs_le
          · intro i j
            exact abs_nonneg (A i j)
          · intro i j
            unfold higham9_15_triuPart
            by_cases h : i.val ≤ j.val
            · simp [h]
            · simp [h, abs_nonneg]
    _ = frobNormRect A := frobNormRect_abs A

/-- **Theorem 9.15**, entrywise absolute value commutes with the strictly
lower projection up to a nonnegative projected majorant. -/
theorem higham9_15_abs_strilPart_le_strilPart_of_abs_le {n : ℕ}
    (A B : Matrix (Fin n) (Fin n) ℝ)
    (_hB_nonneg : ∀ i j : Fin n, 0 ≤ B i j)
    (hAB : ∀ i j : Fin n, |A i j| ≤ B i j) :
    ∀ i j : Fin n,
      |higham9_15_strilPart A i j| ≤ higham9_15_strilPart B i j := by
  intro i j
  unfold higham9_15_strilPart
  by_cases h : j.val < i.val
  · simpa [h] using hAB i j
  · simp [h]

/-- **Theorem 9.15**, entrywise absolute value commutes with the upper
projection up to a nonnegative projected majorant. -/
theorem higham9_15_abs_triuPart_le_triuPart_of_abs_le {n : ℕ}
    (A B : Matrix (Fin n) (Fin n) ℝ)
    (_hB_nonneg : ∀ i j : Fin n, 0 ≤ B i j)
    (hAB : ∀ i j : Fin n, |A i j| ≤ B i j) :
    ∀ i j : Fin n,
      |higham9_15_triuPart A i j| ≤ higham9_15_triuPart B i j := by
  intro i j
  unfold higham9_15_triuPart
  by_cases h : i.val ≤ j.val
  · simpa [h] using hAB i j
  · simp [h]

/-- **Theorem 9.15**, monotonicity of the strictly lower projection. -/
theorem higham9_15_strilPart_mono {n : ℕ}
    (A B : Matrix (Fin n) (Fin n) ℝ)
    (hAB : ∀ i j : Fin n, A i j ≤ B i j) :
    ∀ i j : Fin n,
      higham9_15_strilPart A i j ≤ higham9_15_strilPart B i j := by
  intro i j
  unfold higham9_15_strilPart
  by_cases h : j.val < i.val
  · simpa [h] using hAB i j
  · simp [h]

/-- **Theorem 9.15**, monotonicity of the upper projection. -/
theorem higham9_15_triuPart_mono {n : ℕ}
    (A B : Matrix (Fin n) (Fin n) ℝ)
    (hAB : ∀ i j : Fin n, A i j ≤ B i j) :
    ∀ i j : Fin n,
      higham9_15_triuPart A i j ≤ higham9_15_triuPart B i j := by
  intro i j
  unfold higham9_15_triuPart
  by_cases h : i.val ≤ j.val
  · simpa [h] using hAB i j
  · simp [h]

/-- **Theorem 9.15**, the strictly lower projection distributes over addition. -/
theorem higham9_15_strilPart_add {n : ℕ}
    (A B : Matrix (Fin n) (Fin n) ℝ) :
    higham9_15_strilPart (A + B) =
      higham9_15_strilPart A + higham9_15_strilPart B := by
  ext i j
  unfold higham9_15_strilPart
  by_cases h : j.val < i.val
  · have hfin : j < i := h
    simp [hfin]
  · have hfin : ¬ j < i := by
      intro hji
      exact h hji
    simp [hfin]

/-- **Theorem 9.15**, the upper projection distributes over addition. -/
theorem higham9_15_triuPart_add {n : ℕ}
    (A B : Matrix (Fin n) (Fin n) ℝ) :
    higham9_15_triuPart (A + B) =
      higham9_15_triuPart A + higham9_15_triuPart B := by
  ext i j
  unfold higham9_15_triuPart
  by_cases h : i.val ≤ j.val
  · have hfin : i ≤ j := h
    simp [hfin]
  · have hfin : ¬ i ≤ j := by
      intro hij
      exact h hij
    simp [hfin]

/-- **Theorem 9.15**, right multiplication by a split strictly-lower
majorant separates into leading and local-product contributions. -/
theorem higham9_15_rectMatMul_strilPart_add_right {n : ℕ}
    (A B C : Matrix (Fin n) (Fin n) ℝ) (i j : Fin n) :
    rectMatMul A (higham9_15_strilPart (B + C)) i j =
      rectMatMul A (higham9_15_strilPart B) i j +
        rectMatMul A (higham9_15_strilPart C) i j := by
  rw [higham9_15_strilPart_add]
  unfold rectMatMul
  simp [mul_add, Finset.sum_add_distrib]

/-- **Theorem 9.15**, left multiplication by a split upper majorant separates
into leading and local-product contributions. -/
theorem higham9_15_rectMatMul_triuPart_add_left {n : ℕ}
    (A B C : Matrix (Fin n) (Fin n) ℝ) (i j : Fin n) :
    rectMatMul (higham9_15_triuPart (A + B)) C i j =
      rectMatMul (higham9_15_triuPart A) C i j +
        rectMatMul (higham9_15_triuPart B) C i j := by
  rw [higham9_15_triuPart_add]
  unfold rectMatMul
  simp [add_mul, Finset.sum_add_distrib]

/-- **Theorem 9.15**, entrywise absolute product bound for the local square
matrix product. -/
theorem higham9_15_abs_matrix_mul_le_abs_mul_abs {n : ℕ}
    (X Y : Matrix (Fin n) (Fin n) ℝ) :
    ∀ i j : Fin n,
      |(X * Y) i j| ≤
        rectMatMul (absMatrix n X) (absMatrix n Y) i j := by
  intro i j
  unfold rectMatMul absMatrix
  calc
    |∑ k : Fin n, X i k * Y k j|
        ≤ ∑ k : Fin n, |X i k * Y k j| :=
          Finset.abs_sum_le_sum_abs _ _
    _ = ∑ k : Fin n, |X i k| * |Y k j| := by
          apply Finset.sum_congr rfl
          intro k _
          rw [abs_mul]

/-- **Theorem 9.15 support**, product-shape bridge for normalized lower
perturbations: lower triangular times strictly lower triangular is strictly
lower triangular.  This supplies the `hXtri` side condition for
`X = L⁻¹ ΔL` from ordinary triangular support assumptions. -/
theorem higham9_15_rectMatMul_lower_strictLower_is_strictLower {n : ℕ}
    (A B : Matrix (Fin n) (Fin n) ℝ)
    (hA_lower : ∀ i j : Fin n, i.val < j.val → A i j = 0)
    (hB_strict : ∀ i j : Fin n, i.val ≤ j.val → B i j = 0) :
    ∀ i j : Fin n, i.val ≤ j.val → rectMatMul A B i j = 0 := by
  intro i j hij
  unfold rectMatMul
  apply Finset.sum_eq_zero
  intro k _hk
  by_cases hki : k.val ≤ i.val
  · have hkj : k.val ≤ j.val := by omega
    simp [hB_strict k j hkj]
  · have hik : i.val < k.val := by omega
    simp [hA_lower i k hik]

/-- **Theorem 9.15 support**, product-shape bridge for normalized upper
perturbations: upper triangular times upper triangular is upper triangular.
This supplies the `hYtri` side condition for `Y = ΔU U⁻¹` from ordinary
triangular support assumptions. -/
theorem higham9_15_rectMatMul_upper_upper_is_upper {n : ℕ}
    (A B : Matrix (Fin n) (Fin n) ℝ)
    (hA_upper : ∀ i j : Fin n, j.val < i.val → A i j = 0)
    (hB_upper : ∀ i j : Fin n, j.val < i.val → B i j = 0) :
    ∀ i j : Fin n, j.val < i.val → rectMatMul A B i j = 0 := by
  intro i j hji
  unfold rectMatMul
  apply Finset.sum_eq_zero
  intro k _hk
  by_cases hki : k.val < i.val
  · simp [hA_upper i k hki]
  · have hjk : j.val < k.val := by omega
    simp [hB_upper k j hjk]

/-- **Theorem 9.15 support**, packaged triangular-support discharge for the
normalized Barrlund--Sun factors `L⁻¹ΔL` and `ΔU U⁻¹`. -/
theorem higham9_15_normalized_triangular_support_of_factor_triangularity
    {n : ℕ}
    (Linv Uinv ΔL ΔU : Matrix (Fin n) (Fin n) ℝ)
    (hLinv_lower : ∀ i j : Fin n, i.val < j.val → Linv i j = 0)
    (hΔL_strict : ∀ i j : Fin n, i.val ≤ j.val → ΔL i j = 0)
    (hΔU_upper : ∀ i j : Fin n, j.val < i.val → ΔU i j = 0)
    (hUinv_upper : ∀ i j : Fin n, j.val < i.val → Uinv i j = 0) :
    (∀ i j : Fin n, i.val ≤ j.val → rectMatMul Linv ΔL i j = 0) ∧
      (∀ i j : Fin n, j.val < i.val → rectMatMul ΔU Uinv i j = 0) :=
  ⟨higham9_15_rectMatMul_lower_strictLower_is_strictLower
      Linv ΔL hLinv_lower hΔL_strict,
    higham9_15_rectMatMul_upper_upper_is_upper
      ΔU Uinv hΔU_upper hUinv_upper⟩

/-- **Theorem 9.15**, the strictly lower projection of a strict-lower plus
upper split recovers the strict-lower summand. -/
theorem higham9_15_strilPart_add_strictLower_upper {n : ℕ}
    (X Y : Matrix (Fin n) (Fin n) ℝ)
    (hX : ∀ i j : Fin n, i.val ≤ j.val → X i j = 0)
    (hY : ∀ i j : Fin n, j.val < i.val → Y i j = 0) :
    higham9_15_strilPart (X + Y) = X := by
  ext i j
  unfold higham9_15_strilPart
  by_cases h : j.val < i.val
  · simp [h, hY i j h]
  · have hij : i.val ≤ j.val := by omega
    simp [h, hX i j hij]

/-- **Theorem 9.15**, the upper projection of a strict-lower plus upper split
recovers the upper summand. -/
theorem higham9_15_triuPart_add_strictLower_upper {n : ℕ}
    (X Y : Matrix (Fin n) (Fin n) ℝ)
    (hX : ∀ i j : Fin n, i.val ≤ j.val → X i j = 0)
    (hY : ∀ i j : Fin n, j.val < i.val → Y i j = 0) :
    higham9_15_triuPart (X + Y) = Y := by
  ext i j
  unfold higham9_15_triuPart
  by_cases h : i.val ≤ j.val
  · simp [h, hX i j h]
  · have hji : j.val < i.val := by omega
    simp [h, hY i j hji]

/-- **Theorem 9.15 support**, residual identity for the normwise normalized
split: `I + G = (I + X)(I + Y)` implies `G - XY = X + Y`. -/
theorem higham9_15_normalized_G_residual_eq_add {n : ℕ}
    (G X Y : Matrix (Fin n) (Fin n) ℝ)
    (hfact : 1 + G = (1 + X) * (1 + Y)) :
    G - X * Y = X + Y := by
  have hG_eq : G = X + Y + X * Y := by
    calc
      G = (1 + G) - 1 := by
        abel
      _ = (1 + X) * (1 + Y) - 1 := by
        rw [hfact]
      _ = X + Y + X * Y := by
        noncomm_ring
  rw [hG_eq]
  abel

/-- **Theorem 9.15 support**, Frobenius form of the normwise normalized
residual identity. -/
theorem higham9_15_normalized_G_residual_frobNormRect_eq_add {n : ℕ}
    (G X Y : Matrix (Fin n) (Fin n) ℝ)
    (hfact : 1 + G = (1 + X) * (1 + Y)) :
    frobNormRect (G - X * Y) = frobNormRect (X + Y) := by
  rw [higham9_15_normalized_G_residual_eq_add G X Y hfact]

/-- **Theorem 9.15 support**, squared Frobenius form of the normwise
normalized residual identity. -/
theorem higham9_15_normalized_G_residual_frobNormSqRect_eq_add {n : ℕ}
    (G X Y : Matrix (Fin n) (Fin n) ℝ)
    (hfact : 1 + G = (1 + X) * (1 + Y)) :
    frobNormSqRect (G - X * Y) = frobNormSqRect (X + Y) := by
  rw [higham9_15_normalized_G_residual_eq_add G X Y hfact]

/-- **Theorem 9.15**, normalized split equations for the normwise route:
from `I + G = (I + X)(I + Y)`, strict-lower `X`, and upper `Y`, one gets
`X = stril(G - XY)` and `Y = triu(G - XY)`. -/
theorem higham9_15_normalized_G_split_matrix {n : ℕ}
    (G X Y : Matrix (Fin n) (Fin n) ℝ)
    (hfact : 1 + G = (1 + X) * (1 + Y))
    (hX : ∀ i j : Fin n, i.val ≤ j.val → X i j = 0)
    (hY : ∀ i j : Fin n, j.val < i.val → Y i j = 0) :
    higham9_15_strilPart (G - X * Y) = X ∧
      higham9_15_triuPart (G - X * Y) = Y := by
  have hG : G - X * Y = X + Y :=
    higham9_15_normalized_G_residual_eq_add G X Y hfact
  constructor
  · rw [hG]
    exact higham9_15_strilPart_add_strictLower_upper X Y hX hY
  · rw [hG]
    exact higham9_15_triuPart_add_strictLower_upper X Y hX hY

/-- **Theorem 9.15**, Frobenius projection bounds from the normwise normalized
split equation. -/
theorem higham9_15_normalized_G_split_frobNorm_bounds {n : ℕ}
    (G X Y : Matrix (Fin n) (Fin n) ℝ)
    (hfact : 1 + G = (1 + X) * (1 + Y))
    (hX : ∀ i j : Fin n, i.val ≤ j.val → X i j = 0)
    (hY : ∀ i j : Fin n, j.val < i.val → Y i j = 0) :
    frobNormRect X ≤ frobNormRect (G - X * Y) ∧
      frobNormRect Y ≤ frobNormRect (G - X * Y) := by
  have hsplit :=
    higham9_15_normalized_G_split_matrix G X Y hfact hX hY
  constructor
  · calc
      frobNormRect X = frobNormRect (higham9_15_strilPart (G - X * Y)) := by
        rw [hsplit.1]
      _ ≤ frobNormRect (G - X * Y) :=
        higham9_15_frobNormRect_strilPart_le (G - X * Y)
  · calc
      frobNormRect Y = frobNormRect (higham9_15_triuPart (G - X * Y)) := by
        rw [hsplit.2]
      _ ≤ frobNormRect (G - X * Y) :=
        higham9_15_frobNormRect_triuPart_le (G - X * Y)

/-- **Theorem 9.15**, componentwise projected majorants from the normwise
normalized split equation. -/
theorem higham9_15_normalized_G_split_componentwise_majorants {n : ℕ}
    (G X Y : Matrix (Fin n) (Fin n) ℝ)
    (hfact : 1 + G = (1 + X) * (1 + Y))
    (hX : ∀ i j : Fin n, i.val ≤ j.val → X i j = 0)
    (hY : ∀ i j : Fin n, j.val < i.val → Y i j = 0) :
    (∀ i j : Fin n,
      |X i j| ≤
        higham9_15_strilPart
          (fun i j : Fin n =>
            |G i j| + rectMatMul (absMatrix n X) (absMatrix n Y) i j)
          i j) ∧
      (∀ i j : Fin n,
        |Y i j| ≤
          higham9_15_triuPart
            (fun i j : Fin n =>
              |G i j| + rectMatMul (absMatrix n X) (absMatrix n Y) i j)
            i j) := by
  let B : Matrix (Fin n) (Fin n) ℝ :=
    fun i j => |G i j| + rectMatMul (absMatrix n X) (absMatrix n Y) i j
  have hB_nonneg : ∀ i j : Fin n, 0 ≤ B i j := by
    intro i j
    unfold B rectMatMul absMatrix
    exact add_nonneg (abs_nonneg _) <|
      Finset.sum_nonneg fun k _ => mul_nonneg (abs_nonneg _) (abs_nonneg _)
  have hres : ∀ i j : Fin n, |(G - X * Y) i j| ≤ B i j := by
    intro i j
    calc
      |(G - X * Y) i j|
          = |G i j - (X * Y) i j| := rfl
      _ ≤ |G i j| + |(X * Y) i j| := by
          simpa [sub_eq_add_neg, abs_neg] using
            abs_add_le (G i j) (-((X * Y) i j))
      _ ≤ |G i j| + rectMatMul (absMatrix n X) (absMatrix n Y) i j :=
          add_le_add le_rfl (higham9_15_abs_matrix_mul_le_abs_mul_abs X Y i j)
      _ = B i j := rfl
  have hsplit :=
    higham9_15_normalized_G_split_matrix G X Y hfact hX hY
  constructor
  · intro i j
    calc
      |X i j| = |higham9_15_strilPart (G - X * Y) i j| := by
        rw [hsplit.1]
      _ ≤ higham9_15_strilPart B i j :=
        higham9_15_abs_strilPart_le_strilPart_of_abs_le
          (G - X * Y) B hB_nonneg hres i j
  · intro i j
    calc
      |Y i j| = |higham9_15_triuPart (G - X * Y) i j| := by
        rw [hsplit.2]
      _ ≤ higham9_15_triuPart B i j :=
        higham9_15_abs_triuPart_le_triuPart_of_abs_le
          (G - X * Y) B hB_nonneg hres i j

/-- **Theorem 9.15**, one-step Frobenius nonlinear bound from the normwise
normalized split equation. -/
theorem higham9_15_normalized_G_split_frobNorm_step_bound {n : ℕ}
    (G X Y : Matrix (Fin n) (Fin n) ℝ)
    (hfact : 1 + G = (1 + X) * (1 + Y))
    (hX : ∀ i j : Fin n, i.val ≤ j.val → X i j = 0)
    (hY : ∀ i j : Fin n, j.val < i.val → Y i j = 0) :
    max (frobNormRect X) (frobNormRect Y) ≤
      frobNormRect G + frobNormRect X * frobNormRect Y := by
  have hb :=
    higham9_15_normalized_G_split_frobNorm_bounds G X Y hfact hX hY
  have hres :
      frobNormRect (G - X * Y) ≤
        frobNormRect G + frobNormRect (X * Y) :=
    frobNormRect_sub_le G (X * Y)
  have hmul :
      frobNormRect (X * Y) ≤ frobNormRect X * frobNormRect Y := by
    simpa [rectMatMul, Matrix.mul_apply] using
      (frobNormRect_rectMatMul_le X Y)
  have hstep :
      frobNormRect (G - X * Y) ≤
      frobNormRect G + frobNormRect X * frobNormRect Y :=
    hres.trans (add_le_add le_rfl hmul)
  exact max_le (hb.1.trans hstep) (hb.2.trans hstep)

/-- **Theorem 9.15 support**, residual Frobenius product bound from the
normwise normalized split. -/
theorem higham9_15_normalized_G_residual_frobNormRect_le_add_product {n : ℕ}
    (G X Y : Matrix (Fin n) (Fin n) ℝ) :
    frobNormRect (G - X * Y) ≤
      frobNormRect G + frobNormRect X * frobNormRect Y := by
  have hres :
      frobNormRect (G - X * Y) ≤
        frobNormRect G + frobNormRect (X * Y) :=
    frobNormRect_sub_le G (X * Y)
  have hmul :
      frobNormRect (X * Y) ≤ frobNormRect X * frobNormRect Y := by
    simpa [rectMatMul, Matrix.mul_apply] using
      (frobNormRect_rectMatMul_le X Y)
  exact hres.trans (add_le_add le_rfl hmul)

/-- **Theorem 9.15 support**, square-level residual product bound from the
normwise normalized split. -/
theorem higham9_15_normalized_G_residual_frobNormSqRect_le_add_product_sq
    {n : ℕ}
    (G X Y : Matrix (Fin n) (Fin n) ℝ) :
    frobNormSqRect (G - X * Y) ≤
      (frobNormRect G + frobNormRect X * frobNormRect Y) ^ 2 := by
  have hres :
      frobNormRect (G - X * Y) ≤
        frobNormRect G + frobNormRect (X * Y) :=
    frobNormRect_sub_le G (X * Y)
  have hmul :
      frobNormRect (X * Y) ≤ frobNormRect X * frobNormRect Y := by
    simpa [rectMatMul, Matrix.mul_apply] using
      (frobNormRect_rectMatMul_le X Y)
  have hnorm :
      frobNormRect (G - X * Y) ≤
        frobNormRect G + frobNormRect X * frobNormRect Y :=
    hres.trans (add_le_add le_rfl hmul)
  have hleft_nonneg : 0 ≤ frobNormRect (G - X * Y) :=
    frobNormRect_nonneg _
  have hright_nonneg :
      0 ≤ frobNormRect G + frobNormRect X * frobNormRect Y :=
    add_nonneg (frobNormRect_nonneg _)
      (mul_nonneg (frobNormRect_nonneg _) (frobNormRect_nonneg _))
  rw [← frobNormRect_sq (G - X * Y)]
  nlinarith

/-- **Theorem 9.15**, scalar denominator step used by the normwise
Barrlund--Sun route: from `q <= g + eta*q` and `eta < 1`, derive
`q <= g/(1-eta)`. -/
theorem higham9_15_scalar_bound_of_le_add_mul {q g eta : ℝ}
    (heta : eta < 1)
    (hstep : q ≤ g + eta * q) :
    q ≤ g / (1 - eta) := by
  have hpos : 0 < 1 - eta := by linarith
  have hmul : (1 - eta) * q ≤ g := by nlinarith
  exact (le_div_iff₀ hpos).mpr (by
    simpa [mul_comm] using hmul)

/-- **Theorem 9.15**, final scalar ratio handoff once the missing normwise
Schur-induction lemma supplies the linearized step bound. -/
theorem higham9_15_normalized_G_frobNorm_ratio_bound_of_linear_step {n : ℕ}
    (G X Y : Matrix (Fin n) (Fin n) ℝ)
    (hGlt : opNorm2 G < 1)
    (hlinear :
      max (frobNormRect X) (frobNormRect Y) ≤
        frobNormRect G + opNorm2 G *
          max (frobNormRect X) (frobNormRect Y)) :
    max (frobNormRect X) (frobNormRect Y) ≤
      frobNormRect G / (1 - opNorm2 G) :=
  higham9_15_scalar_bound_of_le_add_mul hGlt hlinear

/-- **Theorem 9.15**, scalar support lemma: if the smaller of two
nonnegative factors is bounded by `eta`, then their product is bounded by
`eta` times their maximum. -/
theorem higham9_15_mul_le_eta_mul_max_of_min_le {x y eta : ℝ}
    (hx : 0 ≤ x) (hy : 0 ≤ y) (hmin : min x y ≤ eta) :
    x * y ≤ eta * max x y := by
  by_cases hxy : x ≤ y
  · have hxeta : x ≤ eta := by
      simpa [min_eq_left hxy] using hmin
    have hmax : max x y = y := max_eq_right hxy
    calc
      x * y ≤ eta * y := mul_le_mul_of_nonneg_right hxeta hy
      _ = eta * max x y := by rw [hmax]
  · have hyx : y ≤ x := le_of_lt (lt_of_not_ge hxy)
    have hyeta : y ≤ eta := by
      simpa [min_eq_right hyx] using hmin
    have hmax : max x y = x := max_eq_left hyx
    calc
      x * y = y * x := by ring
      _ ≤ eta * x := mul_le_mul_of_nonneg_right hyeta hx
      _ = eta * max x y := by rw [hmax]

/-- **Theorem 9.15**, normalized linearized step from a supplied min-factor
bound in the `I + G` split.  This isolates the exact remaining target for the
Barrlund--Sun Schur induction: prove the displayed min-factor control, then the
quadratic Frobenius step becomes the linear step consumed by the ratio theorem. -/
theorem higham9_15_normalized_G_linear_step_of_min_factor_bound {n : ℕ}
    (G X Y : Matrix (Fin n) (Fin n) ℝ)
    (hfact : 1 + G = (1 + X) * (1 + Y))
    (hX : ∀ i j : Fin n, i.val ≤ j.val → X i j = 0)
    (hY : ∀ i j : Fin n, j.val < i.val → Y i j = 0)
    (hmin :
      min (frobNormRect X) (frobNormRect Y) ≤ opNorm2 G) :
    max (frobNormRect X) (frobNormRect Y) ≤
      frobNormRect G + opNorm2 G *
        max (frobNormRect X) (frobNormRect Y) := by
  have hstep :=
    higham9_15_normalized_G_split_frobNorm_step_bound
      G X Y hfact hX hY
  have hquad :
      frobNormRect X * frobNormRect Y ≤
        opNorm2 G * max (frobNormRect X) (frobNormRect Y) :=
    higham9_15_mul_le_eta_mul_max_of_min_le
      (frobNormRect_nonneg X) (frobNormRect_nonneg Y) hmin
  exact hstep.trans (add_le_add le_rfl hquad)

/-- **Theorem 9.15 support**, square-level residual bound with the quadratic
term linearized by a supplied min-factor hypothesis. -/
theorem higham9_15_normalized_G_residual_frobNormSqRect_le_linear_step_sq_of_min_factor_bound
    {n : ℕ}
    (G X Y : Matrix (Fin n) (Fin n) ℝ)
    (hmin :
      min (frobNormRect X) (frobNormRect Y) ≤ opNorm2 G) :
    frobNormSqRect (G - X * Y) ≤
      (frobNormRect G +
        opNorm2 G * max (frobNormRect X) (frobNormRect Y)) ^ 2 := by
  have hprod :=
    higham9_15_normalized_G_residual_frobNormSqRect_le_add_product_sq
      G X Y
  have hquad :
      frobNormRect X * frobNormRect Y ≤
        opNorm2 G * max (frobNormRect X) (frobNormRect Y) :=
    higham9_15_mul_le_eta_mul_max_of_min_le
      (frobNormRect_nonneg X) (frobNormRect_nonneg Y) hmin
  have hsum :
      frobNormRect G + frobNormRect X * frobNormRect Y ≤
        frobNormRect G +
          opNorm2 G * max (frobNormRect X) (frobNormRect Y) :=
    add_le_add le_rfl hquad
  have hleft_nonneg :
      0 ≤ frobNormRect G + frobNormRect X * frobNormRect Y :=
    add_nonneg (frobNormRect_nonneg _)
      (mul_nonneg (frobNormRect_nonneg _) (frobNormRect_nonneg _))
  have hmax_nonneg :
      0 ≤ max (frobNormRect X) (frobNormRect Y) :=
    (frobNormRect_nonneg X).trans (le_max_left _ _)
  have hright_nonneg :
      0 ≤ frobNormRect G +
          opNorm2 G * max (frobNormRect X) (frobNormRect Y) :=
    add_nonneg (frobNormRect_nonneg _)
      (mul_nonneg (opNorm2_nonneg _) hmax_nonneg)
  exact hprod.trans (by nlinarith)

/-- **Theorem 9.15 support**, residual Frobenius bound with the product term
linearized by a supplied min-factor hypothesis. -/
theorem higham9_15_normalized_G_residual_frobNormRect_le_linear_step_of_min_factor_bound
    {n : ℕ}
    (G X Y : Matrix (Fin n) (Fin n) ℝ)
    (hmin :
      min (frobNormRect X) (frobNormRect Y) ≤ opNorm2 G) :
    frobNormRect (G - X * Y) ≤
      frobNormRect G +
        opNorm2 G * max (frobNormRect X) (frobNormRect Y) := by
  have hprod :=
    higham9_15_normalized_G_residual_frobNormRect_le_add_product
      G X Y
  have hquad :
      frobNormRect X * frobNormRect Y ≤
        opNorm2 G * max (frobNormRect X) (frobNormRect Y) :=
    higham9_15_mul_le_eta_mul_max_of_min_le
      (frobNormRect_nonneg X) (frobNormRect_nonneg Y) hmin
  exact hprod.trans (add_le_add le_rfl hquad)

/-- **Theorem 9.15**, conditional ratio bound from the normalized split when
one normalized factor is already controlled by the small operator parameter.

This is a proved scalar bridge for the Barrlund--Sun route; the full source
theorem still requires the Schur-induction argument that supplies this
one-factor control from `||G||₂ < 1`. -/
theorem higham9_15_normalized_G_frobNorm_ratio_bound_of_min_factor_bound {n : ℕ}
    (G X Y : Matrix (Fin n) (Fin n) ℝ)
    (hfact : 1 + G = (1 + X) * (1 + Y))
    (hX : ∀ i j : Fin n, i.val ≤ j.val → X i j = 0)
    (hY : ∀ i j : Fin n, j.val < i.val → Y i j = 0)
    (hGlt : opNorm2 G < 1)
    (hmin :
      min (frobNormRect X) (frobNormRect Y) ≤ opNorm2 G) :
    max (frobNormRect X) (frobNormRect Y) ≤
      frobNormRect G / (1 - opNorm2 G) := by
  have hlinear :
      max (frobNormRect X) (frobNormRect Y) ≤
        frobNormRect G + opNorm2 G *
          max (frobNormRect X) (frobNormRect Y) :=
    higham9_15_normalized_G_linear_step_of_min_factor_bound
      G X Y hfact hX hY hmin
  exact higham9_15_normalized_G_frobNorm_ratio_bound_of_linear_step
    G X Y hGlt hlinear

/-- The combined normalized factor-perturbation size along the Barrlund
homotopy path: `s(t) = ‖L⁻¹·(L(t) − L) + (U(t) − U)·U⁻¹‖_F` for the chosen
factorization path `L(t) = pathL`, `U(t) = pathU`. -/
noncomputable def higham9_15_pathS {n : ℕ}
    (A L U ΔA Linv Uinv : Matrix (Fin n) (Fin n) ℝ) (t : ℝ) : ℝ :=
  frobNormRect
    ((Linv * (Matrix.of (higham9_15_pathL A ΔA t) - L)
      + (Matrix.of (higham9_15_pathU A ΔA t) - U) * Uinv
      : Matrix (Fin n) (Fin n) ℝ))

/-- `s(0) = 0`: at the start of the path the factors are unperturbed. -/
theorem higham9_15_pathS_zero {n : ℕ}
    (A L U ΔA Linv Uinv : Matrix (Fin n) (Fin n) ℝ)
    (hLU : L * U = A)
    (hL_diag : ∀ i : Fin n, L i i = 1)
    (hL : ∀ i j : Fin n, i.val < j.val → L i j = 0)
    (hU : ∀ i j : Fin n, j.val < i.val → U i j = 0)
    (hLinv : Linv * L = 1)
    (hUinv : U * Uinv = 1)
    (hpivnz : ∀ i : Fin n, U i i ≠ 0)
    {c : ℝ} (hc : c < 1)
    (hG : opNorm2Le (fun i j : Fin n => (Linv * ΔA * Uinv) i j) c) :
    higham9_15_pathS A L U ΔA Linv Uinv 0 = 0 := by
  obtain ⟨hL0, hU0⟩ := higham9_15_pathLU_zero A L U ΔA Linv Uinv hLU
    hL_diag hL hU hLinv hUinv hpivnz hc hG
  have hLof : Matrix.of (higham9_15_pathL A ΔA 0) = L := by
    rw [hL0]
    ext i j
    rfl
  have hUof : Matrix.of (higham9_15_pathU A ΔA 0) = U := by
    rw [hU0]
    ext i j
    rfl
  unfold higham9_15_pathS
  rw [hLof, hUof, sub_self, sub_self, Matrix.mul_zero, Matrix.zero_mul,
    add_zero]
  unfold frobNormRect frobNormSqRect
  simp

/-- Frobenius norm of an entrywise scaling. -/
theorem higham9_15_frobNormRect_smul {m n : ℕ}
    (t : ℝ) (M : Fin m → Fin n → ℝ) :
    frobNormRect (fun i j => t * M i j) = |t| * frobNormRect M := by
  unfold frobNormRect frobNormSqRect
  rw [show (∑ i : Fin m, ∑ j : Fin n, (t * M i j) ^ 2)
        = t ^ 2 * ∑ i : Fin m, ∑ j : Fin n, M i j ^ 2 from by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [Finset.mul_sum]
      exact Finset.sum_congr rfl (fun j _ => by ring)]
  rw [Real.sqrt_mul (sq_nonneg t), Real.sqrt_sq_eq_abs]

/-- **Theorem 9.15 / Equation (9.27): the pointwise quadratic self-majorant
along the Barrlund homotopy path.**  For `t ∈ [0, 1]`,
`s(t) ≤ ‖L⁻¹ΔA U⁻¹‖_F + s(t)²`. -/
theorem higham9_15_pathS_selfMajorant {n : ℕ}
    (A L U ΔA Linv Uinv : Matrix (Fin n) (Fin n) ℝ)
    (hLU : L * U = A)
    (hL_diag : ∀ i : Fin n, L i i = 1)
    (hL : ∀ i j : Fin n, i.val < j.val → L i j = 0)
    (hU : ∀ i j : Fin n, j.val < i.val → U i j = 0)
    (hLinv : Linv * L = 1)
    (hUinv : U * Uinv = 1)
    (hLinv_lower : ∀ i j : Fin n, i.val < j.val → Linv i j = 0)
    (hUinv_upper : ∀ i j : Fin n, j.val < i.val → Uinv i j = 0)
    (hpivnz : ∀ i : Fin n, U i i ≠ 0)
    {c : ℝ} (hc : c < 1)
    (hG : opNorm2Le (fun i j : Fin n => (Linv * ΔA * Uinv) i j) c)
    {t : ℝ} (ht0 : 0 ≤ t) (ht1 : t ≤ 1) :
    higham9_15_pathS A L U ΔA Linv Uinv t
      ≤ frobNormRect ((Linv * ΔA * Uinv : Matrix (Fin n) (Fin n) ℝ))
        + higham9_15_pathS A L U ΔA Linv Uinv t ^ 2 := by
  classical
  have ht : |t| ≤ 1 := abs_le.mpr ⟨by linarith, ht1⟩
  have hspec := higham9_15_pathLU_spec_of_barrlund A L U ΔA Linv Uinv hLU
    hL_diag hL hU hLinv hUinv hpivnz hc hG ht
  set ΔLt : Matrix (Fin n) (Fin n) ℝ :=
    Matrix.of (higham9_15_pathL A ΔA t) - L with hΔLt
  set ΔUt : Matrix (Fin n) (Fin n) ℝ :=
    Matrix.of (higham9_15_pathU A ΔA t) - U with hΔUt
  set X : Matrix (Fin n) (Fin n) ℝ := Linv * ΔLt with hX
  set Y : Matrix (Fin n) (Fin n) ℝ := ΔUt * Uinv with hY
  set Gt : Matrix (Fin n) (Fin n) ℝ := Linv * (t • ΔA) * Uinv with hGt
  have hs_def : higham9_15_pathS A L U ΔA Linv Uinv t
      = frobNormRect (X + Y : Matrix (Fin n) (Fin n) ℝ) := rfl
  -- the perturbed factorization at parameter t
  have hPert : (L + ΔLt) * (U + ΔUt) = A + t • ΔA := by
    have h1 : L + ΔLt = Matrix.of (higham9_15_pathL A ΔA t) := by
      rw [hΔLt]
      abel
    have h2 : U + ΔUt = Matrix.of (higham9_15_pathU A ΔA t) := by
      rw [hΔUt]
      abel
    rw [h1, h2]
    ext i j
    simp only [Matrix.mul_apply, Matrix.of_apply, Matrix.add_apply]
    exact hspec.product_eq i j
  have hfact := higham9_15_normalized_G_factorization_matrix
    A L U (t • ΔA) ΔLt ΔUt Linv Uinv hLU hPert hLinv hUinv
  have hfact' : 1 + Gt = (1 + X) * (1 + Y) := by
    rw [hGt, hX, hY]
    exact hfact.symm
  -- triangular structure of the normalized factors
  have hΔL_strict : ∀ i j : Fin n, i.val ≤ j.val → ΔLt i j = 0 := by
    intro i j hij
    rcases eq_or_lt_of_le hij with heq | hlt
    · have hij' : i = j := Fin.ext heq
      subst hij'
      simp only [hΔLt, Matrix.sub_apply, Matrix.of_apply]
      rw [hspec.L_diag i, hL_diag i, sub_self]
    · simp only [hΔLt, Matrix.sub_apply, Matrix.of_apply]
      rw [hspec.L_upper_zero i j hlt, hL i j hlt, sub_self]
  have hΔU_upper : ∀ i j : Fin n, j.val < i.val → ΔUt i j = 0 := by
    intro i j hij
    simp only [hΔUt, Matrix.sub_apply, Matrix.of_apply]
    rw [hspec.U_lower_zero i j hij, hU i j hij, sub_self]
  obtain ⟨hXtri', hYtri'⟩ :=
    higham9_15_normalized_triangular_support_of_factor_triangularity
      Linv Uinv ΔLt ΔUt hLinv_lower hΔL_strict hΔU_upper hUinv_upper
  have hXtri : ∀ i j : Fin n, i.val ≤ j.val → X i j = 0 := by
    intro i j hij
    have := hXtri' i j hij
    simpa [rectMatMul, Matrix.mul_apply, hX] using this
  have hYtri : ∀ i j : Fin n, j.val < i.val → Y i j = 0 := by
    intro i j hij
    have := hYtri' i j hij
    simpa [rectMatMul, Matrix.mul_apply, hY] using this
  -- s = ‖Gt − X·Y‖ ≤ ‖Gt‖ + ‖X‖·‖Y‖
  have hres : frobNormRect ((Gt - X * Y : Matrix (Fin n) (Fin n) ℝ))
      = frobNormRect ((X + Y : Matrix (Fin n) (Fin n) ℝ)) :=
    higham9_15_normalized_G_residual_frobNormRect_eq_add Gt X Y hfact'
  have hle := higham9_15_normalized_G_residual_frobNormRect_le_add_product
    Gt X Y
  -- ‖X‖, ‖Y‖ ≤ s
  have hXle : frobNormRect (X : Matrix (Fin n) (Fin n) ℝ)
      ≤ frobNormRect ((X + Y : Matrix (Fin n) (Fin n) ℝ)) := by
    have hXeq := higham9_15_strilPart_add_strictLower_upper X Y hXtri hYtri
    calc frobNormRect (X : Matrix (Fin n) (Fin n) ℝ)
        = frobNormRect (higham9_15_strilPart (X + Y)) := by rw [hXeq]
      _ ≤ frobNormRect ((X + Y : Matrix (Fin n) (Fin n) ℝ)) :=
          higham9_15_frobNormRect_strilPart_le (X + Y)
  have hYle : frobNormRect (Y : Matrix (Fin n) (Fin n) ℝ)
      ≤ frobNormRect ((X + Y : Matrix (Fin n) (Fin n) ℝ)) := by
    have hYeq := higham9_15_triuPart_add_strictLower_upper X Y hXtri hYtri
    calc frobNormRect (Y : Matrix (Fin n) (Fin n) ℝ)
        = frobNormRect (higham9_15_triuPart (X + Y)) := by rw [hYeq]
      _ ≤ frobNormRect ((X + Y : Matrix (Fin n) (Fin n) ℝ)) :=
          higham9_15_frobNormRect_triuPart_le (X + Y)
  -- ‖Gt‖ ≤ ‖G‖
  have hGt_le : frobNormRect (Gt : Matrix (Fin n) (Fin n) ℝ)
      ≤ frobNormRect ((Linv * ΔA * Uinv : Matrix (Fin n) (Fin n) ℝ)) := by
    have hGt_eq : (Gt : Matrix (Fin n) (Fin n) ℝ)
        = fun i j => t * (Linv * ΔA * Uinv) i j := by
      funext i j
      simp only [hGt, Matrix.mul_apply, Matrix.smul_apply, smul_eq_mul]
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun p _ => ?_)
      rw [show (∑ x, Linv i x * (t * ΔA x p))
            = t * ∑ x, Linv i x * ΔA x p from by
          rw [Finset.mul_sum]
          exact Finset.sum_congr rfl (fun q _ => by ring)]
      ring
    rw [hGt_eq, higham9_15_frobNormRect_smul]
    calc |t| * frobNormRect ((Linv * ΔA * Uinv : Matrix (Fin n) (Fin n) ℝ))
        ≤ 1 * frobNormRect ((Linv * ΔA * Uinv : Matrix (Fin n) (Fin n) ℝ)) :=
          mul_le_mul_of_nonneg_right ht (frobNormRect_nonneg _)
      _ = frobNormRect ((Linv * ΔA * Uinv : Matrix (Fin n) (Fin n) ℝ)) :=
          one_mul _
  -- combine
  rw [hs_def]
  have hs_nonneg : 0 ≤ frobNormRect ((X + Y : Matrix (Fin n) (Fin n) ℝ)) :=
    frobNormRect_nonneg _
  calc frobNormRect ((X + Y : Matrix (Fin n) (Fin n) ℝ))
      = frobNormRect ((Gt - X * Y : Matrix (Fin n) (Fin n) ℝ)) := hres.symm
    _ ≤ frobNormRect (Gt : Matrix (Fin n) (Fin n) ℝ)
        + frobNormRect (X : Matrix (Fin n) (Fin n) ℝ)
          * frobNormRect (Y : Matrix (Fin n) (Fin n) ℝ) := hle
    _ ≤ frobNormRect ((Linv * ΔA * Uinv : Matrix (Fin n) (Fin n) ℝ))
        + frobNormRect ((X + Y : Matrix (Fin n) (Fin n) ℝ))
          * frobNormRect ((X + Y : Matrix (Fin n) (Fin n) ℝ)) := by
        refine add_le_add hGt_le ?_
        exact mul_le_mul hXle hYle (frobNormRect_nonneg _) hs_nonneg
    _ = frobNormRect ((Linv * ΔA * Uinv : Matrix (Fin n) (Fin n) ℝ))
        + frobNormRect ((X + Y : Matrix (Fin n) (Fin n) ℝ)) ^ 2 := by
        rw [sq]

/-- Every entry of the lower path factor is continuous on `[0, 1]` (it is a
minor ratio with nonvanishing denominator along the Barrlund path). -/
theorem higham9_15_pathL_entry_continuousOn {n : ℕ}
    (A L U ΔA Linv Uinv : Matrix (Fin n) (Fin n) ℝ)
    (hLU : L * U = A)
    (hL_diag : ∀ i : Fin n, L i i = 1)
    (hL : ∀ i j : Fin n, i.val < j.val → L i j = 0)
    (hU : ∀ i j : Fin n, j.val < i.val → U i j = 0)
    (hLinv : Linv * L = 1)
    (hUinv : U * Uinv = 1)
    (hpivnz : ∀ i : Fin n, U i i ≠ 0)
    {c : ℝ} (hc : c < 1)
    (hG : opNorm2Le (fun i j : Fin n => (Linv * ΔA * Uinv) i j) c)
    (i j : Fin n) :
    ContinuousOn (fun t : ℝ => higham9_15_pathL A ΔA t i j)
      (Set.Icc 0 1) := by
  have hj1 : j.val + 1 ≤ n := j.isLt
  have hden : ∀ t ∈ Set.Icc (0 : ℝ) 1,
      ((A + t • ΔA).submatrix (Fin.castLE hj1) (Fin.castLE hj1)).det ≠ 0 := by
    intro t ht
    have habs : |t| ≤ 1 := abs_le.mpr ⟨by linarith [ht.1], ht.2⟩
    exact higham9_15_perturbed_leading_minor_ne_zero A L U (t • ΔA)
      Linv Uinv hLU hL_diag hL hU hLinv hUinv hpivnz hc
      (higham9_15_path_G_opNorm2Le ΔA Linv Uinv hG habs) hj1
  refine (higham9_15_L_entry_path_continuousOn A ΔA hj1 i hden).congr ?_
  intro t ht
  have habs : |t| ≤ 1 := abs_le.mpr ⟨by linarith [ht.1], ht.2⟩
  have hspec := higham9_15_pathLU_spec_of_barrlund A L U ΔA Linv Uinv hLU
    hL_diag hL hU hLinv hUinv hpivnz hc hG habs
  have hratio := higham9_15_L_entry_eq_minor_ratio hspec hj1 i
    (by
      show Matrix.det ((Matrix.of (fun a b => A a b + (t • ΔA) a b)
          : Matrix (Fin n) (Fin n) ℝ).submatrix
        (Fin.castLE hj1) (Fin.castLE hj1)) ≠ 0
      exact hden t ht)
  show higham9_15_pathL A ΔA t i j
      = ((A + t • ΔA).submatrix (higham9_15_borderedRows hj1 i)
          (Fin.castLE hj1)).det /
        ((A + t • ΔA).submatrix (Fin.castLE hj1) (Fin.castLE hj1)).det
  have hjeq : (⟨j.val, hj1⟩ : Fin n) = j := rfl
  exact hratio

/-- Every entry of the upper path factor is continuous on `[0, 1]`. -/
theorem higham9_15_pathU_entry_continuousOn {n : ℕ}
    (A L U ΔA Linv Uinv : Matrix (Fin n) (Fin n) ℝ)
    (hLU : L * U = A)
    (hL_diag : ∀ i : Fin n, L i i = 1)
    (hL : ∀ i j : Fin n, i.val < j.val → L i j = 0)
    (hU : ∀ i j : Fin n, j.val < i.val → U i j = 0)
    (hLinv : Linv * L = 1)
    (hUinv : U * Uinv = 1)
    (hpivnz : ∀ i : Fin n, U i i ≠ 0)
    {c : ℝ} (hc : c < 1)
    (hG : opNorm2Le (fun i j : Fin n => (Linv * ΔA * Uinv) i j) c)
    (i j : Fin n) :
    ContinuousOn (fun t : ℝ => higham9_15_pathU A ΔA t i j)
      (Set.Icc 0 1) := by
  have hi1 : i.val + 1 ≤ n := i.isLt
  have hden : ∀ t ∈ Set.Icc (0 : ℝ) 1,
      ((A + t • ΔA).submatrix (Fin.castLE (Nat.le_of_succ_le hi1))
        (Fin.castLE (Nat.le_of_succ_le hi1))).det ≠ 0 := by
    intro t ht
    have habs : |t| ≤ 1 := abs_le.mpr ⟨by linarith [ht.1], ht.2⟩
    exact higham9_15_perturbed_leading_minor_ne_zero A L U (t • ΔA)
      Linv Uinv hLU hL_diag hL hU hLinv hUinv hpivnz hc
      (higham9_15_path_G_opNorm2Le ΔA Linv Uinv hG habs)
      (Nat.le_of_succ_le hi1)
  refine (higham9_15_U_entry_path_continuousOn A ΔA hi1 j hden).congr ?_
  intro t ht
  have habs : |t| ≤ 1 := abs_le.mpr ⟨by linarith [ht.1], ht.2⟩
  have hspec := higham9_15_pathLU_spec_of_barrlund A L U ΔA Linv Uinv hLU
    hL_diag hL hU hLinv hUinv hpivnz hc hG habs
  have hratio := higham9_15_U_entry_eq_minor_ratio hspec hi1 j
    (by
      show Matrix.det ((Matrix.of (fun a b => A a b + (t • ΔA) a b)
          : Matrix (Fin n) (Fin n) ℝ).submatrix
        (Fin.castLE (Nat.le_of_succ_le hi1))
        (Fin.castLE (Nat.le_of_succ_le hi1))) ≠ 0
      exact hden t ht)
  show higham9_15_pathU A ΔA t i j
      = ((A + t • ΔA).submatrix (Fin.castLE hi1)
          (higham9_15_borderedCols hi1 j)).det /
        ((A + t • ΔA).submatrix (Fin.castLE (Nat.le_of_succ_le hi1))
          (Fin.castLE (Nat.le_of_succ_le hi1))).det
  exact hratio

/-- **Theorem 9.15 / Equation (9.27)**: the combined factor-perturbation
size `s(t)` is continuous on `[0, 1]`. -/
theorem higham9_15_pathS_continuousOn {n : ℕ}
    (A L U ΔA Linv Uinv : Matrix (Fin n) (Fin n) ℝ)
    (hLU : L * U = A)
    (hL_diag : ∀ i : Fin n, L i i = 1)
    (hL : ∀ i j : Fin n, i.val < j.val → L i j = 0)
    (hU : ∀ i j : Fin n, j.val < i.val → U i j = 0)
    (hLinv : Linv * L = 1)
    (hUinv : U * Uinv = 1)
    (hpivnz : ∀ i : Fin n, U i i ≠ 0)
    {c : ℝ} (hc : c < 1)
    (hG : opNorm2Le (fun i j : Fin n => (Linv * ΔA * Uinv) i j) c) :
    ContinuousOn (higham9_15_pathS A L U ΔA Linv Uinv) (Set.Icc 0 1) := by
  have hentry : ∀ a b : Fin n,
      ContinuousOn (fun t : ℝ =>
        (Linv * (Matrix.of (higham9_15_pathL A ΔA t) - L)
          + (Matrix.of (higham9_15_pathU A ΔA t) - U) * Uinv
          : Matrix (Fin n) (Fin n) ℝ) a b) (Set.Icc 0 1) := by
    intro a b
    have hXab : ContinuousOn (fun t : ℝ =>
        ∑ k : Fin n, Linv a k * (higham9_15_pathL A ΔA t k b - L k b))
        (Set.Icc 0 1) := by
      refine continuousOn_finset_sum _ (fun k _ => ?_)
      exact (continuousOn_const.mul
        ((higham9_15_pathL_entry_continuousOn A L U ΔA Linv Uinv hLU
          hL_diag hL hU hLinv hUinv hpivnz hc hG k b).sub
          continuousOn_const))
    have hYab : ContinuousOn (fun t : ℝ =>
        ∑ k : Fin n, (higham9_15_pathU A ΔA t a k - U a k) * Uinv k b)
        (Set.Icc 0 1) := by
      refine continuousOn_finset_sum _ (fun k _ => ?_)
      exact (((higham9_15_pathU_entry_continuousOn A L U ΔA Linv Uinv hLU
        hL_diag hL hU hLinv hUinv hpivnz hc hG a k).sub
          continuousOn_const).mul continuousOn_const)
    have heq : ∀ t : ℝ,
        (Linv * (Matrix.of (higham9_15_pathL A ΔA t) - L)
          + (Matrix.of (higham9_15_pathU A ΔA t) - U) * Uinv
          : Matrix (Fin n) (Fin n) ℝ) a b
        = (∑ k : Fin n, Linv a k * (higham9_15_pathL A ΔA t k b - L k b))
          + ∑ k : Fin n, (higham9_15_pathU A ΔA t a k - U a k) * Uinv k b := by
      intro t
      simp only [Matrix.add_apply, Matrix.mul_apply, Matrix.sub_apply,
        Matrix.of_apply]
    simpa only [heq] using hXab.add hYab
  unfold higham9_15_pathS frobNormRect frobNormSqRect
  refine Real.continuous_sqrt.comp_continuousOn ?_
  refine continuousOn_finset_sum _ (fun a _ => ?_)
  refine continuousOn_finset_sum _ (fun b _ => ?_)
  exact (hentry a b).pow 2

/-- **Theorem 9.15 / Equation (9.27): rigorous endpoint bound for the
Barrlund homotopy.**  Under the smallness hypotheses
(`opNorm2Le G c` with `c < 1` and `‖G‖_F < 1/4` for `G = L⁻¹ΔA U⁻¹`), the
combined normalized factor-perturbation size at the endpoint satisfies the
small-branch bound `s(1) ≤ (1 − √(1 − 4‖G‖_F))/2`. -/
theorem higham9_15_rigorous_pathS_endpoint_bound {n : ℕ}
    (A L U ΔA Linv Uinv : Matrix (Fin n) (Fin n) ℝ)
    (hLU : L * U = A)
    (hL_diag : ∀ i : Fin n, L i i = 1)
    (hL : ∀ i j : Fin n, i.val < j.val → L i j = 0)
    (hU : ∀ i j : Fin n, j.val < i.val → U i j = 0)
    (hLinv : Linv * L = 1)
    (hUinv : U * Uinv = 1)
    (hLinv_lower : ∀ i j : Fin n, i.val < j.val → Linv i j = 0)
    (hUinv_upper : ∀ i j : Fin n, j.val < i.val → Uinv i j = 0)
    (hpivnz : ∀ i : Fin n, U i i ≠ 0)
    {c : ℝ} (hc : c < 1)
    (hG : opNorm2Le (fun i j : Fin n => (Linv * ΔA * Uinv) i j) c)
    (hg : frobNormRect ((Linv * ΔA * Uinv : Matrix (Fin n) (Fin n) ℝ))
      < 1 / 4) :
    higham9_15_pathS A L U ΔA Linv Uinv 1
      ≤ (1 - Real.sqrt (1 - 4 *
          frobNormRect ((Linv * ΔA * Uinv : Matrix (Fin n) (Fin n) ℝ)))) / 2 :=
  higham9_15_selfMajorant_path_small_branch
    (frobNormRect_nonneg _) hg
    (higham9_15_pathS A L U ΔA Linv Uinv)
    (higham9_15_pathS_continuousOn A L U ΔA Linv Uinv hLU hL_diag hL hU
      hLinv hUinv hpivnz hc hG)
    (higham9_15_pathS_zero A L U ΔA Linv Uinv hLU hL_diag hL hU hLinv
      hUinv hpivnz hc hG)
    (fun _ ht => higham9_15_pathS_selfMajorant A L U ΔA Linv Uinv hLU
      hL_diag hL hU hLinv hUinv hLinv_lower hUinv_upper hpivnz hc hG
      ht.1 ht.2)

/-- **Theorem 9.15 / Equation (9.27): rigorous combined perturbation bound
for any LU factorization of the perturbed matrix** (Barrlund [90, 1991];
Higham states the normwise bound (9.27) without proof; this is the rigorous
quadratic-form variant with hypothesis `‖G‖_F < 1/4`).

For any exact LU certificate `A + ΔA = L'·U'`, the combined normalized
factor perturbation satisfies
`‖L⁻¹(L' − L) + (U' − U)U⁻¹‖_F ≤ (1 − √(1 − 4‖G‖_F))/2`, where
`G = L⁻¹ΔA U⁻¹`.  Since the two summands have disjoint supports (strictly
lower/upper), each of `‖L⁻¹ΔL‖_F` and `‖ΔU·U⁻¹‖_F` is bounded by the same
quantity.  Proof: the certificate coincides with the endpoint of the
Barrlund homotopy path by uniqueness, and the path size obeys the
small-branch bound. -/
theorem higham9_15_rigorous_lu_perturbation_combined_bound {n : ℕ}
    (A L U ΔA Linv Uinv : Matrix (Fin n) (Fin n) ℝ)
    (hLU : L * U = A)
    (hL_diag : ∀ i : Fin n, L i i = 1)
    (hL : ∀ i j : Fin n, i.val < j.val → L i j = 0)
    (hU : ∀ i j : Fin n, j.val < i.val → U i j = 0)
    (hLinv : Linv * L = 1)
    (hUinv : U * Uinv = 1)
    (hLinv_lower : ∀ i j : Fin n, i.val < j.val → Linv i j = 0)
    (hUinv_upper : ∀ i j : Fin n, j.val < i.val → Uinv i j = 0)
    (hpivnz : ∀ i : Fin n, U i i ≠ 0)
    {c : ℝ} (hc : c < 1)
    (hG : opNorm2Le (fun i j : Fin n => (Linv * ΔA * Uinv) i j) c)
    (hg : frobNormRect ((Linv * ΔA * Uinv : Matrix (Fin n) (Fin n) ℝ))
      < 1 / 4)
    {L' U' : Fin n → Fin n → ℝ}
    (hLU' : LUFactSpec n (fun i j => A i j + ΔA i j) L' U') :
    frobNormRect ((Linv * (Matrix.of L' - L)
        + (Matrix.of U' - U) * Uinv : Matrix (Fin n) (Fin n) ℝ))
      ≤ (1 - Real.sqrt (1 - 4 *
          frobNormRect ((Linv * ΔA * Uinv : Matrix (Fin n) (Fin n) ℝ)))) / 2 := by
  have hone : LUFactSpec n
      (fun i j => A i j + ((1 : ℝ) • ΔA) i j) L' U' := by
    have h : (fun i j : Fin n => A i j + ((1 : ℝ) • ΔA) i j)
        = fun i j => A i j + ΔA i j := by
      funext i j
      simp
    rw [h]
    exact hLU'
  obtain ⟨hLeq, hUeq⟩ := higham9_15_pathLU_unique A L U ΔA Linv Uinv hLU
    hL_diag hL hU hLinv hUinv hpivnz hc hG (by norm_num) hone
  have hpathS_eq : higham9_15_pathS A L U ΔA Linv Uinv 1
      = frobNormRect ((Linv * (Matrix.of L' - L)
          + (Matrix.of U' - U) * Uinv : Matrix (Fin n) (Fin n) ℝ)) := by
    unfold higham9_15_pathS
    rw [hLeq, hUeq]
  rw [← hpathS_eq]
  exact higham9_15_rigorous_pathS_endpoint_bound A L U ΔA Linv Uinv hLU
    hL_diag hL hU hLinv hUinv hLinv_lower hUinv_upper hpivnz hc hG hg

/-- **Theorem 9.15 / Equation (9.27): separated normalized bounds.**  Under
the Barrlund smallness hypotheses, for any exact LU certificate
`A + ΔA = L'·U'` the two normalized factor perturbations are *individually*
bounded by the small-branch quantity — the shape of Higham's displayed
componentwise bound (9.27):
`‖L⁻¹(L'−L)‖_F ≤ (1−√(1−4‖G‖_F))/2` and
`‖(U'−U)U⁻¹‖_F ≤ (1−√(1−4‖G‖_F))/2`.

These follow from the combined bound `higham9_15_rigorous_lu_perturbation_
combined_bound` because `L⁻¹(L'−L)` is strictly lower triangular and
`(U'−U)U⁻¹` is upper triangular, so each is a projection (stril / triu) of
their sum and is therefore Frobenius-dominated by it. -/
theorem higham9_15_rigorous_lu_perturbation_split_bounds {n : ℕ}
    (A L U ΔA Linv Uinv : Matrix (Fin n) (Fin n) ℝ)
    (hLU : L * U = A)
    (hL_diag : ∀ i : Fin n, L i i = 1)
    (hL : ∀ i j : Fin n, i.val < j.val → L i j = 0)
    (hU : ∀ i j : Fin n, j.val < i.val → U i j = 0)
    (hLinv : Linv * L = 1)
    (hUinv : U * Uinv = 1)
    (hLinv_lower : ∀ i j : Fin n, i.val < j.val → Linv i j = 0)
    (hUinv_upper : ∀ i j : Fin n, j.val < i.val → Uinv i j = 0)
    (hpivnz : ∀ i : Fin n, U i i ≠ 0)
    {c : ℝ} (hc : c < 1)
    (hG : opNorm2Le (fun i j : Fin n => (Linv * ΔA * Uinv) i j) c)
    (hg : frobNormRect ((Linv * ΔA * Uinv : Matrix (Fin n) (Fin n) ℝ))
      < 1 / 4)
    {L' U' : Fin n → Fin n → ℝ}
    (hLU' : LUFactSpec n (fun i j => A i j + ΔA i j) L' U') :
    frobNormRect ((Linv * (Matrix.of L' - L) : Matrix (Fin n) (Fin n) ℝ))
        ≤ (1 - Real.sqrt (1 - 4 *
            frobNormRect ((Linv * ΔA * Uinv : Matrix (Fin n) (Fin n) ℝ)))) / 2
      ∧ frobNormRect (((Matrix.of U' - U) * Uinv : Matrix (Fin n) (Fin n) ℝ))
        ≤ (1 - Real.sqrt (1 - 4 *
            frobNormRect ((Linv * ΔA * Uinv : Matrix (Fin n) (Fin n) ℝ)))) / 2 := by
  classical
  set ΔL : Matrix (Fin n) (Fin n) ℝ := Matrix.of L' - L with hΔL
  set ΔU : Matrix (Fin n) (Fin n) ℝ := Matrix.of U' - U with hΔU
  set X : Matrix (Fin n) (Fin n) ℝ := Linv * ΔL with hX
  set Y : Matrix (Fin n) (Fin n) ℝ := ΔU * Uinv with hY
  -- triangular structure of ΔL, ΔU
  have hΔL_strict : ∀ i j : Fin n, i.val ≤ j.val → ΔL i j = 0 := by
    intro i j hij
    rcases eq_or_lt_of_le hij with heq | hlt
    · have : i = j := Fin.ext heq
      subst this
      simp only [hΔL, Matrix.sub_apply, Matrix.of_apply]
      rw [hLU'.L_diag i, hL_diag i, sub_self]
    · simp only [hΔL, Matrix.sub_apply, Matrix.of_apply]
      rw [hLU'.L_upper_zero i j hlt, hL i j hlt, sub_self]
  have hΔU_upper : ∀ i j : Fin n, j.val < i.val → ΔU i j = 0 := by
    intro i j hij
    simp only [hΔU, Matrix.sub_apply, Matrix.of_apply]
    rw [hLU'.U_lower_zero i j hij, hU i j hij, sub_self]
  obtain ⟨hXtri', hYtri'⟩ :=
    higham9_15_normalized_triangular_support_of_factor_triangularity
      Linv Uinv ΔL ΔU hLinv_lower hΔL_strict hΔU_upper hUinv_upper
  have hXtri : ∀ i j : Fin n, i.val ≤ j.val → X i j = 0 := by
    intro i j hij
    have := hXtri' i j hij
    simpa [rectMatMul, Matrix.mul_apply, hX] using this
  have hYtri : ∀ i j : Fin n, j.val < i.val → Y i j = 0 := by
    intro i j hij
    have := hYtri' i j hij
    simpa [rectMatMul, Matrix.mul_apply, hY] using this
  have hcombined := higham9_15_rigorous_lu_perturbation_combined_bound
    A L U ΔA Linv Uinv hLU hL_diag hL hU hLinv hUinv hLinv_lower hUinv_upper
    hpivnz hc hG hg hLU'
  -- ‖X‖ ≤ ‖X+Y‖ ≤ bound, ‖Y‖ ≤ ‖X+Y‖ ≤ bound
  have hXeq := higham9_15_strilPart_add_strictLower_upper X Y hXtri hYtri
  have hYeq := higham9_15_triuPart_add_strictLower_upper X Y hXtri hYtri
  have hXle : frobNormRect (X : Matrix (Fin n) (Fin n) ℝ)
      ≤ frobNormRect ((X + Y : Matrix (Fin n) (Fin n) ℝ)) := by
    calc frobNormRect (X : Matrix (Fin n) (Fin n) ℝ)
        = frobNormRect (higham9_15_strilPart (X + Y)) := by rw [hXeq]
      _ ≤ frobNormRect ((X + Y : Matrix (Fin n) (Fin n) ℝ)) :=
          higham9_15_frobNormRect_strilPart_le (X + Y)
  have hYle : frobNormRect (Y : Matrix (Fin n) (Fin n) ℝ)
      ≤ frobNormRect ((X + Y : Matrix (Fin n) (Fin n) ℝ)) := by
    calc frobNormRect (Y : Matrix (Fin n) (Fin n) ℝ)
        = frobNormRect (higham9_15_triuPart (X + Y)) := by rw [hYeq]
      _ ≤ frobNormRect ((X + Y : Matrix (Fin n) (Fin n) ℝ)) :=
          higham9_15_frobNormRect_triuPart_le (X + Y)
  exact ⟨le_trans hXle hcombined, le_trans hYle hcombined⟩

/-- Matrix multiplication agrees with the rectangular product used by the
Frobenius/operator-norm lemmas. -/
theorem higham9_15_matMul_eq_rectMatMul {n : ℕ}
    (A B : Matrix (Fin n) (Fin n) ℝ) :
    (A * B) = rectMatMul A B := by
  ext i j
  simp [rectMatMul, Matrix.mul_apply]

/-- `‖A·B‖_F ≤ a·‖B‖_F` for matrix multiplication, from a spectral-norm bound
`rectOpNorm2Le A a`. -/
theorem higham9_15_frobNormRect_matMul_le_of_rectOpNorm2Le {n : ℕ}
    (A B : Matrix (Fin n) (Fin n) ℝ) {a : ℝ} (ha : 0 ≤ a)
    (hA : rectOpNorm2Le A a) :
    frobNormRect ((A * B : Matrix (Fin n) (Fin n) ℝ)) ≤ a * frobNormRect B := by
  rw [higham9_15_matMul_eq_rectMatMul]
  exact frobNormRect_rectMatMul_le_mul_of_rectOpNorm2Le A B ha hA

/-- **Theorem 9.15 / Equation (9.27), exact Barrlund normwise bound for the
`L` factor** (Barrlund [90, 1991], Theorem 3.1a; Higham states (9.27) without
proof).  For `A = LU`, `A + ΔA = (L+ΔL)(U+ΔU)` with the usual triangular
shapes and inverse certificates, if the normalized perturbation
`G = L⁻¹ ΔA U⁻¹` has spectral norm `< 1` then
`‖ΔL‖_F ≤ ‖L‖₂ · ‖G‖_F / (1 − ‖G‖₂)`.

`ℓ₂`, `g₂` are spectral-norm bounds (`rectOpNorm2Le`) for `L` and `G`; taking
them to be the exact operator norms (`opNorm2Le_opNorm2`) recovers Higham's
displayed inequality.  This is Barrlund's elementary proof: the exact
factorization gives `L⁻¹ΔL + ΔU(U+ΔU)⁻¹ = L⁻¹ΔA(U+ΔU)⁻¹`; the left summand is
strictly lower and the right is upper, so the strictly-lower projection gives
`‖L⁻¹ΔL‖_F ≤ ‖L⁻¹ΔA(U+ΔU)⁻¹‖_F`; the resolvent identity
`(U+ΔU)⁻¹ = U⁻¹ − U⁻¹ΔU(U+ΔU)⁻¹` and Frobenius/spectral submultiplicativity
close the scalar inequality. -/
theorem higham9_15_barrlund_deltaL_bound {n : ℕ}
    (A L U ΔA ΔL ΔU Linv Uinv UΔUinv : Matrix (Fin n) (Fin n) ℝ)
    (hLU : L * U = A)
    (hPert : (L + ΔL) * (U + ΔU) = A + ΔA)
    (hΔL_strict : ∀ i j : Fin n, i.val ≤ j.val → ΔL i j = 0)
    (hΔU_upper : ∀ i j : Fin n, j.val < i.val → ΔU i j = 0)
    (hLinv_lower : ∀ i j : Fin n, i.val < j.val → Linv i j = 0)
    (hUΔUinv_upper : ∀ i j : Fin n, j.val < i.val → UΔUinv i j = 0)
    (hLinvL : Linv * L = 1) (hLLinv : L * Linv = 1)
    (hUinvU : Uinv * U = 1)
    (hUΔUinvR : (U + ΔU) * UΔUinv = 1)
    {ℓ₂ g₂ : ℝ} (hℓ₂ : 0 ≤ ℓ₂) (hg₂0 : 0 ≤ g₂) (hg₂1 : g₂ < 1)
    (hLnorm : rectOpNorm2Le L ℓ₂)
    (hGnorm : rectOpNorm2Le (Linv * ΔA * Uinv) g₂) :
    frobNormRect ((ΔL : Matrix (Fin n) (Fin n) ℝ))
      ≤ ℓ₂ * frobNormRect ((Linv * ΔA * Uinv : Matrix (Fin n) (Fin n) ℝ))
        / (1 - g₂) := by
  classical
  set G : Matrix (Fin n) (Fin n) ℝ := Linv * ΔA * Uinv with hG
  set W : Matrix (Fin n) (Fin n) ℝ := Linv * ΔA * UΔUinv with hW
  set X : Matrix (Fin n) (Fin n) ℝ := Linv * ΔL with hX
  set Y : Matrix (Fin n) (Fin n) ℝ := ΔU * UΔUinv with hY
  -- (3.4): L ΔU + ΔL (U+ΔU) = ΔA
  have hΔ : L * ΔU + ΔL * (U + ΔU) = ΔA := by
    have hexp : (L + ΔL) * (U + ΔU) = L * U + (L * ΔU + ΔL * (U + ΔU)) := by
      noncomm_ring
    rw [hexp, hLU] at hPert
    have := hPert
    -- A + (L ΔU + ΔL (U+ΔU)) = A + ΔA
    have h2 : A + (L * ΔU + ΔL * (U + ΔU)) = A + ΔA := this
    exact (add_left_cancel h2)
  -- (3.5): X + Y = W
  have hsplit : X + Y = W := by
    have h1 : Linv * (L * ΔU + ΔL * (U + ΔU)) * UΔUinv = Linv * ΔA * UΔUinv := by
      rw [hΔ]
    have hexpand :
        Linv * (L * ΔU + ΔL * (U + ΔU)) * UΔUinv
          = (Linv * L) * (ΔU * UΔUinv)
            + (Linv * ΔL) * ((U + ΔU) * UΔUinv) := by
      noncomm_ring
    rw [hexpand, hLinvL, hUΔUinvR] at h1
    simp only [one_mul, mul_one] at h1
    rw [hX, hY, hW]
    rw [add_comm]
    exact h1
  -- triangular support of X (strictly lower) and Y (upper)
  have hXstrict : ∀ i j : Fin n, i.val ≤ j.val → X i j = 0 := by
    intro i j hij
    have := higham9_15_rectMatMul_lower_strictLower_is_strictLower Linv ΔL
      hLinv_lower hΔL_strict i j hij
    rw [hX, higham9_15_matMul_eq_rectMatMul]; exact this
  have hYupper : ∀ i j : Fin n, j.val < i.val → Y i j = 0 := by
    intro i j hij
    have := higham9_15_rectMatMul_upper_upper_is_upper ΔU UΔUinv
      hΔU_upper hUΔUinv_upper i j hij
    rw [hY, higham9_15_matMul_eq_rectMatMul]; exact this
  -- (3.6): ‖X‖ ≤ ‖W‖, ‖Y‖ ≤ ‖W‖
  have hXW : frobNormRect X ≤ frobNormRect W := by
    have hxeq := higham9_15_strilPart_add_strictLower_upper X Y hXstrict hYupper
    calc frobNormRect X = frobNormRect (higham9_15_strilPart (X + Y)) := by rw [hxeq]
      _ ≤ frobNormRect (X + Y) := higham9_15_frobNormRect_strilPart_le (X + Y)
      _ = frobNormRect W := by rw [hsplit]
  have hYW : frobNormRect Y ≤ frobNormRect W := by
    have hyeq := higham9_15_triuPart_add_strictLower_upper X Y hXstrict hYupper
    calc frobNormRect Y = frobNormRect (higham9_15_triuPart (X + Y)) := by rw [hyeq]
      _ ≤ frobNormRect (X + Y) := higham9_15_frobNormRect_triuPart_le (X + Y)
      _ = frobNormRect W := by rw [hsplit]
  -- (3.7): resolvent identity  UΔUinv = Uinv - Uinv ΔU UΔUinv, so W = G - G*Y
  have hres : W = G - G * Y := by
    have hUΔUinv_eq : UΔUinv = Uinv - Uinv * ΔU * UΔUinv := by
      have hstep : Uinv * ((U + ΔU) * UΔUinv) = Uinv * 1 := by rw [hUΔUinvR]
      have hexp : Uinv * ((U + ΔU) * UΔUinv)
          = (Uinv * U) * UΔUinv + Uinv * ΔU * UΔUinv := by noncomm_ring
      rw [hexp, hUinvU, one_mul, mul_one] at hstep
      -- UΔUinv + Uinv ΔU UΔUinv = Uinv
      linear_combination (norm := noncomm_ring) hstep
    calc W = Linv * ΔA * UΔUinv := hW
      _ = Linv * ΔA * (Uinv - Uinv * ΔU * UΔUinv) := by rw [← hUΔUinv_eq]
      _ = Linv * ΔA * Uinv - (Linv * ΔA * Uinv) * (ΔU * UΔUinv) := by noncomm_ring
      _ = G - G * Y := by rw [hG, hY]
  -- ‖W‖ ≤ ‖G‖ + g₂ ‖W‖
  have hWbound : frobNormRect W ≤ frobNormRect G + g₂ * frobNormRect W := by
    have htri : frobNormRect W ≤ frobNormRect G + frobNormRect (G * Y) := by
      rw [hres]; exact frobNormRect_sub_le G (G * Y)
    have hGY : frobNormRect (G * Y) ≤ g₂ * frobNormRect Y := by
      rw [hG]
      exact higham9_15_frobNormRect_matMul_le_of_rectOpNorm2Le
        (Linv * ΔA * Uinv) Y hg₂0 hGnorm
    calc frobNormRect W ≤ frobNormRect G + frobNormRect (G * Y) := htri
      _ ≤ frobNormRect G + g₂ * frobNormRect Y := by linarith
      _ ≤ frobNormRect G + g₂ * frobNormRect W := by nlinarith [hYW, hg₂0]
  -- solve: ‖W‖ ≤ ‖G‖/(1-g₂)
  have h1mg : 0 < 1 - g₂ := by linarith
  have hWfinal : frobNormRect W ≤ frobNormRect G / (1 - g₂) := by
    rw [le_div_iff₀ h1mg]; nlinarith [hWbound]
  -- ‖ΔL‖ = ‖L X‖ ≤ ℓ₂ ‖X‖ ≤ ℓ₂ ‖W‖ ≤ ℓ₂ ‖G‖/(1-g₂)
  have hΔLeq : ΔL = L * X := by
    rw [hX, ← mul_assoc, hLLinv, one_mul]
  have hΔLnorm : frobNormRect ΔL ≤ ℓ₂ * frobNormRect X := by
    rw [hΔLeq]
    exact higham9_15_frobNormRect_matMul_le_of_rectOpNorm2Le L X hℓ₂ hLnorm
  calc frobNormRect ΔL ≤ ℓ₂ * frobNormRect X := hΔLnorm
    _ ≤ ℓ₂ * frobNormRect W := by
        exact mul_le_mul_of_nonneg_left hXW hℓ₂
    _ ≤ ℓ₂ * (frobNormRect G / (1 - g₂)) :=
        mul_le_mul_of_nonneg_left hWfinal hℓ₂
    _ = ℓ₂ * frobNormRect G / (1 - g₂) := by ring

/-- `‖B·C‖_F ≤ ‖B‖_F · c` for matrix multiplication, from a spectral-norm
bound on `C` (`rectOpNorm2Le Cᵀ c`, i.e. `‖C‖₂ ≤ c`). -/
theorem higham9_15_frobNormRect_matMul_le_of_transpose_rectOpNorm2Le {n : ℕ}
    (B C : Matrix (Fin n) (Fin n) ℝ) {c : ℝ} (hc : 0 ≤ c)
    (hC : rectOpNorm2Le (finiteTranspose C) c) :
    frobNormRect ((B * C : Matrix (Fin n) (Fin n) ℝ)) ≤ frobNormRect B * c := by
  rw [higham9_15_matMul_eq_rectMatMul]
  exact frobNormRect_rectMatMul_le_mul_of_transpose_rectOpNorm2Le B C hc hC

/-- **Theorem 9.15 / Equation (9.27), exact Barrlund normwise bound for the
`U` factor** (Barrlund [90, 1991], Theorem 3.1b).  Mirror of the `L`-factor
bound with the left inverse `(L+ΔL)⁻¹`: if `G = L⁻¹ΔA U⁻¹` has spectral norm
`< 1` then `‖ΔU‖_F ≤ ‖U‖₂ · ‖G‖_F / (1 − ‖G‖₂)`.

`u₂`, `g₂` are spectral-norm bounds via the transposes (`‖Uᵀ‖₂ = ‖U‖₂`).
The exact factorization gives `(L+ΔL)⁻¹ΔL + ΔU U⁻¹ = (L+ΔL)⁻¹ΔA U⁻¹`; the
left summand is strictly lower and the right is upper, so the upper projection
gives `‖ΔU U⁻¹‖_F ≤ ‖(L+ΔL)⁻¹ΔA U⁻¹‖_F`; the left resolvent identity
`(L+ΔL)⁻¹ = L⁻¹ − (L+ΔL)⁻¹ΔL L⁻¹` and Frobenius/spectral submultiplicativity
close the scalar inequality. -/
theorem higham9_15_barrlund_deltaU_bound {n : ℕ}
    (A L U ΔA ΔL ΔU Linv Uinv LΔLinv : Matrix (Fin n) (Fin n) ℝ)
    (hLU : L * U = A)
    (hPert : (L + ΔL) * (U + ΔU) = A + ΔA)
    (hΔL_strict : ∀ i j : Fin n, i.val ≤ j.val → ΔL i j = 0)
    (hΔU_upper : ∀ i j : Fin n, j.val < i.val → ΔU i j = 0)
    (hUinv_upper : ∀ i j : Fin n, j.val < i.val → Uinv i j = 0)
    (hLΔLinv_lower : ∀ i j : Fin n, i.val < j.val → LΔLinv i j = 0)
    (hLLinv : L * Linv = 1)
    (hUinvU : Uinv * U = 1)
    (hLΔLinvL : LΔLinv * (L + ΔL) = 1)
    {u₂ g₂ : ℝ} (hu₂ : 0 ≤ u₂) (hg₂0 : 0 ≤ g₂) (hg₂1 : g₂ < 1)
    (hUnorm : rectOpNorm2Le (finiteTranspose U) u₂)
    (hGnorm : rectOpNorm2Le (finiteTranspose (Linv * ΔA * Uinv)) g₂) :
    frobNormRect ((ΔU : Matrix (Fin n) (Fin n) ℝ))
      ≤ frobNormRect ((Linv * ΔA * Uinv : Matrix (Fin n) (Fin n) ℝ)) * u₂
        / (1 - g₂) := by
  classical
  set G : Matrix (Fin n) (Fin n) ℝ := Linv * ΔA * Uinv with hG
  set V : Matrix (Fin n) (Fin n) ℝ := LΔLinv * ΔA * Uinv with hV
  set X : Matrix (Fin n) (Fin n) ℝ := LΔLinv * ΔL with hX
  set Y : Matrix (Fin n) (Fin n) ℝ := ΔU * Uinv with hY
  -- ΔA = ΔL U + (L+ΔL) ΔU
  have hΔ : ΔL * U + (L + ΔL) * ΔU = ΔA := by
    have hexp : (L + ΔL) * (U + ΔU) = L * U + (ΔL * U + (L + ΔL) * ΔU) := by
      noncomm_ring
    rw [hexp, hLU] at hPert
    exact add_left_cancel hPert
  -- split: X + Y = V
  have hsplit : X + Y = V := by
    have h1 : LΔLinv * (ΔL * U + (L + ΔL) * ΔU) * Uinv = LΔLinv * ΔA * Uinv := by
      rw [hΔ]
    have hexpand :
        LΔLinv * (ΔL * U + (L + ΔL) * ΔU) * Uinv
          = (LΔLinv * ΔL) * (U * Uinv)
            + (LΔLinv * (L + ΔL)) * (ΔU * Uinv) := by noncomm_ring
    rw [hexpand, hLΔLinvL] at h1
    -- need U * Uinv = 1: derive from Uinv * U = 1
    have hUUinv : U * Uinv = 1 := by
      have := mul_eq_one_comm.mp hUinvU; exact this
    rw [hUUinv] at h1
    simp only [one_mul, mul_one] at h1
    rw [hX, hY, hV]; exact h1
  -- support: X strictly lower, Y upper
  have hXstrict : ∀ i j : Fin n, i.val ≤ j.val → X i j = 0 := by
    intro i j hij
    have := higham9_15_rectMatMul_lower_strictLower_is_strictLower LΔLinv ΔL
      hLΔLinv_lower hΔL_strict i j hij
    rw [hX, higham9_15_matMul_eq_rectMatMul]; exact this
  have hYupper : ∀ i j : Fin n, j.val < i.val → Y i j = 0 := by
    intro i j hij
    have := higham9_15_rectMatMul_upper_upper_is_upper ΔU Uinv
      hΔU_upper hUinv_upper i j hij
    rw [hY, higham9_15_matMul_eq_rectMatMul]; exact this
  have hXV : frobNormRect X ≤ frobNormRect V := by
    have := higham9_15_strilPart_add_strictLower_upper X Y hXstrict hYupper
    calc frobNormRect X = frobNormRect (higham9_15_strilPart (X + Y)) := by rw [this]
      _ ≤ frobNormRect (X + Y) := higham9_15_frobNormRect_strilPart_le (X + Y)
      _ = frobNormRect V := by rw [hsplit]
  have hYV : frobNormRect Y ≤ frobNormRect V := by
    have := higham9_15_triuPart_add_strictLower_upper X Y hXstrict hYupper
    calc frobNormRect Y = frobNormRect (higham9_15_triuPart (X + Y)) := by rw [this]
      _ ≤ frobNormRect (X + Y) := higham9_15_frobNormRect_triuPart_le (X + Y)
      _ = frobNormRect V := by rw [hsplit]
  -- left resolvent: LΔLinv = Linv - LΔLinv ΔL Linv, so V = G - X*G
  have hres : V = G - X * G := by
    have hLΔLinv_eq : LΔLinv = Linv - LΔLinv * ΔL * Linv := by
      have hstep : (LΔLinv * (L + ΔL)) * Linv = (1 : Matrix (Fin n) (Fin n) ℝ) * Linv := by
        rw [hLΔLinvL]
      have hexp : (LΔLinv * (L + ΔL)) * Linv
          = LΔLinv * (L * Linv) + LΔLinv * ΔL * Linv := by noncomm_ring
      rw [hexp, hLLinv, mul_one, one_mul] at hstep
      linear_combination (norm := noncomm_ring) hstep
    calc V = LΔLinv * ΔA * Uinv := hV
      _ = (Linv - LΔLinv * ΔL * Linv) * ΔA * Uinv := by rw [← hLΔLinv_eq]
      _ = Linv * ΔA * Uinv - (LΔLinv * ΔL) * (Linv * ΔA * Uinv) := by noncomm_ring
      _ = G - X * G := by rw [hG, hX]
  -- ‖V‖ ≤ ‖G‖ + g₂ ‖V‖
  have hVbound : frobNormRect V ≤ frobNormRect G + g₂ * frobNormRect V := by
    have htri : frobNormRect V ≤ frobNormRect G + frobNormRect (X * G) := by
      rw [hres]; exact frobNormRect_sub_le G (X * G)
    have hXG : frobNormRect (X * G) ≤ frobNormRect X * g₂ := by
      rw [hG]
      exact higham9_15_frobNormRect_matMul_le_of_transpose_rectOpNorm2Le
        X (Linv * ΔA * Uinv) hg₂0 hGnorm
    calc frobNormRect V ≤ frobNormRect G + frobNormRect (X * G) := htri
      _ ≤ frobNormRect G + frobNormRect X * g₂ := by linarith
      _ ≤ frobNormRect G + g₂ * frobNormRect V := by nlinarith [hXV, hg₂0]
  have h1mg : 0 < 1 - g₂ := by linarith
  have hVfinal : frobNormRect V ≤ frobNormRect G / (1 - g₂) := by
    rw [le_div_iff₀ h1mg]; nlinarith [hVbound]
  -- ‖ΔU‖ = ‖Y U‖ ≤ ‖Y‖ u₂ ≤ ‖V‖ u₂ ≤ ‖G‖ u₂/(1-g₂)
  have hΔUeq : ΔU = Y * U := by
    rw [hY, mul_assoc, hUinvU, mul_one]
  have hΔUnorm : frobNormRect ΔU ≤ frobNormRect Y * u₂ := by
    rw [hΔUeq]
    exact higham9_15_frobNormRect_matMul_le_of_transpose_rectOpNorm2Le Y U hu₂ hUnorm
  calc frobNormRect ΔU ≤ frobNormRect Y * u₂ := hΔUnorm
    _ ≤ frobNormRect V * u₂ := by exact mul_le_mul_of_nonneg_right hYV hu₂
    _ ≤ (frobNormRect G / (1 - g₂)) * u₂ :=
        mul_le_mul_of_nonneg_right hVfinal hu₂
    _ = frobNormRect G * u₂ / (1 - g₂) := by ring

/-- **Theorem 9.15 support**, residual identity for the componentwise-sign
normalized split: `I - Gtilde = (I - X)(I - Y)` implies
`Gtilde + XY = X + Y`. -/
theorem higham9_15_normalized_Gtilde_residual_eq_add {n : ℕ}
    (Gtilde X Y : Matrix (Fin n) (Fin n) ℝ)
    (hfact : 1 - Gtilde = (1 - X) * (1 - Y)) :
    Gtilde + X * Y = X + Y := by
  have hG_eq : Gtilde = X + Y - X * Y := by
    calc
      Gtilde = 1 - (1 - Gtilde) := by
        abel
      _ = 1 - ((1 - X) * (1 - Y)) := by
        rw [hfact]
      _ = X + Y - X * Y := by
        noncomm_ring
  rw [hG_eq]
  abel

/-- **Theorem 9.15 support**, Frobenius form of the componentwise-sign
normalized residual identity. -/
theorem higham9_15_normalized_Gtilde_residual_frobNormRect_eq_add {n : ℕ}
    (Gtilde X Y : Matrix (Fin n) (Fin n) ℝ)
    (hfact : 1 - Gtilde = (1 - X) * (1 - Y)) :
    frobNormRect (Gtilde + X * Y) = frobNormRect (X + Y) := by
  rw [higham9_15_normalized_Gtilde_residual_eq_add Gtilde X Y hfact]

/-- **Theorem 9.15 support**, squared Frobenius form of the componentwise-sign
normalized residual identity. -/
theorem higham9_15_normalized_Gtilde_residual_frobNormSqRect_eq_add {n : ℕ}
    (Gtilde X Y : Matrix (Fin n) (Fin n) ℝ)
    (hfact : 1 - Gtilde = (1 - X) * (1 - Y)) :
    frobNormSqRect (Gtilde + X * Y) = frobNormSqRect (X + Y) := by
  rw [higham9_15_normalized_Gtilde_residual_eq_add Gtilde X Y hfact]

/-- **Theorem 9.15**, normalized split equations for the componentwise route:
from `I - Gtilde = (I - X)(I - Y)`, strict-lower `X`, and upper `Y`, one gets
`X = stril(Gtilde + XY)` and `Y = triu(Gtilde + XY)`. -/
theorem higham9_15_normalized_Gtilde_split_matrix {n : ℕ}
    (Gtilde X Y : Matrix (Fin n) (Fin n) ℝ)
    (hfact : 1 - Gtilde = (1 - X) * (1 - Y))
    (hX : ∀ i j : Fin n, i.val ≤ j.val → X i j = 0)
    (hY : ∀ i j : Fin n, j.val < i.val → Y i j = 0) :
    higham9_15_strilPart (Gtilde + X * Y) = X ∧
      higham9_15_triuPart (Gtilde + X * Y) = Y := by
  have hG : Gtilde + X * Y = X + Y :=
    higham9_15_normalized_Gtilde_residual_eq_add Gtilde X Y hfact
  constructor
  · rw [hG]
    exact higham9_15_strilPart_add_strictLower_upper X Y hX hY
  · rw [hG]
    exact higham9_15_triuPart_add_strictLower_upper X Y hX hY

/-- **Theorem 9.15**, Frobenius projection bounds from the componentwise
normalized split equation. -/
theorem higham9_15_normalized_Gtilde_split_frobNorm_bounds {n : ℕ}
    (Gtilde X Y : Matrix (Fin n) (Fin n) ℝ)
    (hfact : 1 - Gtilde = (1 - X) * (1 - Y))
    (hX : ∀ i j : Fin n, i.val ≤ j.val → X i j = 0)
    (hY : ∀ i j : Fin n, j.val < i.val → Y i j = 0) :
    frobNormRect X ≤ frobNormRect (Gtilde + X * Y) ∧
      frobNormRect Y ≤ frobNormRect (Gtilde + X * Y) := by
  have hsplit :=
    higham9_15_normalized_Gtilde_split_matrix Gtilde X Y hfact hX hY
  constructor
  · calc
      frobNormRect X = frobNormRect (higham9_15_strilPart (Gtilde + X * Y)) := by
        rw [hsplit.1]
      _ ≤ frobNormRect (Gtilde + X * Y) :=
        higham9_15_frobNormRect_strilPart_le (Gtilde + X * Y)
  · calc
      frobNormRect Y = frobNormRect (higham9_15_triuPart (Gtilde + X * Y)) := by
        rw [hsplit.2]
      _ ≤ frobNormRect (Gtilde + X * Y) :=
        higham9_15_frobNormRect_triuPart_le (Gtilde + X * Y)

/-- **Theorem 9.15**, componentwise projected majorants from the
componentwise normalized split equation. -/
theorem higham9_15_normalized_Gtilde_split_componentwise_majorants {n : ℕ}
    (Gtilde X Y : Matrix (Fin n) (Fin n) ℝ)
    (hfact : 1 - Gtilde = (1 - X) * (1 - Y))
    (hX : ∀ i j : Fin n, i.val ≤ j.val → X i j = 0)
    (hY : ∀ i j : Fin n, j.val < i.val → Y i j = 0) :
    (∀ i j : Fin n,
      |X i j| ≤
        higham9_15_strilPart
          (fun i j : Fin n =>
            |Gtilde i j| + rectMatMul (absMatrix n X) (absMatrix n Y) i j)
          i j) ∧
      (∀ i j : Fin n,
        |Y i j| ≤
          higham9_15_triuPart
            (fun i j : Fin n =>
              |Gtilde i j| + rectMatMul (absMatrix n X) (absMatrix n Y) i j)
            i j) := by
  let B : Matrix (Fin n) (Fin n) ℝ :=
    fun i j => |Gtilde i j| + rectMatMul (absMatrix n X) (absMatrix n Y) i j
  have hB_nonneg : ∀ i j : Fin n, 0 ≤ B i j := by
    intro i j
    unfold B rectMatMul absMatrix
    exact add_nonneg (abs_nonneg _) <|
      Finset.sum_nonneg fun k _ => mul_nonneg (abs_nonneg _) (abs_nonneg _)
  have hres : ∀ i j : Fin n, |(Gtilde + X * Y) i j| ≤ B i j := by
    intro i j
    calc
      |(Gtilde + X * Y) i j|
          = |Gtilde i j + (X * Y) i j| := rfl
      _ ≤ |Gtilde i j| + |(X * Y) i j| :=
          abs_add_le (Gtilde i j) ((X * Y) i j)
      _ ≤ |Gtilde i j| + rectMatMul (absMatrix n X) (absMatrix n Y) i j :=
          add_le_add le_rfl (higham9_15_abs_matrix_mul_le_abs_mul_abs X Y i j)
      _ = B i j := rfl
  have hsplit :=
    higham9_15_normalized_Gtilde_split_matrix Gtilde X Y hfact hX hY
  constructor
  · intro i j
    calc
      |X i j| = |higham9_15_strilPart (Gtilde + X * Y) i j| := by
        rw [hsplit.1]
      _ ≤ higham9_15_strilPart B i j :=
        higham9_15_abs_strilPart_le_strilPart_of_abs_le
          (Gtilde + X * Y) B hB_nonneg hres i j
  · intro i j
    calc
      |Y i j| = |higham9_15_triuPart (Gtilde + X * Y) i j| := by
        rw [hsplit.2]
      _ ≤ higham9_15_triuPart B i j :=
        higham9_15_abs_triuPart_le_triuPart_of_abs_le
          (Gtilde + X * Y) B hB_nonneg hres i j

/-- **Theorem 9.15 support**, componentwise product-majorant discharge when
the normalized lower perturbation is identically zero. -/
theorem higham9_15_componentwise_product_majorant_of_left_zero {n : ℕ}
    (G X Y : Matrix (Fin n) (Fin n) ℝ)
    (hXzero : ∀ i j : Fin n, X i j = 0) :
    ∀ i j : Fin n,
      rectMatMul (absMatrix n X) (absMatrix n Y) i j ≤
        rectMatMul (absMatrix n G)
          (fun r c : Fin n =>
            |G r c| + rectMatMul (absMatrix n X) (absMatrix n Y) r c)
          i j := by
  intro i j
  have hleft_zero :
      rectMatMul (absMatrix n X) (absMatrix n Y) i j = 0 := by
    unfold rectMatMul absMatrix
    apply Finset.sum_eq_zero
    intro k _hk
    simp [hXzero i k]
  have hproduct_nonneg :
      ∀ r c : Fin n, 0 ≤
        rectMatMul (absMatrix n X) (absMatrix n Y) r c := by
    intro r c
    unfold rectMatMul absMatrix
    exact Finset.sum_nonneg fun k _hk =>
      mul_nonneg (abs_nonneg (X r k)) (abs_nonneg (Y k c))
  have hmajorant_nonneg :
      ∀ r c : Fin n,
        0 ≤ |G r c| + rectMatMul (absMatrix n X) (absMatrix n Y) r c := by
    intro r c
    exact add_nonneg (abs_nonneg (G r c)) (hproduct_nonneg r c)
  have hright_nonneg :
      0 ≤
        rectMatMul (absMatrix n G)
          (fun r c : Fin n =>
            |G r c| + rectMatMul (absMatrix n X) (absMatrix n Y) r c)
          i j := by
    unfold rectMatMul absMatrix
    exact Finset.sum_nonneg fun k _hk =>
      mul_nonneg (abs_nonneg (G i k)) (hmajorant_nonneg k j)
  calc
    rectMatMul (absMatrix n X) (absMatrix n Y) i j = 0 := hleft_zero
    _ ≤
        rectMatMul (absMatrix n G)
          (fun r c : Fin n =>
            |G r c| + rectMatMul (absMatrix n X) (absMatrix n Y) r c)
          i j := hright_nonneg

