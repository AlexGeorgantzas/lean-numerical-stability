/-- **Equation (9.27)**, native `Matrix`-product exact-operator-norm bound
for `G = L⁻¹ ΔA U⁻¹`. -/
theorem higham9_27_matrix_mul_opNorm2Le_exact_opNorm2_product {n : ℕ}
    (Linv ΔA Uinv : Matrix (Fin n) (Fin n) ℝ) :
    opNorm2Le ((Linv * ΔA) * Uinv)
      (opNorm2 Linv * opNorm2 ΔA * opNorm2 Uinv) := by
  rw [← higham9_27_GMatrix_eq_matrix_mul Linv ΔA Uinv]
  exact higham9_27_GMatrix_opNorm2Le_exact_opNorm2_product Linv ΔA Uinv

/-- **Equation (9.27)**, native `Matrix`-product exact-operator-norm
smallness bridge for `G = L⁻¹ ΔA U⁻¹`. -/
theorem higham9_27_matrix_mul_opNorm2_lt_one_of_exact_opNorm2_product_lt_one
