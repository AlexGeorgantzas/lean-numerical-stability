/-- **Equation (9.16) / Foster [435, 1997], Theorem 1 core (his eq. (9)): the
subset-Hadamard pivot inequality.**  For a rook LU factorization `A = LU`
(`L` unit lower triangular, `U` upper triangular) normalized so
`max|aᵢⱼ| ≤ 1`, with the rook multiplier bound `|ℓᵢⱼ| ≤ 1` and the rook row
property `|uᵢⱼ| ≤ |uᵢᵢ|`, every index subset `I` (with complement `J = Iᶜ`,
`h = |I|`) satisfies
`∏_{i∈I} |uᵢᵢ| ≤ √(hʰ) · (1 + ∑_{j∈J} |uⱼⱼ|)ʰ`.

This is the tool Foster attributes to Hadamard (as Wilkinson did for complete
pivoting).  Proof: the `I×I` block of `B = ∑_{i∈I} ℓᵢ uᵢ` factors as
`L_{II} U_{II}` (via the monotone enumeration `orderEmbOfFin`), so its
determinant is `∏_{i∈I} uᵢᵢ`; its entries are bounded by `1 + ∑_{j∈J} |uⱼⱼ|`
(the discarded `J`-part), and Hadamard's inequality closes it. -/
theorem higham9_16_foster_subset_hadamard {n : ℕ}
    (A L U : Matrix (Fin n) (Fin n) ℝ)
    (hLU : L * U = A)
    (hL_diag : ∀ i : Fin n, L i i = 1)
    (hL_upper : ∀ i j : Fin n, i.val < j.val → L i j = 0)
    (hU_lower : ∀ i j : Fin n, j.val < i.val → U i j = 0)
    (hAmax : ∀ i j : Fin n, |A i j| ≤ 1)
    (hL1 : ∀ i j : Fin n, |L i j| ≤ 1)
    (hUrook : ∀ i j : Fin n, |U i j| ≤ |U i i|)
    (I : Finset (Fin n)) :
    (∏ i ∈ I, |U i i|)
      ≤ Real.sqrt ((I.card : ℝ) ^ I.card)
          * (1 + ∑ j ∈ Iᶜ, |U j j|) ^ I.card := by
  classical
  set h := I.card with hh
  -- complement-sum bound is nonnegative
  set Mbd : ℝ := 1 + ∑ j ∈ Iᶜ, |U j j| with hMbd
  have hMbd_nonneg : 0 ≤ Mbd := by
    have : 0 ≤ ∑ j ∈ Iᶜ, |U j j| := Finset.sum_nonneg (fun j _ => abs_nonneg _)
    simp only [hMbd]; linarith
  rcases Nat.eq_zero_or_pos h with hzero | hpos
  · -- empty subset: both sides equal 1
    have hIempty : I = ∅ := Finset.card_eq_zero.mp (by rw [← hh]; exact hzero)
    rw [hIempty, Finset.prod_empty, hzero]
    simp [Real.sqrt_one]
  · -- h > 0: the interesting case
    set emb : Fin h ↪o Fin n := I.orderEmbOfFin hh.symm with hemb
    set e : Fin h → Fin n := fun a => emb a with he
    have heinj : Function.Injective e := emb.injective
    have himg : Finset.image e Finset.univ = I := by
      simpa [he, hemb] using Finset.image_orderEmbOfFin_univ I hh.symm
    have he_lt : ∀ {a b : Fin h}, a.val < b.val → (e a).val < (e b).val := by
      intro a b hab
      have : a < b := hab
      exact emb.strictMono this
    -- the h×h submatrices of L and U
    set Lsub : Matrix (Fin h) (Fin h) ℝ := L.submatrix e e with hLsub
    set Usub : Matrix (Fin h) (Fin h) ℝ := U.submatrix e e with hUsub
    set M : Matrix (Fin h) (Fin h) ℝ := Lsub * Usub with hM
    -- det Lsub = 1 (unit lower triangular)
    have hLtri : Matrix.BlockTriangular Lsub OrderDual.toDual := by
      intro a b hab
      have hab' : a.val < b.val := by simpa using hab
      simp only [hLsub, Matrix.submatrix_apply]
      exact hL_upper (e a) (e b) (he_lt hab')
    have hUtri : Matrix.BlockTriangular Usub id := by
      intro a b hab
      have hab' : b.val < a.val := by simpa using hab
      simp only [hUsub, Matrix.submatrix_apply]
      exact hU_lower (e a) (e b) (he_lt hab')
    have hLdet : Lsub.det = 1 := by
      rw [Matrix.det_of_lowerTriangular _ hLtri]
      refine Finset.prod_eq_one (fun a _ => ?_)
      simp only [hLsub, Matrix.submatrix_apply]; exact hL_diag (e a)
    have hUdet : Usub.det = ∏ a : Fin h, U (e a) (e a) := by
      rw [Matrix.det_of_upperTriangular hUtri]
      exact Finset.prod_congr rfl (fun a _ => by simp only [hUsub, Matrix.submatrix_apply])
    have hMdet : M.det = ∏ a : Fin h, U (e a) (e a) := by
      rw [hM, Matrix.det_mul, hLdet, one_mul, hUdet]
    -- entry structure: M a b = A(e a)(e b) - ∑_{k∈Iᶜ} L(e a)k U k(e b)
    have hMentry : ∀ a b : Fin h,
        M a b = A (e a) (e b) - ∑ k ∈ Iᶜ, L (e a) k * U k (e b) := by
      intro a b
      have hMe : M a b = ∑ m : Fin h, L (e a) (e m) * U (e m) (e b) := by
        simp only [hM, Matrix.mul_apply, hLsub, hUsub, Matrix.submatrix_apply]
      -- ∑_{m} f(e m) = ∑_{k ∈ I} f k
      have hreindex : (∑ m : Fin h, L (e a) (e m) * U (e m) (e b))
          = ∑ k ∈ I, L (e a) k * U k (e b) := by
        rw [← himg, Finset.sum_image (fun x _ y _ hxy => heinj hxy)]
      have hAe : A (e a) (e b) = ∑ k : Fin n, L (e a) k * U k (e b) := by
        rw [← hLU]; simp [Matrix.mul_apply]
      have hsplit : (∑ k : Fin n, L (e a) k * U k (e b))
          = (∑ k ∈ I, L (e a) k * U k (e b))
            + ∑ k ∈ Iᶜ, L (e a) k * U k (e b) := by
        rw [← Finset.sum_add_sum_compl I (fun k => L (e a) k * U k (e b))]
      rw [hMe, hreindex, hAe, hsplit]; ring
    -- entry bound
    have hMbound : ∀ a b : Fin h, |M a b| ≤ Mbd := by
      intro a b
      rw [hMentry a b]
      have h1 : |A (e a) (e b) - ∑ k ∈ Iᶜ, L (e a) k * U k (e b)|
          ≤ |A (e a) (e b)| + |∑ k ∈ Iᶜ, L (e a) k * U k (e b)| := abs_sub _ _
      have h2 : |∑ k ∈ Iᶜ, L (e a) k * U k (e b)| ≤ ∑ k ∈ Iᶜ, |U k k| := by
        refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
        refine Finset.sum_le_sum (fun k _ => ?_)
        rw [abs_mul]
        calc |L (e a) k| * |U k (e b)|
            ≤ 1 * |U k k| := by
              apply mul_le_mul (hL1 (e a) k) (hUrook k (e b)) (abs_nonneg _) (by norm_num)
          _ = |U k k| := one_mul _
      calc |A (e a) (e b) - ∑ k ∈ Iᶜ, L (e a) k * U k (e b)|
          ≤ |A (e a) (e b)| + |∑ k ∈ Iᶜ, L (e a) k * U k (e b)| := h1
        _ ≤ 1 + ∑ k ∈ Iᶜ, |U k k| := add_le_add (hAmax (e a) (e b)) h2
        _ = Mbd := by rw [hMbd]
    -- Hadamard on M
    have hmax : maxEntryNorm hpos M ≤ Mbd :=
      maxEntryNorm_le_of_entry_le_bound hpos M Mbd (fun a b => hMbound a b)
    have hhad := higham9_hadamard_det_sq_le_pow_maxEntryNorm hpos M
    have hpow : (maxEntryNorm hpos M) ^ (2 * h) ≤ Mbd ^ (2 * h) :=
      pow_le_pow_left₀ (maxEntryNorm_nonneg hpos M) hmax (2 * h)
    have hstep : (M.det) ^ 2 ≤ (h : ℝ) ^ h * Mbd ^ (2 * h) :=
      hhad.trans (mul_le_mul_of_nonneg_left hpow (by positivity))
    -- |det M| ≤ √(h^h) · Mbd^h
    have habs : |M.det| ≤ Real.sqrt ((h : ℝ) ^ h) * Mbd ^ h := by
      have h1 : |M.det| ≤ Real.sqrt ((h : ℝ) ^ h * Mbd ^ (2 * h)) := by
        rw [← Real.sqrt_sq_eq_abs]; exact Real.sqrt_le_sqrt hstep
      have hrhs : Real.sqrt ((h : ℝ) ^ h * Mbd ^ (2 * h))
          = Real.sqrt ((h : ℝ) ^ h) * Mbd ^ h := by
        rw [Real.sqrt_mul (by positivity), show 2 * h = h * 2 from by ring, pow_mul,
          Real.sqrt_sq (pow_nonneg hMbd_nonneg h)]
      rwa [hrhs] at h1
    -- |det M| = ∏_{i∈I} |U i i|
    have hdetabs : |M.det| = ∏ i ∈ I, |U i i| := by
      rw [hMdet, Finset.abs_prod, ← himg,
        Finset.prod_image (fun x _ y _ hxy => heinj hxy)]
    rw [← hdetabs]
    exact habs


/-! ## Theorem 9.11, `p = 1`: tridiagonal GEPP growth (Bohte `p = 1`) -/

/-- **Theorem 9.11 (`p = 1`) support** (Higham, *Accuracy and Stability*,
2nd ed., §9.5, Theorem 9.11 with `p = 1`), band-tracked active-stage bound for
tridiagonal GEPP.  The active matrix stays tridiagonal, its leading entry is
bounded by twice the original max-entry norm, and every other entry keeps the
original max-entry bound. -/
def higham9_11_TridiagActiveBound (n : ℕ) (M : ℝ)
    (S : Fin n → Fin n → ℝ) : Prop :=
  IsTridiagonal n S ∧
    (∀ i j : Fin n, i.val = 0 → j.val = 0 → |S i j| ≤ 2 * M) ∧
    (∀ i j : Fin n, ¬(i.val = 0 ∧ j.val = 0) → |S i j| ≤ M)

/-- **Theorem 9.11 (`p = 1`) support**, a nonzero first-column pivot of a
tridiagonal stage lies in the first two rows. -/
theorem higham9_11_tridiag_pivot_val_le_one {m : ℕ}
    {S : Fin (m + 1) → Fin (m + 1) → ℝ} {r : Fin (m + 1)}
    (hTri : IsTridiagonal (m + 1) S) (hpivot : S r 0 ≠ 0) :
    r.val ≤ 1 := by
  by_contra h
  have hcond : (0 : Fin (m + 1)).val + 1 < r.val := by
    simp only [Fin.val_zero]
    omega
  exact hpivot (hTri r 0 (Or.inr hcond))

/-- **Theorem 9.11 (`p = 1`) support**, every entry of a band-tracked
tridiagonal active stage is bounded by twice the tracked bound. -/
theorem higham9_11_tridiagActive_row_abs_le_two_mul {n : ℕ} {M : ℝ}
    {S : Fin n → Fin n → ℝ}
    (hM : 0 ≤ M)
    (hS : higham9_11_TridiagActiveBound n M S)
    (r j : Fin n) :
    |S r j| ≤ 2 * M := by
  by_cases h00 : r.val = 0 ∧ j.val = 0
  · exact hS.2.1 r j h00.1 h00.2
  · have h := hS.2.2 r j h00
    linarith

/-- **Theorem 9.11 (`p = 1`) support**, one partial-pivoting Gaussian
elimination step preserves the band-tracked tridiagonal active-stage bound:
after moving the first-column partial pivot into leading position, the first
Schur complement is again tridiagonal with the same `(2M, M)` entry profile.
This is the band-fill bookkeeping Higham describes as "easily verified" for
the tridiagonal (`p = 1`) case of Theorem 9.11. -/
theorem higham9_11_tridiagActive_schur_preserved {m : ℕ}
    {S : Fin (m + 1) → Fin (m + 1) → ℝ} {M : ℝ} {r : Fin (m + 1)}
    (hM : 0 ≤ M)
    (hS : higham9_11_TridiagActiveBound (m + 1) M S)
    (hchoice : higham9_1_partialPivotChoice S 0 r)
    (hpivot : S r 0 ≠ 0) :
    higham9_11_TridiagActiveBound m M
      (luFirstSchurComplement
        (higham9_2_rowPermutedMatrix S (higham9_7_firstPivotRowSwap r))) := by
  obtain ⟨hTri, h00, hOff⟩ := hS
  have hrle : r.val ≤ 1 := higham9_11_tridiag_pivot_val_le_one hTri hpivot
  set σ : Fin (m + 1) → Fin (m + 1) := higham9_7_firstPivotRowSwap r with hσdef
  have hσ0 : σ 0 = r := by
    simp [hσdef, higham9_7_firstPivotRowSwap]
  have hσ_high : ∀ x : Fin (m + 1), 1 < x.val → σ x = x := by
    intro x hx
    have hx0 : x ≠ 0 := by
      intro h
      subst h
      simp at hx
    have hxr : x ≠ r := by
      intro h
      subst h
      omega
    simp [hσdef, higham9_7_firstPivotRowSwap, hx0, hxr]
  have hσ_le_one : ∀ x : Fin (m + 1), x.val ≤ 1 → (σ x).val ≤ 1 := by
    intro x hx
    by_cases hx0 : x = 0
    · subst hx0
      rw [hσ0]
      exact hrle
    · by_cases hxr : x = r
      · have hswap : σ x = 0 := by
          simp [hσdef, higham9_7_firstPivotRowSwap, hxr]
        rw [hswap]
        simp
      · have hid : σ x = x := by
          simp [hσdef, higham9_7_firstPivotRowSwap, hx0, hxr]
        rw [hid]
        exact hx
  have hSchur : ∀ i j : Fin m,
      luFirstSchurComplement (higham9_2_rowPermutedMatrix S σ) i j =
        S (σ i.succ) j.succ - S (σ i.succ) 0 * S r j.succ / S r 0 := by
    intro i j
    show S (σ i.succ) j.succ - S (σ i.succ) 0 * S (σ 0) j.succ / S (σ 0) 0 = _
    rw [hσ0]
  have hmul : ∀ x : Fin (m + 1), |S x 0 / S r 0| ≤ 1 := fun x =>
    higham9_1_partialPivot_multiplier_abs_le_one S 0 r x hchoice hpivot
      (Nat.zero_le _)
  have hOffCol : ∀ x y : Fin (m + 1), y.val ≠ 0 → |S x y| ≤ M := by
    intro x y hy
    exact hOff x y (fun h => hy h.2)
  refine ⟨?_, ?_, ?_⟩
  · -- tridiagonality of the Schur complement
    intro i j hij
    have his : i.succ.val = i.val + 1 := rfl
    have hjs : j.succ.val = j.val + 1 := rfl
    by_cases hi : 0 < i.val
    · -- rows below the corner are pure shifts
      have hσs : σ i.succ = i.succ := hσ_high i.succ (by omega)
      have hzero_col : S i.succ 0 = 0 := by
        apply hTri i.succ 0
        refine Or.inr ?_
        simp only [Fin.val_zero]
        omega
      rw [hSchur i j, hσs, hzero_col]
      have hclean : S i.succ j.succ - 0 * S r j.succ / S r 0 =
          S i.succ j.succ := by ring
      rw [hclean]
      apply hTri i.succ j.succ
      rcases hij with h | h
      · exact Or.inl (by omega)
      · exact Or.inr (by omega)
    · -- first row: entries beyond the first superdiagonal vanish
      have hi0 : i.val = 0 := by omega
      have hj2 : 1 < j.val := by
        rcases hij with h | h <;> omega
      have hpr0 : S r j.succ = 0 := by
        apply hTri r j.succ
        exact Or.inl (by omega)
      have hσs_le : (σ i.succ).val ≤ 1 := hσ_le_one i.succ (by omega)
      have helim0 : S (σ i.succ) j.succ = 0 := by
        apply hTri (σ i.succ) j.succ
        exact Or.inl (by omega)
      rw [hSchur i j, hpr0, helim0]
      ring
  · -- the new corner entry is bounded by `2M`
    intro i j hi hj
    have his : i.succ.val = i.val + 1 := rfl
    have hjs : j.succ.val = j.val + 1 := rfl
    have h1 : |S (σ i.succ) j.succ| ≤ M := hOffCol _ _ (by omega)
    have h2 : |S r j.succ| ≤ M := hOffCol _ _ (by omega)
    have hterm : |S (σ i.succ) 0 * S r j.succ / S r 0| ≤ M := by
      have heq : S (σ i.succ) 0 * S r j.succ / S r 0 =
          S (σ i.succ) 0 / S r 0 * S r j.succ := by ring
      rw [heq, abs_mul]
      calc |S (σ i.succ) 0 / S r 0| * |S r j.succ| ≤ 1 * M :=
            mul_le_mul (hmul _) h2 (abs_nonneg _) zero_le_one
        _ = M := one_mul M
    rw [hSchur i j]
    calc |S (σ i.succ) j.succ - S (σ i.succ) 0 * S r j.succ / S r 0|
        ≤ |S (σ i.succ) j.succ| +
            |S (σ i.succ) 0 * S r j.succ / S r 0| := by
          simpa [sub_eq_add_neg, abs_neg] using
            abs_add_le (S (σ i.succ) j.succ)
              (-(S (σ i.succ) 0 * S r j.succ / S r 0))
      _ ≤ M + M := add_le_add h1 hterm
      _ = 2 * M := by ring
  · -- every non-corner entry keeps the original bound `M`
    intro i j hne
    have his : i.succ.val = i.val + 1 := rfl
    have hjs : j.succ.val = j.val + 1 := rfl
    by_cases hi : 0 < i.val
    · -- shifted untouched rows
      have hσs : σ i.succ = i.succ := hσ_high i.succ (by omega)
      have hzero_col : S i.succ 0 = 0 := by
        apply hTri i.succ 0
        refine Or.inr ?_
        simp only [Fin.val_zero]
        omega
      rw [hSchur i j, hσs, hzero_col]
      have hclean : S i.succ j.succ - 0 * S r j.succ / S r 0 =
          S i.succ j.succ := by ring
      rw [hclean]
      exact hOff i.succ j.succ (by omega)
    · -- first row, off-corner columns
      have hi0 : i.val = 0 := by omega
      have hj1 : 0 < j.val := by
        by_contra hj0
        exact hne ⟨hi0, by omega⟩
      by_cases hj2 : 1 < j.val
      · -- far columns vanish entirely
        have hpr0 : S r j.succ = 0 := by
          apply hTri r j.succ
          exact Or.inl (by omega)
        have hσs_le : (σ i.succ).val ≤ 1 := hσ_le_one i.succ (by omega)
        have helim0 : S (σ i.succ) j.succ = 0 := by
          apply hTri (σ i.succ) j.succ
          exact Or.inl (by omega)
        rw [hSchur i j, hpr0, helim0]
        have hclean : (0 : ℝ) - S (σ i.succ) 0 * 0 / S r 0 = 0 := by ring
        rw [hclean]
        simpa using hM
      · -- the single fill-in column `j = 1`
        have hj1' : j.val = 1 := by omega
        rcases Nat.lt_or_ge r.val 1 with hr | hr
        · -- no row swap: the pivot row vanishes at column 2
          have hr0 : r = 0 := by
            apply Fin.ext
            simp only [Fin.val_zero]
            omega
          have hs1 : i.succ ≠ 0 := Fin.succ_ne_zero i
          have hs2 : i.succ ≠ r := by
            rw [hr0]
            exact hs1
          have hσs : σ i.succ = i.succ := by
            simp [hσdef, higham9_7_firstPivotRowSwap, hs1, hs2]
          have hpr0 : S r j.succ = 0 := by
            apply hTri r j.succ
            exact Or.inl (by omega)
          rw [hSchur i j, hσs, hpr0]
          have hclean : S i.succ j.succ - S i.succ 0 * 0 / S r 0 =
              S i.succ j.succ := by ring
          rw [hclean]
          exact hOffCol i.succ j.succ (by omega)
        · -- rows 0 and 1 swapped: the eliminated row vanishes at column 2
          have hrv : r.val = 1 := by omega
          have his_r : i.succ = r := by
            apply Fin.ext
            omega
          have hr0' : r ≠ 0 := by
            intro h
            subst h
            simp at hrv
          have hσs : σ i.succ = 0 := by
            simp [hσdef, higham9_7_firstPivotRowSwap, his_r, hr0']
          have helim0 : S (σ i.succ) j.succ = 0 := by
            rw [hσs]
            apply hTri 0 j.succ
            refine Or.inl ?_
            simp only [Fin.val_zero]
            omega
          rw [hSchur i j, helim0]
          have heq : (0 : ℝ) - S (σ i.succ) 0 * S r j.succ / S r 0 =
              -(S (σ i.succ) 0 / S r 0 * S r j.succ) := by ring
          rw [heq, abs_neg, abs_mul]
          have h2 : |S r j.succ| ≤ M := hOffCol r j.succ (by omega)
          calc |S (σ i.succ) 0 / S r 0| * |S r j.succ| ≤ 1 * M :=
                mul_le_mul (hmul _) h2 (abs_nonneg _) zero_le_one
            _ = M := one_mul M

/-- **Theorem 9.11 (`p = 1`)**, trace-level tridiagonal GEPP entry bound:
along any explicit recursive partial-pivoting trace whose input satisfies the
band-tracked tridiagonal bound, every final upper-factor entry is bounded by
`2M`. -/
theorem higham9_11_tridiag_PartialPivotGEPPUTrace_entry_abs_le_two_mul :
    ∀ {n : ℕ} {A U : Fin n → Fin n → ℝ},
      higham9_7_PartialPivotGEPPUTrace n A U →
      ∀ M : ℝ, 0 ≤ M →
        higham9_11_TridiagActiveBound n M A →
        ∀ i j : Fin n, |U i j| ≤ 2 * M := by
  intro n A U htrace
  induction htrace with
  | done =>
      intro M hM hA i j
      exact Fin.elim0 i
  | step hchoice hpivot _hnext ih =>
      rename_i m A r U₁
      intro M hM hA i j
      by_cases hi : i = 0
      · subst hi
        have hrow := higham9_11_tridiagActive_row_abs_le_two_mul hM hA r j
        simpa [luFirstStepU, higham9_2_rowPermutedMatrix,
          higham9_7_firstPivotRowSwap] using hrow
      · by_cases hj : j = 0
        · subst hj
          have hzero : luFirstStepU
              (higham9_2_rowPermutedMatrix A (higham9_7_firstPivotRowSwap r))
              U₁ i 0 = 0 := by
            simp [luFirstStepU, hi]
          rw [hzero]
          simp only [abs_zero]
          linarith
        · have hA' := higham9_11_tridiagActive_schur_preserved hM hA
            hchoice hpivot
          have hrec := ih M hM hA' (i.pred hi) (j.pred hj)
          simpa [luFirstStepU, hi, hj] using hrec

/-- **Theorem 9.11 (`p = 1`)** (Higham, 2nd ed., §9.5, Theorem 9.11 with
`p = 1`, pdf p. 17), tridiagonal GEPP entry bound: for a tridiagonal matrix,
every entry of the exact partial-pivoting upper factor is bounded by twice the
max-entry norm of `A`. -/
theorem higham9_11_tridiag_GEPPUTrace_entry_abs_le_two_mul {n : ℕ}
    (hn : 0 < n) (A U : Fin n → Fin n → ℝ)
    (hA_tridiag : IsTridiagonal n A)
    (htrace : higham9_7_PartialPivotGEPPUTrace n A U)
    (i j : Fin n) :
    |U i j| ≤ 2 * maxEntryNorm hn A := by
  apply higham9_11_tridiag_PartialPivotGEPPUTrace_entry_abs_le_two_mul htrace
    (maxEntryNorm hn A) (maxEntryNorm_nonneg hn A) ?_ i j
  refine ⟨hA_tridiag, ?_, ?_⟩
  · intro a b _ _
    have h := entry_le_maxEntryNorm hn A a b
    have h0 := maxEntryNorm_nonneg hn A
    linarith
  · intro a b _
    exact entry_le_maxEntryNorm hn A a b

/-- **Theorem 9.11 (`p = 1`)** (Higham, 2nd ed., §9.5, Theorem 9.11 with
`p = 1`, pdf p. 17), the tridiagonal GEPP growth-factor bound `rho <= 2`:
Gaussian elimination with partial pivoting on a tridiagonal matrix has
max-entry growth factor at most `2`.  This discharges the Bohte `p = 1`
growth constant unconditionally at the exact-trace level. -/
theorem higham9_11_tridiag_GEPPUTrace_growthFactorEntry_le_two {n : ℕ}
    (hn : 0 < n) (A U : Fin n → Fin n → ℝ)
    (hAmax : 0 < maxEntryNorm hn A)
    (hA_tridiag : IsTridiagonal n A)
    (htrace : higham9_7_PartialPivotGEPPUTrace n A U) :
    growthFactorEntry hn A U hAmax ≤ 2 := by
  apply growthFactorEntry_le_of_entry_bound_factor hn A U 2 hAmax
  exact higham9_11_tridiag_GEPPUTrace_entry_abs_le_two_mul hn A U
    hA_tridiag htrace

/-- **Theorem 9.11 (`p = 1`)**, the tridiagonal GEPP growth bound stated with
the Bohte scalar: `rho <= higham9_11_bohteBound 1`.  This closes the `p = 1`
case of the Theorem 9.11 growth constant from first principles. -/
theorem higham9_11_tridiag_GEPPUTrace_growthFactorEntry_le_bohteBound {n : ℕ}
    (hn : 0 < n) (A U : Fin n → Fin n → ℝ)
    (hAmax : 0 < maxEntryNorm hn A)
    (hA_tridiag : IsTridiagonal n A)
    (htrace : higham9_7_PartialPivotGEPPUTrace n A U) :
    growthFactorEntry hn A U hAmax ≤ higham9_11_bohteBound 1 := by
  rw [higham9_11_bohteBound_tridiagonal]
  exact higham9_11_tridiag_GEPPUTrace_growthFactorEntry_le_two hn A U hAmax
    hA_tridiag htrace

/-- **Theorem 9.11 (`p = 1`) / Theorem 9.5 endpoint**, tridiagonal GEPP
Wilkinson-style solve bound with the proved growth constant `2`: the computed
solution of a tridiagonal system via a partial-pivoting trace satisfies the
source normwise backward-error bound with `rho = 2`. -/
theorem higham9_11_tridiag_wilkinson_source_bound_of_PartialPivotGEPPUTrace
    (fp : FPModel) (n : ℕ) (hn_pos : 0 < n)
    (A L_hat U_hat : Fin n → Fin n → ℝ) (b : Fin n → ℝ)
    (hAmax : 0 < maxEntryNorm hn_pos A)
    (hA_tridiag : IsTridiagonal n A)
    (htrace : higham9_7_PartialPivotGEPPUTrace n A U_hat)
    (hL_diag : ∀ i : Fin n, L_hat i i ≠ 0)
    (hU_diag : ∀ i : Fin n, U_hat i i ≠ 0)
    (hLU : LUBackwardError n A L_hat U_hat (gamma fp n))
    (hn : gammaValid fp n) (hn3 : gammaValid fp (3 * n))
    (hL_bound : ∀ i j : Fin n, |L_hat i j| ≤ 1) :
    let y_hat := fl_forwardSub fp n L_hat b
    let x_hat := fl_backSub fp n U_hat y_hat
    ∃ ΔA : Fin n → Fin n → ℝ,
      (infNorm ΔA ≤ (↑n) ^ 2 * gamma fp (3 * n) * 2 * infNorm A) ∧
      (∀ i, ∑ j : Fin n, (A i j + ΔA i j) * x_hat j = b i) :=
  higham9_5_wilkinson_source_bound_of_entry_growth fp n hn_pos A L_hat U_hat
    b 2 hAmax (by norm_num)
    (higham9_11_tridiag_GEPPUTrace_growthFactorEntry_le_two hn_pos A U_hat
      hAmax hA_tridiag htrace)
    hL_diag hU_diag hLU hn hn3 hL_bound


/-! ## Equation (9.16) / Foster eq. (10): sorted nested pivot constraints -/

/-- **Equation (9.16) / Foster support**, every real tuple admits an
antitone (descending) enumeration by a permutation. -/
theorem higham9_16_exists_antitone_enumeration {n : ℕ} (p : Fin n → ℝ) :
    ∃ σ : Equiv.Perm (Fin n), Antitone (fun i => p (σ i)) := by
  refine ⟨Fin.revPerm.trans (Tuple.sort p), ?_⟩
  intro i j hij
  have hrev : Fin.rev j ≤ Fin.rev i := Fin.rev_le_rev.mpr hij
  have hmono := Tuple.monotone_sort p hrev
  simpa [Equiv.trans_apply, Fin.revPerm_apply, Function.comp] using hmono

/-- **Equation (9.16) / Foster support**, the index set of the first `h`
positions of `Fin n` has cardinality `h` whenever `h ≤ n`. -/
lemma higham9_16_card_filter_val_lt {n h : ℕ} (hh : h ≤ n) :
    (Finset.univ.filter (fun i : Fin n => i.val < h)).card = h := by
  classical
  have hmem : ∀ m ∈ Finset.range h, m < n := fun m hm =>
    lt_of_lt_of_le (Finset.mem_range.mp hm) hh
  have hset : Finset.univ.filter (fun i : Fin n => i.val < h) =
      (Finset.range h).attachFin hmem := by
    ext a
    simp [Finset.mem_attachFin, Finset.mem_range]
  rw [hset, Finset.card_attachFin, Finset.card_range]

/-- **Equation (9.16) / Foster's eq. (10)** (Foster [435, 1997], §3; Higham,
2nd ed., §9.4, eq. (9.16) support), nested subset-Hadamard pivot constraints:
for a rook LU factorization normalized to `max |a_ij| <= 1` and any
enumeration `σ` of the indices, the product of the first `h` enumerated pivot
magnitudes is bounded by `sqrt(h^h) * (1 + sum of the remaining pivot
magnitudes)^h`.  Instantiating `σ` with a descending enumeration gives
Foster's constraints (10), the exact input of his Lemma 2 optimization. -/
theorem higham9_16_foster_nested_constraints {n : ℕ}
    (A L U : Matrix (Fin n) (Fin n) ℝ)
    (hLU : L * U = A)
    (hL_diag : ∀ i : Fin n, L i i = 1)
    (hL_upper : ∀ i j : Fin n, i.val < j.val → L i j = 0)
    (hU_lower : ∀ i j : Fin n, j.val < i.val → U i j = 0)
    (hAmax : ∀ i j : Fin n, |A i j| ≤ 1)
    (hL1 : ∀ i j : Fin n, |L i j| ≤ 1)
    (hUrook : ∀ i j : Fin n, |U i j| ≤ |U i i|)
    (σ : Equiv.Perm (Fin n))
    (h : ℕ) (hh : h ≤ n) :
    ∏ i ∈ Finset.univ.filter (fun i : Fin n => i.val < h),
        |U (σ i) (σ i)| ≤
      Real.sqrt ((h : ℝ) ^ h) *
        (1 + ∑ i ∈ Finset.univ.filter (fun i : Fin n => ¬ i.val < h),
          |U (σ i) (σ i)|) ^ h := by
  classical
  set F : Finset (Fin n) := Finset.univ.filter (fun i : Fin n => i.val < h)
    with hF
  set I : Finset (Fin n) := F.image σ with hI
  have hcardF : F.card = h := higham9_16_card_filter_val_lt hh
  have hcardI : I.card = h := by
    rw [hI, Finset.card_image_of_injective F σ.injective, hcardF]
  have hcompl : Iᶜ = Fᶜ.image σ := by
    ext x
    constructor
    · intro hx
      have hx' : x ∉ I := Finset.mem_compl.mp hx
      refine Finset.mem_image.mpr ⟨σ.symm x, ?_, by simp⟩
      refine Finset.mem_compl.mpr ?_
      intro hmem
      exact hx' (hI ▸ Finset.mem_image.mpr ⟨σ.symm x, hmem, by simp⟩)
    · intro hx
      obtain ⟨y, hy, rfl⟩ := Finset.mem_image.mp hx
      refine Finset.mem_compl.mpr ?_
      intro hmem
      obtain ⟨z, hz, hzy⟩ := Finset.mem_image.mp (hI ▸ hmem)
      have hzy' : z = y := σ.injective hzy
      subst hzy'
      exact Finset.mem_compl.mp hy hz
  have hmain := higham9_16_foster_subset_hadamard A L U hLU hL_diag hL_upper
    hU_lower hAmax hL1 hUrook I
  rw [hcardI] at hmain
  have hprod : ∏ i ∈ I, |U i i| = ∏ i ∈ F, |U (σ i) (σ i)| := by
    rw [hI]
    exact Finset.prod_image (fun x _ y _ hxy => σ.injective hxy)
  have hsum : ∑ j ∈ Iᶜ, |U j j| = ∑ i ∈ Fᶜ, |U (σ i) (σ i)| := by
    rw [hcompl]
    exact Finset.sum_image (fun x _ y _ hxy => σ.injective hxy)
  have hcomplF : Fᶜ = Finset.univ.filter (fun i : Fin n => ¬ i.val < h) := by
    ext x
    simp [hF]
  rw [hprod, hsum, hcomplF] at hmain
  exact hmain

/-- **Equation (9.16) / Foster's eq. (10)**, sorted form: the pivot
magnitudes of a normalized rook LU factorization admit a descending
enumeration whose nested products satisfy Foster's constraints (10). -/
theorem higham9_16_foster_sorted_constraints {n : ℕ}
    (A L U : Matrix (Fin n) (Fin n) ℝ)
    (hLU : L * U = A)
    (hL_diag : ∀ i : Fin n, L i i = 1)
    (hL_upper : ∀ i j : Fin n, i.val < j.val → L i j = 0)
    (hU_lower : ∀ i j : Fin n, j.val < i.val → U i j = 0)
    (hAmax : ∀ i j : Fin n, |A i j| ≤ 1)
    (hL1 : ∀ i j : Fin n, |L i j| ≤ 1)
    (hUrook : ∀ i j : Fin n, |U i j| ≤ |U i i|) :
    ∃ q : Fin n → ℝ,
      Antitone q ∧
      (∀ i : Fin n, 0 ≤ q i) ∧
      (∃ σ : Equiv.Perm (Fin n), ∀ i : Fin n, q i = |U (σ i) (σ i)|) ∧
      ∀ h : ℕ, h ≤ n →
        ∏ i ∈ Finset.univ.filter (fun i : Fin n => i.val < h), q i ≤
          Real.sqrt ((h : ℝ) ^ h) *
            (1 + ∑ i ∈ Finset.univ.filter (fun i : Fin n => ¬ i.val < h),
              q i) ^ h := by
  classical
  obtain ⟨σ, hσ⟩ :=
    higham9_16_exists_antitone_enumeration (fun i : Fin n => |U i i|)
  refine ⟨fun i => |U (σ i) (σ i)|, hσ, fun i => abs_nonneg _,
    ⟨σ, fun i => rfl⟩, ?_⟩
  intro h hh
  exact higham9_16_foster_nested_constraints A L U hLU hL_diag hL_upper
    hU_lower hAmax hL1 hUrook σ h hh


/-! ## Equation (9.16) / Foster's implicit stage roots `s_k` and bound `t_n` -/

/-- **Equation (9.16) / Foster eq. (6) support**, the stage function
`s ↦ s * (1 + s)^(k-1)`. -/
noncomputable def higham9_16_fosterStage (k : ℕ) (s : ℝ) : ℝ :=
  s * (1 + s) ^ (k - 1)

/-- **Equation (9.16) / Foster eq. (6) support**, the stage constant
`C_k = sqrt(k^k) / sqrt((k-1)^(k-1))`. -/
noncomputable def higham9_16_fosterStageConst (k : ℕ) : ℝ :=
  Real.sqrt ((k : ℝ) ^ k) / Real.sqrt (((k - 1 : ℕ) : ℝ) ^ (k - 1))

lemma higham9_16_fosterStageConst_one : higham9_16_fosterStageConst 1 = 1 := by
  unfold higham9_16_fosterStageConst
  norm_num

lemma higham9_16_fosterStageConst_pos {k : ℕ} (hk : 1 ≤ k) :
    0 < higham9_16_fosterStageConst k := by
  unfold higham9_16_fosterStageConst
  apply div_pos
  · apply Real.sqrt_pos.mpr
    have : (0 : ℝ) < (k : ℝ) := by exact_mod_cast hk
    positivity
  · apply Real.sqrt_pos.mpr
    rcases Nat.eq_zero_or_pos (k - 1) with h0 | hpos
    · rw [h0]
      norm_num
    · have : (0 : ℝ) < ((k - 1 : ℕ) : ℝ) := by exact_mod_cast hpos
      positivity

/-- The stage function is continuous in `s`. -/
lemma higham9_16_fosterStage_continuous (k : ℕ) :
    Continuous (higham9_16_fosterStage k) := by
  unfold higham9_16_fosterStage
  fun_prop

/-- The stage function is strictly monotone on `[0, ∞)`. -/
lemma higham9_16_fosterStage_strictMonoOn (k : ℕ) :
    StrictMonoOn (higham9_16_fosterStage k) (Set.Ici (0 : ℝ)) := by
  intro a ha b hb hab
  simp only [Set.mem_Ici] at ha hb
  unfold higham9_16_fosterStage
  have hpow : (1 + a) ^ (k - 1) ≤ (1 + b) ^ (k - 1) := by
    apply pow_le_pow_left₀ (by linarith) (by linarith)
  have hpow_pos : (0 : ℝ) < (1 + a) ^ (k - 1) := by positivity
  rcases eq_or_lt_of_le ha with rfl | hapos
  · calc (0 : ℝ) * (1 + 0) ^ (k - 1) = 0 := by ring
      _ < b * (1 + b) ^ (k - 1) := by positivity
  · calc a * (1 + a) ^ (k - 1) < b * (1 + a) ^ (k - 1) := by
          exact mul_lt_mul_of_pos_right hab hpow_pos
      _ ≤ b * (1 + b) ^ (k - 1) := by
          apply mul_le_mul_of_nonneg_left hpow (by linarith)

/-- The stage function dominates its argument on `[0, ∞)`. -/
lemma higham9_16_fosterStage_ge_self {k : ℕ} {s : ℝ} (hs : 0 ≤ s) :
    s ≤ higham9_16_fosterStage k s := by
  unfold higham9_16_fosterStage
  have hpow : (1 : ℝ) ≤ (1 + s) ^ (k - 1) :=
    one_le_pow₀ (by linarith)
  calc s = s * 1 := by ring
    _ ≤ s * (1 + s) ^ (k - 1) := mul_le_mul_of_nonneg_left hpow hs

/-- **Equation (9.16) / Foster eq. (6)**, existence and uniqueness of the
positive stage root `s_k`: the unique nonnegative solution of
`s (1+s)^(k-1) = C_k`. -/
theorem higham9_16_existsUnique_fosterStage_root (k : ℕ) (hk : 1 ≤ k) :
    ∃! s : ℝ, 0 ≤ s ∧
      higham9_16_fosterStage k s = higham9_16_fosterStageConst k := by
  have hC := higham9_16_fosterStageConst_pos hk
  set C := higham9_16_fosterStageConst k with hCdef
  -- existence via the intermediate value theorem on [0, C]
  have hcont : ContinuousOn (higham9_16_fosterStage k) (Set.Icc 0 C) :=
    (higham9_16_fosterStage_continuous k).continuousOn
  have hf0 : higham9_16_fosterStage k 0 = 0 := by
    unfold higham9_16_fosterStage
    ring
  have hfC : C ≤ higham9_16_fosterStage k C :=
    higham9_16_fosterStage_ge_self (le_of_lt hC)
  have hmem : C ∈ Set.Icc (higham9_16_fosterStage k 0)
      (higham9_16_fosterStage k C) := by
    constructor
    · rw [hf0]
      exact le_of_lt hC
    · exact hfC
  obtain ⟨s, hs_mem, hs_eq⟩ :=
    intermediate_value_Icc (le_of_lt hC) hcont hmem
  refine ⟨s, ⟨hs_mem.1, hs_eq⟩, ?_⟩
  intro t ⟨ht0, ht_eq⟩
  have hs0 : (0 : ℝ) ≤ s := hs_mem.1
  by_contra hne
  rcases lt_or_gt_of_ne hne with hlt | hgt
  · have := higham9_16_fosterStage_strictMonoOn k
      (Set.mem_Ici.mpr ht0) (Set.mem_Ici.mpr hs0) hlt
    rw [ht_eq, hs_eq] at this
    exact lt_irrefl _ this
  · have := higham9_16_fosterStage_strictMonoOn k
      (Set.mem_Ici.mpr hs0) (Set.mem_Ici.mpr ht0) hgt
    rw [ht_eq, hs_eq] at this
    exact lt_irrefl _ this

/-- **Equation (9.16) / Foster eq. (6)**, the implicit stage root `s_k`
(defined as `1` in the vacuous case `k = 0`). -/
noncomputable def higham9_16_fosterS (k : ℕ) : ℝ :=
  if hk : 1 ≤ k then
    (higham9_16_existsUnique_fosterStage_root k hk).choose
  else 1

lemma higham9_16_fosterS_spec {k : ℕ} (hk : 1 ≤ k) :
    0 ≤ higham9_16_fosterS k ∧
      higham9_16_fosterStage k (higham9_16_fosterS k) =
        higham9_16_fosterStageConst k := by
  unfold higham9_16_fosterS
  rw [dif_pos hk]
  exact (higham9_16_existsUnique_fosterStage_root k hk).choose_spec.1

lemma higham9_16_fosterS_nonneg {k : ℕ} (hk : 1 ≤ k) :
    0 ≤ higham9_16_fosterS k :=
  (higham9_16_fosterS_spec hk).1

lemma higham9_16_fosterS_eq (k : ℕ) (hk : 1 ≤ k) :
    higham9_16_fosterS k *
        (1 + higham9_16_fosterS k) ^ (k - 1) =
      higham9_16_fosterStageConst k :=
  (higham9_16_fosterS_spec hk).2

/-- Uniqueness: any nonnegative solution of the stage equation is `s_k`. -/
lemma higham9_16_fosterS_unique {k : ℕ} (hk : 1 ≤ k) {t : ℝ}
    (ht0 : 0 ≤ t)
    (ht : higham9_16_fosterStage k t = higham9_16_fosterStageConst k) :
    t = higham9_16_fosterS k := by
  have hspec := higham9_16_fosterS_spec hk
  unfold higham9_16_fosterS at hspec ⊢
  rw [dif_pos hk] at hspec ⊢
  exact (higham9_16_existsUnique_fosterStage_root k hk).choose_spec.2 t
    ⟨ht0, ht⟩

/-- `s_k` is strictly positive. -/
lemma higham9_16_fosterS_pos {k : ℕ} (hk : 1 ≤ k) :
    0 < higham9_16_fosterS k := by
  rcases eq_or_lt_of_le (higham9_16_fosterS_nonneg hk) with h0 | hpos
  · exfalso
    have heq := higham9_16_fosterS_eq k hk
    rw [← h0] at heq
    have : higham9_16_fosterStageConst k = 0 := by
      rw [← heq]
      ring
    exact absurd this (ne_of_gt (higham9_16_fosterStageConst_pos hk))
  · exact hpos

/-- **Foster eq. (6)**, the first stage root is `s_1 = 1`. -/
lemma higham9_16_fosterS_one : higham9_16_fosterS 1 = 1 := by
  have h := higham9_16_fosterS_unique (k := 1) le_rfl (t := 1)
    (by norm_num)
    (by
      unfold higham9_16_fosterStage
      rw [higham9_16_fosterStageConst_one]
      norm_num)
  exact h.symm

/-- **Equation (9.16) / Foster eq. (7)**, the rook-pivoting growth bound
`t_n = s_1 (1+s_2) ⋯ (1+s_n)`. -/
noncomputable def higham9_16_fosterT (n : ℕ) : ℝ :=
  higham9_16_fosterS 1 * ∏ k ∈ Finset.Icc 2 n, (1 + higham9_16_fosterS k)

lemma higham9_16_fosterT_one : higham9_16_fosterT 1 = 1 := by
  unfold higham9_16_fosterT
  rw [higham9_16_fosterS_one]
  norm_num

lemma higham9_16_fosterT_pos (n : ℕ) :
    0 < higham9_16_fosterT n := by
  unfold higham9_16_fosterT
  apply mul_pos
  · rw [higham9_16_fosterS_one]
    norm_num
  · apply Finset.prod_pos
    intro k hk
    have hk1 : 1 ≤ k := le_trans (by norm_num) (Finset.mem_Icc.mp hk).1
    have := higham9_16_fosterS_pos hk1
    linarith

/-- `t` satisfies the recurrence `t_(n+1) = t_n * (1 + s_(n+1))` for
`n ≥ 1`. -/
lemma higham9_16_fosterT_succ {n : ℕ} (hn : 1 ≤ n) :
    higham9_16_fosterT (n + 1) =
      higham9_16_fosterT n * (1 + higham9_16_fosterS (n + 1)) := by
  unfold higham9_16_fosterT
  rw [mul_assoc]
  congr 1
  rw [← Finset.prod_Icc_succ_top (by omega : 2 ≤ n + 1)]


/-! ## Equation (9.16) / Foster Lemma A.1: ordering of the stage roots -/

/-- `sqrt` commutes with natural powers of nonnegative reals. -/
lemma higham9_16_sqrt_pow {x : ℝ} (hx : 0 ≤ x) (k : ℕ) :
    Real.sqrt (x ^ k) = Real.sqrt x ^ k := by
  have hs : ((Real.sqrt x) ^ k) ^ 2 = x ^ k := by
    rw [← pow_mul, mul_comm, pow_mul, Real.sq_sqrt hx]
  calc Real.sqrt (x ^ k) = Real.sqrt (((Real.sqrt x) ^ k) ^ 2) := by rw [hs]
    _ = (Real.sqrt x) ^ k :=
        Real.sqrt_sq (pow_nonneg (Real.sqrt_nonneg x) k)

/-- **Foster Lemma 2 support**, telescoping product of the stage constants:
`C_1 C_2 ⋯ C_n = sqrt(n^n)`. -/
lemma higham9_16_prod_fosterStageConst (n : ℕ) :
    ∏ k ∈ Finset.Icc 1 n, higham9_16_fosterStageConst k =
      Real.sqrt ((n : ℝ) ^ n) := by
  induction n with
  | zero => simp
  | succ n ih =>
      rw [Finset.prod_Icc_succ_top (by omega : 1 ≤ n + 1), ih]
      unfold higham9_16_fosterStageConst
      simp only [Nat.add_sub_cancel]
      have hne : Real.sqrt ((n : ℝ) ^ n) ≠ 0 := by
        apply ne_of_gt
        apply Real.sqrt_pos.mpr
        rcases Nat.eq_zero_or_pos n with rfl | hn
        · norm_num
        · have : (0 : ℝ) < (n : ℝ) := by exact_mod_cast hn
          positivity
      rw [mul_comm, div_mul_cancel₀ _ hne]

/-- **Foster Lemma A.1 (first part)**, the stage root is below `sqrt k` for
`k ≥ 2`. -/
lemma higham9_16_fosterS_lt_sqrt {k : ℕ} (hk : 2 ≤ k) :
    higham9_16_fosterS k < Real.sqrt k := by
  have hk1 : 1 ≤ k := by omega
  have hsq_pos : (0 : ℝ) < Real.sqrt k := by
    apply Real.sqrt_pos.mpr
    exact_mod_cast Nat.lt_of_lt_of_le (by norm_num) hk
  -- `C_k < fosterStage k (sqrt k)`
  have hCk_lt : higham9_16_fosterStageConst k <
      higham9_16_fosterStage k (Real.sqrt k) := by
    have hden_ge_one : (1 : ℝ) ≤ Real.sqrt (((k - 1 : ℕ) : ℝ) ^ (k - 1)) := by
      rw [show (1 : ℝ) = Real.sqrt 1 from (Real.sqrt_one).symm]
      apply Real.sqrt_le_sqrt
      apply one_le_pow₀
      have : (1 : ℕ) ≤ k - 1 := by omega
      exact_mod_cast this
    have hnum : Real.sqrt ((k : ℝ) ^ k) =
        Real.sqrt k * Real.sqrt k ^ (k - 1) := by
      rw [higham9_16_sqrt_pow (Nat.cast_nonneg k) k]
      calc Real.sqrt k ^ k = Real.sqrt k ^ (1 + (k - 1)) := by
            congr 1
            omega
        _ = Real.sqrt k * Real.sqrt k ^ (k - 1) := by
            rw [pow_add, pow_one]
    have hstep1 : higham9_16_fosterStageConst k ≤
        Real.sqrt k * Real.sqrt k ^ (k - 1) := by
      unfold higham9_16_fosterStageConst
      rw [hnum]
      apply div_le_self ?_ hden_ge_one
      positivity
    have hstep2 : Real.sqrt k * Real.sqrt k ^ (k - 1) <
        Real.sqrt k * (1 + Real.sqrt k) ^ (k - 1) := by
      apply mul_lt_mul_of_pos_left ?_ hsq_pos
      apply pow_lt_pow_left₀ (by linarith) (Real.sqrt_nonneg k)
      omega
    unfold higham9_16_fosterStage
    calc higham9_16_fosterStageConst k
        ≤ Real.sqrt k * Real.sqrt k ^ (k - 1) := hstep1
      _ < Real.sqrt k * (1 + Real.sqrt k) ^ (k - 1) := hstep2
  by_contra hle
  push_neg at hle
  have hmono := higham9_16_fosterStage_strictMonoOn k
  have hs0 : 0 ≤ higham9_16_fosterS k := higham9_16_fosterS_nonneg hk1
  rcases eq_or_lt_of_le hle with heq | hlt
  · rw [heq, (higham9_16_fosterS_spec hk1).2] at hCk_lt
    exact lt_irrefl _ hCk_lt
  · have hmono_lt := hmono (Set.mem_Ici.mpr (le_of_lt hsq_pos))
      (Set.mem_Ici.mpr hs0) hlt
    rw [(higham9_16_fosterS_spec hk1).2] at hmono_lt
    exact lt_irrefl _ (hCk_lt.trans hmono_lt)

/-- **Foster Lemma A.1 support**, `1 + s_k > sqrt (k / (k-1))` for `k ≥ 2`. -/
lemma higham9_16_sqrt_ratio_lt_one_add_fosterS {k : ℕ} (hk : 2 ≤ k) :
    Real.sqrt ((k : ℝ) / ((k : ℝ) - 1)) < 1 + higham9_16_fosterS k := by
  have hk1 : 1 ≤ k := by omega
  have hkR : (2 : ℝ) ≤ (k : ℝ) := by exact_mod_cast hk
  have hk1R : (0 : ℝ) < (k : ℝ) - 1 := by linarith
  have hs_pos := higham9_16_fosterS_pos hk1
  have hone_add_pos : (0 : ℝ) < 1 + higham9_16_fosterS k := by linarith
  -- from `s_k < sqrt k`: `C_k < sqrt k * (1 + s_k)^(k-1)`
  have hC_lt : higham9_16_fosterStageConst k <
      Real.sqrt k * (1 + higham9_16_fosterS k) ^ (k - 1) := by
    calc higham9_16_fosterStageConst k
        = higham9_16_fosterS k * (1 + higham9_16_fosterS k) ^ (k - 1) :=
          (higham9_16_fosterS_eq k hk1).symm
      _ < Real.sqrt k * (1 + higham9_16_fosterS k) ^ (k - 1) := by
          apply mul_lt_mul_of_pos_right (higham9_16_fosterS_lt_sqrt hk)
          positivity
  -- rewrite `C_k / sqrt k` as the `(k-1)`-power of the sqrt ratio
  have hcast : ((k - 1 : ℕ) : ℝ) = (k : ℝ) - 1 := by
    have : (1 : ℕ) ≤ k := hk1
    push_cast [Nat.cast_sub this]
    ring
  have hratio_pow : (Real.sqrt ((k : ℝ) / ((k : ℝ) - 1))) ^ (k - 1) <
      (1 + higham9_16_fosterS k) ^ (k - 1) := by
    have hsqrtk_pos : (0 : ℝ) < Real.sqrt k := by
      apply Real.sqrt_pos.mpr
      linarith
    -- `C_k = sqrt k * sqrt(k/(k-1))^(k-1) / 1`? — direct algebraic identity:
    -- `C_k = sqrt(k^k)/sqrt((k-1)^(k-1)) = sqrt k * (sqrt(k/(k-1)))^(k-1)`
    have hC_eq : higham9_16_fosterStageConst k =
        Real.sqrt k * (Real.sqrt ((k : ℝ) / ((k : ℝ) - 1))) ^ (k - 1) := by
      unfold higham9_16_fosterStageConst
      rw [hcast]
      rw [Real.sqrt_div (by linarith : (0:ℝ) ≤ (k:ℝ)) ((k:ℝ) - 1)]
      rw [div_pow]
      rw [higham9_16_sqrt_pow (by linarith : (0:ℝ) ≤ (k:ℝ)) k]
      rw [higham9_16_sqrt_pow (by linarith : (0:ℝ) ≤ (k:ℝ) - 1) (k-1)]
      rw [← mul_div_assoc]
      congr 1
      calc Real.sqrt ((k : ℝ)) ^ k
          = Real.sqrt ((k : ℝ)) ^ (1 + (k - 1)) := by
            congr 1
            omega
        _ = Real.sqrt ((k : ℝ)) * Real.sqrt ((k : ℝ)) ^ (k - 1) := by
            rw [pow_add, pow_one]
    rw [hC_eq] at hC_lt
    exact lt_of_mul_lt_mul_left hC_lt (le_of_lt hsqrtk_pos)
  have hbase_nonneg : (0 : ℝ) ≤ Real.sqrt ((k : ℝ) / ((k : ℝ) - 1)) :=
    Real.sqrt_nonneg _
  exact lt_of_pow_lt_pow_left₀ (k - 1) (le_of_lt hone_add_pos) hratio_pow

/-- **Foster Lemma A.1 support**, the Bernoulli-type integer inequality
`(k+1)^(k+1) (k-1)^k < k^(2k+1)` for `k ≥ 2` (real form). -/
lemma higham9_16_bernoulli_pow_ratio {k : ℕ} (hk : 2 ≤ k) :
    ((k : ℝ) + 1) ^ (k + 1) * ((k : ℝ) - 1) ^ k < (k : ℝ) ^ (2 * k + 1) := by
  have hkR : (2 : ℝ) ≤ (k : ℝ) := by exact_mod_cast hk
  have hkpos : (0 : ℝ) < (k : ℝ) := by linarith
  have hden_pos : (0 : ℝ) < (k : ℝ) ^ 2 - 1 := by nlinarith
  have ha_nonneg : (0 : ℝ) ≤ 1 / ((k : ℝ) ^ 2 - 1) := by positivity
  -- Bernoulli: `(1 + a)^k ≥ 1 + k a` with `a = 1/(k²-1)`
  have hbern := one_add_mul_le_pow
    (by linarith : (-2 : ℝ) ≤ 1 / ((k : ℝ) ^ 2 - 1)) k
  have hbase_eq : 1 + 1 / ((k : ℝ) ^ 2 - 1) =
      (k : ℝ) ^ 2 / ((k : ℝ) ^ 2 - 1) := by
    field_simp
    try ring
  -- `1 + k/(k²-1) > (k+1)/k`
  have hstep : ((k : ℝ) + 1) / (k : ℝ) <
      1 + (k : ℝ) * (1 / ((k : ℝ) ^ 2 - 1)) := by
    rw [div_lt_iff₀ hkpos]
    have hexpand : (1 + (k : ℝ) * (1 / ((k : ℝ) ^ 2 - 1))) * (k : ℝ) =
        (k : ℝ) + (k : ℝ) ^ 2 / ((k : ℝ) ^ 2 - 1) := by
      field_simp
      try ring
    rw [hexpand]
    have hlast : (1 : ℝ) < (k : ℝ) ^ 2 / ((k : ℝ) ^ 2 - 1) := by
      rw [lt_div_iff₀ hden_pos]
      linarith
    linarith
  have hpow_gt : ((k : ℝ) + 1) / (k : ℝ) <
      ((k : ℝ) ^ 2 / ((k : ℝ) ^ 2 - 1)) ^ k := by
    calc ((k : ℝ) + 1) / (k : ℝ)
        < 1 + (k : ℝ) * (1 / ((k : ℝ) ^ 2 - 1)) := hstep
      _ ≤ (1 + 1 / ((k : ℝ) ^ 2 - 1)) ^ k := hbern
      _ = ((k : ℝ) ^ 2 / ((k : ℝ) ^ 2 - 1)) ^ k := by rw [hbase_eq]
  -- cross-multiply
  have hpow_den_pos : (0 : ℝ) < ((k : ℝ) ^ 2 - 1) ^ k := by positivity
  rw [div_pow, div_lt_div_iff₀ hkpos hpow_den_pos] at hpow_gt
  have hfactor : ((k : ℝ) ^ 2 - 1) ^ k =
      ((k : ℝ) + 1) ^ k * ((k : ℝ) - 1) ^ k := by
    rw [← mul_pow]
    congr 1
    ring
  rw [hfactor] at hpow_gt
  calc ((k : ℝ) + 1) ^ (k + 1) * ((k : ℝ) - 1) ^ k
      = ((k : ℝ) + 1) * (((k : ℝ) + 1) ^ k * ((k : ℝ) - 1) ^ k) := by ring
    _ < ((k : ℝ) ^ 2) ^ k * (k : ℝ) := hpow_gt
    _ = (k : ℝ) ^ (2 * k + 1) := by
        rw [← pow_mul, ← pow_succ]

/-- **Foster Lemma A.1 support**, the stage-constant ratio bound
`C_(k+1) ≤ sqrt(k/(k-1)) * C_k` for `k ≥ 2`. -/
lemma higham9_16_fosterStageConst_succ_le {k : ℕ} (hk : 2 ≤ k) :
    higham9_16_fosterStageConst (k + 1) ≤
      Real.sqrt ((k : ℝ) / ((k : ℝ) - 1)) * higham9_16_fosterStageConst k := by
  have hk1 : 1 ≤ k := by omega
  have hkR : (2 : ℝ) ≤ (k : ℝ) := by exact_mod_cast hk
  have hk1R : (0 : ℝ) < (k : ℝ) - 1 := by linarith
  have hkpos : (0 : ℝ) < (k : ℝ) := by linarith
  have hcast : ((k - 1 : ℕ) : ℝ) = (k : ℝ) - 1 := by
    push_cast [Nat.cast_sub hk1]
    ring
  have hcast2 : ((k + 1 : ℕ) : ℝ) = (k : ℝ) + 1 := by push_cast; ring
  set a := Real.sqrt (k : ℝ) with ha
  set b := Real.sqrt ((k : ℝ) - 1) with hb
  set c := Real.sqrt ((k : ℝ) + 1) with hc
  have hapos : 0 < a := Real.sqrt_pos.mpr hkpos
  have hbpos : 0 < b := Real.sqrt_pos.mpr hk1R
  have hcpos : 0 < c := Real.sqrt_pos.mpr (by linarith)
  have hC1 : higham9_16_fosterStageConst (k + 1) = c ^ (k + 1) / a ^ k := by
    unfold higham9_16_fosterStageConst
    simp only [Nat.add_sub_cancel]
    rw [hcast2]
    rw [higham9_16_sqrt_pow (by linarith : (0:ℝ) ≤ (k:ℝ) + 1) (k + 1)]
    rw [higham9_16_sqrt_pow (le_of_lt hkpos) k]
  have hC2 : higham9_16_fosterStageConst k = a ^ k / b ^ (k - 1) := by
    unfold higham9_16_fosterStageConst
    rw [hcast]
    rw [higham9_16_sqrt_pow (le_of_lt hkpos) k]
    rw [higham9_16_sqrt_pow (le_of_lt hk1R) (k - 1)]
  have hratio : Real.sqrt ((k : ℝ) / ((k : ℝ) - 1)) = a / b :=
    Real.sqrt_div (le_of_lt hkpos) _
  rw [hC1, hC2, hratio]
  -- key: `c^(k+1) b^k ≤ a^(2k+1)` from the Bernoulli inequality
  have hkey : c ^ (k + 1) * b ^ k ≤ a ^ (2 * k + 1) := by
    have e1 : (c ^ (k + 1) * b ^ k) ^ 2 =
        ((k : ℝ) + 1) ^ (k + 1) * ((k : ℝ) - 1) ^ k := by
      rw [mul_pow, ← pow_mul c, ← pow_mul b,
        mul_comm (k + 1) 2, mul_comm k 2, pow_mul c, pow_mul b, hc, hb,
        Real.sq_sqrt (by linarith : (0:ℝ) ≤ (k:ℝ) + 1),
        Real.sq_sqrt (by linarith : (0:ℝ) ≤ (k:ℝ) - 1)]
    have e2 : (a ^ (2 * k + 1)) ^ 2 = (k : ℝ) ^ (2 * k + 1) := by
      rw [← pow_mul a, mul_comm (2 * k + 1) 2, pow_mul a, ha,
        Real.sq_sqrt (le_of_lt hkpos)]
    have hsq : (c ^ (k + 1) * b ^ k) ^ 2 < (a ^ (2 * k + 1)) ^ 2 := by
      rw [e1, e2]
      exact higham9_16_bernoulli_pow_ratio hk
    exact le_of_lt (lt_of_pow_lt_pow_left₀ 2
      (le_of_lt (by positivity : (0:ℝ) < a ^ (2 * k + 1))) hsq)
  have hrhs : a / b * (a ^ k / b ^ (k - 1)) = a ^ (k + 1) / b ^ k := by
    rw [div_mul_div_comm]
    congr 1
    · rw [← pow_succ']
    · rw [← pow_succ']
      congr 1
      omega
  rw [hrhs]
  rw [div_le_div_iff₀ (by positivity) (by positivity)]
  calc c ^ (k + 1) * b ^ k ≤ a ^ (2 * k + 1) := hkey
    _ = a ^ (k + 1) * a ^ k := by
        rw [← pow_add]
        congr 1
        omega

/-- **Foster Lemma A.1 (A.1)**, the stage roots are strictly decreasing from
`k = 2` on: `s_(k+1) < s_k` for `k ≥ 2`. -/
theorem higham9_16_fosterS_succ_lt {k : ℕ} (hk : 2 ≤ k) :
    higham9_16_fosterS (k + 1) < higham9_16_fosterS k := by
  have hk1 : 1 ≤ k := by omega
  have hs_pos := higham9_16_fosterS_pos hk1
  have hs1_pos := higham9_16_fosterS_pos (by omega : 1 ≤ k + 1)
  have hC_pos := higham9_16_fosterStageConst_pos hk1
  -- `fosterStage (k+1) s_k = C_k (1 + s_k) > C_(k+1)`
  have hval : higham9_16_fosterStage (k + 1) (higham9_16_fosterS k) =
      higham9_16_fosterStageConst k * (1 + higham9_16_fosterS k) := by
    unfold higham9_16_fosterStage
    rw [← higham9_16_fosterS_eq k hk1]
    simp only [Nat.add_sub_cancel]
    calc higham9_16_fosterS k * (1 + higham9_16_fosterS k) ^ k
        = higham9_16_fosterS k * ((1 + higham9_16_fosterS k) ^ (k - 1) *
            (1 + higham9_16_fosterS k)) := by
          congr 1
          rw [← pow_succ]
          congr 1
          omega
      _ = higham9_16_fosterS k * (1 + higham9_16_fosterS k) ^ (k - 1) *
            (1 + higham9_16_fosterS k) := by ring
  have hgt : higham9_16_fosterStageConst (k + 1) <
      higham9_16_fosterStage (k + 1) (higham9_16_fosterS k) := by
    rw [hval]
    calc higham9_16_fosterStageConst (k + 1)
        ≤ Real.sqrt ((k : ℝ) / ((k : ℝ) - 1)) *
            higham9_16_fosterStageConst k :=
          higham9_16_fosterStageConst_succ_le hk
      _ < (1 + higham9_16_fosterS k) * higham9_16_fosterStageConst k := by
          apply mul_lt_mul_of_pos_right
            (higham9_16_sqrt_ratio_lt_one_add_fosterS hk) hC_pos
      _ = higham9_16_fosterStageConst k * (1 + higham9_16_fosterS k) := by
          ring
  by_contra hle
  push_neg at hle
  have hmono := higham9_16_fosterStage_strictMonoOn (k + 1)
  rcases eq_or_lt_of_le hle with heq | hlt
  · rw [heq, (higham9_16_fosterS_spec (by omega : 1 ≤ k + 1)).2] at hgt
    exact lt_irrefl _ hgt
  · have hmono_lt := hmono (Set.mem_Ici.mpr (le_of_lt hs_pos))
      (Set.mem_Ici.mpr (le_of_lt hs1_pos)) hlt
    rw [(higham9_16_fosterS_spec (by omega : 1 ≤ k + 1)).2] at hmono_lt
    exact lt_irrefl _ (hgt.trans hmono_lt)

/-- **Foster Lemma A.1**, `s_2 = 1`. -/
lemma higham9_16_fosterS_two : higham9_16_fosterS 2 = 1 := by
  have h := higham9_16_fosterS_unique (k := 2) (by norm_num) (t := 1)
    (by norm_num)
    (by
      unfold higham9_16_fosterStage higham9_16_fosterStageConst
      norm_num
      rw [show (4 : ℝ) = 2 ^ 2 from by norm_num]
      rw [Real.sqrt_sq (by norm_num : (0 : ℝ) ≤ 2)])
  exact h.symm

/-- **Foster Lemma A.1**, all stage roots are at most `1`:
`s_k ≤ 1` for `k ≥ 1`. -/
lemma higham9_16_fosterS_le_one {k : ℕ} (hk : 1 ≤ k) :
    higham9_16_fosterS k ≤ 1 := by
  rcases Nat.lt_or_ge k 2 with h2 | h2
  · have : k = 1 := by omega
    rw [this, higham9_16_fosterS_one]
  · induction k with
    | zero => omega
    | succ n ih =>
        rcases Nat.lt_or_ge n 2 with hn2 | hn2
        · have : n + 1 = 2 := by omega
          rw [this, higham9_16_fosterS_two]
        · have hlt := higham9_16_fosterS_succ_lt hn2
          have hn1 : 1 ≤ n := by omega
          exact le_of_lt (lt_of_lt_of_le hlt (ih hn1 hn2))


/-! ## Equation (9.16) / Foster (A.5): the band roots `q_r` -/

/-- **Foster Lemma A.2 support**, general positive-root existence and
uniqueness for a continuous function strictly monotone on `[0, ∞)` with
`f 0 = 0`, given an explicit witness point above the target value. -/
theorem higham9_16_existsUnique_root {f : ℝ → ℝ} (hcont : Continuous f)
    (hmono : StrictMonoOn f (Set.Ici (0 : ℝ))) (hf0 : f 0 = 0) {C b : ℝ}
    (hC : 0 < C) (hb : 0 ≤ b) (hfb : C ≤ f b) :
    ∃! s : ℝ, 0 ≤ s ∧ f s = C := by
  have hmem : C ∈ Set.Icc (f 0) (f b) := by
    constructor
    · rw [hf0]
      exact le_of_lt hC
    · exact hfb
  obtain ⟨s, hs_mem, hs_eq⟩ :=
    intermediate_value_Icc hb hcont.continuousOn hmem
  refine ⟨s, ⟨hs_mem.1, hs_eq⟩, ?_⟩
  intro t ⟨ht0, ht_eq⟩
  by_contra hne
  rcases lt_or_gt_of_ne hne with hlt | hgt
  · have hmono_lt := hmono (Set.mem_Ici.mpr ht0)
      (Set.mem_Ici.mpr hs_mem.1) hlt
    rw [ht_eq, hs_eq] at hmono_lt
    exact lt_irrefl _ hmono_lt
  · have hmono_lt := hmono (Set.mem_Ici.mpr hs_mem.1)
      (Set.mem_Ici.mpr ht0) hgt
    rw [ht_eq, hs_eq] at hmono_lt
    exact lt_irrefl _ hmono_lt

/-- **Foster (A.5)**, the band-root stage function
`q ↦ sqrt((k-r)^(k-r)) * q^r * (1 + r q)^(k-r)`. -/
noncomputable def higham9_16_fosterQStage (k r : ℕ) (q : ℝ) : ℝ :=
  Real.sqrt (((k - r : ℕ) : ℝ) ^ (k - r)) * q ^ r * (1 + r * q) ^ (k - r)

lemma higham9_16_fosterQStage_continuous (k r : ℕ) :
    Continuous (higham9_16_fosterQStage k r) := by
  unfold higham9_16_fosterQStage
  fun_prop

/-- The leading constant `sqrt((k-r)^(k-r))` is at least one. -/
lemma higham9_16_fosterQStage_sqrt_ge_one (k r : ℕ) :
    (1 : ℝ) ≤ Real.sqrt (((k - r : ℕ) : ℝ) ^ (k - r)) := by
  rw [show (1 : ℝ) = Real.sqrt 1 from Real.sqrt_one.symm]
  apply Real.sqrt_le_sqrt
  rcases Nat.eq_zero_or_pos (k - r) with h0 | hpos
  · rw [h0]
    norm_num
  · apply one_le_pow₀
    exact_mod_cast hpos

lemma higham9_16_fosterQStage_zero {k r : ℕ} (hr : 1 ≤ r) :
    higham9_16_fosterQStage k r 0 = 0 := by
  unfold higham9_16_fosterQStage
  rw [zero_pow (by omega : r ≠ 0)]
  ring

lemma higham9_16_fosterQStage_strictMonoOn (k r : ℕ) (hr : 1 ≤ r) :
    StrictMonoOn (higham9_16_fosterQStage k r) (Set.Ici (0 : ℝ)) := by
  intro a ha b hb hab
  simp only [Set.mem_Ici] at ha hb
  unfold higham9_16_fosterQStage
  have hD : (0 : ℝ) < Real.sqrt (((k - r : ℕ) : ℝ) ^ (k - r)) :=
    lt_of_lt_of_le one_pos (higham9_16_fosterQStage_sqrt_ge_one k r)
  have hbpos : (0 : ℝ) < b := lt_of_le_of_lt ha hab
  rcases eq_or_lt_of_le ha with rfl | hapos
  · rw [zero_pow (by omega : r ≠ 0)]
    rw [mul_zero, zero_mul]
    positivity
  · have h1 : a ^ r < b ^ r := pow_lt_pow_left₀ hab ha (by omega)
    have h2 : (1 + (r : ℝ) * a) ^ (k - r) ≤ (1 + (r : ℝ) * b) ^ (k - r) := by
      apply pow_le_pow_left₀ (by positivity)
      have hra : (r : ℝ) * a ≤ (r : ℝ) * b :=
        mul_le_mul_of_nonneg_left (le_of_lt hab) (Nat.cast_nonneg r)
      linarith
    rw [mul_assoc, mul_assoc]
    apply mul_lt_mul_of_pos_left ?_ hD
    exact mul_lt_mul h1 h2 (by positivity) (by positivity)

/-- A concrete witness point where the band-root stage function reaches any
positive target. -/
lemma higham9_16_fosterQStage_witness (k r : ℕ) (hr : 1 ≤ r) (C : ℝ) :
    C ≤ higham9_16_fosterQStage k r (max 1 C) := by
  set b : ℝ := max 1 C with hbdef
  have hb1 : (1 : ℝ) ≤ b := le_max_left 1 C
  have hbC : C ≤ b := le_max_right 1 C
  have hb0 : (0 : ℝ) ≤ b := by linarith
  unfold higham9_16_fosterQStage
  have h1 : b ≤ b ^ r := le_self_pow₀ hb1 (by omega)
  have h2 : (1 : ℝ) ≤ (1 + (r : ℝ) * b) ^ (k - r) := by
    apply one_le_pow₀
    have : (0 : ℝ) ≤ (r : ℝ) * b := by positivity
    linarith
  have hD := higham9_16_fosterQStage_sqrt_ge_one k r
  calc C ≤ b := hbC
    _ = 1 * b * 1 := by ring
    _ ≤ Real.sqrt (((k - r : ℕ) : ℝ) ^ (k - r)) * b ^ r *
          (1 + (r : ℝ) * b) ^ (k - r) := by
        apply mul_le_mul ?_ h2 (by norm_num) (by positivity)
        apply mul_le_mul hD h1 hb0
        linarith

/-- **Foster (A.5)**, existence and uniqueness of the band root. -/
theorem higham9_16_existsUnique_fosterQ_root (k r : ℕ) (hr : 1 ≤ r) {C : ℝ}
    (hC : 0 < C) :
    ∃! q : ℝ, 0 ≤ q ∧ higham9_16_fosterQStage k r q = C :=
  higham9_16_existsUnique_root (higham9_16_fosterQStage_continuous k r)
    (higham9_16_fosterQStage_strictMonoOn k r hr)
    (higham9_16_fosterQStage_zero hr) hC
    (le_trans zero_le_one (le_max_left 1 C))
    (higham9_16_fosterQStage_witness k r hr C)

/-- **Foster (A.5)**, the band root `q` for stage `r` at constant `C`
(junk value `0` outside `1 ≤ r`, `0 < C`). -/
noncomputable def higham9_16_fosterQ (k r : ℕ) (C : ℝ) : ℝ :=
  if h : 1 ≤ r ∧ 0 < C then
    (higham9_16_existsUnique_fosterQ_root k r h.1 h.2).choose
  else 0

lemma higham9_16_fosterQ_spec {k r : ℕ} (hr : 1 ≤ r) {C : ℝ} (hC : 0 < C) :
    0 ≤ higham9_16_fosterQ k r C ∧
      higham9_16_fosterQStage k r (higham9_16_fosterQ k r C) = C := by
  unfold higham9_16_fosterQ
  rw [dif_pos ⟨hr, hC⟩]
  exact (higham9_16_existsUnique_fosterQ_root k r hr hC).choose_spec.1

lemma higham9_16_fosterQ_nonneg {k r : ℕ} (hr : 1 ≤ r) {C : ℝ}
    (hC : 0 < C) : 0 ≤ higham9_16_fosterQ k r C :=
  (higham9_16_fosterQ_spec hr hC).1

lemma higham9_16_fosterQ_eq {k r : ℕ} (hr : 1 ≤ r) {C : ℝ} (hC : 0 < C) :
    higham9_16_fosterQStage k r (higham9_16_fosterQ k r C) = C :=
  (higham9_16_fosterQ_spec hr hC).2

/-- Uniqueness: any nonnegative solution of the band equation is the band
root. -/
lemma higham9_16_fosterQ_unique {k r : ℕ} (hr : 1 ≤ r) {C : ℝ} (hC : 0 < C)
    {t : ℝ} (ht0 : 0 ≤ t)
    (ht : higham9_16_fosterQStage k r t = C) :
    t = higham9_16_fosterQ k r C := by
  unfold higham9_16_fosterQ
  rw [dif_pos ⟨hr, hC⟩]
  exact (higham9_16_existsUnique_fosterQ_root k r hr hC).choose_spec.2 t
    ⟨ht0, ht⟩

/-- The band root is strictly positive. -/
lemma higham9_16_fosterQ_pos {k r : ℕ} (hr : 1 ≤ r) {C : ℝ} (hC : 0 < C) :
    0 < higham9_16_fosterQ k r C := by
  rcases eq_or_lt_of_le (higham9_16_fosterQ_nonneg (k := k) hr hC)
    with h0 | hpos
  · exfalso
    have heq := higham9_16_fosterQ_eq (k := k) hr hC
    rw [← h0, higham9_16_fosterQStage_zero hr] at heq
    exact absurd heq.symm (ne_of_gt hC)
  · exact hpos

/-- **Foster's link between (A.5) and eq. (6)**: the `r = 1` band root at the
stage constant `C_k` is exactly the stage root `s_k` (for `k ≥ 2`). -/
lemma higham9_16_fosterQ_one_eq_fosterS {k : ℕ} (hk : 2 ≤ k) :
    higham9_16_fosterQ k 1 (higham9_16_fosterStageConst k *
        Real.sqrt (((k - 1 : ℕ) : ℝ) ^ (k - 1))) =
      higham9_16_fosterS k := by
  have hk1 : 1 ≤ k := by omega
  have hden_pos : (0 : ℝ) < Real.sqrt (((k - 1 : ℕ) : ℝ) ^ (k - 1)) :=
    lt_of_lt_of_le one_pos (by
      have := higham9_16_fosterQStage_sqrt_ge_one k 1
      simpa using this)
  have hC_pos : (0 : ℝ) < higham9_16_fosterStageConst k *
      Real.sqrt (((k - 1 : ℕ) : ℝ) ^ (k - 1)) :=
    mul_pos (higham9_16_fosterStageConst_pos hk1) hden_pos
  symm
  apply higham9_16_fosterQ_unique le_rfl hC_pos
    (higham9_16_fosterS_nonneg hk1)
  unfold higham9_16_fosterQStage
  have hstage := higham9_16_fosterS_eq k hk1
  calc Real.sqrt (((k - 1 : ℕ) : ℝ) ^ (k - 1)) *
        higham9_16_fosterS k ^ 1 *
        (1 + (1 : ℕ) * higham9_16_fosterS k) ^ (k - 1)
      = Real.sqrt (((k - 1 : ℕ) : ℝ) ^ (k - 1)) *
          (higham9_16_fosterS k *
            (1 + higham9_16_fosterS k) ^ (k - 1)) := by
        push_cast
        ring
    _ = Real.sqrt (((k - 1 : ℕ) : ℝ) ^ (k - 1)) *
          higham9_16_fosterStageConst k := by rw [hstage]
    _ = higham9_16_fosterStageConst k *
          Real.sqrt (((k - 1 : ℕ) : ℝ) ^ (k - 1)) := by ring

/-- **Foster's link between (A.5) and eq. (6)** at the chapter constant:
`q` for `r = 1` at `C = sqrt(k^k)` is exactly `s_k` (for `k ≥ 2`). -/
lemma higham9_16_fosterQ_one_sqrt_eq_fosterS {k : ℕ} (hk : 2 ≤ k) :
    higham9_16_fosterQ k 1 (Real.sqrt ((k : ℝ) ^ k)) =
      higham9_16_fosterS k := by
  have hden_ne : Real.sqrt (((k - 1 : ℕ) : ℝ) ^ (k - 1)) ≠ 0 :=
    ne_of_gt (lt_of_lt_of_le one_pos (by
      have := higham9_16_fosterQStage_sqrt_ge_one k 1
      simpa using this))
  have hC_eq : Real.sqrt ((k : ℝ) ^ k) =
      higham9_16_fosterStageConst k *
        Real.sqrt (((k - 1 : ℕ) : ℝ) ^ (k - 1)) := by
    unfold higham9_16_fosterStageConst
    rw [div_mul_cancel₀ _ hden_ne]
  rw [hC_eq]
  exact higham9_16_fosterQ_one_eq_fosterS hk

/-- The band root is monotone in the constant. -/
lemma higham9_16_fosterQ_mono_const {k r : ℕ} (hr : 1 ≤ r) {C₁ C₂ : ℝ}
    (hC₁ : 0 < C₁) (hC₁₂ : C₁ ≤ C₂) :
    higham9_16_fosterQ k r C₁ ≤ higham9_16_fosterQ k r C₂ := by
  have hC₂ : 0 < C₂ := lt_of_lt_of_le hC₁ hC₁₂
  by_contra hgt
  push_neg at hgt
  have hmono := higham9_16_fosterQStage_strictMonoOn k r hr
    (Set.mem_Ici.mpr (higham9_16_fosterQ_nonneg hr hC₂))
    (Set.mem_Ici.mpr (higham9_16_fosterQ_nonneg hr hC₁)) hgt
  rw [higham9_16_fosterQ_eq hr hC₁, higham9_16_fosterQ_eq hr hC₂] at hmono
  linarith

/-- **Foster Lemma A.3 support**, `q_k ≤ s_k` whenever the constant is at
most the chapter value `sqrt(k^k)` (for `k ≥ 2`). -/
lemma higham9_16_fosterQ_one_le_fosterS {k : ℕ} (hk : 2 ≤ k) {C : ℝ}
    (hC : 0 < C) (hCle : C ≤ Real.sqrt ((k : ℝ) ^ k)) :
    higham9_16_fosterQ k 1 C ≤ higham9_16_fosterS k := by
  calc higham9_16_fosterQ k 1 C
      ≤ higham9_16_fosterQ k 1 (Real.sqrt ((k : ℝ) ^ k)) :=
        higham9_16_fosterQ_mono_const le_rfl hC hCle
    _ = higham9_16_fosterS k := higham9_16_fosterQ_one_sqrt_eq_fosterS hk

/-- **Foster Lemma A.3 support**, the Möbius-substitution product identity
`(1+x)(1 + m·x/(1+x)) = 1 + (m+1)x` used throughout Foster's appendix. -/
lemma higham9_16_one_add_mul_hat (m x : ℝ) (hx : 0 ≤ x) :
    (1 + x) * (1 + m * (x / (1 + x))) = 1 + (m + 1) * x := by
  have hne : (1 : ℝ) + x ≠ 0 := by linarith
  field_simp
  ring


/-! ## Equation (9.16) / Foster Lemma A.3: band-root interlacing (base) -/

/-- **Foster Lemma A.3 support**, `s_k ≤ s_(k-1)` for `k ≥ 2`. -/
lemma higham9_16_fosterS_le_pred {k : ℕ} (hk : 2 ≤ k) :
    higham9_16_fosterS k ≤ higham9_16_fosterS (k - 1) := by
  rcases eq_or_lt_of_le hk with heq | hlt
  · rw [← heq]
    norm_num [higham9_16_fosterS_two, higham9_16_fosterS_one]
  · have h2 : 2 ≤ k - 1 := by omega
    have hstep := higham9_16_fosterS_succ_lt h2
    rw [show k - 1 + 1 = k from by omega] at hstep
    exact le_of_lt hstep

/-- **Foster Lemma A.3 key identity**, the successive band-stage functions
are related through the Möbius substitution `x ↦ x/(1+rx)`:
`QStage_(r+1)(x) · C_(k-r) = QStage_r(x) · fosterStage_(k-r)(x/(1+rx))`. -/
lemma higham9_16_fosterQStage_succ_mul_const {k r : ℕ} (hrk : r + 1 ≤ k)
    (x : ℝ) (hx : 0 ≤ x) :
    higham9_16_fosterQStage k (r + 1) x *
        higham9_16_fosterStageConst (k - r) =
      higham9_16_fosterQStage k r x *
        higham9_16_fosterStage (k - r) (x / (1 + (r : ℝ) * x)) := by
  have hden : (0 : ℝ) < 1 + (r : ℝ) * x := by positivity
  have hsub1 : k - (r + 1) = (k - r) - 1 := by omega
  have hsub2 : (k - r) - 1 + 1 = k - r := by omega
  have hA_pos : (0 : ℝ) <
      Real.sqrt ((((k - r) - 1 : ℕ) : ℝ) ^ ((k - r) - 1)) := by
    have h := higham9_16_fosterQStage_sqrt_ge_one k (r + 1)
    rw [hsub1] at h
    linarith
  unfold higham9_16_fosterQStage higham9_16_fosterStageConst
    higham9_16_fosterStage
  rw [hsub1]
  -- Möbius: `1 + x/(1+rx) = (1+(r+1)x)/(1+rx)`
  have hmob : 1 + x / (1 + (r : ℝ) * x) =
      (1 + ((r : ℕ) + 1 : ℝ) * x) / (1 + (r : ℝ) * x) := by
    field_simp
    ring
  rw [hmob]
  have hcast : ((r + 1 : ℕ) : ℝ) = (r : ℝ) + 1 := by push_cast; ring
  rw [hcast]
  -- expand `(1+rx)^(k-r) = (1+rx)^((k-r)-1) * (1+rx)`
  have hpow : (1 + (r : ℝ) * x) ^ (k - r) =
      (1 + (r : ℝ) * x) ^ ((k - r) - 1) * (1 + (r : ℝ) * x) := by
    rw [← pow_succ, hsub2]
  rw [hpow, div_pow]
  -- expand `x^(r+1) = x^r * x`
  rw [pow_succ]
  field_simp
  try ring

/-- **Foster Lemma A.3 criterion**, the band roots step up whenever the
Möbius image of the current root lies strictly below the next stage root:
if `fosterStage_(k-r)(q_r/(1+r q_r)) < C_(k-r)` then `q_r < q_(r+1)`. -/
lemma higham9_16_fosterQ_succ_gt_of_stage_lt {k r : ℕ} (hr : 1 ≤ r)
    (hrk : r + 1 ≤ k) {C : ℝ} (hC : 0 < C)
    (hstage : higham9_16_fosterStage (k - r)
        (higham9_16_fosterQ k r C /
          (1 + (r : ℝ) * higham9_16_fosterQ k r C)) <
      higham9_16_fosterStageConst (k - r)) :
    higham9_16_fosterQ k r C < higham9_16_fosterQ k (r + 1) C := by
  set q₁ := higham9_16_fosterQ k r C with hq₁def
  have hq₁_nonneg : 0 ≤ q₁ := higham9_16_fosterQ_nonneg (k := k) hr hC
  have hCk_pos : 0 < higham9_16_fosterStageConst (k - r) :=
    higham9_16_fosterStageConst_pos (by omega)
  -- the ratio identity at `x = q₁`
  have hid := higham9_16_fosterQStage_succ_mul_const hrk q₁ hq₁_nonneg
  have heq₁ : higham9_16_fosterQStage k r q₁ = C :=
    higham9_16_fosterQ_eq (k := k) hr hC
  rw [heq₁] at hid
  -- hence the next stage value at `q₁` lies strictly below `C`
  have hlt : higham9_16_fosterQStage k (r + 1) q₁ < C := by
    have hmul : higham9_16_fosterQStage k (r + 1) q₁ *
        higham9_16_fosterStageConst (k - r) <
        C * higham9_16_fosterStageConst (k - r) := by
      rw [hid]
      exact mul_lt_mul_of_pos_left hstage hC
    exact lt_of_mul_lt_mul_right hmul (le_of_lt hCk_pos)
  -- conclude by strict monotonicity of the `(r+1)`-stage function
  by_contra hle
  push_neg at hle
  have hmono := higham9_16_fosterQStage_strictMonoOn k (r + 1) (by omega)
  rcases eq_or_lt_of_le hle with heq | hlt2
  · rw [← heq, higham9_16_fosterQ_eq (k := k) (by omega) hC] at hlt
    exact lt_irrefl _ hlt
  · have hmono_lt := hmono
      (Set.mem_Ici.mpr (higham9_16_fosterQ_nonneg (k := k) (by omega) hC))
      (Set.mem_Ici.mpr hq₁_nonneg) hlt2
    rw [higham9_16_fosterQ_eq (k := k) (by omega) hC] at hmono_lt
    exact lt_irrefl _ (hmono_lt.trans hlt)

/-- **Foster Lemma A.3, base step**: `q_k < q_(k-1)` in Foster's indexing,
i.e. the `r = 1` band root lies strictly below the `r = 2` band root, for
`k ≥ 2` and `0 < C ≤ sqrt(k^k)`. -/
theorem higham9_16_fosterQ_one_lt_two {k : ℕ} (hk : 2 ≤ k) {C : ℝ}
    (hC : 0 < C) (hCle : C ≤ Real.sqrt ((k : ℝ) ^ k)) :
    higham9_16_fosterQ k 1 C < higham9_16_fosterQ k 2 C := by
  have hq₁_pos : 0 < higham9_16_fosterQ k 1 C :=
    higham9_16_fosterQ_pos (k := k) le_rfl hC
  have hk1 : 1 ≤ k - 1 := by omega
  have hden : (0 : ℝ) < 1 + ((1 : ℕ) : ℝ) * higham9_16_fosterQ k 1 C := by
    push_cast
    linarith
  -- Möbius image is strictly below `q₁`
  have hxh_lt : higham9_16_fosterQ k 1 C /
      (1 + ((1 : ℕ) : ℝ) * higham9_16_fosterQ k 1 C) <
      higham9_16_fosterQ k 1 C := by
    rw [div_lt_iff₀ hden]
    push_cast
    nlinarith [hq₁_pos]
  -- the `s`-chain: `q₁ ≤ s_k ≤ s_(k-1)`
  have hq₁_le : higham9_16_fosterQ k 1 C ≤ higham9_16_fosterS k :=
    higham9_16_fosterQ_one_le_fosterS hk hC hCle
  have hs_le : higham9_16_fosterS k ≤ higham9_16_fosterS (k - 1) :=
    higham9_16_fosterS_le_pred hk
  have hxh_lt_s : higham9_16_fosterQ k 1 C /
      (1 + ((1 : ℕ) : ℝ) * higham9_16_fosterQ k 1 C) <
      higham9_16_fosterS (k - 1) :=
    lt_of_lt_of_le (lt_of_lt_of_le hxh_lt hq₁_le) hs_le
  -- stage value strictly below the stage constant
  have hstage : higham9_16_fosterStage (k - 1)
      (higham9_16_fosterQ k 1 C /
        (1 + ((1 : ℕ) : ℝ) * higham9_16_fosterQ k 1 C)) <
      higham9_16_fosterStageConst (k - 1) := by
    have hxh_nonneg : 0 ≤ higham9_16_fosterQ k 1 C /
        (1 + ((1 : ℕ) : ℝ) * higham9_16_fosterQ k 1 C) :=
      div_nonneg (le_of_lt hq₁_pos) (le_of_lt hden)
    have hmono_lt := higham9_16_fosterStage_strictMonoOn (k - 1)
      (Set.mem_Ici.mpr hxh_nonneg)
      (Set.mem_Ici.mpr (higham9_16_fosterS_nonneg hk1)) hxh_lt_s
    rw [(higham9_16_fosterS_spec hk1).2] at hmono_lt
    exact hmono_lt
  have hcrit := higham9_16_fosterQ_succ_gt_of_stage_lt (k := k) (r := 1)
    le_rfl (by omega) hC hstage
  simpa using hcrit


/-! ## Equation (9.16) / Foster Lemma A.2: feasibility and rescaling -/

/-- **Foster (A.2)-(A.4)**, the feasible set of Lemma A.2: an antitone
tuple `p` dominating the fixed tail `P`, whose full product is at most `C`
and whose nested leading products satisfy the subset-Hadamard constraints
(the tail sums range over the free variables only, matching (A.4)). -/
def higham9_16_FosterFeasible (k : ℕ) (C P : ℝ) (p : Fin k → ℝ) : Prop :=
  Antitone p ∧
    (∀ i : Fin k, P ≤ p i) ∧
    (∏ i, p i) ≤ C ∧
    ∀ h : ℕ, 1 ≤ h → h ≤ k - 1 →
      ∏ i ∈ Finset.univ.filter (fun i : Fin k => i.val < h), p i ≤
        Real.sqrt ((h : ℝ) ^ h) *
          (1 + ∑ i ∈ Finset.univ.filter (fun i : Fin k => ¬ i.val < h), p i)
            ^ h

/-- Feasible tuples are entrywise nonnegative when the tail is. -/
lemma higham9_16_fosterFeasible_nonneg {k : ℕ} {C P : ℝ} {p : Fin k → ℝ}
    (hP : 0 ≤ P) (hfeas : higham9_16_FosterFeasible k C P p) (i : Fin k) :
    0 ≤ p i :=
  le_trans hP (hfeas.2.1 i)

/-- Leading-product splitting: for `h ≤ k`, the first-`h` product over
`Fin (k+1)` equals the first-`h` product of the `castSucc` restriction. -/
lemma higham9_16_lead_prod_split {k h : ℕ} (hh : h ≤ k)
    (p : Fin (k + 1) → ℝ) :
    ∏ i ∈ Finset.univ.filter (fun i : Fin (k + 1) => i.val < h), p i =
      ∏ i ∈ Finset.univ.filter (fun i : Fin k => i.val < h), p i.castSucc := by
  classical
  rw [Finset.prod_filter, Finset.prod_filter, Fin.prod_univ_castSucc]
  have hlast : ¬ ((Fin.last k).val < h) := by
    simp [Fin.last]
    omega
  rw [if_neg hlast, mul_one]
  apply Finset.prod_congr rfl
  intro i _
  congr 1

/-- Tail-sum splitting: for `h ≤ k`, the tail sum over `Fin (k+1)` splits
off the last coordinate. -/
lemma higham9_16_tail_sum_split {k h : ℕ} (hh : h ≤ k)
    (p : Fin (k + 1) → ℝ) :
    ∑ i ∈ Finset.univ.filter (fun i : Fin (k + 1) => ¬ i.val < h), p i =
      p (Fin.last k) +
        ∑ i ∈ Finset.univ.filter (fun i : Fin k => ¬ i.val < h),
          p i.castSucc := by
  classical
  rw [Finset.sum_filter, Finset.sum_filter, Fin.sum_univ_castSucc]
  have hlast : ¬ ((Fin.last k).val < h) := by
    simp [Fin.last]
    omega
  rw [if_pos hlast, add_comm]
  congr 1

/-- Full-product splitting over `Fin (k+1)`. -/
lemma higham9_16_full_prod_split {k : ℕ} (p : Fin (k + 1) → ℝ) :
    ∏ i, p i = (∏ i : Fin k, p i.castSucc) * p (Fin.last k) :=
  Fin.prod_univ_castSucc p

/-- **Foster A.2 proof, rescaling (standard part)**: dropping the last free
variable `t := p_(k+1)` and dividing by `1 + t` yields a `k`-dimensional
feasible tuple at the standard constant `sqrt(k^k)` with tail `t/(1+t)`.
This encodes the exact transformation of the constraints (A.2)-(A.4) used in
Foster's induction. -/
lemma higham9_16_fosterFeasible_rescale_std {k : ℕ} {C P : ℝ}
    {p : Fin (k + 1) → ℝ} (hk : 1 ≤ k) (hP : 0 ≤ P)
    (hfeas : higham9_16_FosterFeasible (k + 1) C P p) :
    higham9_16_FosterFeasible k (Real.sqrt ((k : ℝ) ^ k))
      (p (Fin.last k) / (1 + p (Fin.last k)))
      (fun i => p i.castSucc / (1 + p (Fin.last k))) := by
  classical
  obtain ⟨hanti, htail, hprod, hnested⟩ := hfeas
  set t := p (Fin.last k) with ht
  have ht0 : 0 ≤ t := le_trans hP (htail _)
  have hden : (0 : ℝ) < 1 + t := by linarith
  have hinv : (0 : ℝ) ≤ (1 + t)⁻¹ := inv_nonneg.mpr (le_of_lt hden)
  refine ⟨?_, ?_, ?_, ?_⟩
  · -- antitone
    intro i j hij
    have hpm : p j.castSucc ≤ p i.castSucc :=
      hanti (Fin.castSucc_le_castSucc_iff.mpr hij)
    simp only [div_eq_mul_inv]
    exact mul_le_mul_of_nonneg_right hpm hinv
  · -- tail domination
    intro i
    have hpm : t ≤ p i.castSucc := hanti (le_of_lt (Fin.castSucc_lt_last i))
    simp only [div_eq_mul_inv]
    exact mul_le_mul_of_nonneg_right hpm hinv
  · -- full product at the standard constant, from `(A.4)` at `h = k`
    have hk_constraint := hnested k hk (by omega)
    rw [higham9_16_lead_prod_split le_rfl p,
      higham9_16_tail_sum_split le_rfl p] at hk_constraint
    have hfilter_all : Finset.univ.filter (fun i : Fin k => i.val < k) =
        Finset.univ :=
      Finset.filter_true_of_mem (fun i _ => i.isLt)
    have hfilter_none : Finset.univ.filter (fun i : Fin k => ¬ i.val < k) =
        (∅ : Finset (Fin k)) :=
      Finset.filter_false_of_mem (fun i _ => by simp [i.isLt])
    rw [hfilter_all, hfilter_none] at hk_constraint
    simp only [Finset.sum_empty, add_zero] at hk_constraint
    -- `∏ p̂ = (∏ p∘castSucc) / (1+t)^k ≤ sqrt(k^k)`
    have hprod_div : (∏ i : Fin k, p i.castSucc / (1 + t)) =
        (∏ i : Fin k, p i.castSucc) / (1 + t) ^ k := by
      rw [Finset.prod_div_distrib, Finset.prod_const, Finset.card_univ,
        Fintype.card_fin]
    rw [hprod_div, div_le_iff₀ (by positivity)]
    calc (∏ i : Fin k, p i.castSucc)
        ≤ Real.sqrt ((k : ℝ) ^ k) * (1 + t) ^ k := hk_constraint
      _ = Real.sqrt ((k : ℝ) ^ k) * (1 + t) ^ k := rfl
  · -- nested constraints
    intro h hh1 hhk
    have hhk' : h ≤ k := by omega
    have hconstraint := hnested h hh1 (by omega)
    rw [higham9_16_lead_prod_split hhk' p,
      higham9_16_tail_sum_split hhk' p] at hconstraint
    set S := ∑ i ∈ Finset.univ.filter (fun i : Fin k => ¬ i.val < h),
      p i.castSucc with hS
    have hS_nonneg : 0 ≤ S := by
      apply Finset.sum_nonneg
      intro i _
      exact le_trans hP (htail _)
    -- `1 + t + S = (1+t)(1 + S/(1+t))`
    have hsplit_base : 1 + (t + S) = (1 + t) * (1 + S / (1 + t)) := by
      field_simp
      ring
    rw [hsplit_base, mul_pow] at hconstraint
    -- tail sum of the rescaled tuple
    have hsum_div : ∑ i ∈ Finset.univ.filter (fun i : Fin k => ¬ i.val < h),
        p i.castSucc / (1 + t) = S / (1 + t) := by
      rw [hS, Finset.sum_div]
    -- leading product of the rescaled tuple
    have hcard : (Finset.univ.filter (fun i : Fin k => i.val < h)).card =
        h := higham9_16_card_filter_val_lt hhk'
    have hprod_div : ∏ i ∈ Finset.univ.filter (fun i : Fin k => i.val < h),
        p i.castSucc / (1 + t) =
        (∏ i ∈ Finset.univ.filter (fun i : Fin k => i.val < h),
          p i.castSucc) / (1 + t) ^ h := by
      rw [Finset.prod_div_distrib, Finset.prod_const, hcard]
    rw [hsum_div, hprod_div, div_le_iff₀ (by positivity)]
    calc ∏ i ∈ Finset.univ.filter (fun i : Fin k => i.val < h), p i.castSucc
        ≤ Real.sqrt ((h : ℝ) ^ h) * ((1 + t) ^ h *
            (1 + S / (1 + t)) ^ h) := hconstraint
      _ = Real.sqrt ((h : ℝ) ^ h) * (1 + S / (1 + t)) ^ h *
            (1 + t) ^ h := by ring

/-- **Foster A.2 proof, rescaling (product part)**: when the last free
variable `t` is positive, the rescaled tuple's full product is bounded by
`C / (t (1+t)^k)` — the sharpened constant of Foster's second case. -/
lemma higham9_16_fosterFeasible_rescale_prod {k : ℕ} {C P : ℝ}
    {p : Fin (k + 1) → ℝ} (_hP : 0 ≤ P)
    (hfeas : higham9_16_FosterFeasible (k + 1) C P p)
    (ht_pos : 0 < p (Fin.last k)) :
    (∏ i : Fin k, p i.castSucc / (1 + p (Fin.last k))) ≤
      C / (p (Fin.last k) * (1 + p (Fin.last k)) ^ k) := by
  classical
  obtain ⟨hanti, htail, hprod, hnested⟩ := hfeas
  set t := p (Fin.last k) with ht
  have hden : (0 : ℝ) < 1 + t := by linarith
  rw [higham9_16_full_prod_split p] at hprod
  have hprod_div : (∏ i : Fin k, p i.castSucc / (1 + t)) =
      (∏ i : Fin k, p i.castSucc) / (1 + t) ^ k := by
    rw [Finset.prod_div_distrib, Finset.prod_const, Finset.card_univ,
      Fintype.card_fin]
  rw [hprod_div, div_le_div_iff₀ (by positivity) (by positivity)]
  calc (∏ i : Fin k, p i.castSucc) * (t * (1 + t) ^ k)
      = ((∏ i : Fin k, p i.castSucc) * t) * (1 + t) ^ k := by ring
    _ ≤ C * (1 + t) ^ k := by
        apply mul_le_mul_of_nonneg_right hprod (by positivity)

/-- Any non-last entry of the original tuple is the corresponding rescaled
entry times `1 + t`. -/
lemma higham9_16_fosterFeasible_head_eq {k : ℕ} (p : Fin (k + 1) → ℝ)
    (i : Fin k) (hden : (1 : ℝ) + p (Fin.last k) ≠ 0) :
    p i.castSucc = (p i.castSucc / (1 + p (Fin.last k))) *
      (1 + p (Fin.last k)) := by
  rw [div_mul_cancel₀ _ hden]


/-! ## Equation (9.16) / Foster (A.6)-(A.7): shifted roots and band-1 value -/

/-- **Foster (A.6)**, the shifted stage function
`p ↦ sqrt(m^m) * p * (a + p)^m`. -/
noncomputable def higham9_16_fosterQShift (m : ℕ) (a p : ℝ) : ℝ :=
  Real.sqrt ((m : ℝ) ^ m) * p * (a + p) ^ m

lemma higham9_16_fosterQShift_continuous (m : ℕ) (a : ℝ) :
    Continuous (higham9_16_fosterQShift m a) := by
  unfold higham9_16_fosterQShift
  fun_prop

lemma higham9_16_fosterQShift_sqrt_ge_one (m : ℕ) :
    (1 : ℝ) ≤ Real.sqrt ((m : ℝ) ^ m) := by
  rw [show (1 : ℝ) = Real.sqrt 1 from Real.sqrt_one.symm]
  apply Real.sqrt_le_sqrt
  rcases Nat.eq_zero_or_pos m with h0 | hpos
  · rw [h0]
    norm_num
  · apply one_le_pow₀
    exact_mod_cast hpos

lemma higham9_16_fosterQShift_zero (m : ℕ) (a : ℝ) :
    higham9_16_fosterQShift m a 0 = 0 := by
  unfold higham9_16_fosterQShift
  ring

lemma higham9_16_fosterQShift_strictMonoOn (m : ℕ) {a : ℝ} (ha : 0 ≤ a) :
    StrictMonoOn (higham9_16_fosterQShift m a) (Set.Ici (0 : ℝ)) := by
  intro x hx y hy hxy
  simp only [Set.mem_Ici] at hx hy
  unfold higham9_16_fosterQShift
  have hD : (0 : ℝ) < Real.sqrt ((m : ℝ) ^ m) :=
    lt_of_lt_of_le one_pos (higham9_16_fosterQShift_sqrt_ge_one m)
  have hy_pos : (0 : ℝ) < y := lt_of_le_of_lt hx hxy
  rcases eq_or_lt_of_le hx with rfl | hx_pos
  · rw [mul_zero, zero_mul]
    positivity
  · have h1 : x < y := hxy
    have h2 : (a + x) ^ m ≤ (a + y) ^ m := by
      apply pow_le_pow_left₀ (by linarith)
      linarith
    rw [mul_assoc, mul_assoc]
    apply mul_lt_mul_of_pos_left ?_ hD
    exact mul_lt_mul h1 h2 (by positivity) (by positivity)

lemma higham9_16_fosterQShift_witness (m : ℕ) {a : ℝ} (ha : 0 ≤ a)
    (C : ℝ) :
    C ≤ higham9_16_fosterQShift m a (max 1 C) := by
  set b : ℝ := max 1 C with hbdef
  have hb1 : (1 : ℝ) ≤ b := le_max_left 1 C
  have hbC : C ≤ b := le_max_right 1 C
  unfold higham9_16_fosterQShift
  have h2 : (1 : ℝ) ≤ (a + b) ^ m := by
    apply one_le_pow₀
    linarith
  have hD := higham9_16_fosterQShift_sqrt_ge_one m
  calc C ≤ b := hbC
    _ = 1 * b * 1 := by ring
    _ ≤ Real.sqrt ((m : ℝ) ^ m) * b * (a + b) ^ m := by
        apply mul_le_mul ?_ h2 (by norm_num) (by positivity)
        apply mul_le_mul hD le_rfl (by linarith) ?_
        linarith

/-- **Foster (A.6)**, existence and uniqueness of the shifted root. -/
theorem higham9_16_existsUnique_fosterQShift_root (m : ℕ) {a C : ℝ}
    (ha : 0 ≤ a) (hC : 0 < C) :
    ∃! p : ℝ, 0 ≤ p ∧ higham9_16_fosterQShift m a p = C :=
  higham9_16_existsUnique_root (higham9_16_fosterQShift_continuous m a)
    (higham9_16_fosterQShift_strictMonoOn m ha)
    (higham9_16_fosterQShift_zero m a) hC
    (le_trans zero_le_one (le_max_left 1 C))
    (higham9_16_fosterQShift_witness m ha C)

/-- **Foster (A.6)**, the shifted root `p*` (junk `0` outside the valid
parameter range). -/
noncomputable def higham9_16_fosterPStar (m : ℕ) (a C : ℝ) : ℝ :=
  if h : 0 ≤ a ∧ 0 < C then
    (higham9_16_existsUnique_fosterQShift_root m h.1 h.2).choose
  else 0

lemma higham9_16_fosterPStar_spec {m : ℕ} {a C : ℝ} (ha : 0 ≤ a)
    (hC : 0 < C) :
    0 ≤ higham9_16_fosterPStar m a C ∧
      higham9_16_fosterQShift m a (higham9_16_fosterPStar m a C) = C := by
  unfold higham9_16_fosterPStar
  rw [dif_pos ⟨ha, hC⟩]
  exact (higham9_16_existsUnique_fosterQShift_root m ha hC).choose_spec.1

lemma higham9_16_fosterPStar_unique {m : ℕ} {a C : ℝ} (ha : 0 ≤ a)
    (hC : 0 < C) {t : ℝ} (ht0 : 0 ≤ t)
    (ht : higham9_16_fosterQShift m a t = C) :
    t = higham9_16_fosterPStar m a C := by
  unfold higham9_16_fosterPStar
  rw [dif_pos ⟨ha, hC⟩]
  exact (higham9_16_existsUnique_fosterQShift_root m ha hC).choose_spec.2 t
    ⟨ht0, ht⟩

/-- **Foster (A.7) with `r = 0` / the band-1 value**: the equality-case
maximum `V(k, C) = t_(k-1-prefix) * (1 + q)` with `q` the `r = 1` band root.
At the chapter constant this is exactly `t_k`. -/
noncomputable def higham9_16_fosterV (k : ℕ) (C : ℝ) : ℝ :=
  higham9_16_fosterT (k - 1) * (1 + higham9_16_fosterQ k 1 C)

/-- At the chapter constant `sqrt(k^k)` the band-1 value is `t_k`. -/
lemma higham9_16_fosterV_chapter {k : ℕ} (hk : 2 ≤ k) :
    higham9_16_fosterV k (Real.sqrt ((k : ℝ) ^ k)) =
      higham9_16_fosterT k := by
  unfold higham9_16_fosterV
  rw [higham9_16_fosterQ_one_sqrt_eq_fosterS hk]
  have hrec := higham9_16_fosterT_succ (n := k - 1) (by omega)
  rw [show k - 1 + 1 = k from by omega] at hrec
  exact hrec.symm

/-- The band-1 value is positive. -/
lemma higham9_16_fosterV_pos (k : ℕ) {C : ℝ} (hC : 0 < C) :
    0 < higham9_16_fosterV k C := by
  unfold higham9_16_fosterV
  apply mul_pos (higham9_16_fosterT_pos (k - 1))
  have := higham9_16_fosterQ_pos (k := k) (r := 1) le_rfl hC
  linarith

/-- The band-1 value is monotone in the constant. -/
lemma higham9_16_fosterV_mono_const {k : ℕ} {C₁ C₂ : ℝ} (hC₁ : 0 < C₁)
    (hC₁₂ : C₁ ≤ C₂) :
    higham9_16_fosterV k C₁ ≤ higham9_16_fosterV k C₂ := by
  unfold higham9_16_fosterV
  apply mul_le_mul_of_nonneg_left ?_
    (le_of_lt (higham9_16_fosterT_pos (k - 1)))
  have := higham9_16_fosterQ_mono_const (k := k) (r := 1) le_rfl hC₁ hC₁₂
  linarith

/-- **Foster's case-1 boundary**: the last free variable is in the first
band exactly when the sharpened constant still dominates the standard one:
`sqrt(k^k) * t (1+t)^k ≤ C ↔ t ≤ fosterQ (k+1) 1 C` (for `t ≥ 0`). -/
lemma higham9_16_case1_iff {k : ℕ} {C t : ℝ} (hC : 0 < C) (ht : 0 ≤ t) :
    Real.sqrt ((k : ℝ) ^ k) * (t * (1 + t) ^ k) ≤ C ↔
      t ≤ higham9_16_fosterQ (k + 1) 1 C := by
  have hstage : higham9_16_fosterQStage (k + 1) 1 t =
      Real.sqrt ((k : ℝ) ^ k) * (t * (1 + t) ^ k) := by
    unfold higham9_16_fosterQStage
    simp only [Nat.add_sub_cancel, Nat.cast_one, pow_one]
    ring_nf
  constructor
  · intro hle
    by_contra hgt
    push_neg at hgt
    have hmono := higham9_16_fosterQStage_strictMonoOn (k + 1) 1 le_rfl
      (Set.mem_Ici.mpr (higham9_16_fosterQ_nonneg (k := k + 1) le_rfl hC))
      (Set.mem_Ici.mpr ht) hgt
    rw [higham9_16_fosterQ_eq (k := k + 1) le_rfl hC, hstage] at hmono
    linarith
  · intro hle
    rcases eq_or_lt_of_le hle with heq | hlt
    · rw [← hstage, heq, higham9_16_fosterQ_eq (k := k + 1) le_rfl hC]
    · have hmono := higham9_16_fosterQStage_strictMonoOn (k + 1) 1 le_rfl
        (Set.mem_Ici.mpr ht)
        (Set.mem_Ici.mpr (higham9_16_fosterQ_nonneg (k := k + 1) le_rfl hC))
        hlt
      rw [higham9_16_fosterQ_eq (k := k + 1) le_rfl hC, hstage] at hmono
      linarith


/-! ## Equation (9.16) / Foster (A.5)-(A.8): the band index and value -/

/-- **Foster (A.5) band index**: the number of band roots strictly below the
fixed tail `P`.  By Lemma A.3 the roots increase in `r`, so this counts the
band containing `P` (`0` means `P ≤ q_k`, Foster's equality case). -/
noncomputable def higham9_16_fosterBandIdx (k : ℕ) (C P : ℝ) : ℕ :=
  ((Finset.Icc 1 k).filter
    (fun r => higham9_16_fosterQ k r C < P)).card

/-- The band index vanishes on the first band. -/
lemma higham9_16_fosterBandIdx_eq_zero {k : ℕ} {C P : ℝ}
    (hP : P ≤ higham9_16_fosterQ k 1 C)
    (hmono : ∀ r ∈ Finset.Icc 1 k,
      higham9_16_fosterQ k 1 C ≤ higham9_16_fosterQ k r C) :
    higham9_16_fosterBandIdx k C P = 0 := by
  unfold higham9_16_fosterBandIdx
  rw [Finset.card_eq_zero]
  apply Finset.filter_false_of_mem
  intro r hr
  push_neg
  exact le_trans hP (hmono r hr)

/-- The band index vanishes at `P = 0`. -/
lemma higham9_16_fosterBandIdx_zero_of_tail_zero {k : ℕ} {C : ℝ}
    (hC : 0 < C) :
    higham9_16_fosterBandIdx k C 0 = 0 := by
  unfold higham9_16_fosterBandIdx
  rw [Finset.card_eq_zero]
  apply Finset.filter_false_of_mem
  intro r hr
  push_neg
  exact higham9_16_fosterQ_nonneg (k := k) (Finset.mem_Icc.mp hr).1 hC

/-- **Foster (A.5)-(A.8), the band value function** `M(k, C, P)`: the claimed
maximum of `p_1` over the feasible set of Lemma A.2.  For band index
`j ≤ k-2` this is the (A.7) formula `t_(k-j-1)-prefix × (1 + jP + p*)` with
`p*` the (A.6) shifted root at constant `C/P^j`; for `j = k-1` it is the
(A.8) value `C/P^(k-1)`. -/
noncomputable def higham9_16_fosterBandValue (k : ℕ) (C P : ℝ) : ℝ :=
  if higham9_16_fosterBandIdx k C P + 2 ≤ k then
    higham9_16_fosterT (k - higham9_16_fosterBandIdx k C P - 1) *
      (1 + (higham9_16_fosterBandIdx k C P : ℝ) * P +
        higham9_16_fosterPStar (k - higham9_16_fosterBandIdx k C P - 1)
          (1 + (higham9_16_fosterBandIdx k C P : ℝ) * P)
          (C / P ^ higham9_16_fosterBandIdx k C P))
  else
    C / P ^ (k - 1)

/-- On the first band (`P = 0` in particular) the band value is the
equality-case value `V(k, C)` (for `k ≥ 2`). -/
lemma higham9_16_fosterBandValue_of_idx_zero {k : ℕ} (hk : 2 ≤ k) {C P : ℝ}
    (hC : 0 < C)
    (hidx : higham9_16_fosterBandIdx k C P = 0) :
    higham9_16_fosterBandValue k C P = higham9_16_fosterV k C := by
  unfold higham9_16_fosterBandValue
  rw [hidx]
  rw [if_pos (by omega : 0 + 2 ≤ k)]
  simp only [Nat.cast_zero, zero_mul, add_zero, pow_zero, Nat.sub_zero,
    div_one]
  unfold higham9_16_fosterV
  congr 1
  -- the shifted root at `a = 1` is the `r = 1` band root
  have hshift_eq : ∀ p : ℝ, higham9_16_fosterQShift (k - 1) 1 p =
      higham9_16_fosterQStage k 1 p := by
    intro p
    unfold higham9_16_fosterQShift higham9_16_fosterQStage
    simp only [Nat.cast_one, pow_one, one_mul]
  have hq_spec := higham9_16_fosterQ_spec (k := k) (r := 1) le_rfl hC
  have huniq := higham9_16_fosterPStar_unique (m := k - 1) (a := 1)
    (by norm_num) hC hq_spec.1 (by rw [hshift_eq]; exact hq_spec.2)
  rw [← huniq]


/-! ## Equation (9.16) / Foster Lemma 2: rook bridge and A.2 base case -/

/-- **Foster Lemma 2 input bridge**: the sorted pivot magnitudes of a
normalized rook LU factorization form a feasible tuple of Lemma A.2 at the
chapter constant `sqrt(n^n)` with zero tail. -/
theorem higham9_16_fosterFeasible_of_rook {n : ℕ}
    (A L U : Matrix (Fin n) (Fin n) ℝ)
    (hLU : L * U = A)
    (hL_diag : ∀ i : Fin n, L i i = 1)
    (hL_upper : ∀ i j : Fin n, i.val < j.val → L i j = 0)
    (hU_lower : ∀ i j : Fin n, j.val < i.val → U i j = 0)
    (hAmax : ∀ i j : Fin n, |A i j| ≤ 1)
    (hL1 : ∀ i j : Fin n, |L i j| ≤ 1)
    (hUrook : ∀ i j : Fin n, |U i j| ≤ |U i i|) :
    ∃ q : Fin n → ℝ,
      (∃ σ : Equiv.Perm (Fin n), ∀ i : Fin n, q i = |U (σ i) (σ i)|) ∧
      higham9_16_FosterFeasible n (Real.sqrt ((n : ℝ) ^ n)) 0 q := by
  classical
  obtain ⟨q, hanti, hnonneg, hperm, hconstraints⟩ :=
    higham9_16_foster_sorted_constraints A L U hLU hL_diag hL_upper
      hU_lower hAmax hL1 hUrook
  refine ⟨q, hperm, hanti, hnonneg, ?_, ?_⟩
  · -- full product from the `h = n` constraint
    rcases Nat.eq_zero_or_pos n with rfl | hn
    · simp
    · have hcon := hconstraints n le_rfl
      have hfilter_all : Finset.univ.filter
          (fun i : Fin n => i.val < n) = Finset.univ :=
        Finset.filter_true_of_mem (fun i _ => i.isLt)
      have hfilter_none : Finset.univ.filter
          (fun i : Fin n => ¬ i.val < n) = (∅ : Finset (Fin n)) :=
        Finset.filter_false_of_mem (fun i _ => by simp [i.isLt])
      rw [hfilter_all, hfilter_none] at hcon
      simpa using hcon
  · intro h hh1 hhk
    exact hconstraints h (by omega)

/-- **Foster Lemma A.2, base case `k = 1`**: the head of a one-dimensional
feasible tuple is bounded by the constant. -/
theorem higham9_16_fosterA2_one {C P : ℝ} {p : Fin 1 → ℝ}
    (hfeas : higham9_16_FosterFeasible 1 C P p) :
    p 0 ≤ C := by
  have hprod := hfeas.2.2.1
  simpa using hprod

/-- The head of an antitone tuple dominates every entry. -/
lemma higham9_16_fosterFeasible_head_max {k : ℕ} {C P : ℝ}
    {p : Fin (k + 1) → ℝ}
    (hfeas : higham9_16_FosterFeasible (k + 1) C P p) (i : Fin (k + 1)) :
    p i ≤ p 0 :=
  hfeas.1 (Fin.zero_le i)


/-! ## Equation (9.16) / Foster Lemma A.2: the case-1 slice bound -/

/-- **Foster Lemma A.2 induction step, case 1 (small last variable)**:
if the last free variable `t` satisfies the case-1 condition
`sqrt(k^k)·t(1+t)^k ≤ C`, then — given the `k`-dimensional bound at the
standard constant as an induction hypothesis — the head is bounded by the
band-1 value `V(k+1, C) = t_k (1 + q)`. -/
lemma higham9_16_fosterA2_case1_slice {k : ℕ} (hk : 1 ≤ k) {C P : ℝ}
    {p : Fin (k + 1) → ℝ} (hC : 0 < C) (hP : 0 ≤ P)
    (hfeas : higham9_16_FosterFeasible (k + 1) C P p)
    (hcase1 : Real.sqrt ((k : ℝ) ^ k) *
      (p (Fin.last k) * (1 + p (Fin.last k)) ^ k) ≤ C)
    (hIH : ∀ p' : Fin k → ℝ,
      higham9_16_FosterFeasible k (Real.sqrt ((k : ℝ) ^ k))
        (p (Fin.last k) / (1 + p (Fin.last k))) p' →
      p' ⟨0, hk⟩ ≤ higham9_16_fosterT k) :
    p 0 ≤ higham9_16_fosterV (k + 1) C := by
  have ht0 : 0 ≤ p (Fin.last k) := le_trans hP (hfeas.2.1 _)
  have hden : (0 : ℝ) < 1 + p (Fin.last k) := by linarith
  -- rescale and apply the induction hypothesis
  have hfeas' := higham9_16_fosterFeasible_rescale_std hk hP hfeas
  have hhead := hIH _ hfeas'
  -- reassemble the head
  have hzero_eq : ((⟨0, hk⟩ : Fin k)).castSucc = (0 : Fin (k + 1)) := by
    apply Fin.ext
    simp
  have hp0 : p 0 = (p ((⟨0, hk⟩ : Fin k)).castSucc /
      (1 + p (Fin.last k))) * (1 + p (Fin.last k)) := by
    rw [← hzero_eq]
    exact higham9_16_fosterFeasible_head_eq p ⟨0, hk⟩ (ne_of_gt hden)
  -- case-1 boundary
  have hcase1' : p (Fin.last k) ≤ higham9_16_fosterQ (k + 1) 1 C :=
    (higham9_16_case1_iff hC ht0).mp hcase1
  have hq_nonneg : 0 ≤ higham9_16_fosterQ (k + 1) 1 C :=
    higham9_16_fosterQ_nonneg (k := k + 1) le_rfl hC
  have hT_pos := higham9_16_fosterT_pos k
  calc p 0
      = (p ((⟨0, hk⟩ : Fin k)).castSucc / (1 + p (Fin.last k))) *
          (1 + p (Fin.last k)) := hp0
    _ ≤ higham9_16_fosterT k * (1 + p (Fin.last k)) := by
        apply mul_le_mul_of_nonneg_right hhead (le_of_lt hden)
    _ ≤ higham9_16_fosterT k * (1 + higham9_16_fosterQ (k + 1) 1 C) := by
        apply mul_le_mul_of_nonneg_left ?_ (le_of_lt hT_pos)
        linarith
    _ = higham9_16_fosterV (k + 1) C := by
        unfold higham9_16_fosterV
        simp only [Nat.add_sub_cancel]

/-- **Foster Lemma A.2 induction step, case-2 reduction**: when the last
free variable is positive, the rescaled tuple is feasible at the minimum of
the standard constant and the sharpened constant. -/
lemma higham9_16_fosterA2_case2_reduction {k : ℕ} (hk : 1 ≤ k) {C P : ℝ}
    {p : Fin (k + 1) → ℝ} (hP : 0 ≤ P)
    (hfeas : higham9_16_FosterFeasible (k + 1) C P p)
    (ht_pos : 0 < p (Fin.last k)) :
    higham9_16_FosterFeasible k
      (min (Real.sqrt ((k : ℝ) ^ k))
        (C / (p (Fin.last k) * (1 + p (Fin.last k)) ^ k)))
      (p (Fin.last k) / (1 + p (Fin.last k)))
      (fun i => p i.castSucc / (1 + p (Fin.last k))) := by
  have hstd := higham9_16_fosterFeasible_rescale_std hk hP hfeas
  have hprod := higham9_16_fosterFeasible_rescale_prod hP hfeas ht_pos
  exact ⟨hstd.1, hstd.2.1, le_min hstd.2.2.1 hprod, hstd.2.2.2⟩


/-! ## Equation (9.16) / Foster Lemma A.3: general interlacing -/

/-- `x ↦ x/(1+x)` is strictly monotone on `[0, ∞)`. -/
lemma higham9_16_hat_strictMonoOn :
    StrictMonoOn (fun x : ℝ => x / (1 + x)) (Set.Ici (0 : ℝ)) := by
  intro a ha b hb hab
  simp only [Set.mem_Ici] at ha hb
  have hda : (0 : ℝ) < 1 + a := by linarith
  have hdb : (0 : ℝ) < 1 + b := by linarith
  simp only
  rw [div_lt_div_iff₀ hda hdb]
  nlinarith

/-- **Foster (A.22)/(A.25) hat-transfer identity**: the band-stage function
at level `k`, stage `r+1`, factors through level `k-1`, stage `r`, under
`x ↦ x/(1+x)`: `QStage_k^(r+1)(x) = QStage_(k-1)^r(x/(1+x)) · x(1+x)^(k-1)`. -/
lemma higham9_16_fosterQStage_hat_transfer {k r : ℕ} (hrk : r + 1 ≤ k)
    (x : ℝ) (hx : 0 ≤ x) :
    higham9_16_fosterQStage k (r + 1) x =
      higham9_16_fosterQStage (k - 1) r (x / (1 + x)) *
        (x * (1 + x) ^ (k - 1)) := by
  have hden : (0 : ℝ) < 1 + x := by linarith
  have hne : (1 + x) ≠ 0 := ne_of_gt hden
  have hsub : k - (r + 1) = (k - 1) - r := by omega
  unfold higham9_16_fosterQStage
  rw [hsub]
  have hmob : 1 + (r : ℝ) * (x / (1 + x)) =
      (1 + ((r + 1 : ℕ) : ℝ) * x) / (1 + x) := by
    push_cast
    field_simp
    ring
  rw [hmob]
  have hpow_split : (1 + x) ^ (k - 1) =
      (1 + x) ^ r * (1 + x) ^ ((k - 1) - r) := by
    rw [← pow_add]
    congr 1
    omega
  rw [div_pow, div_pow, hpow_split]
  field_simp
  ring

/-- **Foster (A.22)**, the hat image of a level-`k` stage-`(r+1)` root is
the level-`(k-1)` stage-`r` root at the hatted constant. -/
lemma higham9_16_fosterQ_hat {k r : ℕ} (hr : 1 ≤ r) (hrk : r + 1 ≤ k)
    {C : ℝ} (hC : 0 < C) :
    higham9_16_fosterQ k (r + 1) C /
        (1 + higham9_16_fosterQ k (r + 1) C) =
      higham9_16_fosterQ (k - 1) r
        (C / (higham9_16_fosterQ k (r + 1) C *
          (1 + higham9_16_fosterQ k (r + 1) C) ^ (k - 1))) := by
  set u := higham9_16_fosterQ k (r + 1) C with hu
  have hu_pos : 0 < u := higham9_16_fosterQ_pos (k := k) (by omega) hC
  have hden : (0 : ℝ) < 1 + u := by linarith
  have hChat_pos : 0 < C / (u * (1 + u) ^ (k - 1)) := by positivity
  apply higham9_16_fosterQ_unique hr hChat_pos
    (div_nonneg (le_of_lt hu_pos) (le_of_lt hden))
  have htrans := higham9_16_fosterQStage_hat_transfer hrk u (le_of_lt hu_pos)
  have hueq : higham9_16_fosterQStage k (r + 1) u = C :=
    higham9_16_fosterQ_eq (k := k) (by omega) hC
  rw [hueq] at htrans
  rw [eq_div_iff (ne_of_gt (by positivity : (0:ℝ) < u * (1 + u) ^ (k - 1)))]
  exact htrans.symm

/-- **Foster Lemma A.3 (A.18)**, general interlacing of the band roots:
for `2 ≤ k`, `0 < C ≤ sqrt(k^k)` and `1 ≤ r`, `r + 1 ≤ k`,
`q^(r) < q^(r+1)` — in Foster's indexing `q_(k+1) < q_k < ⋯ < q_1`. -/
theorem higham9_16_fosterQ_lt_succ :
    ∀ k : ℕ, 2 ≤ k → ∀ C : ℝ, 0 < C → C ≤ Real.sqrt ((k : ℝ) ^ k) →
      ∀ r : ℕ, 1 ≤ r → r + 1 ≤ k →
        higham9_16_fosterQ k r C < higham9_16_fosterQ k (r + 1) C := by
  intro k
  induction k using Nat.strong_induction_on with
  | _ k ihk =>
    intro hk C hC hCle r hr hrk
    induction r using Nat.strong_induction_on with
    | _ r ihr =>
      rcases eq_or_lt_of_le hr with heq | hr2
      · -- `r = 1`: the proved base step
        rw [← heq]
        exact higham9_16_fosterQ_one_lt_two hk hC hCle
      · -- `r ≥ 2`: Foster's hatted induction step
        have hr1 : 2 ≤ r := hr2
        have hk3 : 3 ≤ k := by omega
        -- the chain `q^(1) ≤ q^(r-1) < q^(r)`
        have hchain : ∀ j, 1 ≤ j → j ≤ r →
            higham9_16_fosterQ k 1 C ≤ higham9_16_fosterQ k j C := by
          intro j hj1 hjr
          induction j with
          | zero => omega
          | succ n ihn =>
              rcases Nat.eq_zero_or_pos n with rfl | hn
              · exact le_rfl
              · have h1 := ihn (by omega) (by omega)
                have h2 := ihr n (by omega) (by omega) (by omega)
                linarith
        have hq1_lt_u : higham9_16_fosterQ k 1 C <
            higham9_16_fosterQ k r C := by
          have h1 := hchain (r - 1) (by omega) (by omega)
          have h2 := ihr (r - 1) (by omega) (by omega) (by omega)
          rw [show r - 1 + 1 = r from by omega] at h2
          linarith
        -- notation
        set q₁ := higham9_16_fosterQ k 1 C with hq₁
        set u := higham9_16_fosterQ k r C with hu
        set w := higham9_16_fosterQ k (r + 1) C with hw
        have hq₁_pos : 0 < q₁ := higham9_16_fosterQ_pos (k := k) le_rfl hC
        have hu_pos : 0 < u := lt_trans hq₁_pos hq1_lt_u
        have hw_pos : 0 < w :=
          higham9_16_fosterQ_pos (k := k) (by omega) hC
        have hdu : (0 : ℝ) < 1 + u := by linarith
        have hdw : (0 : ℝ) < 1 + w := by linarith
        -- the hatted constant and its bound
        set Chat := C / (u * (1 + u) ^ (k - 1)) with hChat
        have hChat_pos : 0 < Chat := by
          rw [hChat]
          positivity
        -- `C = sqrt((k-1)^(k-1)) q₁ (1+q₁)^(k-1)` from the stage-1 relation
        have hq₁_rel : Real.sqrt (((k - 1 : ℕ) : ℝ) ^ (k - 1)) *
            (q₁ * (1 + q₁) ^ (k - 1)) = C := by
          have h := higham9_16_fosterQ_eq (k := k) (r := 1) le_rfl hC
          rw [← hq₁] at h
          unfold higham9_16_fosterQStage at h
          rw [show k - 1 = k - 1 from rfl] at h
          calc Real.sqrt (((k - 1 : ℕ) : ℝ) ^ (k - 1)) *
              (q₁ * (1 + q₁) ^ (k - 1))
              = Real.sqrt (((k - 1 : ℕ) : ℝ) ^ (k - 1)) * q₁ ^ 1 *
                (1 + ((1 : ℕ) : ℝ) * q₁) ^ (k - 1) := by
                push_cast
                ring
            _ = C := h
        -- the stage function `x(1+x)^(k-1)` is strictly monotone (fosterStage k)
        have hstage_mono : q₁ * (1 + q₁) ^ (k - 1) <
            u * (1 + u) ^ (k - 1) := by
          have := higham9_16_fosterStage_strictMonoOn k
            (Set.mem_Ici.mpr (le_of_lt hq₁_pos))
            (Set.mem_Ici.mpr (le_of_lt hu_pos)) hq1_lt_u
          unfold higham9_16_fosterStage at this
          exact this
        have hChat_lt : Chat < Real.sqrt (((k - 1 : ℕ) : ℝ) ^ (k - 1)) := by
          rw [hChat, div_lt_iff₀ (by positivity)]
          calc C = Real.sqrt (((k - 1 : ℕ) : ℝ) ^ (k - 1)) *
              (q₁ * (1 + q₁) ^ (k - 1)) := hq₁_rel.symm
            _ < Real.sqrt (((k - 1 : ℕ) : ℝ) ^ (k - 1)) *
                (u * (1 + u) ^ (k - 1)) := by
                apply mul_lt_mul_of_pos_left hstage_mono
                exact lt_of_lt_of_le one_pos
                  (by simpa using
                    higham9_16_fosterQStage_sqrt_ge_one k 1)
        -- cast bridge for the level-(k-1) chapter constant
        have hcast : (((k - 1 : ℕ) : ℝ)) ^ (k - 1) =
            ((k - 1 : ℕ) : ℝ) ^ (k - 1) := rfl
        -- hat images
        have hu_hat := higham9_16_fosterQ_hat (k := k) (r := r - 1)
          (by omega) (by omega) hC
        rw [show r - 1 + 1 = r from by omega, ← hu] at hu_hat
        -- `w̃` satisfies the level-(k-1) stage-r relation at `h(w)`
        have hw_trans := higham9_16_fosterQStage_hat_transfer
          (k := k) (r := r) (by omega) w (le_of_lt hw_pos)
        have hw_eq : higham9_16_fosterQStage k (r + 1) w = C :=
          higham9_16_fosterQ_eq (k := k) (by omega) hC
        rw [hw_eq] at hw_trans
        -- case split on `w̃` versus `q̂ := fosterQ (k-1) r Chat`
        set qhat := higham9_16_fosterQ (k - 1) r Chat with hqhat
        rcases lt_or_ge (w / (1 + w)) qhat with hcase | hcase
        · -- `w̃ < q̂`: the stage value at `w̃` is below `Chat`, so `h(w) < h(u)`
          have hmono := higham9_16_fosterQStage_strictMonoOn (k - 1) r
            (by omega)
            (Set.mem_Ici.mpr (div_nonneg (le_of_lt hw_pos) (le_of_lt hdw)))
            (Set.mem_Ici.mpr (higham9_16_fosterQ_nonneg (k := k - 1)
              (by omega) hChat_pos)) hcase
          rw [higham9_16_fosterQ_eq (k := k - 1) (by omega) hChat_pos]
            at hmono
          -- `QStage (k-1) r w̃ = C / (w(1+w)^(k-1))`
          have hwrel : higham9_16_fosterQStage (k - 1) r (w / (1 + w)) =
              C / (w * (1 + w) ^ (k - 1)) := by
            rw [eq_div_iff (ne_of_gt (by positivity :
              (0:ℝ) < w * (1 + w) ^ (k - 1)))]
            exact hw_trans.symm
          rw [hwrel, hChat] at hmono
          -- `C/(w·) < C/(u·)` forces `u· < w·`, hence `u < w`
          rw [div_lt_div_iff₀ (by positivity) (by positivity)] at hmono
          have hlt : u * (1 + u) ^ (k - 1) < w * (1 + w) ^ (k - 1) := by
            nlinarith
          by_contra hle
          push_neg at hle
          have := higham9_16_fosterStage_strictMonoOn k
          rcases eq_or_lt_of_le hle with heq2 | hlt2
          · rw [heq2] at hlt
            exact lt_irrefl _ hlt
          · have hmono2 := this (Set.mem_Ici.mpr (le_of_lt hw_pos))
              (Set.mem_Ici.mpr (le_of_lt hu_pos)) hlt2
            unfold higham9_16_fosterStage at hmono2
            linarith
        · -- `q̂ ≤ w̃`: the outer induction hypothesis gives `û < q̂ ≤ w̃`
          have hihk := ihk (k - 1) (by omega) (by omega) Chat hChat_pos
            (by
              rw [show (((k - 1 : ℕ)) : ℝ) = ((k - 1 : ℕ) : ℝ) from rfl]
              exact le_of_lt hChat_lt)
            (r - 1) (by omega) (by omega)
          rw [show r - 1 + 1 = r from by omega, ← hqhat] at hihk
          rw [← hChat] at hu_hat
          have huhat_lt : u / (1 + u) < w / (1 + w) := by
            calc u / (1 + u) = higham9_16_fosterQ (k - 1) (r - 1) Chat :=
                hu_hat
              _ < qhat := hihk
              _ ≤ w / (1 + w) := hcase
          by_contra hle
          push_neg at hle
          have hmono := higham9_16_hat_strictMonoOn
          rcases eq_or_lt_of_le hle with heq2 | hlt2
          · rw [heq2] at huhat_lt
            exact lt_irrefl _ huhat_lt
          · have := hmono (Set.mem_Ici.mpr (le_of_lt hw_pos))
              (Set.mem_Ici.mpr (le_of_lt hu_pos)) hlt2
            simp only at this
            linarith


/-! ## Equation (9.16) / Foster Lemma A.2: assembled case-1 step -/

/-- The one-dimensional band value is the constant itself. -/
lemma higham9_16_fosterBandValue_one (C P : ℝ) :
    higham9_16_fosterBandValue 1 C P = C := by
  unfold higham9_16_fosterBandValue
  rw [if_neg (by omega : ¬ (higham9_16_fosterBandIdx 1 C P + 2 ≤ 1))]
  simp

/-- With Lemma A.3, the first band root is the least band root. -/
lemma higham9_16_fosterQ_one_le {k : ℕ} (hk : 2 ≤ k) {C : ℝ} (hC : 0 < C)
    (hCle : C ≤ Real.sqrt ((k : ℝ) ^ k)) {r : ℕ} (hr1 : 1 ≤ r)
    (hrk : r ≤ k) :
    higham9_16_fosterQ k 1 C ≤ higham9_16_fosterQ k r C := by
  induction r with
  | zero => omega
  | succ n ihn =>
      rcases Nat.eq_zero_or_pos n with rfl | hn
      · exact le_rfl
      · have h1 := ihn (by omega) (by omega)
        have h2 := higham9_16_fosterQ_lt_succ k hk C hC hCle n (by omega)
          (by omega)
        linarith

/-- With Lemma A.3, the band index vanishes whenever the tail is below the
first band root. -/
lemma higham9_16_fosterBandIdx_eq_zero_of_le_first {k : ℕ} (hk : 2 ≤ k)
    {C P : ℝ} (hC : 0 < C) (hCle : C ≤ Real.sqrt ((k : ℝ) ^ k))
    (hP : P ≤ higham9_16_fosterQ k 1 C) :
    higham9_16_fosterBandIdx k C P = 0 :=
  higham9_16_fosterBandIdx_eq_zero hP (fun _r hr =>
    higham9_16_fosterQ_one_le hk hC hCle (Finset.mem_Icc.mp hr).1
      (Finset.mem_Icc.mp hr).2)

/-- **Foster Lemma A.2 induction step, case 1, assembled**: when the last
free variable satisfies the case-1 condition, the head is bounded by the
full band value at the tail `P`. -/
lemma higham9_16_fosterA2_step_case1 {k : ℕ} (hk : 1 ≤ k) {C P : ℝ}
    {p : Fin (k + 1) → ℝ} (hC : 0 < C)
    (hCle : C ≤ Real.sqrt (((k + 1 : ℕ) : ℝ) ^ (k + 1)))
    (hP : 0 ≤ P)
    (hfeas : higham9_16_FosterFeasible (k + 1) C P p)
    (hcase1 : Real.sqrt ((k : ℝ) ^ k) *
      (p (Fin.last k) * (1 + p (Fin.last k)) ^ k) ≤ C)
    (hIH : ∀ p' : Fin k → ℝ,
      higham9_16_FosterFeasible k (Real.sqrt ((k : ℝ) ^ k))
        (p (Fin.last k) / (1 + p (Fin.last k))) p' →
      p' ⟨0, hk⟩ ≤ higham9_16_fosterT k) :
    p 0 ≤ higham9_16_fosterBandValue (k + 1) C P := by
  have ht0 : 0 ≤ p (Fin.last k) := le_trans hP (hfeas.2.1 _)
  have htQ : p (Fin.last k) ≤ higham9_16_fosterQ (k + 1) 1 C :=
    (higham9_16_case1_iff hC ht0).mp hcase1
  have hPQ : P ≤ higham9_16_fosterQ (k + 1) 1 C :=
    le_trans (hfeas.2.1 (Fin.last k)) htQ
  rw [higham9_16_fosterBandValue_of_idx_zero (by omega : 2 ≤ k + 1) hC
    (higham9_16_fosterBandIdx_eq_zero_of_le_first (by omega : 2 ≤ k + 1)
      hC hCle hPQ)]
  exact higham9_16_fosterA2_case1_slice hk hC hP hfeas hcase1 hIH


/-! ## Equation (9.16) / Foster (A.12): band-membership transfer -/

/-- Comparison with a band root is equivalent to comparison of stage
values. -/
lemma higham9_16_le_fosterQ_iff {k r : ℕ} (hr : 1 ≤ r) {C x : ℝ}
    (hC : 0 < C) (hx : 0 ≤ x) :
    x ≤ higham9_16_fosterQ k r C ↔
      higham9_16_fosterQStage k r x ≤ C := by
  have hq0 : 0 ≤ higham9_16_fosterQ k r C :=
    higham9_16_fosterQ_nonneg (k := k) hr hC
  have hmono := higham9_16_fosterQStage_strictMonoOn k r hr
  constructor
  · intro hle
    rcases eq_or_lt_of_le hle with heq | hlt
    · rw [heq, higham9_16_fosterQ_eq (k := k) hr hC]
    · have := hmono (Set.mem_Ici.mpr hx) (Set.mem_Ici.mpr hq0) hlt
      rw [higham9_16_fosterQ_eq (k := k) hr hC] at this
      linarith
  · intro hle
    by_contra hgt
    push_neg at hgt
    have := hmono (Set.mem_Ici.mpr hq0) (Set.mem_Ici.mpr hx) hgt
    rw [higham9_16_fosterQ_eq (k := k) hr hC] at this
    linarith

/-- **Foster (A.12)**: band membership transfers through the Möbius map —
`t ≤ q^(r+1)` at level `k+1` iff `t/(1+t) ≤ q̂^(r)` at level `k` with the
hatted constant `C/(t(1+t)^k)`. -/
lemma higham9_16_fosterQ_le_iff_hat_le {k r : ℕ} (hr : 1 ≤ r)
    (hrk : r + 1 ≤ k + 1) {C t : ℝ} (hC : 0 < C) (ht : 0 < t) :
    t ≤ higham9_16_fosterQ (k + 1) (r + 1) C ↔
      t / (1 + t) ≤ higham9_16_fosterQ k r (C / (t * (1 + t) ^ k)) := by
  have hdt : (0 : ℝ) < 1 + t := by linarith
  have hChat_pos : (0 : ℝ) < C / (t * (1 + t) ^ k) := by positivity
  have htrans := higham9_16_fosterQStage_hat_transfer
    (k := k + 1) (r := r) (by omega) t (le_of_lt ht)
  simp only [Nat.add_sub_cancel] at htrans
  rw [higham9_16_le_fosterQ_iff (by omega) hC (le_of_lt ht),
    higham9_16_le_fosterQ_iff hr hChat_pos
      (div_nonneg (le_of_lt ht) (le_of_lt hdt)),
    htrans, ← le_div_iff₀ (by positivity : (0:ℝ) < t * (1 + t) ^ k)]

/-- **Foster (A.12)**, strict form: `q^(r+1) < t` at level `k+1` iff
`q̂^(r) < t/(1+t)` at level `k`. -/
lemma higham9_16_fosterQ_lt_iff_hat_lt {k r : ℕ} (hr : 1 ≤ r)
    (hrk : r + 1 ≤ k + 1) {C t : ℝ} (hC : 0 < C) (ht : 0 < t) :
    higham9_16_fosterQ (k + 1) (r + 1) C < t ↔
      higham9_16_fosterQ k r (C / (t * (1 + t) ^ k)) < t / (1 + t) := by
  rw [← not_le, ← not_le]
  exact not_congr (higham9_16_fosterQ_le_iff_hat_le hr hrk hC ht)

/-- **Foster (A.12), band-index form**: for a case-2 tail
(`q^(1) < t`), the level-`(k+1)` band index at `t` is one more than the
level-`k` band index of the hat image at the hatted constant. -/
lemma higham9_16_fosterBandIdx_hat {k : ℕ} {C t : ℝ} (hC : 0 < C)
    (ht : 0 < t) (htQ : higham9_16_fosterQ (k + 1) 1 C < t) :
    higham9_16_fosterBandIdx (k + 1) C t =
      higham9_16_fosterBandIdx k (C / (t * (1 + t) ^ k)) (t / (1 + t)) +
        1 := by
  classical
  unfold higham9_16_fosterBandIdx
  -- split off `r = 1` from `Icc 1 (k+1)`
  have hsplit : Finset.Icc 1 (k + 1) =
      insert 1 (Finset.Icc 2 (k + 1)) := by
    ext r
    simp only [Finset.mem_insert, Finset.mem_Icc]
    omega
  rw [hsplit, Finset.filter_insert, if_pos htQ]
  rw [Finset.card_insert_of_notMem (by
    intro hmem
    have := (Finset.mem_filter.mp hmem).1
    simp only [Finset.mem_Icc] at this
    omega)]
  congr 1
  -- the remaining stages biject with the level-`k` stages via `r ↦ r + 1`
  rw [show Finset.Icc 2 (k + 1) = (Finset.Icc 1 k).image (· + 1) from by
    ext r
    simp only [Finset.mem_Icc, Finset.mem_image]
    constructor
    · intro hr
      exact ⟨r - 1, by omega, by omega⟩
    · rintro ⟨s, hs, rfl⟩
      omega]
  rw [Finset.filter_image]
  rw [Finset.card_image_of_injective _ (fun a b hab => by omega)]
  congr 1
  apply Finset.filter_congr
  intro r hr
  simp only [Finset.mem_Icc] at hr
  exact higham9_16_fosterQ_lt_iff_hat_lt hr.1 (by omega) hC ht


/-! ## Equation (9.16) / Foster (A.14)-(A.16): band-formula composition -/

/-- **Foster (A.14)-(A.16) core**, the `p*` scaling identity: the level-`k`
shifted root at the hatted data, scaled by `1+t`, is the level-`(k+1)`
shifted root at the original data.  Here `m = k - j` and the constant
exponent collapse `(j-1)+(m+1) = j+m` makes the hatted constants match. -/
lemma higham9_16_fosterPStar_scale (m j : ℕ) (hj : 1 ≤ j) {C t : ℝ}
    (hC : 0 < C) (ht : 0 < t) :
    (1 + t) * higham9_16_fosterPStar m
        (1 + ((j - 1 : ℕ) : ℝ) * (t / (1 + t)))
        ((C / (t * (1 + t) ^ (j + m))) / (t / (1 + t)) ^ (j - 1)) =
      higham9_16_fosterPStar m (1 + (j : ℝ) * t) (C / t ^ j) := by
  have hdt : (0 : ℝ) < 1 + t := by linarith
  have hth : (0 : ℝ) < t / (1 + t) := by positivity
  have hshift_nonneg : (0 : ℝ) ≤ 1 + ((j - 1 : ℕ) : ℝ) * (t / (1 + t)) := by
    positivity
  have hChat_pos : (0 : ℝ) <
      (C / (t * (1 + t) ^ (j + m))) / (t / (1 + t)) ^ (j - 1) := by
    positivity
  have hp := higham9_16_fosterPStar_spec (m := m) hshift_nonneg hChat_pos
  set p := higham9_16_fosterPStar m
    (1 + ((j - 1 : ℕ) : ℝ) * (t / (1 + t)))
    ((C / (t * (1 + t) ^ (j + m))) / (t / (1 + t)) ^ (j - 1)) with hpdef
  -- the shift identity `1 + j t = (1+t)(1 + (j-1) t̂)`
  have hshift_eq : 1 + (j : ℝ) * t =
      (1 + t) * (1 + ((j - 1 : ℕ) : ℝ) * (t / (1 + t))) := by
    have h := higham9_16_one_add_mul_hat (((j - 1 : ℕ) : ℝ)) t
      (le_of_lt ht)
    rw [h]
    have hcast : ((j - 1 : ℕ) : ℝ) + 1 = (j : ℝ) := by
      push_cast [Nat.cast_sub hj]
      ring
    rw [hcast]
  -- apply uniqueness at the target root
  have hC_target_pos : (0 : ℝ) < C / t ^ j := by positivity
  apply higham9_16_fosterPStar_unique
    (by positivity : (0 : ℝ) ≤ 1 + (j : ℝ) * t) hC_target_pos
    (mul_nonneg (le_of_lt hdt) hp.1)
  -- compute the shifted stage value at `(1+t)p`
  unfold higham9_16_fosterQShift
  have hinner : 1 + (j : ℝ) * t + (1 + t) * p =
      (1 + t) * ((1 + ((j - 1 : ℕ) : ℝ) * (t / (1 + t))) + p) := by
    rw [hshift_eq]
    ring
  rw [hinner, mul_pow]
  have hq := hp.2
  unfold higham9_16_fosterQShift at hq
  -- rearrange to expose the level-`k` stage value
  have hrearrange : Real.sqrt ((m : ℝ) ^ m) * ((1 + t) * p) *
      ((1 + t) ^ m * ((1 + ((j - 1 : ℕ) : ℝ) * (t / (1 + t))) + p) ^ m) =
      (1 + t) ^ (m + 1) * (Real.sqrt ((m : ℝ) ^ m) * p *
        ((1 + ((j - 1 : ℕ) : ℝ) * (t / (1 + t))) + p) ^ m) := by
    rw [pow_succ]
    ring
  rw [hrearrange, hq]
  -- final constant collapse:
  -- `(1+t)^(m+1) · (C/(t(1+t)^(j+m)))/((t/(1+t))^(j-1)) = C/t^j`
  rw [div_pow]
  have hsplit : (1 + t) ^ (j + m) =
      (1 + t) ^ (j - 1) * (1 + t) ^ (m + 1) := by
    rw [← pow_add]
    congr 1
    omega
  have htj : t ^ j = t * t ^ (j - 1) := by
    conv_lhs => rw [show j = 1 + (j - 1) from by omega]
    rw [pow_add, pow_one]
  rw [hsplit, htj]
  field_simp


/-! ## Equation (9.16) / Foster (A.14)-(A.16): band-value composition -/

/-- **Foster (A.14)-(A.16)**, the case-2 slice value composes into the next
band's value: for a case-2 tail `t` (`q^(1) < t`),
`(1+t)·M(k, C/(t(1+t)^k), t/(1+t)) = M(k+1, C, t)`. -/
lemma higham9_16_fosterBandValue_hat_compose {k : ℕ} (hk : 1 ≤ k)
    {C t : ℝ} (hC : 0 < C) (ht : 0 < t)
    (htQ : higham9_16_fosterQ (k + 1) 1 C < t) :
    (1 + t) * higham9_16_fosterBandValue k (C / (t * (1 + t) ^ k))
        (t / (1 + t)) =
      higham9_16_fosterBandValue (k + 1) C t := by
  have hdt : (0 : ℝ) < 1 + t := by linarith
  have hidx := higham9_16_fosterBandIdx_hat (k := k) hC ht htQ
  set jhat := higham9_16_fosterBandIdx k (C / (t * (1 + t) ^ k))
    (t / (1 + t)) with hjhat
  unfold higham9_16_fosterBandValue
  rw [hidx, ← hjhat]
  by_cases hband : jhat + 2 ≤ k
  · -- both if-branches
    rw [if_pos hband, if_pos (by omega : jhat + 1 + 2 ≤ k + 1)]
    have hpre : k + 1 - (jhat + 1) - 1 = k - jhat - 1 := by omega
    rw [hpre]
    have hscale := higham9_16_fosterPStar_scale (k - jhat - 1) (jhat + 1)
      (by omega) hC ht
    rw [show jhat + 1 - 1 = jhat from by omega] at hscale
    rw [show jhat + 1 + (k - jhat - 1) = k from by omega] at hscale
    have hcast : ((jhat + 1 : ℕ) : ℝ) = (jhat : ℝ) + 1 := by
      push_cast
      ring
    -- Möbius shift: `1 + (jhat+1) t = (1+t)(1 + jhat t̂)`
    have hshift : 1 + ((jhat : ℝ) + 1) * t =
        (1 + t) * (1 + (jhat : ℝ) * (t / (1 + t))) := by
      have h := higham9_16_one_add_mul_hat ((jhat : ℝ)) t (le_of_lt ht)
      rw [h]
    rw [← hscale, hcast, hshift]
    ring
  · -- both else-branches: `(1+t)·Ĉ/t̂^(k-1) = C/t^k`
    rw [if_neg hband, if_neg (by omega : ¬ (jhat + 1 + 2 ≤ k + 1))]
    rw [show k + 1 - 1 = k from by omega]
    have hth_pow : (t / (1 + t)) ^ (k - 1) =
        t ^ (k - 1) / (1 + t) ^ (k - 1) := div_pow t (1 + t) (k - 1)
    rw [hth_pow]
    have hsplit : (1 + t) ^ k = (1 + t) ^ (k - 1) * (1 + t) := by
      conv_lhs => rw [show k = (k - 1) + 1 from by omega]
      rw [pow_succ]
    have htk : t ^ k = t * t ^ (k - 1) := by
      conv_lhs => rw [show k = 1 + (k - 1) from by omega]
      rw [pow_add, pow_one]
    rw [hsplit, htk]
    field_simp


/-! ## Equation (9.16) / Foster (A.17) replacement: the `phi` toolkit -/

/-- Discrete convexity bound: `y^j - x^j ≥ j x^(j-1) (y - x)` for
`0 ≤ x ≤ y`. -/
lemma higham9_16_pow_sub_pow_ge {j : ℕ} {x y : ℝ} (hx : 0 ≤ x)
    (hxy : x ≤ y) :
    (j : ℝ) * x ^ (j - 1) * (y - x) ≤ y ^ j - x ^ j := by
  have hgeom := geom_sum₂_mul y x j
  rw [← hgeom]
  apply mul_le_mul_of_nonneg_right ?_ (by linarith)
  calc (j : ℝ) * x ^ (j - 1) =
      ∑ _i ∈ Finset.range j, x ^ (j - 1) := by
        rw [Finset.sum_const, Finset.card_range]
        ring
    _ ≤ ∑ i ∈ Finset.range j, y ^ i * x ^ (j - 1 - i) := by
        apply Finset.sum_le_sum
        intro i hi
        have hij : i < j := Finset.mem_range.mp hi
        calc x ^ (j - 1) = x ^ i * x ^ (j - 1 - i) := by
              rw [← pow_add]
              congr 1
              omega
          _ ≤ y ^ i * x ^ (j - 1 - i) := by
              apply mul_le_mul_of_nonneg_right
                (pow_le_pow_left₀ hx hxy i) (by positivity)

/-- **Foster (A.17) replacement, zone-1 monotonicity**: the profile
`phi(x) = (a - jx) x^j` is strictly increasing on `[0, a/(j+1)]`. -/
lemma higham9_16_phi_strictMono {j : ℕ} (hj : 1 ≤ j) {a x y : ℝ}
    (hx : 0 ≤ x) (hxy : x < y) (hy : y * ((j : ℝ) + 1) ≤ a) :
    (a - (j : ℝ) * x) * x ^ j < (a - (j : ℝ) * y) * y ^ j := by
  have hy0 : 0 < y := lt_of_le_of_lt hx hxy
  have hay : y ≤ a - (j : ℝ) * y := by nlinarith
  rcases eq_or_lt_of_le hx with rfl | hx_pos
  · -- `x = 0`
    rw [zero_pow (by omega : j ≠ 0), mul_zero]
    apply mul_pos (by linarith) (by positivity)
  · -- `x > 0`
    have hkey := higham9_16_pow_sub_pow_ge (le_of_lt hx_pos)
      (le_of_lt hxy) (j := j)
    have hexpand : (a - (j : ℝ) * y) * y ^ j - (a - (j : ℝ) * x) * x ^ j =
        (a - (j : ℝ) * y) * (y ^ j - x ^ j) -
          (j : ℝ) * (y - x) * x ^ j := by
      ring
    have hstep1 : (a - (j : ℝ) * y) * ((j : ℝ) * x ^ (j - 1) * (y - x)) ≤
        (a - (j : ℝ) * y) * (y ^ j - x ^ j) := by
      apply mul_le_mul_of_nonneg_left hkey
      linarith
    have hxpow : x ^ j = x ^ (j - 1) * x := by
      conv_lhs => rw [show j = (j - 1) + 1 from by omega]
      rw [pow_succ]
    have hfinal : 0 < (a - (j : ℝ) * y) * ((j : ℝ) * x ^ (j - 1) * (y - x)) -
        (j : ℝ) * (y - x) * x ^ j := by
      rw [hxpow]
      have hfactor : (a - (j : ℝ) * y) * ((j : ℝ) * x ^ (j - 1) * (y - x)) -
          (j : ℝ) * (y - x) * (x ^ (j - 1) * x) =
          (j : ℝ) * (y - x) * x ^ (j - 1) * ((a - (j : ℝ) * y) - x) := by
        ring
      rw [hfactor]
      have hj_pos : (0 : ℝ) < (j : ℝ) := by exact_mod_cast hj
      have hpos : (0 : ℝ) < (a - (j : ℝ) * y) - x := by linarith
      apply mul_pos (mul_pos (mul_pos hj_pos (by linarith)) (by positivity))
        hpos
    linarith

/-- **Foster (A.17) replacement, peak bound** (the AM-GM instance):
`p x^j ≤ ((jx + p)/(j+1))^(j+1)` whenever `0 ≤ x ≤ p`. -/
lemma higham9_16_phi_le_peak {j : ℕ} (hj : 1 ≤ j) {x p : ℝ} (hx : 0 ≤ x)
    (hxp : x ≤ p) :
    p * x ^ j ≤ (((j : ℝ) * x + p) / ((j : ℝ) + 1)) ^ (j + 1) := by
  have hj1 : (0 : ℝ) < (j : ℝ) + 1 := by positivity
  set a : ℝ := (j : ℝ) * x + p with ha
  have hpeak_val : (a - (j : ℝ) * (a / ((j : ℝ) + 1))) *
      (a / ((j : ℝ) + 1)) ^ j = (a / ((j : ℝ) + 1)) ^ (j + 1) := by
    have hleft : a - (j : ℝ) * (a / ((j : ℝ) + 1)) = a / ((j : ℝ) + 1) := by
      field_simp
      ring
    rw [hleft, ← pow_succ']
  have hphi_x : p * x ^ j = (a - (j : ℝ) * x) * x ^ j := by
    rw [ha]
    ring_nf
  rw [hphi_x, ← hpeak_val]
  rcases eq_or_lt_of_le (show x ≤ a / ((j : ℝ) + 1) from by
    rw [ha, le_div_iff₀ hj1]
    nlinarith) with heq | hlt
  · rw [← heq]
  · exact le_of_lt (higham9_16_phi_strictMono hj hx hlt (by
      rw [div_mul_cancel₀ _ (ne_of_gt hj1)]))

/-- Comparison with a shifted root is equivalent to comparison of shifted
stage values. -/
lemma higham9_16_le_fosterPStar_iff {m : ℕ} {a C x : ℝ} (ha : 0 ≤ a)
    (hC : 0 < C) (hx : 0 ≤ x) :
    x ≤ higham9_16_fosterPStar m a C ↔
      higham9_16_fosterQShift m a x ≤ C := by
  have hp := higham9_16_fosterPStar_spec (m := m) ha hC
  have hmono := higham9_16_fosterQShift_strictMonoOn m ha
  constructor
  · intro hle
    rcases eq_or_lt_of_le hle with heq | hlt
    · rw [heq, hp.2]
    · have := hmono (Set.mem_Ici.mpr hx) (Set.mem_Ici.mpr hp.1) hlt
      rw [hp.2] at this
      linarith
  · intro hle
    by_contra hgt
    push_neg at hgt
    have := hmono (Set.mem_Ici.mpr hp.1) (Set.mem_Ici.mpr hx) hgt
    rw [hp.2] at this
    linarith

/-- **Foster's in-band characterization**: the (A.6) shifted root dominates
the tail exactly when the tail is below the next band root:
`P ≤ p*(P) ↔ P ≤ q^(j+1)`. -/
lemma higham9_16_fosterPStar_ge_tail_iff {K j : ℕ}
    (_hjK : j + 1 ≤ K) {C P : ℝ} (hC : 0 < C) (hP : 0 < P) :
    P ≤ higham9_16_fosterPStar (K - j - 1) (1 + (j : ℝ) * P) (C / P ^ j) ↔
      P ≤ higham9_16_fosterQ K (j + 1) C := by
  have hshift_nonneg : (0 : ℝ) ≤ 1 + (j : ℝ) * P := by positivity
  have hCP_pos : (0 : ℝ) < C / P ^ j := by positivity
  rw [higham9_16_le_fosterPStar_iff hshift_nonneg hCP_pos (le_of_lt hP),
    higham9_16_le_fosterQ_iff (by omega) hC (le_of_lt hP)]
  -- `QShift (K-j-1) (1+jP) P · P^j = QStage K (j+1) P`
  have hstage_eq : higham9_16_fosterQStage K (j + 1) P =
      higham9_16_fosterQShift (K - j - 1) (1 + (j : ℝ) * P) P * P ^ j := by
    unfold higham9_16_fosterQStage higham9_16_fosterQShift
    have hsub : K - (j + 1) = K - j - 1 := by omega
    rw [hsub]
    have hcast : ((j + 1 : ℕ) : ℝ) = (j : ℝ) + 1 := by push_cast; ring
    rw [hcast]
    have hinner : 1 + ((j : ℝ) + 1) * P = 1 + (j : ℝ) * P + P := by ring
    rw [hinner]
    have hpow : P ^ (j + 1) = P * P ^ j := by
      rw [pow_succ]
      ring
    rw [hpow]
    ring
  rw [hstage_eq, ← le_div_iff₀ (by positivity : (0 : ℝ) < P ^ j)]


/-! ## Equation (9.16) / Foster (A.17): in-band value monotonicity -/

/-- **Foster (A.17), derivative-free**: within a band, the (A.7) value
`1 + jP + p*(P)` is antitone in the tail `P`.  Stated with the in-band
conditions `Pᵢ ≤ p*(Pᵢ)` as explicit hypotheses (supplied in context by
`higham9_16_fosterPStar_ge_tail_iff`). -/
lemma higham9_16_fosterBandValue_inband_antitone {j m : ℕ} (hj : 1 ≤ j)
    (hm : 1 ≤ m) {C P₁ P₂ : ℝ} (hC : 0 < C) (hP₁ : 0 < P₁)
    (hP₁₂ : P₁ < P₂)
    (hin₁ : P₁ ≤ higham9_16_fosterPStar m (1 + (j : ℝ) * P₁) (C / P₁ ^ j))
    (hin₂ : P₂ ≤ higham9_16_fosterPStar m (1 + (j : ℝ) * P₂) (C / P₂ ^ j)) :
    1 + (j : ℝ) * P₂ +
        higham9_16_fosterPStar m (1 + (j : ℝ) * P₂) (C / P₂ ^ j) ≤
      1 + (j : ℝ) * P₁ +
        higham9_16_fosterPStar m (1 + (j : ℝ) * P₁) (C / P₁ ^ j) := by
  have hP₂ : (0 : ℝ) < P₂ := lt_trans hP₁ hP₁₂
  set p₁ := higham9_16_fosterPStar m (1 + (j : ℝ) * P₁) (C / P₁ ^ j)
    with hp₁def
  set p₂ := higham9_16_fosterPStar m (1 + (j : ℝ) * P₂) (C / P₂ ^ j)
    with hp₂def
  have hp₁_pos : 0 < p₁ := lt_of_lt_of_le hP₁ hin₁
  have hp₂_pos : 0 < p₂ := lt_of_lt_of_le hP₂ hin₂
  set y₁ : ℝ := 1 + (j : ℝ) * P₁ + p₁ with hy₁
  set y₂ : ℝ := 1 + (j : ℝ) * P₂ + p₂ with hy₂
  have hy₁_pos : (0 : ℝ) < y₁ := by
    rw [hy₁]
    positivity
  have hy₂_pos : (0 : ℝ) < y₂ := by
    rw [hy₂]
    positivity
  -- defining relations, cleared of square roots and divisions:
  -- `sqrt(m^m) · pᵢ · yᵢ^m · Pᵢ^j = C`
  have hD : (0 : ℝ) < Real.sqrt ((m : ℝ) ^ m) :=
    lt_of_lt_of_le one_pos (higham9_16_fosterQShift_sqrt_ge_one m)
  have hrel : ∀ (P p : ℝ), 0 < P →
      higham9_16_fosterQShift m (1 + (j : ℝ) * P) p = C / P ^ j →
      Real.sqrt ((m : ℝ) ^ m) * p * (1 + (j : ℝ) * P + p) ^ m * P ^ j =
        C := by
    intro P p hP hrel
    unfold higham9_16_fosterQShift at hrel
    have hPj : (0 : ℝ) < P ^ j := by positivity
    calc Real.sqrt ((m : ℝ) ^ m) * p * (1 + (j : ℝ) * P + p) ^ m * P ^ j
        = (C / P ^ j) * P ^ j := by rw [← hrel]
      _ = C := div_mul_cancel₀ C (ne_of_gt hPj)
  have hrel₁ := hrel P₁ p₁ hP₁
    ((higham9_16_fosterPStar_spec (by positivity) (by positivity)).2)
  have hrel₂ := hrel P₂ p₂ hP₂
    ((higham9_16_fosterPStar_spec (by positivity) (by positivity)).2)
  rw [← hy₁] at hrel₁
  rw [← hy₂] at hrel₂
  -- suppose `y₂ > y₁`; derive a contradiction
  by_contra hgt
  push_neg at hgt
  have hy₂₁ : y₁ < y₂ := hgt
  -- `p₁ P₁^j > p₂ P₂^j` from dividing the relations by `y`-powers
  have hstep1 : p₂ * y₁ ^ m * P₂ ^ j < p₂ * y₂ ^ m * P₂ ^ j := by
    have hpow : y₁ ^ m < y₂ ^ m :=
      pow_lt_pow_left₀ hy₂₁ (le_of_lt hy₁_pos) (by omega)
    have h1 : p₂ * y₁ ^ m < p₂ * y₂ ^ m :=
      mul_lt_mul_of_pos_left hpow hp₂_pos
    apply mul_lt_mul_of_pos_right h1 (by positivity)
  have hkey : p₂ * P₂ ^ j < p₁ * P₁ ^ j := by
    have hCeq : p₁ * y₁ ^ m * P₁ ^ j = p₂ * y₂ ^ m * P₂ ^ j := by
      have e₁ : Real.sqrt ((m : ℝ) ^ m) * (p₁ * y₁ ^ m * P₁ ^ j) = C := by
        rw [← hrel₁]
        ring
      have e₂ : Real.sqrt ((m : ℝ) ^ m) * (p₂ * y₂ ^ m * P₂ ^ j) = C := by
        rw [← hrel₂]
        ring
      have := e₁.trans e₂.symm
      exact mul_left_cancel₀ (ne_of_gt hD) this
    have hlt : p₂ * y₁ ^ m * P₂ ^ j < p₁ * y₁ ^ m * P₁ ^ j := by
      rw [hCeq]
      exact hstep1
    have hy₁m : (0 : ℝ) < y₁ ^ m := by positivity
    nlinarith [hy₁m]
  -- `phi` comparison at `a := y₁ - 1`
  have hphi : (y₁ - 1 - (j : ℝ) * P₂) * P₂ ^ j < p₁ * P₁ ^ j := by
    have hp₂_gt : y₁ - 1 - (j : ℝ) * P₂ < p₂ := by
      rw [hy₂] at hy₂₁
      linarith
    calc (y₁ - 1 - (j : ℝ) * P₂) * P₂ ^ j
        < p₂ * P₂ ^ j := by
          apply mul_lt_mul_of_pos_right hp₂_gt (by positivity)
      _ < p₁ * P₁ ^ j := hkey
  -- two zones on `P₂` versus `(y₁-1)/(j+1)`
  have hp₁_eq : p₁ = (y₁ - 1) - (j : ℝ) * P₁ := by
    rw [hy₁]
    ring
  rcases le_or_gt (P₂ * ((j : ℝ) + 1)) (y₁ - 1) with hzone | hzone
  · -- zone 1: `phi` strictly increasing gives the reverse inequality
    have hmono := higham9_16_phi_strictMono hj (le_of_lt hP₁) hP₁₂ hzone
      (a := y₁ - 1)
    rw [← hp₁_eq] at hmono
    linarith
  · -- zone 2: the peak bound caps `p₁ P₁^j` strictly below `P₂^(j+1)`
    have hin_peak : p₁ * P₁ ^ j ≤
        (((j : ℝ) * P₁ + p₁) / ((j : ℝ) + 1)) ^ (j + 1) :=
      higham9_16_phi_le_peak hj (le_of_lt hP₁) hin₁
    have hpeak_eq : ((j : ℝ) * P₁ + p₁) / ((j : ℝ) + 1) =
        (y₁ - 1) / ((j : ℝ) + 1) := by
      rw [hy₁]
      ring_nf
    have hlt_P₂ : (y₁ - 1) / ((j : ℝ) + 1) < P₂ := by
      rw [div_lt_iff₀ (by positivity : (0 : ℝ) < (j : ℝ) + 1)]
      linarith
    have hbound : p₁ * P₁ ^ j < P₂ ^ (j + 1) := by
      calc p₁ * P₁ ^ j
          ≤ ((y₁ - 1) / ((j : ℝ) + 1)) ^ (j + 1) := by
            rw [← hpeak_eq]
            exact hin_peak
        _ < P₂ ^ (j + 1) := by
            apply pow_lt_pow_left₀ hlt_P₂ ?_ (by omega)
            apply div_nonneg ?_ (by positivity)
            rw [hy₁]
            nlinarith [hp₁_pos, hP₁]
    -- but zone 2 + in-band at `P₂` force `p₁ P₁^j > P₂^(j+1)`
    have hy₂_ge : 1 + ((j : ℝ) + 1) * P₂ ≤ y₂ := by
      rw [hy₂]
      have : P₂ ≤ p₂ := hin₂
      nlinarith
    have hforce : P₂ ^ (j + 1) < p₁ * P₁ ^ j := by
      have hCeq : p₁ * y₁ ^ m * P₁ ^ j = p₂ * y₂ ^ m * P₂ ^ j := by
        have e₁ : Real.sqrt ((m : ℝ) ^ m) * (p₁ * y₁ ^ m * P₁ ^ j) = C := by
          rw [← hrel₁]
          ring
        have e₂ : Real.sqrt ((m : ℝ) ^ m) * (p₂ * y₂ ^ m * P₂ ^ j) = C := by
          rw [← hrel₂]
          ring
        exact mul_left_cancel₀ (ne_of_gt hD) (e₁.trans e₂.symm)
      have h1 : P₂ * y₂ ^ m * P₂ ^ j ≤ p₂ * y₂ ^ m * P₂ ^ j := by
        apply mul_le_mul_of_nonneg_right ?_ (by positivity)
        apply mul_le_mul_of_nonneg_right hin₂ (by positivity)
      have h2 : P₂ * y₁ ^ m * P₂ ^ j < P₂ * y₂ ^ m * P₂ ^ j := by
        have hpow : y₁ ^ m < y₂ ^ m :=
          pow_lt_pow_left₀ hy₂₁ (le_of_lt hy₁_pos) (by omega)
        apply mul_lt_mul_of_pos_right
          (mul_lt_mul_of_pos_left hpow hP₂) (by positivity)
      have h3 : P₂ ^ (j + 1) * y₁ ^ m < p₁ * y₁ ^ m * P₁ ^ j := by
        calc P₂ ^ (j + 1) * y₁ ^ m
            = P₂ * y₁ ^ m * P₂ ^ j := by
              rw [pow_succ]
              ring
          _ < P₂ * y₂ ^ m * P₂ ^ j := h2
          _ ≤ p₂ * y₂ ^ m * P₂ ^ j := h1
          _ = p₁ * y₁ ^ m * P₁ ^ j := hCeq.symm
      have hy₁m : (0 : ℝ) < y₁ ^ m := by positivity
      nlinarith [hy₁m]
    linarith


/-! ## Equation (9.16) / Foster band-edge gluing gadgets -/

/-- Mirrored root comparison: `q^(r) ≤ x ↔ C ≤ QStage_r(x)`. -/
lemma higham9_16_fosterQ_le_iff {k r : ℕ} (hr : 1 ≤ r) {C x : ℝ}
    (hC : 0 < C) (hx : 0 ≤ x) :
    higham9_16_fosterQ k r C ≤ x ↔
      C ≤ higham9_16_fosterQStage k r x := by
  have hq0 : 0 ≤ higham9_16_fosterQ k r C :=
    higham9_16_fosterQ_nonneg (k := k) hr hC
  have hmono := higham9_16_fosterQStage_strictMonoOn k r hr
  constructor
  · intro hle
    rcases eq_or_lt_of_le hle with heq | hlt
    · rw [← heq, higham9_16_fosterQ_eq (k := k) hr hC]
    · have := hmono (Set.mem_Ici.mpr hq0) (Set.mem_Ici.mpr hx) hlt
      rw [higham9_16_fosterQ_eq (k := k) hr hC] at this
      linarith
  · intro hle
    by_contra hgt
    push_neg at hgt
    have := hmono (Set.mem_Ici.mpr hx) (Set.mem_Ici.mpr hq0) hgt
    rw [higham9_16_fosterQ_eq (k := k) hr hC] at this
    linarith

/-- Mirrored shifted-root comparison: `p* ≤ x ↔ C ≤ QShift(x)`. -/
lemma higham9_16_fosterPStar_le_iff {m : ℕ} {a C x : ℝ} (ha : 0 ≤ a)
    (hC : 0 < C) (hx : 0 ≤ x) :
    higham9_16_fosterPStar m a C ≤ x ↔
      C ≤ higham9_16_fosterQShift m a x := by
  have hp := higham9_16_fosterPStar_spec (m := m) ha hC
  have hmono := higham9_16_fosterQShift_strictMonoOn m ha
  constructor
  · intro hle
    rcases eq_or_lt_of_le hle with heq | hlt
    · rw [← heq, hp.2]
    · have := hmono (Set.mem_Ici.mpr hp.1) (Set.mem_Ici.mpr hx) hlt
      rw [hp.2] at this
      linarith
  · intro hle
    by_contra hgt
    push_neg at hgt
    have := hmono (Set.mem_Ici.mpr hx) (Set.mem_Ici.mpr hp.1) hgt
    rw [hp.2] at this
    linarith

/-- Mirrored in-band characterization: `p*(P) ≤ P ↔ q^(j+1) ≤ P`. -/
lemma higham9_16_fosterPStar_le_tail_iff {K j : ℕ}
    (_hjK : j + 1 ≤ K) {C P : ℝ} (hC : 0 < C) (hP : 0 < P) :
    higham9_16_fosterPStar (K - j - 1) (1 + (j : ℝ) * P) (C / P ^ j) ≤ P ↔
      higham9_16_fosterQ K (j + 1) C ≤ P := by
  have hshift_nonneg : (0 : ℝ) ≤ 1 + (j : ℝ) * P := by positivity
  have hCP_pos : (0 : ℝ) < C / P ^ j := by positivity
  rw [higham9_16_fosterPStar_le_iff hshift_nonneg hCP_pos (le_of_lt hP),
    higham9_16_fosterQ_le_iff (by omega) hC (le_of_lt hP)]
  have hstage_eq : higham9_16_fosterQStage K (j + 1) P =
      higham9_16_fosterQShift (K - j - 1) (1 + (j : ℝ) * P) P * P ^ j := by
    unfold higham9_16_fosterQStage higham9_16_fosterQShift
    have hsub : K - (j + 1) = K - j - 1 := by omega
    rw [hsub]
    have hcast : ((j + 1 : ℕ) : ℝ) = (j : ℝ) + 1 := by push_cast; ring
    rw [hcast]
    have hinner : 1 + ((j : ℝ) + 1) * P = 1 + (j : ℝ) * P + P := by ring
    rw [hinner]
    have hpow : P ^ (j + 1) = P * P ^ j := by
      rw [pow_succ]
      ring
    rw [hpow]
    ring
  rw [hstage_eq, ← div_le_iff₀ (by positivity : (0 : ℝ) < P ^ j)]

/-- The band index is monotone in the tail. -/
lemma higham9_16_fosterBandIdx_mono {k : ℕ} {C P₁ P₂ : ℝ} (h : P₁ ≤ P₂) :
    higham9_16_fosterBandIdx k C P₁ ≤ higham9_16_fosterBandIdx k C P₂ := by
  unfold higham9_16_fosterBandIdx
  apply Finset.card_le_card
  intro r hr
  rw [Finset.mem_filter] at hr ⊢
  exact ⟨hr.1, lt_of_lt_of_le hr.2 h⟩

/-- **Band-edge value**: at the edge `e = q^(j+1)`, the band-`(j+1)` shifted
root is `s_(K-j-1)` times the shift. -/
lemma higham9_16_fosterPStar_at_edge {K j : ℕ}
    (hjK : j + 2 ≤ K) {C : ℝ} (hC : 0 < C) :
    higham9_16_fosterPStar (K - j - 2)
        (1 + ((j + 1 : ℕ) : ℝ) * higham9_16_fosterQ K (j + 1) C)
        (C / higham9_16_fosterQ K (j + 1) C ^ (j + 1)) =
      higham9_16_fosterS (K - j - 1) *
        (1 + ((j + 1 : ℕ) : ℝ) * higham9_16_fosterQ K (j + 1) C) := by
  set e := higham9_16_fosterQ K (j + 1) C with hedef
  have he_pos : 0 < e := higham9_16_fosterQ_pos (k := K) (by omega) hC
  set a : ℝ := 1 + ((j + 1 : ℕ) : ℝ) * e with ha
  have ha_pos : (0 : ℝ) < a := by
    rw [ha]
    positivity
  have hs_pos : 0 < higham9_16_fosterS (K - j - 1) :=
    higham9_16_fosterS_pos (by omega)
  have hCe_pos : (0 : ℝ) < C / e ^ (j + 1) := by positivity
  symm
  apply higham9_16_fosterPStar_unique (le_of_lt ha_pos) hCe_pos
    (by positivity)
  -- `QShift M a (s·a) = sqrt(M^M) s (1+s)^M a^(M+1)`
  unfold higham9_16_fosterQShift
  have hexpand : Real.sqrt (((K - j - 2 : ℕ) : ℝ) ^ (K - j - 2)) *
      (higham9_16_fosterS (K - j - 1) * a) *
      (a + higham9_16_fosterS (K - j - 1) * a) ^ (K - j - 2) =
      Real.sqrt (((K - j - 2 : ℕ) : ℝ) ^ (K - j - 2)) *
        (higham9_16_fosterS (K - j - 1) *
          (1 + higham9_16_fosterS (K - j - 1)) ^ (K - j - 2)) *
        a ^ (K - j - 2 + 1) := by
    have hfactor : a + higham9_16_fosterS (K - j - 1) * a =
        a * (1 + higham9_16_fosterS (K - j - 1)) := by ring
    rw [hfactor, mul_pow, pow_succ]
    ring
  rw [hexpand]
  -- the stage relation of `s_(K-j-1)`
  have hs_eq := higham9_16_fosterS_eq (K - j - 1) (by omega)
  rw [show K - j - 1 - 1 = K - j - 2 from by omega] at hs_eq
  rw [hs_eq]
  -- unfold the stage constant and collapse the square roots
  unfold higham9_16_fosterStageConst
  rw [show K - j - 1 - 1 = K - j - 2 from by omega]
  have hden_pos : (0 : ℝ) <
      Real.sqrt (((K - j - 2 : ℕ) : ℝ) ^ (K - j - 2)) := by
    have := higham9_16_fosterQShift_sqrt_ge_one (K - j - 2)
    linarith
  rw [mul_div_assoc']
  rw [mul_div_cancel_left₀ _ (ne_of_gt hden_pos)]
  -- remaining: `sqrt((K-j-1)^(K-j-1)) · a^(K-j-1) = C / e^(j+1)`
  rw [show K - j - 2 + 1 = K - j - 1 from by omega]
  -- from the defining relation of the edge root
  have he_eq := higham9_16_fosterQ_eq (k := K) (r := j + 1) (by omega) hC
  rw [← hedef] at he_eq
  unfold higham9_16_fosterQStage at he_eq
  rw [show K - (j + 1) = K - j - 1 from by omega, ← ha] at he_eq
  rw [eq_div_iff (ne_of_gt (by positivity : (0 : ℝ) < e ^ (j + 1)))]
  calc Real.sqrt (((K - j - 1 : ℕ) : ℝ) ^ (K - j - 1)) * a ^ (K - j - 1) *
      e ^ (j + 1)
      = Real.sqrt (((K - j - 1 : ℕ) : ℝ) ^ (K - j - 1)) * e ^ (j + 1) *
        a ^ (K - j - 1) := by ring
    _ = C := he_eq


/-! ## Equation (9.16) / Foster band gluing and band characterization -/

/-- With Lemma A.3 the band roots are monotone in the stage. -/
lemma higham9_16_fosterQ_mono_stage {k : ℕ} (hk : 2 ≤ k) {C : ℝ}
    (hC : 0 < C) (hCle : C ≤ Real.sqrt ((k : ℝ) ^ k)) {r r' : ℕ}
    (hr : 1 ≤ r) (hrr' : r ≤ r') (hr'k : r' ≤ k) :
    higham9_16_fosterQ k r C ≤ higham9_16_fosterQ k r' C := by
  induction r' with
  | zero => omega
  | succ n ihn =>
      rcases Nat.lt_or_ge n r with hlt | hge
      · have : r = n + 1 := by omega
        rw [this]
      · have h1 := ihn (by omega) (by omega)
        have h2 := higham9_16_fosterQ_lt_succ k hk C hC hCle n (by omega)
          (by omega)
        linarith

/-- At the right edge of its band, the shifted root equals the edge:
`p*_j(q^(j+1)) = q^(j+1)`. -/
lemma higham9_16_fosterPStar_eq_at_edge {K j : ℕ}
    (hjK : j + 1 ≤ K) {C : ℝ} (hC : 0 < C) :
    higham9_16_fosterPStar (K - j - 1)
        (1 + (j : ℝ) * higham9_16_fosterQ K (j + 1) C)
        (C / higham9_16_fosterQ K (j + 1) C ^ j) =
      higham9_16_fosterQ K (j + 1) C := by
  set e := higham9_16_fosterQ K (j + 1) C with hedef
  have he_pos : 0 < e := higham9_16_fosterQ_pos (k := K) (by omega) hC
  apply le_antisymm
  · exact (higham9_16_fosterPStar_le_tail_iff hjK hC he_pos).mpr le_rfl
  · exact (higham9_16_fosterPStar_ge_tail_iff hjK hC he_pos).mpr le_rfl

/-- **Band gluing (if-if edges)**: at the edge `e = q^(j+1)`, the band-`j`
formula (whose shifted root degenerates to `e`) equals the band-`(j+1)`
formula. -/
lemma higham9_16_band_formula_glue {K j : ℕ} (hjK : j + 3 ≤ K) {C : ℝ}
    (hC : 0 < C) :
    higham9_16_fosterT (K - j - 1) *
        (1 + (j : ℝ) * higham9_16_fosterQ K (j + 1) C +
          higham9_16_fosterQ K (j + 1) C) =
      higham9_16_fosterT (K - j - 2) *
        (1 + ((j + 1 : ℕ) : ℝ) * higham9_16_fosterQ K (j + 1) C +
          higham9_16_fosterPStar (K - j - 2)
            (1 + ((j + 1 : ℕ) : ℝ) * higham9_16_fosterQ K (j + 1) C)
            (C / higham9_16_fosterQ K (j + 1) C ^ (j + 1))) := by
  set e := higham9_16_fosterQ K (j + 1) C with hedef
  rw [higham9_16_fosterPStar_at_edge (by omega : j + 2 ≤ K) hC]
  rw [← hedef]
  have hT := higham9_16_fosterT_succ (n := K - j - 2) (by omega)
  rw [show K - j - 2 + 1 = K - j - 1 from by omega] at hT
  rw [hT]
  have hcast : ((j + 1 : ℕ) : ℝ) = (j : ℝ) + 1 := by push_cast; ring
  rw [hcast]
  ring

/-- **Band gluing (last if-band to the (A.8) band)**: at the edge
`e = q^(K-1)` the band-`(K-2)` formula equals `C/e^(K-1)`. -/
lemma higham9_16_band_formula_glue_last {K : ℕ} (hK : 2 ≤ K) {C : ℝ}
    (hC : 0 < C) :
    higham9_16_fosterT 1 *
        (1 + ((K - 2 : ℕ) : ℝ) * higham9_16_fosterQ K (K - 1) C +
          higham9_16_fosterQ K (K - 1) C) =
      C / higham9_16_fosterQ K (K - 1) C ^ (K - 1) := by
  set e := higham9_16_fosterQ K (K - 1) C with hedef
  have he_pos : 0 < e := higham9_16_fosterQ_pos (k := K) (by omega) hC
  rw [higham9_16_fosterT_one, one_mul]
  -- the defining relation of `e` at stage `K-1`
  have he_eq := higham9_16_fosterQ_eq (k := K) (r := K - 1) (by omega) hC
  rw [← hedef] at he_eq
  unfold higham9_16_fosterQStage at he_eq
  rw [show K - (K - 1) = 1 from by omega] at he_eq
  simp only [pow_one] at he_eq
  rw [show (((1 : ℕ) : ℝ)) = (1 : ℝ) from by norm_num, Real.sqrt_one,
    one_mul] at he_eq
  -- `e^(K-1) (1 + (K-1) e) = C`
  rw [eq_div_iff (ne_of_gt (by positivity : (0 : ℝ) < e ^ (K - 1)))]
  have hcast : ((K - 1 : ℕ) : ℝ) = ((K - 2 : ℕ) : ℝ) + 1 := by
    push_cast [Nat.cast_sub (by omega : 1 ≤ K), Nat.cast_sub (by omega : 2 ≤ K)]
    ring
  calc (1 + ((K - 2 : ℕ) : ℝ) * e + e) * e ^ (K - 1)
      = e ^ (K - 1) * (1 + ((K - 1 : ℕ) : ℝ) * e) := by
        rw [hcast]
        ring
    _ = C := he_eq


/-! ## Equation (9.16) / Foster band-index characterization -/

/-- The band filter is an initial segment: with A.3 it equals
`Icc 1 (bandIdx)`. -/
lemma higham9_16_fosterBandIdx_filter_eq {k : ℕ} (hk : 2 ≤ k) {C P : ℝ}
    (hC : 0 < C) (hCle : C ≤ Real.sqrt ((k : ℝ) ^ k)) :
    (Finset.Icc 1 k).filter
        (fun r => higham9_16_fosterQ k r C < P) =
      Finset.Icc 1 (higham9_16_fosterBandIdx k C P) := by
  classical
  set F := (Finset.Icc 1 k).filter
    (fun r => higham9_16_fosterQ k r C < P) with hF
  set j := higham9_16_fosterBandIdx k C P with hj
  have hcard : F.card = j := rfl
  -- downward closure
  have hdc : ∀ r r' : ℕ, 1 ≤ r → r ≤ r' → r' ∈ F → r ∈ F := by
    intro r r' hr hrr' hr'
    rw [hF, Finset.mem_filter, Finset.mem_Icc] at hr' ⊢
    refine ⟨⟨hr, by omega⟩, ?_⟩
    calc higham9_16_fosterQ k r C
        ≤ higham9_16_fosterQ k r' C :=
          higham9_16_fosterQ_mono_stage hk hC hCle hr hrr' hr'.1.2
      _ < P := hr'.2
  -- every member is at most `j`
  have hub : ∀ r ∈ F, r ≤ j := by
    intro r hr
    by_contra hgt
    push_neg at hgt
    have hsub : Finset.Icc 1 r ⊆ F := by
      intro s hs
      rw [Finset.mem_Icc] at hs
      exact hdc s r hs.1 hs.2 hr
    have := Finset.card_le_card hsub
    rw [Nat.card_Icc] at this
    omega
  -- every index up to `j` is a member
  have hlb : ∀ r : ℕ, 1 ≤ r → r ≤ j → r ∈ F := by
    intro r hr hrj
    by_contra hnot
    have hsub : F ⊆ Finset.Icc 1 (r - 1) := by
      intro s hs
      rw [Finset.mem_Icc]
      have hs1 : 1 ≤ s := by
        have := (Finset.mem_filter.mp (hF ▸ hs)).1
        rw [Finset.mem_Icc] at this
        exact this.1
      refine ⟨hs1, ?_⟩
      by_contra hbig
      push_neg at hbig
      exact hnot (hdc r s hr (by omega) hs)
    have := Finset.card_le_card hsub
    rw [Nat.card_Icc] at this
    omega
  ext r
  rw [Finset.mem_Icc]
  constructor
  · intro hr
    have h1 : 1 ≤ r := by
      have := (Finset.mem_filter.mp (hF ▸ hr)).1
      rw [Finset.mem_Icc] at this
      exact this.1
    exact ⟨h1, hub r hr⟩
  · intro hr
    exact hlb r hr.1 hr.2

/-- **Band membership specification**: the index `j = bandIdx k C P`
satisfies `j ≤ k`, `q^(j) < P` when `j ≥ 1`, and `P ≤ q^(j+1)` when
`j < k`. -/
lemma higham9_16_fosterBandIdx_spec {k : ℕ} (hk : 2 ≤ k) {C P : ℝ}
    (hC : 0 < C) (hCle : C ≤ Real.sqrt ((k : ℝ) ^ k)) :
    higham9_16_fosterBandIdx k C P ≤ k ∧
      (1 ≤ higham9_16_fosterBandIdx k C P →
        higham9_16_fosterQ k (higham9_16_fosterBandIdx k C P) C < P) ∧
      (higham9_16_fosterBandIdx k C P < k →
        P ≤ higham9_16_fosterQ k
          (higham9_16_fosterBandIdx k C P + 1) C) := by
  classical
  have hfe := higham9_16_fosterBandIdx_filter_eq hk hC hCle (P := P)
  set j := higham9_16_fosterBandIdx k C P with hj
  have hjk : j ≤ k := by
    have hcard : ((Finset.Icc 1 k).filter
        (fun r => higham9_16_fosterQ k r C < P)).card = j := rfl
    have := Finset.card_filter_le (Finset.Icc 1 k)
      (fun r => higham9_16_fosterQ k r C < P)
    rw [hcard, Nat.card_Icc] at this
    omega
  refine ⟨hjk, ?_, ?_⟩
  · intro hj1
    have hmem : j ∈ Finset.Icc 1 j := by
      rw [Finset.mem_Icc]
      omega
    rw [← hfe, Finset.mem_filter] at hmem
    exact hmem.2
  · intro hjlt
    by_contra hgt
    push_neg at hgt
    have hmem : j + 1 ∈ (Finset.Icc 1 k).filter
        (fun r => higham9_16_fosterQ k r C < P) := by
      rw [Finset.mem_filter, Finset.mem_Icc]
      exact ⟨⟨by omega, by omega⟩, hgt⟩
    rw [hfe, Finset.mem_Icc] at hmem
    omega


/-! ## Equation (9.16) / Foster: global tail antitonicity of the band value -/

/-- The band index at the root `q^(j+1)` is exactly `j`. -/
lemma higham9_16_fosterBandIdx_at_root {k j : ℕ} (hk : 2 ≤ k)
    (hjk : j + 1 ≤ k) {C : ℝ} (hC : 0 < C)
    (hCle : C ≤ Real.sqrt ((k : ℝ) ^ k)) :
    higham9_16_fosterBandIdx k C (higham9_16_fosterQ k (j + 1) C) = j := by
  classical
  unfold higham9_16_fosterBandIdx
  have hset : (Finset.Icc 1 k).filter
      (fun r => higham9_16_fosterQ k r C <
        higham9_16_fosterQ k (j + 1) C) = Finset.Icc 1 j := by
    ext r
    rw [Finset.mem_filter, Finset.mem_Icc, Finset.mem_Icc]
    constructor
    · rintro ⟨⟨hr1, hrk⟩, hlt⟩
      refine ⟨hr1, ?_⟩
      by_contra hgt
      push_neg at hgt
      have := higham9_16_fosterQ_mono_stage hk hC hCle
        (by omega : 1 ≤ j + 1) (by omega : j + 1 ≤ r) hrk
      linarith
    · rintro ⟨hr1, hrj⟩
      have hrk : r ≤ k := by omega
      refine ⟨⟨hr1, hrk⟩, ?_⟩
      have hj1 : 1 ≤ j := by omega
      calc higham9_16_fosterQ k r C
          ≤ higham9_16_fosterQ k j C :=
            higham9_16_fosterQ_mono_stage hk hC hCle hr1 hrj (by omega)
        _ < higham9_16_fosterQ k (j + 1) C :=
            higham9_16_fosterQ_lt_succ k hk C hC hCle j hj1 hjk
  rw [hset, Nat.card_Icc]
  omega

/-- The band value at the edge `e = q^(j+1)` (whose index is `j`) equals the
band-`(j+1)` formula shape `fosterT(K-j-1)·(1+j·e+e)`, uniformly. -/
lemma higham9_16_fosterBandValue_at_root {K j : ℕ} (hK : 2 ≤ K)
    (hjK : j + 2 ≤ K) {C : ℝ} (hC : 0 < C)
    (hCle : C ≤ Real.sqrt ((K : ℝ) ^ K)) :
    higham9_16_fosterBandValue K C (higham9_16_fosterQ K (j + 1) C) =
      higham9_16_fosterT (K - j - 1) *
        (1 + (j : ℝ) * higham9_16_fosterQ K (j + 1) C +
          higham9_16_fosterQ K (j + 1) C) := by
  set e := higham9_16_fosterQ K (j + 1) C with hedef
  have hidx_e : higham9_16_fosterBandIdx K C e = j := by
    rw [hedef]
    exact higham9_16_fosterBandIdx_at_root hK (by omega) hC hCle
  unfold higham9_16_fosterBandValue
  rw [hidx_e]
  rw [if_pos hjK]
  have heq := higham9_16_fosterPStar_eq_at_edge (K := K) (j := j)
    (by omega) hC
  rw [← hedef] at heq
  rw [heq]

/-- **Global tail antitonicity of the band value**: for `0 ≤ P ≤ t`,
`M(K, C, t) ≤ M(K, C, P)`. -/
theorem higham9_16_fosterBandValue_antitone {K : ℕ} (hK : 2 ≤ K)
    {C P : ℝ} (hC : 0 < C) (hCle : C ≤ Real.sqrt ((K : ℝ) ^ K))
    (_hP : 0 ≤ P) :
    ∀ n : ℕ, ∀ t : ℝ, 0 < t → P ≤ t →
      higham9_16_fosterBandIdx K C t = n →
      higham9_16_fosterBandValue K C t ≤
        higham9_16_fosterBandValue K C P := by
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ihn =>
    intro t ht hPt hidx
    rcases Nat.eq_zero_or_pos n with rfl | hn
    · -- band 0 on both sides
      have hidxP : higham9_16_fosterBandIdx K C P = 0 := by
        have := higham9_16_fosterBandIdx_mono (k := K) (C := C) hPt
        omega
      rw [higham9_16_fosterBandValue_of_idx_zero hK hC hidx,
        higham9_16_fosterBandValue_of_idx_zero hK hC hidxP]
    · -- band `n ≥ 1`
      have hspec := higham9_16_fosterBandIdx_spec hK hC hCle (P := t)
      rw [hidx] at hspec
      obtain ⟨hnK, hlow, hhigh⟩ := hspec
      have hQt : higham9_16_fosterQ K n C < t := hlow hn
      have hidxP_le : higham9_16_fosterBandIdx K C P ≤ n := by
        have := higham9_16_fosterBandIdx_mono (k := K) (C := C) hPt
        omega
      rcases eq_or_lt_of_le hidxP_le with heq | hlt
      · -- same band: direct comparison
        have hspecP := higham9_16_fosterBandIdx_spec hK hC hCle (P := P)
        rw [heq] at hspecP
        obtain ⟨_, hlowP, hhighP⟩ := hspecP
        have hQP : higham9_16_fosterQ K n C < P := hlowP hn
        have hP_pos : 0 < P :=
          lt_of_le_of_lt (higham9_16_fosterQ_nonneg (k := K) hn hC) hQP
        unfold higham9_16_fosterBandValue
        rw [hidx, heq]
        by_cases hband : n + 2 ≤ K
        · rw [if_pos hband, if_pos hband]
          rcases eq_or_lt_of_le hPt with rfl | hPt'
          · exact le_refl _
          · apply mul_le_mul_of_nonneg_left ?_
              (le_of_lt (higham9_16_fosterT_pos (K - n - 1)))
            exact higham9_16_fosterBandValue_inband_antitone hn
              (by omega : 1 ≤ K - n - 1) hC hP_pos hPt'
              ((higham9_16_fosterPStar_ge_tail_iff (by omega) hC
                hP_pos).mpr (hhighP (by omega)))
              ((higham9_16_fosterPStar_ge_tail_iff (by omega) hC
                ht).mpr (hhigh (by omega)))
        · rw [if_neg hband, if_neg hband]
          apply div_le_div_of_nonneg_left (le_of_lt hC) (by positivity)
          exact pow_le_pow_left₀ (le_of_lt hP_pos) hPt (K - 1)
      · -- strictly lower band: descend through the left edge `e = q^(n)`
        set e := higham9_16_fosterQ K n C with hedef
        have he_pos : 0 < e := higham9_16_fosterQ_pos (k := K) hn hC
        have hPe : P ≤ e := by
          have hspecP := higham9_16_fosterBandIdx_spec hK hC hCle (P := P)
          obtain ⟨hjP, _, hhighP⟩ := hspecP
          have h1 := hhighP (by omega)
          have h2 : higham9_16_fosterQ K
              (higham9_16_fosterBandIdx K C P + 1) C ≤ e := by
            rw [hedef]
            exact higham9_16_fosterQ_mono_stage hK hC hCle
              (by omega) (by omega) (by omega)
          linarith
        have hidx_e : higham9_16_fosterBandIdx K C e = n - 1 := by
          rw [hedef, show n = (n - 1) + 1 from by omega]
          exact higham9_16_fosterBandIdx_at_root hK (by omega) hC hCle
        -- `M t ≤ M e`
        have hstep : higham9_16_fosterBandValue K C t ≤
            higham9_16_fosterBandValue K C e := by
          by_cases hband : n + 2 ≤ K
          · -- if-band: in-band antitone from `e` to `t`, then rewrite via glue
            have hval_t : higham9_16_fosterBandValue K C t =
                higham9_16_fosterT (K - n - 1) *
                  (1 + (n : ℝ) * t + higham9_16_fosterPStar (K - n - 1)
                    (1 + (n : ℝ) * t) (C / t ^ n)) := by
              unfold higham9_16_fosterBandValue
              rw [hidx, if_pos hband]
            have hval_e := higham9_16_fosterBandValue_at_root (K := K)
              (j := n - 1) hK (by omega) hC hCle
            rw [show (n - 1) + 1 = n from by omega, ← hedef] at hval_e
            have hmono := higham9_16_fosterBandValue_inband_antitone hn
              (by omega : 1 ≤ K - n - 1) hC he_pos hQt
              ((higham9_16_fosterPStar_ge_tail_iff (by omega) hC
                he_pos).mpr (by
                  rw [hedef]
                  exact le_of_lt (higham9_16_fosterQ_lt_succ K hK C hC
                    hCle n hn (by omega))))
              ((higham9_16_fosterPStar_ge_tail_iff (by omega) hC
                ht).mpr (hhigh (by omega)))
            -- the glue: band-`(n-1)` value at `e` equals the band-`n`
            -- formula with `p* = e`... use `fosterBandValue_at_root` plus
            -- the (A.14) shape: the in-band bound lands on
            -- `fosterT(K-n-1)·(1+n·e+p*_n(e))` and `p*_n(e) = e` is false
            -- in general; instead compare through the value at the edge:
            -- `formula_n(e) = fosterT(K-(n-1)-1)-shape` is exactly
            -- the gluing lemma.
            have hglue := higham9_16_band_formula_glue
              (K := K) (j := n - 1) (by omega) hC
            rw [show (n - 1) + 1 = n from by omega, ← hedef] at hglue
            rw [show K - (n - 1) - 2 = K - n - 1 from by omega] at hglue
            rw [hval_t, hval_e]
            calc higham9_16_fosterT (K - n - 1) *
                (1 + (n : ℝ) * t + higham9_16_fosterPStar (K - n - 1)
                  (1 + (n : ℝ) * t) (C / t ^ n))
                ≤ higham9_16_fosterT (K - n - 1) *
                  (1 + (n : ℝ) * e + higham9_16_fosterPStar (K - n - 1)
                    (1 + (n : ℝ) * e) (C / e ^ n)) :=
                  mul_le_mul_of_nonneg_left hmono
                    (le_of_lt (higham9_16_fosterT_pos (K - n - 1)))
              _ = higham9_16_fosterT (K - (n - 1) - 1) *
                  (1 + ((n - 1 : ℕ) : ℝ) * e + e) := by
                  rw [← hglue]
          · -- else-band: direct antitonicity to the edge value
            have hval_t : higham9_16_fosterBandValue K C t =
                C / t ^ (K - 1) := by
              unfold higham9_16_fosterBandValue
              rw [hidx, if_neg hband]
            -- the edge value in band-`n` shape equals `C/e^(K-1)`:
            -- for `n = K-1` this is `glue_last`; for `n ≥ K` the band
            -- index of `t` cannot exceed `K`, and `n ≤ K` forces `n = K`;
            -- then `e = q^(K)` and the same last-gluing applies at stage
            -- `K`... but `glue_last` is stated at `e = q^(K-1)`.  We avoid
            -- the corner by using `n ≤ K` and splitting:
            rcases Nat.lt_or_ge n K with hnK' | hnK'
            · -- `n = K - 1`
              have hn_eq : n = K - 1 := by omega
              have hval_e := higham9_16_fosterBandValue_at_root (K := K)
                (j := n - 1) hK (by omega) hC hCle
              rw [show (n - 1) + 1 = n from by omega, ← hedef] at hval_e
              have hglue := higham9_16_band_formula_glue_last (K := K)
                hK hC
              have hroot : higham9_16_fosterQ K (K - 1) C = e := by
                rw [hedef]
                congr 1
                omega
              rw [hroot] at hglue
              rw [hval_t, hval_e]
              rw [show K - (n - 1) - 1 = 1 from by omega]
              rw [show ((n - 1 : ℕ) : ℝ) = ((K - 2 : ℕ) : ℝ) from by
                congr 1
                omega]
              rw [hglue]
              apply div_le_div_of_nonneg_left (le_of_lt hC) (by positivity)
              exact pow_le_pow_left₀ (le_of_lt he_pos) (le_of_lt hQt)
                (K - 1)
            · -- `n = K`: the edge `q^(K)` also lies in the (A.8) region
              have hn_eq : n = K := by omega
              have hval_e' : higham9_16_fosterBandValue K C e =
                  C / e ^ (K - 1) := by
                unfold higham9_16_fosterBandValue
                rw [hidx_e, if_neg (by omega)]
              rw [hval_t, hval_e']
              apply div_le_div_of_nonneg_left (le_of_lt hC) (by positivity)
              exact pow_le_pow_left₀ (le_of_lt he_pos) (le_of_lt hQt)
                (K - 1)
        calc higham9_16_fosterBandValue K C t
            ≤ higham9_16_fosterBandValue K C e := hstep
          _ ≤ higham9_16_fosterBandValue K C P :=
              ihn (n - 1) (by omega) e he_pos hPe hidx_e


/-! ## Equation (9.16) / Foster Lemma A.2 and Lemma 2 -/

/-- The band value at the chapter constant and zero tail is `t_k`. -/
lemma higham9_16_fosterBandValue_chapter_zero {k : ℕ} (hk : 1 ≤ k) :
    higham9_16_fosterBandValue k (Real.sqrt ((k : ℝ) ^ k)) 0 =
      higham9_16_fosterT k := by
  have hC : (0 : ℝ) < Real.sqrt ((k : ℝ) ^ k) := by
    apply Real.sqrt_pos.mpr
    have : (0 : ℝ) < (k : ℝ) := by exact_mod_cast hk
    positivity
  rcases eq_or_lt_of_le hk with h1 | h2
  · -- `k = 1`
    rw [← h1]
    rw [higham9_16_fosterBandValue_one, higham9_16_fosterT_one]
    norm_num
  · -- `k ≥ 2`
    have hk2 : 2 ≤ k := h2
    rw [higham9_16_fosterBandValue_of_idx_zero hk2 hC
      (higham9_16_fosterBandIdx_zero_of_tail_zero hC)]
    exact higham9_16_fosterV_chapter hk2

/-- The band value at the chapter constant is at most `t_k` for any
nonnegative tail. -/
lemma higham9_16_fosterBandValue_chapter_le {k : ℕ} (hk : 1 ≤ k) {P : ℝ}
    (hP : 0 ≤ P) :
    higham9_16_fosterBandValue k (Real.sqrt ((k : ℝ) ^ k)) P ≤
      higham9_16_fosterT k := by
  have hC : (0 : ℝ) < Real.sqrt ((k : ℝ) ^ k) := by
    apply Real.sqrt_pos.mpr
    have : (0 : ℝ) < (k : ℝ) := by exact_mod_cast hk
    positivity
  rcases eq_or_lt_of_le hk with h1 | h2
  · -- `k = 1`: the value is the constant itself
    rw [← h1, higham9_16_fosterBandValue_one, higham9_16_fosterT_one]
    norm_num
  · have hk2 : 2 ≤ k := h2
    rcases eq_or_lt_of_le hP with rfl | hP_pos
    · rw [higham9_16_fosterBandValue_chapter_zero hk]
    · calc higham9_16_fosterBandValue k (Real.sqrt ((k : ℝ) ^ k)) P
          ≤ higham9_16_fosterBandValue k (Real.sqrt ((k : ℝ) ^ k)) 0 :=
            higham9_16_fosterBandValue_antitone hk2 hC le_rfl le_rfl _ P
              hP_pos (le_of_lt hP_pos) rfl
        _ = higham9_16_fosterT k :=
            higham9_16_fosterBandValue_chapter_zero hk

/-- **Foster Lemma A.2** (the constrained-maximization upper bound): the
head of any feasible tuple is bounded by the band value at its tail. -/
theorem higham9_16_fosterA2 :
    ∀ k : ℕ, ∀ hk : 1 ≤ k, ∀ C P : ℝ, 0 < C →
      C ≤ Real.sqrt ((k : ℝ) ^ k) → 0 ≤ P →
      ∀ p : Fin k → ℝ, higham9_16_FosterFeasible k C P p →
      p ⟨0, hk⟩ ≤ higham9_16_fosterBandValue k C P := by
  intro k
  induction k using Nat.strong_induction_on with
  | _ k ihk =>
    intro hk C P hC hCle hP p hfeas
    rcases Nat.lt_or_ge k 2 with hk1 | hk2
    · -- base case `k = 1`
      have hk_eq : k = 1 := by omega
      subst hk_eq
      have h := higham9_16_fosterA2_one hfeas
      rw [higham9_16_fosterBandValue_one]
      exact h
    · -- step: `k = K + 1` with `K ≥ 1`
      obtain ⟨K, rfl⟩ : ∃ K, k = K + 1 := ⟨k - 1, by omega⟩
      have hK1 : 1 ≤ K := by omega
      set t := p (Fin.last K) with htdef
      have ht0 : 0 ≤ t := le_trans hP (hfeas.2.1 _)
      have hPt : P ≤ t := hfeas.2.1 _
      -- the standard-constant induction hypothesis for case 1
      have hIH_std : ∀ p' : Fin K → ℝ,
          higham9_16_FosterFeasible K (Real.sqrt ((K : ℝ) ^ K))
            (t / (1 + t)) p' →
          p' ⟨0, hK1⟩ ≤ higham9_16_fosterT K := by
        intro p' hfeas'
        have hCK : (0 : ℝ) < Real.sqrt ((K : ℝ) ^ K) := by
          apply Real.sqrt_pos.mpr
          have : (0 : ℝ) < (K : ℝ) := by exact_mod_cast hK1
          positivity
        have hthat0 : (0 : ℝ) ≤ t / (1 + t) := by positivity
        calc p' ⟨0, hK1⟩
            ≤ higham9_16_fosterBandValue K (Real.sqrt ((K : ℝ) ^ K))
              (t / (1 + t)) :=
              ihk K (by omega) hK1 _ _ hCK le_rfl hthat0 p' hfeas'
          _ ≤ higham9_16_fosterT K :=
              higham9_16_fosterBandValue_chapter_le hK1 hthat0
      by_cases hcase : Real.sqrt ((K : ℝ) ^ K) * (t * (1 + t) ^ K) ≤ C
      · -- case 1
        exact higham9_16_fosterA2_step_case1 hK1 hC hCle hP hfeas hcase
          hIH_std
      · -- case 2
        have ht_pos : 0 < t := by
          rcases eq_or_lt_of_le ht0 with heq | h
          · exfalso
            apply hcase
            rw [← heq]
            simp only [mul_zero, zero_mul]
            exact le_of_lt hC
          · exact h
        push_neg at hcase
        have hQ1t : higham9_16_fosterQ (K + 1) 1 C < t := by
          by_contra hle
          push_neg at hle
          have := (higham9_16_case1_iff hC ht0).mpr hle
          linarith
        -- rescale
        have hfeas2 := higham9_16_fosterA2_case2_reduction hK1 hP hfeas
          ht_pos
        rw [← htdef] at hfeas2
        have hChat_lt : C / (t * (1 + t) ^ K) <
            Real.sqrt ((K : ℝ) ^ K) := by
          rw [div_lt_iff₀ (by positivity)]
          linarith [hcase]
        have hmin_eq : min (Real.sqrt ((K : ℝ) ^ K))
            (C / (t * (1 + t) ^ K)) = C / (t * (1 + t) ^ K) :=
          min_eq_right (le_of_lt hChat_lt)
        rw [hmin_eq] at hfeas2
        have hChat_pos : (0 : ℝ) < C / (t * (1 + t) ^ K) := by
          positivity
        have hthat0 : (0 : ℝ) ≤ t / (1 + t) := by positivity
        -- induction hypothesis at the sharpened constant
        have hbound := ihk K (by omega) hK1 _ _ hChat_pos
          (le_of_lt hChat_lt) hthat0 _ hfeas2
        -- reassemble the head
        have hdenne : (1 : ℝ) + t ≠ 0 := by positivity
        have hzero_eq : ((⟨0, hK1⟩ : Fin K)).castSucc =
            (⟨0, hk⟩ : Fin (K + 1)) := by
          apply Fin.ext
          simp
        have hp0 : p ⟨0, hk⟩ =
            (p ((⟨0, hK1⟩ : Fin K)).castSucc / (1 + t)) * (1 + t) := by
          rw [hzero_eq]
          rw [div_mul_cancel₀ _ hdenne]
        calc p ⟨0, hk⟩
            = (p ((⟨0, hK1⟩ : Fin K)).castSucc / (1 + t)) * (1 + t) := hp0
          _ ≤ higham9_16_fosterBandValue K (C / (t * (1 + t) ^ K))
              (t / (1 + t)) * (1 + t) := by
              apply mul_le_mul_of_nonneg_right hbound (by positivity)
          _ = higham9_16_fosterBandValue (K + 1) C t := by
              rw [mul_comm]
              exact higham9_16_fosterBandValue_hat_compose hK1 hC ht_pos
                hQ1t
          _ ≤ higham9_16_fosterBandValue (K + 1) C P := by
              rcases eq_or_lt_of_le hPt with rfl | hPt'
              · exact le_refl _
              · exact higham9_16_fosterBandValue_antitone (by omega) hC
                  hCle hP _ t ht_pos (le_of_lt hPt') rfl

/-- **Foster Lemma 2** (his eq. (7) upper bound): the head of any feasible
tuple at the chapter constant `sqrt(n^n)` with zero tail is at most
`t_n = s_1(1+s_2)⋯(1+s_n)`. -/
theorem higham9_16_foster_lemma2 {n : ℕ} (hn : 1 ≤ n) {p : Fin n → ℝ}
    (hfeas : higham9_16_FosterFeasible n (Real.sqrt ((n : ℝ) ^ n)) 0 p) :
    p ⟨0, hn⟩ ≤ higham9_16_fosterT n := by
  have hC : (0 : ℝ) < Real.sqrt ((n : ℝ) ^ n) := by
    apply Real.sqrt_pos.mpr
    have : (0 : ℝ) < (n : ℝ) := by exact_mod_cast hn
    positivity
  calc p ⟨0, hn⟩
      ≤ higham9_16_fosterBandValue n (Real.sqrt ((n : ℝ) ^ n)) 0 :=
        higham9_16_fosterA2 n hn _ _ hC le_rfl le_rfl p hfeas
    _ = higham9_16_fosterT n :=
        higham9_16_fosterBandValue_chapter_zero hn


/-! ## Equation (9.16) / rook trace: row-max and enriched certificate -/

/-- **Rook row-max property of the trace factor**: every entry of a
rook-pivoting trace's upper factor is dominated by its row's diagonal
entry. -/
theorem higham9_16_RookPivotGEUTrace_row_max :
    ∀ {n : ℕ} {A U : Fin n → Fin n → ℝ},
      higham9_16_RookPivotGEUTrace n A U →
      ∀ i j : Fin n, |U i j| ≤ |U i i| := by
  intro n A U htrace
  induction htrace with
  | done =>
      intro i
      exact Fin.elim0 i
  | step hchoice hpivot _hnext ih =>
      rename_i m A r s U₁
      intro i j
      by_cases hi : i = 0
      · subst hi
        have hrow := hchoice.2.2.2
          (higham9_7_firstPivotRowSwap s j) (Nat.zero_le _)
        have hdiag0 : (higham9_7_firstPivotRowSwap s) 0 = s := by
          simp [higham9_7_firstPivotRowSwap]
        simpa [luFirstStepU, higham9_2_rowColPermutedMatrix,
          higham9_2_rowPermutedMatrix, higham9_2_colPermutedMatrix,
          higham9_7_firstPivotRowSwap, hdiag0] using hrow
      · by_cases hj : j = 0
        · subst hj
          have hzero : luFirstStepU (higham9_2_rowColPermutedMatrix A
              (higham9_7_firstPivotRowSwap r)
              (higham9_7_firstPivotRowSwap s)) U₁ i 0 = 0 := by
            simp [luFirstStepU, hi]
          rw [hzero, abs_zero]
          exact abs_nonneg _
        · have hrec := ih (i.pred hi) (j.pred hj)
          simpa [luFirstStepU, hi, hj] using hrec

/-- **Enriched rook certificate**: a rook trace yields a `PAQ = LU`
certificate whose `L` is bounded by one, whose `Uc` has the rook row-max
property, and whose diagonal agrees with the trace factor's diagonal. -/
theorem higham9_16_RookPivotGEUTrace_exists_spec_rook :
    ∀ {n : ℕ} {A U : Fin n → Fin n → ℝ},
      higham9_16_RookPivotGEUTrace n A U →
      ∃ L Uc : Fin n → Fin n → ℝ,
      ∃ sigma tau : Fin n → Fin n,
        higham9_2_CompletePermutedLUFactSpec n A L Uc sigma tau ∧
          (∀ i j : Fin n, |L i j| ≤ 1) ∧
          (∀ i j : Fin n, |Uc i j| ≤ |Uc i i|) ∧
          (∀ i : Fin n, Uc i i = U i i) := by
  intro n A U htrace
  induction htrace with
  | done =>
      let empty : Fin 0 → Fin 0 := fun i => Fin.elim0 i
      let Z : Fin 0 → Fin 0 → ℝ := fun i => Fin.elim0 i
      have hempty : IsPermutation 0 empty := by
        constructor
        · intro i
          exact Fin.elim0 i
        · intro i
          exact Fin.elim0 i
      refine ⟨Z, Z, empty, empty, ?_, ?_, ?_, ?_⟩
      · refine ⟨hempty, ?_⟩
        refine
          { perm := hempty
            L_diag := ?_
            L_upper_zero := ?_
            U_lower_zero := ?_
            product_eq := ?_ }
        · intro i
          exact Fin.elim0 i
        · intro i
          exact Fin.elim0 i
        · intro i
          exact Fin.elim0 i
        · intro i
          exact Fin.elim0 i
      · intro i
        exact Fin.elim0 i
      · intro i
        exact Fin.elim0 i
      · intro i
        exact Fin.elim0 i
  | step hchoice hpivot hnext ih =>
      rename_i m A r s U₁
      obtain ⟨L₁, Uc₁, sigma₁, tau₁, hLU₁, hL₁_bound, hrook₁, hdiag₁⟩ := ih
      let sigma₀ : Fin (m + 1) → Fin (m + 1) :=
        higham9_7_firstPivotRowSwap r
      let tau₀ : Fin (m + 1) → Fin (m + 1) :=
        higham9_7_firstPivotRowSwap s
      let Aperm : Fin (m + 1) → Fin (m + 1) → ℝ :=
        higham9_2_rowColPermutedMatrix A sigma₀ tau₀
      let S : Fin m → Fin m → ℝ := luFirstSchurComplement Aperm
      let sigmaExt : Fin (m + 1) → Fin (m + 1) :=
        higham9_8_extendTrailingPerm sigma₁
      let tauExt : Fin (m + 1) → Fin (m + 1) :=
        higham9_8_extendTrailingPerm tau₁
      let sigma : Fin (m + 1) → Fin (m + 1) := fun i => sigma₀ (sigmaExt i)
      let tau : Fin (m + 1) → Fin (m + 1) := fun i => tau₀ (tauExt i)
      let B : Fin (m + 1) → Fin (m + 1) → ℝ :=
        higham9_2_rowColPermutedMatrix Aperm sigmaExt tauExt
      let L : Fin (m + 1) → Fin (m + 1) → ℝ := luFirstStepL B L₁
      let Uc : Fin (m + 1) → Fin (m + 1) → ℝ := luFirstStepU B Uc₁
      have hsigmaExt : IsPermutation (m + 1) sigmaExt :=
        higham9_8_extendTrailingPerm_isPermutation hLU₁.2.perm
      have htauExt : IsPermutation (m + 1) tauExt :=
        higham9_8_extendTrailingPerm_isPermutation hLU₁.1
      have hsigma : IsPermutation (m + 1) sigma :=
        higham9_8_isPermutation_comp
          (by
            show IsPermutation (m + 1) (higham9_7_firstPivotRowSwap r)
            exact higham9_7_firstPivotRowSwap_isPermutation r)
          hsigmaExt
      have htau : IsPermutation (m + 1) tau :=
        higham9_8_isPermutation_comp
          (by
            show IsPermutation (m + 1) (higham9_7_firstPivotRowSwap s)
            exact higham9_7_firstPivotRowSwap_isPermutation s)
          htauExt
      have hpivotB : B 0 0 ≠ 0 := by
        simpa [B, Aperm, sigmaExt, tauExt, higham9_2_rowColPermutedMatrix,
          higham9_2_rowPermutedMatrix, higham9_2_colPermutedMatrix] using
          hpivot
      have hschur :
          luFirstSchurComplement B =
            higham9_2_rowColPermutedMatrix S sigma₁ tau₁ := by
        simpa [B, S] using
          higham9_8_luFirstSchurComplement_trailingPerm Aperm sigma₁ tau₁
      have hLU₁_plain :
          LUFactSpec m (higham9_2_rowColPermutedMatrix S sigma₁ tau₁) L₁
            Uc₁ :=
        higham9_2_completePermutedLUFactSpec_to_LUFactSpec hLU₁
      have hS_B : LUFactSpec m (luFirstSchurComplement B) L₁ Uc₁ := by
        simpa [hschur] using hLU₁_plain
      have hLU_B : LUFactSpec (m + 1) B L Uc :=
        LUFactSpec.of_firstSchurComplement_explicit hpivotB hS_B
      -- row 0 of `Uc` is the rook pivot row, column-permuted
      have hB_row0 : ∀ j : Fin (m + 1),
          B 0 j = A r (tau₀ (tauExt j)) := by
        intro j
        simp [B, Aperm, sigmaExt, higham9_2_rowColPermutedMatrix,
          higham9_2_rowPermutedMatrix, higham9_2_colPermutedMatrix,
          sigma₀, higham9_7_firstPivotRowSwap]
      have hB_00 : B 0 0 = A r s := by
        rw [hB_row0 0]
        simp [tauExt, tau₀, higham9_7_firstPivotRowSwap]
      refine ⟨L, Uc, sigma, tau, ?_, ?_, ?_, ?_⟩
      · refine ⟨htau, ?_⟩
        refine
          { perm := hsigma
            L_diag := hLU_B.L_diag
            L_upper_zero := hLU_B.L_upper_zero
            U_lower_zero := hLU_B.U_lower_zero
            product_eq := ?_ }
        intro i j
        have h := hLU_B.product_eq i j
        simpa [L, Uc, B, Aperm, sigma, tau, sigma₀, tau₀,
          higham9_2_rowColPermutedMatrix, higham9_2_rowPermutedMatrix,
          higham9_2_colPermutedMatrix] using h
      · intro i j
        by_cases hi : i = 0
        · subst i
          by_cases hj : j = 0
          · simp [L, luFirstStepL, hj]
          · simp [L, luFirstStepL, hj]
        · by_cases hj : j = 0
          · have hratio :
                |A (sigma₀ (sigmaExt i)) s / A r s| ≤ 1 :=
              higham9_1_rookPivot_column_multiplier_abs_le_one
                A (0 : Fin (m + 1)) r s (sigma₀ (sigmaExt i))
                hchoice hpivot (Nat.zero_le _)
            simpa [L, B, Aperm, sigma₀, tau₀, sigmaExt, tauExt,
              luFirstStepL, hi, hj, higham9_2_rowColPermutedMatrix,
              higham9_2_rowPermutedMatrix, higham9_2_colPermutedMatrix,
              higham9_7_firstPivotRowSwap] using hratio
          · simpa [L, luFirstStepL, hi, hj] using
              hL₁_bound (i.pred hi) (j.pred hj)
      · -- rook row-max for `Uc`
        intro i j
        by_cases hi : i = 0
        · subst hi
          have hUc0j : Uc 0 j = A r (tau₀ (tauExt j)) := by
            rw [show Uc 0 j = B 0 j from by simp [Uc, luFirstStepU]]
            exact hB_row0 j
          have hUc00 : Uc 0 0 = A r s := by
            rw [show Uc 0 0 = B 0 0 from by simp [Uc, luFirstStepU]]
            exact hB_00
          rw [hUc0j, hUc00]
          exact hchoice.2.2.2 (tau₀ (tauExt j)) (Nat.zero_le _)
        · by_cases hj : j = 0
          · subst hj
            have h0 : Uc i 0 = 0 := by
              simp [Uc, luFirstStepU, hi]
            rw [h0, abs_zero]
            exact abs_nonneg _
          · have hUc_ij : Uc i j = Uc₁ (i.pred hi) (j.pred hj) := by
              simp [Uc, luFirstStepU, hi, hj]
            have hUc_ii : Uc i i = Uc₁ (i.pred hi) (i.pred hi) := by
              simp [Uc, luFirstStepU, hi]
            rw [hUc_ij, hUc_ii]
            exact hrook₁ (i.pred hi) (j.pred hj)
      · -- diagonal agreement with the trace factor
        intro i
        by_cases hi : i = 0
        · subst hi
          have hUc00 : Uc 0 0 = A r s := by
            rw [show Uc 0 0 = B 0 0 from by simp [Uc, luFirstStepU]]
            exact hB_00
          have hU00 : luFirstStepU Aperm U₁ 0 0 = A r s := by
            rw [show luFirstStepU Aperm U₁ 0 0 = Aperm 0 0 from by
              simp [luFirstStepU]]
            simp [Aperm, sigma₀, tau₀, higham9_2_rowColPermutedMatrix,
              higham9_2_rowPermutedMatrix, higham9_2_colPermutedMatrix,
              higham9_7_firstPivotRowSwap]
          rw [hUc00, hU00]
        · have hUc_ii : Uc i i = Uc₁ (i.pred hi) (i.pred hi) := by
            simp [Uc, luFirstStepU, hi]
          have hU_ii : luFirstStepU Aperm U₁ i i =
              U₁ (i.pred hi) (i.pred hi) := by
            simp [luFirstStepU, hi]
          rw [hUc_ii, hU_ii]
          exact hdiag₁ (i.pred hi)


/-! ## Equation (9.16): the rook-pivoting growth bound `ρ ≤ t_n` -/

/-- **Equation (9.16), Foster's growth bound in `t_n` form** (Foster [435,
1997], Theorem 1; Higham, 2nd ed., §9.4, eq. (9.16) support): the max-entry
growth factor of any rook-pivoting trace is at most
`t_n = s_1(1+s_2)⋯(1+s_n)`. -/
theorem higham9_16_RookPivotGEUTrace_growthFactorEntry_le_fosterT {n : ℕ}
    (hn : 0 < n) (A U : Fin n → Fin n → ℝ)
    (hAmax : 0 < maxEntryNorm hn A)
    (htrace : higham9_16_RookPivotGEUTrace n A U) :
    growthFactorEntry hn A U hAmax ≤ higham9_16_fosterT n := by
  classical
  set M := maxEntryNorm hn A with hM
  obtain ⟨L, Uc, sigma, tau, hspec, hL1, hrook, hdiag⟩ :=
    higham9_16_RookPivotGEUTrace_exists_spec_rook htrace
  have hLU' : LUFactSpec n
      (higham9_2_rowColPermutedMatrix A sigma tau) L Uc :=
    higham9_2_completePermutedLUFactSpec_to_LUFactSpec hspec
  -- scaled matrices
  set Ahat : Matrix (Fin n) (Fin n) ℝ :=
    fun i j => higham9_2_rowColPermutedMatrix A sigma tau i j / M
    with hAhat
  set Uhat : Matrix (Fin n) (Fin n) ℝ := fun i j => Uc i j / M with hUhat
  set Lhat : Matrix (Fin n) (Fin n) ℝ := fun i j => L i j with hLhat
  have hLUmat : Lhat * Uhat = Ahat := by
    ext i j
    rw [Matrix.mul_apply]
    show (∑ k : Fin n, L i k * (Uc k j / M)) = _
    rw [show (∑ k : Fin n, L i k * (Uc k j / M)) =
        (∑ k : Fin n, L i k * Uc k j) / M from by
      rw [Finset.sum_div]
      congr 1
      funext k
      ring]
    rw [hLU'.product_eq i j]
  have hAmax1 : ∀ i j : Fin n, |Ahat i j| ≤ 1 := by
    intro i j
    show |higham9_2_rowColPermutedMatrix A sigma tau i j / M| ≤ 1
    rw [abs_div, abs_of_pos hAmax]
    rw [div_le_one hAmax]
    show |A (sigma i) (tau j)| ≤ M
    exact entry_le_maxEntryNorm hn A (sigma i) (tau j)
  have hUrook1 : ∀ i j : Fin n, |Uhat i j| ≤ |Uhat i i| := by
    intro i j
    show |Uc i j / M| ≤ |Uc i i / M|
    rw [abs_div, abs_div, abs_of_pos hAmax]
    exact div_le_div_of_nonneg_right (hrook i j) (le_of_lt hAmax)
  obtain ⟨q, ⟨sigma', hq⟩, hfeas⟩ :=
    higham9_16_fosterFeasible_of_rook Ahat Lhat Uhat hLUmat
      hLU'.L_diag hLU'.L_upper_zero
      (fun i j hij => by
        show Uc i j / M = 0
        rw [hLU'.U_lower_zero i j hij, zero_div]) hAmax1
      (fun i j => hL1 i j) hUrook1
  have hn1 : 1 ≤ n := hn
  have hhead := higham9_16_foster_lemma2 hn1 hfeas
  -- every scaled diagonal entry is bounded by the sorted head
  have hdiag_le : ∀ i : Fin n, |Uhat i i| ≤ higham9_16_fosterT n := by
    intro i
    have h1 : |Uhat i i| = q (sigma'.symm i) := by
      rw [hq (sigma'.symm i)]
      congr 1
      rw [Equiv.apply_symm_apply]
    have h2 : q (sigma'.symm i) ≤ q ⟨0, hn1⟩ := by
      apply hfeas.1
      rw [Fin.le_def]
      exact Nat.zero_le _
    rw [h1]
    exact le_trans h2 hhead
  -- transfer to the trace factor and conclude
  apply growthFactorEntry_le_of_entry_bound_factor hn A U _ hAmax
  intro i j
  calc |U i j|
      ≤ |U i i| := higham9_16_RookPivotGEUTrace_row_max htrace i j
    _ = |Uc i i| := by rw [hdiag i]
    _ ≤ higham9_16_fosterT n * M := by
        have h := hdiag_le i
        show |Uc i i| ≤ _
        have : |Uc i i / M| ≤ higham9_16_fosterT n := h
        rw [abs_div, abs_of_pos hAmax, div_le_iff₀ hAmax] at this
        exact this


/-! ## Equation (9.16) / Foster Theorem 3: exp/log toolkit -/

/-- `(1+x)^m ≤ e^(m x)` for `x ≥ 0`. -/
lemma higham9_16_one_add_pow_le_exp {x : ℝ} (hx : 0 ≤ x) (m : ℕ) :
    (1 + x) ^ m ≤ Real.exp ((m : ℝ) * x) := by
  rw [Real.exp_nat_mul]
  apply pow_le_pow_left₀ (by linarith)
  linarith [Real.add_one_le_exp x]

/-- `e^(m·x/(1+x)) ≤ (1+x)^m` for `x ≥ 0` — the elementary lower bound
`ln(1+x) ≥ x/(1+x)`. -/
lemma higham9_16_exp_le_one_add_pow {x : ℝ} (hx : 0 ≤ x) (m : ℕ) :
    Real.exp ((m : ℝ) * (x / (1 + x))) ≤ (1 + x) ^ m := by
  have hden : (0 : ℝ) < 1 + x := by linarith
  rw [Real.exp_nat_mul]
  apply pow_le_pow_left₀ (le_of_lt (Real.exp_pos _))
  -- `e^(x/(1+x)) ≤ 1 + x` ⟺ `x/(1+x) ≤ ln(1+x)`
  have hlog : x / (1 + x) ≤ Real.log (1 + x) := by
    have h := Real.log_le_sub_one_of_pos
      (show (0 : ℝ) < (1 + x)⁻¹ from by positivity)
    rw [Real.log_inv] at h
    have hsub : (1 + x)⁻¹ - 1 = -(x / (1 + x)) := by
      field_simp
      ring
    rw [hsub] at h
    linarith
  calc Real.exp (x / (1 + x)) ≤ Real.exp (Real.log (1 + x)) :=
        Real.exp_le_exp.mpr hlog
    _ = 1 + x := Real.exp_log hden

/-- `C_k ≤ √k · e^(1/2)` for `k ≥ 2`. -/
lemma higham9_16_fosterStageConst_le_sqrt_mul_exp {k : ℕ} (hk : 2 ≤ k) :
    higham9_16_fosterStageConst k ≤
      Real.sqrt (k : ℝ) * Real.exp (1 / 2) := by
  have hk1R : (0 : ℝ) < (k : ℝ) - 1 := by
    have : (2 : ℝ) ≤ (k : ℝ) := by exact_mod_cast hk
    linarith
  have hkR : (0 : ℝ) < (k : ℝ) := by linarith
  have hcast : ((k - 1 : ℕ) : ℝ) = (k : ℝ) - 1 := by
    push_cast [Nat.cast_sub (by omega : 1 ≤ k)]
    ring
  unfold higham9_16_fosterStageConst
  rw [hcast]
  rw [higham9_16_sqrt_pow (le_of_lt hkR) k,
    higham9_16_sqrt_pow (le_of_lt hk1R) (k - 1)]
  -- split off one factor of `√k` and compare the rest against `e^(1/2)`
  have hsplit : Real.sqrt (k : ℝ) ^ k =
      Real.sqrt (k : ℝ) * Real.sqrt (k : ℝ) ^ (k - 1) := by
    calc Real.sqrt (k : ℝ) ^ k
        = Real.sqrt (k : ℝ) ^ (1 + (k - 1)) := by
          congr 1
          omega
      _ = Real.sqrt (k : ℝ) * Real.sqrt (k : ℝ) ^ (k - 1) := by
          rw [pow_add, pow_one]
  rw [hsplit, mul_div_assoc]
  apply mul_le_mul_of_nonneg_left ?_ (Real.sqrt_nonneg _)
  rw [div_le_iff₀ (by positivity : (0:ℝ) < Real.sqrt ((k:ℝ) - 1) ^ (k-1))]
  have hbase : Real.sqrt (k : ℝ) =
      Real.sqrt ((k : ℝ) - 1) * Real.sqrt (1 + 1 / ((k : ℝ) - 1)) := by
    rw [← Real.sqrt_mul (le_of_lt hk1R)]
    congr 1
    field_simp
    ring
  have hinner : (0 : ℝ) ≤ 1 / ((k : ℝ) - 1) := by positivity
  have h1 := higham9_16_one_add_pow_le_exp hinner (k - 1)
  have hexp_arg : ((k - 1 : ℕ) : ℝ) * (1 / ((k : ℝ) - 1)) = 1 := by
    rw [hcast]
    field_simp
  rw [hexp_arg] at h1
  have h2 : Real.sqrt (1 + 1 / ((k : ℝ) - 1)) ^ (k - 1) =
      Real.sqrt ((1 + 1 / ((k : ℝ) - 1)) ^ (k - 1)) :=
    (higham9_16_sqrt_pow (by linarith) (k - 1)).symm
  calc Real.sqrt (k : ℝ) ^ (k - 1)
      = Real.sqrt ((k : ℝ) - 1) ^ (k - 1) *
        Real.sqrt (1 + 1 / ((k : ℝ) - 1)) ^ (k - 1) := by
        rw [hbase, mul_pow]
    _ ≤ Real.sqrt ((k : ℝ) - 1) ^ (k - 1) * Real.exp (1 / 2) := by
        apply mul_le_mul_of_nonneg_left ?_ (by positivity)
        rw [h2]
        calc Real.sqrt ((1 + 1 / ((k : ℝ) - 1)) ^ (k - 1))
            ≤ Real.sqrt (Real.exp 1) := Real.sqrt_le_sqrt h1
          _ = Real.exp (1 / 2) := by
              rw [show Real.exp 1 = Real.exp (1 / 2) ^ 2 from by
                rw [sq, ← Real.exp_add]
                congr 1
                norm_num]
              exact Real.sqrt_sq (le_of_lt (Real.exp_pos _))
    _ = Real.exp (1 / 2) * Real.sqrt ((k : ℝ) - 1) ^ (k - 1) := by
        ring


/-! ## Equation (9.16) / Foster Theorem 3: the tail bound `s_n ≤ 3 ln n/(2n)` -/

/-- The discrete drift term `G(n) = (3 ln n + (9/2) ln² n)/(2n)`. -/
noncomputable def higham9_16_fosterG (n : ℕ) : ℝ :=
  (3 * Real.log n + (9 / 2) * Real.log n ^ 2) / (2 * n)

/-- `G` is nonincreasing from `31` on (discrete, via `ln(1+1/n) ≤ 1/n`). -/
lemma higham9_16_fosterG_succ_le {n : ℕ} (hn : 8 ≤ n) :
    higham9_16_fosterG (n + 1) ≤ higham9_16_fosterG n := by
  have hnR : (8 : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn
  have hn_pos : (0 : ℝ) < (n : ℝ) := by linarith
  have hn1_pos : (0 : ℝ) < (n : ℝ) + 1 := by linarith
  set L := Real.log n with hL
  have hL2 : (2 : ℝ) ≤ L := by
    rw [hL, show (2 : ℝ) = Real.log (Real.exp 2) from
      (Real.log_exp 2).symm]
    apply Real.log_le_log (Real.exp_pos 2)
    calc Real.exp 2 = Real.exp 1 * Real.exp 1 := by
          rw [← Real.exp_add]
          norm_num
      _ ≤ 2.7182818286 * 2.7182818286 := by
          have h := Real.exp_one_lt_d9
          have h0 := Real.exp_pos 1
          nlinarith [h, h0]
      _ ≤ (n : ℝ) := by nlinarith [hnR]
  -- `ln(n+1) ≤ L + 1/n`
  have hL' : Real.log ((n : ℝ) + 1) ≤ L + 1 / n := by
    have hsplit : Real.log ((n : ℝ) + 1) =
        L + Real.log (((n : ℝ) + 1) / n) := by
      rw [hL, ← Real.log_mul (ne_of_gt hn_pos)
        (by positivity : ((n : ℝ) + 1) / n ≠ 0)]
      congr 1
      field_simp
    rw [hsplit]
    have hlog := Real.log_le_sub_one_of_pos
      (show (0 : ℝ) < ((n : ℝ) + 1) / n from by positivity)
    have heq : ((n : ℝ) + 1) / n - 1 = 1 / n := by
      field_simp
      ring
    rw [heq] at hlog
    linarith
  have hL'_nonneg : 0 ≤ Real.log ((n : ℝ) + 1) :=
    Real.log_nonneg (by linarith)
  have hL_nonneg : (0 : ℝ) ≤ L := by linarith
  -- numerator comparison
  have hnum : 3 * Real.log ((n : ℝ) + 1) +
      (9 / 2) * Real.log ((n : ℝ) + 1) ^ 2 ≤
      (3 * L + (9 / 2) * L ^ 2) * ((n : ℝ) + 1) / n := by
    have hsq : Real.log ((n : ℝ) + 1) ^ 2 ≤ (L + 1 / n) ^ 2 := by
      apply pow_le_pow_left₀ hL'_nonneg hL'
    have hexpand : 3 * (L + 1 / n) + (9 / 2) * (L + 1 / n) ^ 2 =
        3 * L + (9 / 2) * L ^ 2 + (3 + 9 * L + (9 / 2) / n) / n := by
      field_simp
      ring
    have hstep : 3 * Real.log ((n : ℝ) + 1) +
        (9 / 2) * Real.log ((n : ℝ) + 1) ^ 2 ≤
        3 * L + (9 / 2) * L ^ 2 + (3 + 9 * L + (9 / 2) / n) / n := by
      calc 3 * Real.log ((n : ℝ) + 1) +
          (9 / 2) * Real.log ((n : ℝ) + 1) ^ 2
          ≤ 3 * (L + 1 / n) + (9 / 2) * (L + 1 / n) ^ 2 := by
            have h1 : 3 * Real.log ((n : ℝ) + 1) ≤ 3 * (L + 1 / n) := by
              linarith
            have h2 : (9 / 2) * Real.log ((n : ℝ) + 1) ^ 2 ≤
                (9 / 2) * (L + 1 / n) ^ 2 := by
              linarith
            linarith
        _ = 3 * L + (9 / 2) * L ^ 2 + (3 + 9 * L + (9 / 2) / n) / n :=
            hexpand
    -- and the correction is at most `(3L + (9/2)L²)/n`
    have hinv : (1 : ℝ) / n ≤ 1 / 8 := by
      rw [div_le_div_iff₀ hn_pos (by norm_num : (0:ℝ) < 8)]
      linarith
    have hcorr : 3 + 9 * L + (9 / 2) / n ≤ 3 * L + (9 / 2) * L ^ 2 := by
      have h92 : (9 : ℝ) / 2 / n ≤ 9 / 16 := by
        rw [div_div]
        rw [div_le_div_iff₀ (by positivity) (by norm_num : (0:ℝ) < 16)]
        nlinarith [hnR]
      nlinarith [sq_nonneg (L - 2), hL2]
    calc 3 * Real.log ((n : ℝ) + 1) +
        (9 / 2) * Real.log ((n : ℝ) + 1) ^ 2
        ≤ 3 * L + (9 / 2) * L ^ 2 + (3 + 9 * L + (9 / 2) / n) / n :=
          hstep
      _ ≤ 3 * L + (9 / 2) * L ^ 2 + (3 * L + (9 / 2) * L ^ 2) / n := by
          have hd := div_le_div_of_nonneg_right hcorr (le_of_lt hn_pos)
          linarith
      _ = (3 * L + (9 / 2) * L ^ 2) * ((n : ℝ) + 1) / n := by
          field_simp
  unfold higham9_16_fosterG
  rw [div_le_div_iff₀ (by positivity) (by positivity)]
  push_cast
  calc (3 * Real.log ((n : ℝ) + 1) +
      9 / 2 * Real.log ((n : ℝ) + 1) ^ 2) * (2 * (n : ℝ))
      ≤ ((3 * L + (9 / 2) * L ^ 2) * ((n : ℝ) + 1) / n) * (2 * n) := by
        apply mul_le_mul_of_nonneg_right hnum (by positivity)
    _ = (3 * Real.log (n : ℝ) + 9 / 2 * Real.log (n : ℝ) ^ 2) *
        (2 * ((n : ℝ) + 1)) := by
        rw [hL]
        field_simp

/-- `G(n) ≤ G(31)` for `n ≥ 31`. -/
lemma higham9_16_fosterG_le_31 {n : ℕ} (hn : 31 ≤ n) :
    higham9_16_fosterG n ≤ higham9_16_fosterG 31 := by
  induction n, hn using Nat.le_induction with
  | base => exact le_rfl
  | succ m hm ih =>
      calc higham9_16_fosterG (m + 1) ≤ higham9_16_fosterG m :=
            higham9_16_fosterG_succ_le (by omega)
        _ ≤ higham9_16_fosterG 31 := ih

/-- Rational bracketing of `ln 31`. -/
lemma higham9_16_log31_bounds :
    (3.43 : ℝ) ≤ Real.log 31 ∧ Real.log 31 ≤ 3.435 := by
  have h32 : Real.log 32 = 5 * Real.log 2 := by
    rw [show (32 : ℝ) = 2 ^ 5 from by norm_num, Real.log_pow]
    push_cast
    ring
  have hsplit : Real.log 31 = Real.log 32 + Real.log (31 / 32) := by
    rw [← Real.log_mul (by norm_num) (by norm_num)]
    congr 1
    norm_num
  have hlog2_lt := Real.log_two_lt_d9
  have hlog2_gt := Real.log_two_gt_d9
  constructor
  · -- lower: `log(31/32) = −log(32/31) ≥ −1/31`
    have hup : Real.log (32 / 31) ≤ 1 / 31 := by
      have h := Real.log_le_sub_one_of_pos
        (show (0 : ℝ) < 32 / 31 from by norm_num)
      have : (32 : ℝ) / 31 - 1 = 1 / 31 := by norm_num
      linarith [this ▸ h]
    have hneg : Real.log (31 / 32) = -Real.log (32 / 31) := by
      rw [← Real.log_inv]
      norm_num
    rw [hsplit, h32, hneg]
    nlinarith [hlog2_gt, hup]
  · -- upper: `log(31/32) ≤ 31/32 − 1 = −1/32`
    have hup := Real.log_le_sub_one_of_pos
      (show (0 : ℝ) < 31 / 32 from by norm_num)
    rw [hsplit, h32]
    nlinarith [hlog2_lt, hup]

/-- Generic lower bound `1 - 1/x ≤ ln x`. -/
lemma higham9_16_one_sub_inv_le_log {x : ℝ} (hx : 0 < x) :
    1 - 1 / x ≤ Real.log x := by
  have h := Real.log_le_sub_one_of_pos
    (show (0 : ℝ) < 1 / x from by positivity)
  rw [one_div, Real.log_inv] at h
  have : (x⁻¹ : ℝ) = 1 / x := (one_div x).symm
  linarith [this ▸ h]

/-- The numeric endpoint of Theorem 3's tail bound. -/
lemma higham9_16_t3_endpoint :
    1 / 2 + higham9_16_fosterG 31 ≤
      Real.log (3 / 2) + Real.log (Real.log 31) := by
  obtain ⟨hlo, hhi⟩ := higham9_16_log31_bounds
  -- `G(31) ≤ (3·3.435 + 4.5·3.435²)/62 ≤ 1.0227`
  have hG : higham9_16_fosterG 31 ≤ 1.0227 := by
    unfold higham9_16_fosterG
    rw [show (((31 : ℕ)) : ℝ) = (31 : ℝ) from by norm_num]
    have hlog_nonneg : (0 : ℝ) ≤ Real.log 31 :=
      Real.log_nonneg (by norm_num)
    have hsq : Real.log 31 ^ 2 ≤ 3.435 ^ 2 :=
      pow_le_pow_left₀ hlog_nonneg hhi 2
    rw [div_le_iff₀ (by norm_num : (0:ℝ) < 2 * 31)]
    nlinarith [hsq, hhi]
  -- `log(3/2) ≥ 0.3598`
  have hlog32 : (0.3598 : ℝ) ≤ Real.log (3 / 2) := by
    have hsplit : Real.log (3 / 2) = Real.log 2 + Real.log (3 / 4) := by
      rw [← Real.log_mul (by norm_num) (by norm_num)]
      norm_num
    have h34 := higham9_16_one_sub_inv_le_log
      (show (0 : ℝ) < 3 / 4 from by norm_num)
    have hlog2 := Real.log_two_gt_d9
    rw [hsplit]
    have : (1 : ℝ) - 1 / (3 / 4) = -1 / 3 := by norm_num
    nlinarith [this ▸ h34, hlog2]
  -- `log(log 31) ≥ log(3.43) ≥ 2 − e/3.43 ≥ 1.2074`
  have hloglog : (1.2074 : ℝ) ≤ Real.log (Real.log 31) := by
    have hmono : Real.log 3.43 ≤ Real.log (Real.log 31) :=
      Real.log_le_log (by norm_num) hlo
    have hsplit : Real.log (3.43 : ℝ) =
        1 + Real.log (3.43 / Real.exp 1) := by
      rw [Real.log_div (by norm_num) (ne_of_gt (Real.exp_pos 1)),
        Real.log_exp]
      ring
    have hinner := higham9_16_one_sub_inv_le_log
      (show (0 : ℝ) < 3.43 / Real.exp 1 from by positivity)
    have hinv : (1 : ℝ) / (3.43 / Real.exp 1) = Real.exp 1 / 3.43 := by
      field_simp
    have hexp := Real.exp_one_lt_d9
    have hediv : Real.exp 1 / 3.43 ≤ 0.79251 := by
      rw [div_le_iff₀ (by norm_num : (0:ℝ) < 3.43)]
      nlinarith [hexp]
    rw [hinv] at hinner
    have h343 : (1.2074 : ℝ) ≤ Real.log 3.43 := by
      rw [hsplit]
      linarith
    linarith
  linarith [hG, hlog32, hloglog]


/-- **Foster Theorem 3, tail bound**: `s_n ≤ (3/2)·ln n / n` for `n ≥ 31`. -/
theorem higham9_16_fosterS_le_tail {n : ℕ} (hn : 31 ≤ n) :
    higham9_16_fosterS n ≤ 3 / 2 * Real.log n / n := by
  have hnR : (31 : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn
  have hn_pos : (0 : ℝ) < (n : ℝ) := by linarith
  set L := Real.log (n : ℝ) with hLdef
  have hL_pos : 0 < L := Real.log_pos (by linarith)
  set x₀ : ℝ := 3 / 2 * L / n with hx₀
  have hx₀_pos : 0 < x₀ := by
    rw [hx₀]
    positivity
  have hden : (0 : ℝ) < 1 + x₀ := by linarith
  -- the exponent estimate `E ≥ 3L/2 − G(n)`
  have hcast : ((n - 1 : ℕ) : ℝ) = (n : ℝ) - 1 := by
    push_cast [Nat.cast_sub (by omega : 1 ≤ n)]
    ring
  have hE : 3 / 2 * L - higham9_16_fosterG n ≤
      ((n - 1 : ℕ) : ℝ) * (x₀ / (1 + x₀)) := by
    rw [hcast]
    have hfrac : x₀ * (1 - x₀) ≤ x₀ / (1 + x₀) := by
      rw [le_div_iff₀ hden]
      nlinarith [sq_nonneg x₀, hx₀_pos]
    have hmul : ((n : ℝ) - 1) * (x₀ * (1 - x₀)) ≤
        ((n : ℝ) - 1) * (x₀ / (1 + x₀)) := by
      apply mul_le_mul_of_nonneg_left hfrac (by linarith)
    refine le_trans ?_ hmul
    unfold higham9_16_fosterG
    rw [hx₀, ← hLdef]
    have hL_nonneg : (0 : ℝ) ≤ L := le_of_lt hL_pos
    field_simp
    nlinarith [hL_pos, hnR, sq_nonneg L, mul_pos hn_pos hn_pos]
  -- the logarithmic endpoint chain
  have hln_final : 1 / 2 + higham9_16_fosterG n ≤ Real.log (3 / 2 * L) := by
    have hmono1 : Real.log 31 ≤ L := by
      rw [hLdef]
      exact Real.log_le_log (by norm_num) hnR
    have hmono2 : Real.log (Real.log 31) ≤ Real.log L := by
      apply Real.log_le_log ?_ hmono1
      linarith [higham9_16_log31_bounds.1]
    have hsplit : Real.log (3 / 2 * L) = Real.log (3 / 2) + Real.log L := by
      rw [Real.log_mul (by norm_num) (ne_of_gt hL_pos)]
    rw [hsplit]
    have h31 := higham9_16_t3_endpoint
    have hGle := higham9_16_fosterG_le_31 hn
    linarith
  -- assemble: stage value at `x₀` dominates the stage constant
  have hstage_ge : higham9_16_fosterStageConst n ≤
      higham9_16_fosterStage n x₀ := by
    have hsqrt_exp : Real.sqrt (n : ℝ) = Real.exp (L / 2) := by
      rw [show (n : ℝ) = Real.exp L from (Real.exp_log hn_pos).symm]
      rw [show Real.exp L = Real.exp (L / 2) ^ 2 from by
        rw [sq, ← Real.exp_add]
        congr 1
        ring]
      exact Real.sqrt_sq (le_of_lt (Real.exp_pos _))
    have hx₀_exp : x₀ = 3 / 2 * L * Real.exp (-L) := by
      rw [hx₀, Real.exp_neg, show (n : ℝ) = Real.exp L from
        (Real.exp_log hn_pos).symm]
      field_simp
    calc higham9_16_fosterStageConst n
        ≤ Real.sqrt (n : ℝ) * Real.exp (1 / 2) :=
          higham9_16_fosterStageConst_le_sqrt_mul_exp (by omega)
      _ = Real.exp (L / 2 + 1 / 2) := by
          rw [hsqrt_exp, ← Real.exp_add]
      _ ≤ x₀ * Real.exp (((n - 1 : ℕ) : ℝ) * (x₀ / (1 + x₀))) := by
          -- `e^(L/2 + 1/2) ≤ (3L/2)·e^(L/2 − G(n)) ≤ x₀·e^E`
          have hkey : Real.exp (L / 2 + 1 / 2) ≤
              3 / 2 * L * Real.exp (L / 2 - higham9_16_fosterG n) := by
            have hexp32 : 3 / 2 * L =
                Real.exp (Real.log (3 / 2 * L)) := by
              rw [Real.exp_log (by positivity)]
            rw [hexp32, ← Real.exp_add]
            apply Real.exp_le_exp.mpr
            linarith [hln_final]
          calc Real.exp (L / 2 + 1 / 2)
              ≤ 3 / 2 * L * Real.exp (L / 2 - higham9_16_fosterG n) :=
                hkey
            _ = x₀ * Real.exp (3 / 2 * L - higham9_16_fosterG n) := by
                rw [hx₀_exp, mul_assoc (3 / 2 * L), ← Real.exp_add]
                congr 2
                ring
            _ ≤ x₀ * Real.exp (((n - 1 : ℕ) : ℝ) * (x₀ / (1 + x₀))) := by
                apply mul_le_mul_of_nonneg_left
                  (Real.exp_le_exp.mpr hE) (le_of_lt hx₀_pos)
      _ ≤ x₀ * (1 + x₀) ^ (n - 1) := by
          apply mul_le_mul_of_nonneg_left
            (higham9_16_exp_le_one_add_pow (le_of_lt hx₀_pos) (n - 1))
            (le_of_lt hx₀_pos)
      _ = higham9_16_fosterStage n x₀ := rfl
  -- conclude by strict monotonicity of the stage function
  by_contra hgt
  push_neg at hgt
  have hmono := higham9_16_fosterStage_strictMonoOn n
    (Set.mem_Ici.mpr (le_of_lt hx₀_pos))
    (Set.mem_Ici.mpr (higham9_16_fosterS_nonneg (by omega : 1 ≤ n)))
    hgt
  rw [(higham9_16_fosterS_spec (by omega : 1 ≤ n)).2] at hmono
  linarith [hstage_ge, hmono]



/-! ## Equation (9.16) / Foster Theorem 3: the telescoping tail induction -/

/-- Second-order lower bound `x - x²/2 ≤ ln(1+x)` for `x ∈ [0,1]`. -/
lemma higham9_16_log_one_add_ge {x : ℝ} (hx : 0 ≤ x) (hx1 : x ≤ 1) :
    x - x ^ 2 / 2 ≤ Real.log (1 + x) := by
  have hden : (0 : ℝ) < 1 + x := by linarith
  -- `e^(x - x²/2) ≤ 1 + x` since `e^x ≤ (1+x)(1+x²/2) ≤ (1+x)e^(x²/2)`
  have hexp3 := Real.exp_bound' hx hx1 (n := 3) (by norm_num)
  norm_num [Finset.sum_range_succ, Nat.factorial] at hexp3
  have hstep : Real.exp x ≤ (1 + x) * (1 + x ^ 2 / 2) := by
    nlinarith [hexp3, sq_nonneg x, pow_nonneg hx 3,
      mul_nonneg (mul_nonneg hx hx) hx]
  have hhalf : 1 + x ^ 2 / 2 ≤ Real.exp (x ^ 2 / 2) := by
    linarith [Real.add_one_le_exp (x ^ 2 / 2)]
  have hchain : Real.exp x ≤ (1 + x) * Real.exp (x ^ 2 / 2) := by
    calc Real.exp x ≤ (1 + x) * (1 + x ^ 2 / 2) := hstep
      _ ≤ (1 + x) * Real.exp (x ^ 2 / 2) := by
          apply mul_le_mul_of_nonneg_left hhalf (by linarith)
  -- divide by `e^(x²/2)` and take logs
  have hdiv : Real.exp (x - x ^ 2 / 2) ≤ 1 + x := by
    rw [show x - x ^ 2 / 2 = x + (-(x ^ 2 / 2)) from by ring,
      Real.exp_add]
    rw [show (1 : ℝ) + x = ((1 + x) * Real.exp (x ^ 2 / 2)) *
        Real.exp (-(x ^ 2 / 2)) from by
      rw [mul_assoc, ← Real.exp_add]
      simp]
    apply mul_le_mul_of_nonneg_right hchain
      (le_of_lt (Real.exp_pos _))
  calc x - x ^ 2 / 2 = Real.log (Real.exp (x - x ^ 2 / 2)) :=
        (Real.log_exp _).symm
    _ ≤ Real.log (1 + x) := Real.log_le_log (Real.exp_pos _) hdiv

/-- Upper bound `ln(1+x) ≤ x`. -/
lemma higham9_16_log_one_add_le {x : ℝ} (hx : 0 ≤ x) :
    Real.log (1 + x) ≤ x := by
  have h := Real.log_le_sub_one_of_pos
    (show (0 : ℝ) < 1 + x from by linarith)
  linarith

/-- **Theorem 3, telescoping step**: for `n ≥ 30`,
`(3/2)·ln(n+1)/(n+1) ≤ (3/4)(ln²(n+1) − ln²n)`. -/
lemma higham9_16_t3_step {n : ℕ} (hn : 30 ≤ n) :
    3 / 2 * Real.log ((n : ℝ) + 1) / ((n : ℝ) + 1) ≤
      3 / 4 * (Real.log ((n : ℝ) + 1) ^ 2 - Real.log (n : ℝ) ^ 2) := by
  have hnR : (30 : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn
  have hn_pos : (0 : ℝ) < (n : ℝ) := by linarith
  have hn1_pos : (0 : ℝ) < (n : ℝ) + 1 := by linarith
  set L := Real.log (n : ℝ) with hL
  set L' := Real.log ((n : ℝ) + 1) with hL'
  have hLL' : L ≤ L' := Real.log_le_log hn_pos (by linarith)
  have hL_ge : (3 : ℝ) ≤ L := by
    rw [hL]
    calc (3 : ℝ) = Real.log (Real.exp 3) := (Real.log_exp 3).symm
      _ ≤ Real.log (n : ℝ) := by
          apply Real.log_le_log (Real.exp_pos 3)
          have he := Real.exp_one_lt_d9
          have he_pos := Real.exp_pos 1
          calc Real.exp 3 = Real.exp 1 * Real.exp 1 * Real.exp 1 := by
                rw [← Real.exp_add, ← Real.exp_add]
                norm_num
            _ ≤ 2.7182818286 ^ 3 := by nlinarith [he, he_pos]
            _ ≤ 30 := by norm_num
            _ ≤ (n : ℝ) := hnR
  have hL'_ge : (3 : ℝ) ≤ L' := le_trans hL_ge hLL'
  -- the increment `d := L' − L = ln(1+1/n)` is in `[1/n − 1/(2n²), 1/n]`
  set d := L' - L with hd
  have hd_eq : d = Real.log (1 + 1 / n) := by
    rw [hd, hL', hL]
    rw [← Real.log_div (by positivity) (ne_of_gt hn_pos)]
    congr 1
    field_simp
  have hd_le : d ≤ 1 / n := by
    rw [hd_eq]
    exact higham9_16_log_one_add_le (by positivity)
  have hd_ge : 1 / n - (1 / n) ^ 2 / 2 ≤ d := by
    rw [hd_eq]
    apply higham9_16_log_one_add_ge (by positivity)
    rw [div_le_one hn_pos]
    linarith
  -- main chain: `2 L' ≤ d (L' + L) (n+1)`
  have hsum_ge : 2 * L' - 1 / n ≤ L' + L := by
    have hLlow : L' - 1 / n ≤ L := by
      have : L = L' - d := by
        rw [hd]
        ring
      rw [this]
      linarith
    linarith
  have hd_ge' : (2 * n - 1) / (2 * (n : ℝ) ^ 2) ≤ d := by
    have heq : 1 / (n : ℝ) - (1 / n) ^ 2 / 2 =
        (2 * n - 1) / (2 * (n : ℝ) ^ 2) := by
      field_simp
    linarith [heq ▸ hd_ge]
  have hkey : 2 * L' ≤ d * (L' + L) * ((n : ℝ) + 1) := by
    have hmid : (2 * n - 1) / (2 * (n : ℝ) ^ 2) *
        (2 * L' - 1 / n) * ((n : ℝ) + 1) ≤
        d * (L' + L) * ((n : ℝ) + 1) := by
      apply mul_le_mul_of_nonneg_right ?_ (by linarith)
      have h2L : (0 : ℝ) ≤ 2 * L' - 1 / n := by
        have : (1 : ℝ) / n ≤ 1 := by
          rw [div_le_one hn_pos]
          linarith
        linarith
      calc (2 * n - 1) / (2 * (n : ℝ) ^ 2) * (2 * L' - 1 / n)
          ≤ d * (2 * L' - 1 / n) :=
            mul_le_mul_of_nonneg_right hd_ge' h2L
        _ ≤ d * (L' + L) := by
            apply mul_le_mul_of_nonneg_left hsum_ge
            rw [hd]
            linarith
    refine le_trans ?_ hmid
    -- `(2n−1)(2nL'−1)(n+1) ≥ 4n³ L'`, clear denominators
    rw [show (2 * (n : ℝ) - 1) / (2 * (n : ℝ) ^ 2) * (2 * L' - 1 / n) *
        ((n : ℝ) + 1) = (2 * (n : ℝ) - 1) * (2 * (n : ℝ) * L' - 1) *
        ((n : ℝ) + 1) / (2 * (n : ℝ) ^ 3) from by
      field_simp]
    rw [le_div_iff₀ (by positivity)]
    have hprod : (0 : ℝ) ≤ 2 * (n : ℝ) * ((n : ℝ) - 1) * (L' - 3) := by
      apply mul_nonneg (mul_nonneg (by linarith) (by linarith))
      linarith
    nlinarith [hprod, hnR, hn_pos, sq_nonneg ((n : ℝ) - 2)]
  -- finish: unfold the squares and divide back
  rw [div_le_iff₀ hn1_pos]
  have hsq : L' ^ 2 - L ^ 2 = d * (L' + L) := by
    rw [hd]
    ring
  nlinarith [hkey, hsq]

/-- **Theorem 3, telescoping induction**: the exponential-form bound
propagates from the `n = 30` base. -/
theorem higham9_16_fosterT_le_exp_of_base
    (hbase : higham9_16_fosterT 30 ≤
      3 / 2 * Real.exp (3 / 4 * Real.log ((30 : ℕ) : ℝ) ^ 2)) :
    ∀ n : ℕ, 30 ≤ n →
      higham9_16_fosterT n ≤
        3 / 2 * Real.exp (3 / 4 * Real.log ((n : ℕ) : ℝ) ^ 2) := by
  intro n hn
  induction n, hn using Nat.le_induction with
  | base => exact hbase
  | succ m hm ih =>
      have hm1 : 1 ≤ m := by omega
      have hrec := higham9_16_fosterT_succ (n := m) hm1
      have hs_pos : 0 < higham9_16_fosterS (m + 1) :=
        higham9_16_fosterS_pos (by omega)
      have hs_le : higham9_16_fosterS (m + 1) ≤
          3 / 2 * Real.log (((m + 1 : ℕ)) : ℝ) / (((m + 1 : ℕ)) : ℝ) :=
        higham9_16_fosterS_le_tail (by omega)
      have hcast : (((m + 1 : ℕ)) : ℝ) = (m : ℝ) + 1 := by
        push_cast
        ring
      rw [hrec]
      have hexp_bound : 1 + higham9_16_fosterS (m + 1) ≤
          Real.exp (3 / 4 * (Real.log ((m : ℝ) + 1) ^ 2 -
            Real.log (m : ℝ) ^ 2)) := by
        calc 1 + higham9_16_fosterS (m + 1)
            ≤ Real.exp (higham9_16_fosterS (m + 1)) := by
              linarith [Real.add_one_le_exp (higham9_16_fosterS (m + 1))]
          _ ≤ Real.exp (3 / 2 * Real.log ((m : ℝ) + 1) /
              ((m : ℝ) + 1)) := by
              apply Real.exp_le_exp.mpr
              rw [hcast] at hs_le
              exact hs_le
          _ ≤ Real.exp (3 / 4 * (Real.log ((m : ℝ) + 1) ^ 2 -
              Real.log (m : ℝ) ^ 2)) := by
              apply Real.exp_le_exp.mpr
              exact higham9_16_t3_step (by omega)
      calc higham9_16_fosterT m * (1 + higham9_16_fosterS (m + 1))
          ≤ (3 / 2 * Real.exp (3 / 4 * Real.log (m : ℝ) ^ 2)) *
            Real.exp (3 / 4 * (Real.log ((m : ℝ) + 1) ^ 2 -
              Real.log (m : ℝ) ^ 2)) := by
            apply mul_le_mul ih hexp_bound (by linarith) (by positivity)
        _ = 3 / 2 * Real.exp (3 / 4 * Real.log ((m : ℝ) + 1) ^ 2) := by
            rw [mul_assoc, ← Real.exp_add]
            congr 2
            ring
        _ = 3 / 2 * Real.exp (3 / 4 *
            Real.log (((m + 1 : ℕ)) : ℝ) ^ 2) := by
            rw [hcast]



/-- Rational upper-bracket criterion for the stage roots: a squared,
denominator-free certificate. -/
lemma higham9_16_fosterS_le_of_sq_cert {k : ℕ} (hk : 2 ≤ k) {u : ℝ}
    (hu : 0 ≤ u)
    (hcert : ((k : ℝ)) ^ k ≤ (((k - 1 : ℕ)) : ℝ) ^ (k - 1) *
      (u * (1 + u) ^ (k - 1)) ^ 2) :
    higham9_16_fosterS k ≤ u := by
  have hk1 : 1 ≤ k := by omega
  have hstage_ge : higham9_16_fosterStageConst k ≤
      higham9_16_fosterStage k u := by
    unfold higham9_16_fosterStageConst higham9_16_fosterStage
    have hden : (0 : ℝ) < Real.sqrt ((((k - 1 : ℕ)) : ℝ) ^ (k - 1)) := by
      have := higham9_16_fosterQStage_sqrt_ge_one k 1
      linarith
    rw [div_le_iff₀ hden]
    have hlhs : Real.sqrt (((k : ℝ)) ^ k) ≤
        Real.sqrt ((((k - 1 : ℕ)) : ℝ) ^ (k - 1) *
          (u * (1 + u) ^ (k - 1)) ^ 2) := Real.sqrt_le_sqrt hcert
    have hrhs : Real.sqrt ((((k - 1 : ℕ)) : ℝ) ^ (k - 1) *
        (u * (1 + u) ^ (k - 1)) ^ 2) =
        u * (1 + u) ^ (k - 1) * Real.sqrt ((((k - 1 : ℕ)) : ℝ) ^ (k - 1)) := by
      rw [Real.sqrt_mul (by positivity) _]
      rw [Real.sqrt_sq (by positivity : (0:ℝ) ≤ u * (1 + u) ^ (k - 1))]
      ring
    linarith [hrhs ▸ hlhs]
  by_contra hgt
  push_neg at hgt
  have hmono := higham9_16_fosterStage_strictMonoOn k
    (Set.mem_Ici.mpr hu)
    (Set.mem_Ici.mpr (higham9_16_fosterS_nonneg hk1)) hgt
  rw [(higham9_16_fosterS_spec hk1).2] at hmono
  linarith [hstage_ge, hmono]


