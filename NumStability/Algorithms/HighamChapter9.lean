    exact
      higham9_15_resolvent_matrix_majorant_of_componentwise_inequality
        Gabs R Gabs Wloc
        (by simpa [Gabs] using hR)
        (by
          intro i j
          simpa [Gabs, Wloc] using hself i j)
  intro i j
  simpa [Gabs, Wloc] using hmajor i j

