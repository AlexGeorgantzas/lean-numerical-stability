/-! ## Theorem 9.11 (Bohte), the comparison matrix `B` of Bohte [146, 1975] §5

Bohte's sharp growth analysis dominates every GEPP active window entrywise by
a fixed `(p+1) × 2p` matrix `B` defined by `b(i,k) = b(i+1,k+1) + b(1,k+1)`
with last row and last column equal to `1` (Bohte [146, 1975], eq. (9)).
We define `b(i,k)` as `higham9_11_bohteBaux p (2p - k) i`, recursing on the
distance `d = 2p - k` from the last column, and prove the properties of
Bohte's Lemma 7 needed for the growth theorem, together with the closed form
`b(1,1) = 2^(2p-1) - (p-1)·2^(p-2)` (the printed Theorem 9.11 constant). -/

/-- **Bohte [146, 1975], eq. (9)**: the comparison matrix `B`, indexed by the
distance `d = 2p - k` from the last column and the row index `i` (rows
`i >= p+1` and the last column `d = 0` are all ones). -/
noncomputable def higham9_11_bohteBaux (p : ℕ) : ℕ → ℕ → ℝ
  | 0, _ => 1
  | d + 1, i =>
      if p + 1 ≤ i then 1
      else higham9_11_bohteBaux p d (i + 1) + higham9_11_bohteBaux p d 1

/-- **Bohte Lemma 7 support**, unfolding of the recurrence inside the window. -/
lemma higham9_11_bohteBaux_succ {p d i : ℕ} (hi : i ≤ p) :
    higham9_11_bohteBaux p (d + 1) i =
      higham9_11_bohteBaux p d (i + 1) + higham9_11_bohteBaux p d 1 := by
  conv_lhs => rw [higham9_11_bohteBaux]
  rw [if_neg (by omega)]

/-- **Bohte Lemma 7 support**, rows below the window are ones. -/
lemma higham9_11_bohteBaux_high {p d i : ℕ} (hi : p + 1 ≤ i) :
    higham9_11_bohteBaux p d i = 1 := by
  cases d with
  | zero => rfl
  | succ d =>
      conv_lhs => rw [higham9_11_bohteBaux]
      rw [if_pos hi]

/-- **Bohte Lemma 7 (a)**: all entries of `B` are at least `1`. -/
lemma higham9_11_bohteBaux_one_le (p : ℕ) :
    ∀ d i : ℕ, 1 ≤ higham9_11_bohteBaux p d i := by
  intro d
  induction d with
  | zero => intro i; exact le_refl 1
  | succ d ih =>
      intro i
      by_cases hi : p + 1 ≤ i
      · rw [higham9_11_bohteBaux_high hi]
      · rw [higham9_11_bohteBaux_succ (by omega)]
        have h1 := ih (i + 1)
        have h2 := ih 1
        linarith

/-- **Bohte Lemma 7 support**, entries are nonnegative. -/
lemma higham9_11_bohteBaux_nonneg (p d i : ℕ) :
    0 ≤ higham9_11_bohteBaux p d i :=
  le_trans zero_le_one (higham9_11_bohteBaux_one_le p d i)

/-- **Bohte Lemma 7 (b)**, row-antitone form: entries do not increase down a
column, so the first row dominates. -/
lemma higham9_11_bohteBaux_antitone_row (p : ℕ) :
    ∀ d i : ℕ, higham9_11_bohteBaux p d (i + 1) ≤
      higham9_11_bohteBaux p d i := by
  intro d
  induction d with
  | zero => intro i; exact le_refl 1
  | succ d ih =>
      intro i
      by_cases hi1 : p + 1 ≤ i
      · rw [higham9_11_bohteBaux_high hi1,
          higham9_11_bohteBaux_high (by omega)]
      · by_cases hi2 : i = p
        · rw [higham9_11_bohteBaux_high (show p + 1 ≤ i + 1 by omega),
            higham9_11_bohteBaux_succ (show i ≤ p by omega),
            higham9_11_bohteBaux_high (show p + 1 ≤ i + 1 by omega)]
          have h2 := higham9_11_bohteBaux_one_le p d 1
          linarith
        · rw [higham9_11_bohteBaux_succ (by omega),
            higham9_11_bohteBaux_succ (by omega)]
          have h := ih (i + 1)
          linarith

/-- **Bohte Lemma 7 (b)**: the first row of `B` dominates every row. -/
lemma higham9_11_bohteBaux_le_row_one (p d : ℕ) :
    ∀ i : ℕ, 1 ≤ i → higham9_11_bohteBaux p d i ≤
      higham9_11_bohteBaux p d 1 := by
  intro i hi
  induction i with
  | zero => omega
  | succ i ih =>
      by_cases hi1 : 1 ≤ i
      · exact le_trans (higham9_11_bohteBaux_antitone_row p d i) (ih hi1)
      · have : i = 0 := by omega
        subst this
        exact le_refl _

/-- **Bohte Lemma 7 (c,d) support**: the first-row values do not decrease
with the distance from the last column, so `b(1,1)` is the maximum. -/
lemma higham9_11_bohteBaux_row_one_mono (p : ℕ) :
    Monotone (fun d => higham9_11_bohteBaux p d 1) := by
  apply monotone_nat_of_le_succ
  intro d
  by_cases hp : 1 ≤ p
  · rw [higham9_11_bohteBaux_succ (by omega)]
    have h := higham9_11_bohteBaux_nonneg p d 2
    linarith
  · have hp0 : p = 0 := by omega
    subst hp0
    rw [higham9_11_bohteBaux_high (by omega),
      higham9_11_bohteBaux_high (by omega)]

/-- **Bohte Lemma 7 (d)**: every entry of `B` is at most the corner value. -/
lemma higham9_11_bohteBaux_le_top (p D : ℕ) :
    ∀ d i : ℕ, d ≤ D → 1 ≤ i →
      higham9_11_bohteBaux p d i ≤ higham9_11_bohteBaux p D 1 := by
  intro d i hd hi
  calc higham9_11_bohteBaux p d i ≤ higham9_11_bohteBaux p d 1 :=
        higham9_11_bohteBaux_le_row_one p d i hi
    _ ≤ higham9_11_bohteBaux p D 1 :=
        higham9_11_bohteBaux_row_one_mono p hd

/-- **Bohte Lemma 7 (e), regime 1**: pure doubling before the window bottom
is reached: `b`-entries with `d + i <= p + 1` equal `2^d`. -/
lemma higham9_11_bohteBaux_pow {p : ℕ} :
    ∀ d i : ℕ, 1 ≤ i → d + i ≤ p + 1 →
      higham9_11_bohteBaux p d i = 2 ^ d := by
  intro d
  induction d with
  | zero => intro i _ _; norm_num [higham9_11_bohteBaux]
  | succ d ih =>
      intro i hi hdi
      rw [higham9_11_bohteBaux_succ (by omega)]
      rw [ih (i + 1) (by omega) (by omega), ih 1 (by omega) (by omega)]
      ring

/-- **Bohte Lemma 7 support**, the diagonal unfolding of `B` into first-row
values: inside the window, `b(i,k) = 1 + sum of the first-row values of the
`p + 1 - i` previous columns`. -/
lemma higham9_11_bohteBaux_eq_one_add_sum {p : ℕ} :
    ∀ m d : ℕ, m ≤ p → m ≤ d →
      higham9_11_bohteBaux p d (p + 1 - m) =
        1 + ∑ t ∈ Finset.range m, higham9_11_bohteBaux p (d - 1 - t) 1 := by
  intro m
  induction m with
  | zero =>
      intro d _ _
      rw [higham9_11_bohteBaux_high (by omega)]
      simp
  | succ m ih =>
      intro d hm hd
      have hidx : p + 1 - (m + 1) ≤ p := by omega
      obtain ⟨d', rfl⟩ : ∃ d', d = d' + 1 := ⟨d - 1, by omega⟩
      rw [higham9_11_bohteBaux_succ hidx]
      have hstep : p + 1 - (m + 1) + 1 = p + 1 - m := by omega
      rw [hstep, ih d' (by omega) (by omega)]
      rw [Finset.sum_range_succ']
      have hre : ∀ t ∈ Finset.range m,
          higham9_11_bohteBaux p (d' - 1 - t) 1 =
            higham9_11_bohteBaux p (d' + 1 - 1 - (t + 1)) 1 := by
        intro t ht
        congr 1
        omega
      rw [Finset.sum_congr rfl hre]
      have hlast : higham9_11_bohteBaux p (d' + 1 - 1 - 0) 1 =
          higham9_11_bohteBaux p d' 1 := by
        congr 1
      rw [hlast]
      ring

/-- Auxiliary geometric identity: `∑ s < u, s·2^(s-1) = (u-2)·2^(u-1) + 1`
for `u >= 1`. -/
lemma higham9_11_sum_mul_two_pow {u : ℕ} (hu : 1 ≤ u) :
    ∑ s ∈ Finset.range u, (s : ℝ) * 2 ^ (s - 1) =
      ((u : ℝ) - 2) * 2 ^ (u - 1) + 1 := by
  induction u with
  | zero => omega
  | succ u ih =>
      by_cases hu1 : 1 ≤ u
      · rw [Finset.sum_range_succ, ih hu1]
        have he : u + 1 - 1 = (u - 1) + 1 := by omega
        rw [he, pow_succ]
        have hcast : ((u + 1 : ℕ) : ℝ) = (u : ℝ) + 1 := by push_cast; ring
        rw [hcast]
        ring
      · have : u = 0 := by omega
        subst this
        norm_num
        try rfl

/-- Geometric block sum: `∑ t < m, 2^(a + m - 1 - t) = 2^a·(2^m - 1)`. -/
lemma higham9_11_sum_two_pow_desc {a m : ℕ} :
    ∑ t ∈ Finset.range m, (2 : ℝ) ^ (a + m - 1 - t) =
      2 ^ a * (2 ^ m - 1) := by
  induction m with
  | zero => simp
  | succ m ih =>
      rw [Finset.sum_range_succ']
      have hre : ∀ t ∈ Finset.range m,
          (2 : ℝ) ^ (a + (m + 1) - 1 - (t + 1)) = 2 ^ (a + m - 1 - t) := by
        intro t ht
        congr 1
        omega
      rw [Finset.sum_congr rfl hre, ih]
      have hlast : a + (m + 1) - 1 - 0 = a + m := by omega
      rw [hlast, pow_add, pow_succ]
      ring

/-- **Bohte Lemma 7 (e), regime 2**: past the window bottom the first-row
values satisfy `c(p+u) = 2^(p+u) - u·2^(u-1)` for `0 <= u <= p - 1`. -/
lemma higham9_11_bohteBaux_row_one_regime2 {p : ℕ} (hp : 1 ≤ p) :
    ∀ u : ℕ, u ≤ p - 1 →
      higham9_11_bohteBaux p (p + u) 1 =
        2 ^ (p + u) - (u : ℝ) * 2 ^ (u - 1) := by
  intro u
  induction u using Nat.strong_induction_on with
  | _ u ihu =>
      intro hu
      cases u with
      | zero =>
          simpa using higham9_11_bohteBaux_pow (p := p) p 1 le_rfl (by omega)
      | succ u =>
          -- one recurrence step, then the diagonal unfolding at row 2
          have hrow2 : higham9_11_bohteBaux p (p + u) 2 =
              1 + ∑ t ∈ Finset.range (p - 1),
                higham9_11_bohteBaux p (p + u - 1 - t) 1 := by
            have h := higham9_11_bohteBaux_eq_one_add_sum (p := p)
              (p - 1) (p + u) (by omega) (by omega)
            have hidx : p + 1 - (p - 1) = 2 := by omega
            rwa [hidx] at h
          -- split the window sum at `t = u`
          have hsplit : ∑ t ∈ Finset.range (p - 1),
              higham9_11_bohteBaux p (p + u - 1 - t) 1 =
              (∑ t ∈ Finset.range u,
                higham9_11_bohteBaux p (p + u - 1 - t) 1) +
              ∑ t ∈ Finset.Ico u (p - 1),
                higham9_11_bohteBaux p (p + u - 1 - t) 1 := by
            rw [Finset.range_eq_Ico,
              ← Finset.sum_Ico_consecutive _ (Nat.zero_le u) (by omega)]
          -- regime-2 part: indices `t < u` have `p + u - 1 - t >= p`
          have hpart1 : ∑ t ∈ Finset.range u,
              higham9_11_bohteBaux p (p + u - 1 - t) 1 =
              ∑ t ∈ Finset.range u,
                ((2 : ℝ) ^ (p + u - 1 - t) -
                  ((u - 1 - t : ℕ) : ℝ) * 2 ^ (u - 1 - t - 1)) := by
            apply Finset.sum_congr rfl
            intro t ht
            have ht' : t < u := Finset.mem_range.mp ht
            have hidx : p + u - 1 - t = p + (u - 1 - t) := by omega
            rw [hidx, ihu (u - 1 - t) (by omega) (by omega)]
          -- regime-1 part: indices `u <= t <= p - 2` have exponents `<= p`
          have hpart2 : ∑ t ∈ Finset.Ico u (p - 1),
              higham9_11_bohteBaux p (p + u - 1 - t) 1 =
              ∑ t ∈ Finset.Ico u (p - 1), (2 : ℝ) ^ (p + u - 1 - t) := by
            apply Finset.sum_congr rfl
            intro t ht
            obtain ⟨ht1, ht2⟩ := Finset.mem_Ico.mp ht
            exact higham9_11_bohteBaux_pow (p + u - 1 - t) 1 le_rfl (by omega)
          -- evaluate the three sums
          have hsum1 : ∑ t ∈ Finset.range u, (2 : ℝ) ^ (p + u - 1 - t) =
              2 ^ p * (2 ^ u - 1) := by
            exact higham9_11_sum_two_pow_desc
          have hsum2 : ∑ t ∈ Finset.range u,
              ((u - 1 - t : ℕ) : ℝ) * 2 ^ (u - 1 - t - 1) =
              ∑ s ∈ Finset.range u, (s : ℝ) * 2 ^ (s - 1) :=
            Finset.sum_range_reflect (fun s => (s : ℝ) * 2 ^ (s - 1)) u
          have hsum3 : ∑ t ∈ Finset.Ico u (p - 1),
              (2 : ℝ) ^ (p + u - 1 - t) = 2 ^ (u + 1) * (2 ^ (p - 1 - u) - 1) := by
            rw [Finset.sum_Ico_eq_sum_range]
            have := higham9_11_sum_two_pow_desc (a := u + 1) (m := p - 1 - u)
            rw [← this]
            apply Finset.sum_congr rfl
            intro t ht
            have ht' : t < p - 1 - u := Finset.mem_range.mp ht
            congr 1
            omega
          -- one recurrence step at the top row
          have hrec : higham9_11_bohteBaux p (p + (u + 1)) 1 =
              higham9_11_bohteBaux p (p + u) 2 +
                higham9_11_bohteBaux p (p + u) 1 := by
            have hidx : p + (u + 1) = (p + u) + 1 := by omega
            rw [hidx, higham9_11_bohteBaux_succ (by omega)]
          have hih : higham9_11_bohteBaux p (p + u) 1 =
              2 ^ (p + u) - (u : ℝ) * 2 ^ (u - 1) :=
            ihu u (by omega) (by omega)
          -- exponent bookkeeping
          have e1 : (2 : ℝ) ^ (u + 1) * 2 ^ (p - 1 - u) = 2 ^ p := by
            rw [← pow_add]
            congr 1
            omega
          have e2 : (2 : ℝ) ^ (p + u) = 2 ^ p * 2 ^ u := pow_add 2 p u
          have e3 : (2 : ℝ) ^ (p + (u + 1)) = 2 ^ p * 2 ^ u * 2 := by
            rw [pow_add, pow_succ]
            ring
          have e5 : u + 1 - 1 = u := by omega
          have e6 : (2 : ℝ) ^ (u + 1) * (2 ^ (p - 1 - u) - 1) =
              2 ^ p - 2 ^ u * 2 := by
            rw [mul_sub, e1, pow_succ]
            ring
          rw [hrec, hrow2, hsplit, hpart1, Finset.sum_sub_distrib,
            hsum1, hsum2, hpart2, hsum3, hih, e5, e6, e2, e3]
          by_cases hu1 : 1 ≤ u
          · rw [higham9_11_sum_mul_two_pow hu1]
            have e4 : (2 : ℝ) ^ u = 2 ^ (u - 1) * 2 := by
              rw [← pow_succ]
              congr 1
              omega
            rw [e4]
            push_cast
            ring
          · have hu0 : u = 0 := by omega
            subst hu0
            simp only [Finset.range_zero, Finset.sum_empty, Nat.cast_zero]
            push_cast
            ring

/-- **Bohte [146, 1975], Theorem (§5) scalar**: the corner of the comparison
matrix equals the printed Theorem 9.11 constant,
`b(1,1) = 2^(2p-1) - (p-1)·2^(p-2)`. -/
theorem higham9_11_bohteBaux_top_eq_bohteBound {p : ℕ} (hp : 1 ≤ p) :
    higham9_11_bohteBaux p (2 * p - 1) 1 = higham9_11_bohteBound p := by
  have hidx : 2 * p - 1 = p + (p - 1) := by omega
  rw [hidx, higham9_11_bohteBaux_row_one_regime2 hp (p - 1) le_rfl]
  unfold higham9_11_bohteBound
  have h1 : p + (p - 1) = 2 * p - 1 := by omega
  rw [h1]
  have h2 : ((p - 1 : ℕ) : ℝ) = (p : ℝ) - 1 := by
    have : (1 : ℕ) ≤ p := hp
    push_cast [this]
    ring
  rw [h2]
  congr 2


/-- **Theorem 9.11 (Bohte), sharp band-tracked invariant**: like
`higham9_11_BandActiveBound`, but with the per-column fill profile replaced by
Bohte's per-entry comparison matrix `B` (Bohte [146, 1975], §5): window entry
`(i, j)` is bounded by `M·b(i+1, j+1) = M·bohteBaux p (2p-1-j) (i+1)`. -/
def higham9_11_BandActiveBoundSharp (n p : ℕ) (M : ℝ)
    (S : Fin n → Fin n → ℝ) : Prop :=
  (∀ i j : Fin n, j.val + p < i.val → S i j = 0) ∧
  (∀ i j : Fin n, i.val ≤ p → 2 * p < j.val → S i j = 0) ∧
  (∀ i j : Fin n, i.val ≤ p →
    |S i j| ≤ M * higham9_11_bohteBaux p (2 * p - 1 - j.val) (i.val + 1)) ∧
  (∀ i i' j : Fin n, i.val ≤ p → i'.val ≤ p → j.val = 2 * p →
    S i j ≠ 0 → S i' j ≠ 0 → i = i') ∧
  (∀ i j : Fin n, p < i.val →
    |S i j| ≤ M ∧ (i.val + p < j.val → S i j = 0))

/-- **Theorem 9.11 support**, a banded matrix with entries bounded by `M`
satisfies the sharp band-tracked invariant. -/
theorem higham9_11_bandActiveBoundSharp_of_isBanded {n p : ℕ} {M : ℝ}
    {A : Fin n → Fin n → ℝ} (hM : 0 ≤ M)
    (hband : IsBanded n p p A)
    (hbound : ∀ i j : Fin n, |A i j| ≤ M) :
    higham9_11_BandActiveBoundSharp n p M A := by
  have hMb : ∀ d i : ℕ, M ≤ M * higham9_11_bohteBaux p d i := fun d i =>
    le_mul_of_one_le_right hM (higham9_11_bohteBaux_one_le p d i)
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · intro i j hij
    exact hband i j (Or.inl hij)
  · intro i j hi hj
    exact hband i j (Or.inr (by omega))
  · intro i j _
    exact le_trans (hbound i j) (hMb _ _)
  · intro i i' j hi hi' hj hne hne'
    have hiv : i.val = p := by
      by_contra h
      exact hne (hband i j (Or.inr (by omega)))
    have hiv' : i'.val = p := by
      by_contra h
      exact hne' (hband i' j (Or.inr (by omega)))
    exact Fin.ext (by omega)
  · intro i j hi
    refine ⟨hbound i j, fun hj => hband i j (Or.inr (by omega))⟩

/-- **Theorem 9.11 support**, every entry of a sharply band-tracked stage is
bounded by the Bohte corner value `b(1,1)·M`. -/
theorem higham9_11_bandActiveSharp_entry_abs_le {n p : ℕ} {M : ℝ}
    {S : Fin n → Fin n → ℝ}
    (hM : 0 ≤ M)
    (hS : higham9_11_BandActiveBoundSharp n p M S)
    (i j : Fin n) :
    |S i j| ≤ higham9_11_bohteBaux p (2 * p - 1) 1 * M := by
  by_cases hi : i.val ≤ p
  · have h := hS.2.2.1 i j hi
    have htop := higham9_11_bohteBaux_le_top p (2 * p - 1)
      (2 * p - 1 - j.val) (i.val + 1) (by omega) (by omega)
    calc |S i j| ≤ M * higham9_11_bohteBaux p (2 * p - 1 - j.val)
          (i.val + 1) := h
      _ ≤ M * higham9_11_bohteBaux p (2 * p - 1) 1 :=
          mul_le_mul_of_nonneg_left htop hM
      _ = higham9_11_bohteBaux p (2 * p - 1) 1 * M := by ring
  · have h := (hS.2.2.2.2 i j (by omega)).1
    calc |S i j| ≤ M := h
      _ ≤ higham9_11_bohteBaux p (2 * p - 1) 1 * M :=
          le_mul_of_one_le_left hM (higham9_11_bohteBaux_one_le p _ _)

/-- **Theorem 9.11 (Bohte [146, 1975], §5, main induction)**: one
partial-pivoting Gaussian elimination step preserves the sharp band-tracked
invariant.  The two swap cases close exactly against Bohte's recurrence
`b(i,k) = b(i+1,k+1) + b(1,k+1)`: the displaced leading row lands on the
recurrence with equality, and all other window rows use the first-row
domination of Lemma 7(b). -/
theorem higham9_11_bandActiveSharp_schur_preserved {p m : ℕ}
    {S : Fin (m + 1) → Fin (m + 1) → ℝ} {M : ℝ} {r : Fin (m + 1)}
    (hM : 0 ≤ M)
    (hS : higham9_11_BandActiveBoundSharp (m + 1) p M S)
    (hchoice : higham9_1_partialPivotChoice S 0 r)
    (hpivot : S r 0 ≠ 0) :
    higham9_11_BandActiveBoundSharp m p M
      (luFirstSchurComplement
        (higham9_2_rowPermutedMatrix S (higham9_7_firstPivotRowSwap r))) := by
  obtain ⟨h1, h2, h3, h4, h5⟩ := hS
  have hrle : r.val ≤ p := by
    by_contra h
    exact hpivot (h1 r 0 (by simp only [Fin.val_zero]; omega))
  set σ : Fin (m + 1) → Fin (m + 1) := higham9_7_firstPivotRowSwap r
    with hσdef
  have hσ0 : σ 0 = r := by
    simp [hσdef, higham9_7_firstPivotRowSwap]
  have hσr : σ r = 0 := by
    by_cases h : r = 0
    · subst h
      simp [hσdef, higham9_7_firstPivotRowSwap]
    · simp [hσdef, higham9_7_firstPivotRowSwap, h]
  have hσ_high : ∀ x : Fin (m + 1), p < x.val → σ x = x := by
    intro x hx
    have hx0 : x ≠ 0 := by
      intro h
      subst h
      simp at hx
    have hxr : x ≠ r := by
      intro h
      subst h
      omega
    simp [hσdef, higham9_7_firstPivotRowSwap, hx0, hxr]
  have hσ_window : ∀ x : Fin (m + 1), x.val ≤ p → (σ x).val ≤ p := by
    intro x hx
    by_cases hx0 : x = 0
    · subst hx0
      rw [hσ0]
      exact hrle
    · by_cases hxr : x = r
      · subst hxr
        rw [hσr]
        simp
      · have hid : σ x = x := by
          simp [hσdef, higham9_7_firstPivotRowSwap, hx0, hxr]
        rw [hid]
        exact hx
  have hSchur : ∀ i j : Fin m,
      luFirstSchurComplement (higham9_2_rowPermutedMatrix S σ) i j =
        S (σ i.succ) j.succ - S (σ i.succ) 0 * S r j.succ / S r 0 := by
    intro i j
    show S (σ i.succ) j.succ - S (σ i.succ) 0 * S (σ 0) j.succ / S (σ 0) 0 = _
    rw [hσ0]
  have hmul : ∀ x : Fin (m + 1), |S x 0 / S r 0| ≤ 1 := fun x =>
    higham9_1_partialPivot_multiplier_abs_le_one S 0 r x hchoice hpivot
      (Nat.zero_le _)
  have hzero_below : ∀ x : Fin (m + 1), p < x.val → S x 0 = 0 := by
    intro x hx
    exact h1 x 0 (by simp only [Fin.val_zero]; omega)
  have hshift : ∀ i : Fin m, p < i.val + 1 →
      ∀ j : Fin m,
        luFirstSchurComplement (higham9_2_rowPermutedMatrix S σ) i j =
          S i.succ j.succ := by
    intro i hi j
    have hσs : σ i.succ = i.succ := hσ_high i.succ (by
      simp only [Fin.val_succ]
      omega)
    rw [hSchur i j, hσs, hzero_below i.succ (by
      simp only [Fin.val_succ]
      omega)]
    ring
  have habs : ∀ i j : Fin m,
      |luFirstSchurComplement (higham9_2_rowPermutedMatrix S σ) i j| ≤
        |S (σ i.succ) j.succ| + |S r j.succ| := by
    intro i j
    rw [hSchur i j]
    have hterm : |S (σ i.succ) 0 * S r j.succ / S r 0| ≤ |S r j.succ| := by
      have heq : S (σ i.succ) 0 * S r j.succ / S r 0 =
          S (σ i.succ) 0 / S r 0 * S r j.succ := by ring
      rw [heq, abs_mul]
      calc |S (σ i.succ) 0 / S r 0| * |S r j.succ| ≤ 1 * |S r j.succ| :=
            mul_le_mul_of_nonneg_right (hmul _) (abs_nonneg _)
        _ = |S r j.succ| := one_mul _
    calc |S (σ i.succ) j.succ - S (σ i.succ) 0 * S r j.succ / S r 0|
        ≤ |S (σ i.succ) j.succ| +
            |S (σ i.succ) 0 * S r j.succ / S r 0| := by
          simpa [sub_eq_add_neg, abs_neg] using
            abs_add_le (S (σ i.succ) j.succ)
              (-(S (σ i.succ) 0 * S r j.succ / S r 0))
      _ ≤ |S (σ i.succ) j.succ| + |S r j.succ| := by linarith [hterm]
  have hMb1 : ∀ d i : ℕ, M ≤ M * higham9_11_bohteBaux p d i := fun d i =>
    le_mul_of_one_le_right hM (higham9_11_bohteBaux_one_le p d i)
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · -- clause 1: lower bandwidth p
    intro i j hij
    rw [hshift i (by omega) j]
    exact h1 i.succ j.succ (by
      simp only [Fin.val_succ]
      omega)
  · -- clause 2: window support ends at column 2p
    intro i j hi hj
    have hr_col : S r j.succ = 0 := h2 r j.succ hrle (by
      simp only [Fin.val_succ]
      omega)
    have hlead : S (σ i.succ) j.succ = 0 := by
      by_cases hip : i.val + 1 ≤ p
      · exact h2 (σ i.succ) j.succ
          (hσ_window i.succ (by simp only [Fin.val_succ]; omega)) (by
          simp only [Fin.val_succ]
          omega)
      · have hσs : σ i.succ = i.succ := hσ_high i.succ (by
          simp only [Fin.val_succ]
          omega)
        rw [hσs]
        exact (h5 i.succ j.succ (by
          simp only [Fin.val_succ]
          omega)).2 (by
          simp only [Fin.val_succ]
          omega)
    rw [hSchur i j, hr_col, hlead]
    ring
  · -- clause 3: the sharp Bohte fill bound
    intro i j hi
    by_cases hip : i.val + 1 ≤ p
    · have hσw : (σ i.succ).val ≤ p :=
        hσ_window i.succ (by simp only [Fin.val_succ]; omega)
      by_cases hj2 : j.val + 2 ≤ 2 * p
      · -- interior columns: Bohte recurrence
        have hb2 : |S r j.succ| ≤
            M * higham9_11_bohteBaux p (2 * p - 2 - j.val) (r.val + 1) := by
          have h := h3 r j.succ hrle
          have hidx : 2 * p - 1 - j.succ.val = 2 * p - 2 - j.val := by
            simp only [Fin.val_succ]
            omega
          rwa [hidx] at h
        by_cases hir : i.succ = r
        · -- displaced leading row: the recurrence closes with equality
          have hb1 : |S (σ i.succ) j.succ| ≤
              M * higham9_11_bohteBaux p (2 * p - 2 - j.val) 1 := by
            have h := h3 (σ i.succ) j.succ hσw
            have hσv : (σ i.succ).val = 0 := by
              rw [hir, hσr]
              rfl
            have hidx : 2 * p - 1 - j.succ.val = 2 * p - 2 - j.val := by
              simp only [Fin.val_succ]
              omega
            rw [hσv, hidx] at h
            simpa using h
          have hrv : r.val = i.val + 1 := by
            rw [← hir]
            rfl
          calc |luFirstSchurComplement (higham9_2_rowPermutedMatrix S σ) i j|
              ≤ |S (σ i.succ) j.succ| + |S r j.succ| := habs i j
            _ ≤ M * higham9_11_bohteBaux p (2 * p - 2 - j.val) 1 +
                M * higham9_11_bohteBaux p (2 * p - 2 - j.val)
                  (r.val + 1) := by linarith [hb1, hb2]
            _ = M * (higham9_11_bohteBaux p (2 * p - 2 - j.val)
                  (r.val + 1) +
                higham9_11_bohteBaux p (2 * p - 2 - j.val) 1) := by ring
            _ = M * higham9_11_bohteBaux p (2 * p - 2 - j.val + 1)
                  r.val := by
                rw [higham9_11_bohteBaux_succ (by omega)]
            _ = M * higham9_11_bohteBaux p (2 * p - 1 - j.val)
                  (i.val + 1) := by
                rw [← hrv]
                congr 2
                omega
        · -- undisturbed window row: first-row domination then recurrence
          have hσs : σ i.succ = i.succ := by
            simp [hσdef, higham9_7_firstPivotRowSwap, Fin.succ_ne_zero i,
              hir]
          have hb1 : |S (σ i.succ) j.succ| ≤
              M * higham9_11_bohteBaux p (2 * p - 2 - j.val)
                (i.val + 2) := by
            have h := h3 (σ i.succ) j.succ hσw
            have hσv : (σ i.succ).val = i.val + 1 := by
              rw [hσs]
              rfl
            have hidx : 2 * p - 1 - j.succ.val = 2 * p - 2 - j.val := by
              simp only [Fin.val_succ]
              omega
            rw [hσv, hidx] at h
            exact h
          have hb2' : |S r j.succ| ≤
              M * higham9_11_bohteBaux p (2 * p - 2 - j.val) 1 := by
            have hrow1 := higham9_11_bohteBaux_le_row_one p
              (2 * p - 2 - j.val) (r.val + 1) (by omega)
            calc |S r j.succ| ≤ M * higham9_11_bohteBaux p
                  (2 * p - 2 - j.val) (r.val + 1) := hb2
              _ ≤ M * higham9_11_bohteBaux p (2 * p - 2 - j.val) 1 :=
                  mul_le_mul_of_nonneg_left hrow1 hM
          calc |luFirstSchurComplement (higham9_2_rowPermutedMatrix S σ) i j|
              ≤ |S (σ i.succ) j.succ| + |S r j.succ| := habs i j
            _ ≤ M * higham9_11_bohteBaux p (2 * p - 2 - j.val)
                  (i.val + 2) +
                M * higham9_11_bohteBaux p (2 * p - 2 - j.val) 1 := by
                linarith [hb1, hb2']
            _ = M * (higham9_11_bohteBaux p (2 * p - 2 - j.val)
                  (i.val + 1 + 1) +
                higham9_11_bohteBaux p (2 * p - 2 - j.val) 1) := by
                ring_nf
            _ = M * higham9_11_bohteBaux p (2 * p - 2 - j.val + 1)
                  (i.val + 1) := by
                rw [higham9_11_bohteBaux_succ (by omega)]
            _ = M * higham9_11_bohteBaux p (2 * p - 1 - j.val)
                  (i.val + 1) := by
                congr 2
                omega
      · by_cases hj1 : j.val + 1 = 2 * p
        · -- second-to-extreme column: single-nonzero extreme entries
          have hne : σ i.succ ≠ r := by
            intro h
            have : σ (σ i.succ) = σ r := by rw [h]
            rw [hσr] at this
            have hinv := higham9_7_firstPivotRowSwap_involutive r i.succ
            rw [hσdef] at this
            rw [hinv] at this
            exact Fin.succ_ne_zero i this
          have honeM : |S (σ i.succ) j.succ| ≤ M := by
            have h := h3 (σ i.succ) j.succ hσw
            have hidx : 2 * p - 1 - j.succ.val = 0 := by
              simp only [Fin.val_succ]
              omega
            rw [hidx] at h
            calc |S (σ i.succ) j.succ| ≤
                M * higham9_11_bohteBaux p 0 ((σ i.succ).val + 1) := h
              _ = M := by
                  rw [show higham9_11_bohteBaux p 0 ((σ i.succ).val + 1) =
                    1 from rfl]
                  ring
          have hrM : |S r j.succ| ≤ M := by
            have h := h3 r j.succ hrle
            have hidx : 2 * p - 1 - j.succ.val = 0 := by
              simp only [Fin.val_succ]
              omega
            rw [hidx] at h
            calc |S r j.succ| ≤
                M * higham9_11_bohteBaux p 0 (r.val + 1) := h
              _ = M := by
                  rw [show higham9_11_bohteBaux p 0 (r.val + 1) = 1 from rfl]
                  ring
          have hcases : S (σ i.succ) j.succ = 0 ∨ S r j.succ = 0 := by
            by_contra h
            push_neg at h
            exact hne (h4 (σ i.succ) r j.succ hσw hrle (by
              simp only [Fin.val_succ]
              omega) h.1 h.2)
          have hgoal : |luFirstSchurComplement
              (higham9_2_rowPermutedMatrix S σ) i j| ≤ M := by
            rcases hcases with hz | hz
            · rw [hSchur i j, hz]
              have heq : (0 : ℝ) - S (σ i.succ) 0 * S r j.succ / S r 0 =
                  -(S (σ i.succ) 0 / S r 0 * S r j.succ) := by ring
              rw [heq, abs_neg, abs_mul]
              calc |S (σ i.succ) 0 / S r 0| * |S r j.succ| ≤ 1 * M :=
                    mul_le_mul (hmul _) hrM (abs_nonneg _) zero_le_one
                _ = M := one_mul M
            · rw [hSchur i j, hz]
              have heq : S (σ i.succ) j.succ -
                  S (σ i.succ) 0 * 0 / S r 0 = S (σ i.succ) j.succ := by
                ring
              rw [heq]
              exact honeM
          exact le_trans hgoal (hMb1 _ _)
        · -- columns at or beyond 2p: the entry vanishes
          have hr_col : S r j.succ = 0 := h2 r j.succ hrle (by
            simp only [Fin.val_succ]
            omega)
          have hlead : S (σ i.succ) j.succ = 0 :=
            h2 (σ i.succ) j.succ hσw (by
              simp only [Fin.val_succ]
              omega)
          rw [hSchur i j, hr_col, hlead]
          have hz : (0 : ℝ) - S (σ i.succ) 0 * 0 / S r 0 = 0 := by ring
          rw [hz, abs_zero]
          exact mul_nonneg hM (higham9_11_bohteBaux_nonneg p _ _)
    · -- the entrant row: untouched original, multiplier zero
      rw [hshift i (by omega) j]
      calc |S i.succ j.succ| ≤ M := by
            exact (h5 i.succ j.succ (by
              simp only [Fin.val_succ]
              omega)).1
        _ ≤ M * higham9_11_bohteBaux p (2 * p - 1 - j.val) (i.val + 1) :=
            hMb1 _ _
  · -- clause 4: unique window nonzero in the extreme column
    intro i i' j hi hi' hj hne hne'
    have hzero_lt : ∀ x : Fin m, x.val + 1 ≤ p →
        luFirstSchurComplement (higham9_2_rowPermutedMatrix S σ) x j = 0 := by
      intro x hx
      have hσw : (σ x.succ).val ≤ p :=
        hσ_window x.succ (by simp only [Fin.val_succ]; omega)
      have hr_col : S r j.succ = 0 := h2 r j.succ hrle (by
        simp only [Fin.val_succ]
        omega)
      have hlead : S (σ x.succ) j.succ = 0 := h2 (σ x.succ) j.succ hσw (by
        simp only [Fin.val_succ]
        omega)
      rw [hSchur x j, hr_col, hlead]
      ring
    have hiv : i.val = p := by
      by_contra h
      exact hne (hzero_lt i (by omega))
    have hiv' : i'.val = p := by
      by_contra h
      exact hne' (hzero_lt i' (by omega))
    exact Fin.ext (by omega)
  · -- clause 5: rows below the window stay untouched originals
    intro i j hi
    rw [hshift i (by omega) j]
    refine ⟨(h5 i.succ j.succ (by
      simp only [Fin.val_succ]
      omega)).1, fun hj => (h5 i.succ j.succ (by
      simp only [Fin.val_succ]
      omega)).2 (by
      simp only [Fin.val_succ]
      omega)⟩

/-- **Theorem 9.11**, trace-level sharp banded GEPP entry bound: along any
explicit recursive partial-pivoting trace whose input satisfies the sharp
band-tracked invariant, every final upper-factor entry is bounded by
`b(1,1)·M`. -/
theorem higham9_11_banded_PartialPivotGEPPUTrace_entry_abs_le_sharp :
    ∀ {n : ℕ} {A U : Fin n → Fin n → ℝ},
      higham9_7_PartialPivotGEPPUTrace n A U →
      ∀ (p : ℕ) (M : ℝ), 0 ≤ M →
        higham9_11_BandActiveBoundSharp n p M A →
        ∀ i j : Fin n,
          |U i j| ≤ higham9_11_bohteBaux p (2 * p - 1) 1 * M := by
  intro n A U htrace
  induction htrace with
  | done =>
      intro p M hM hA i j
      exact Fin.elim0 i
  | step hchoice hpivot _hnext ih =>
      rename_i m A r U₁
      intro p M hM hA i j
      by_cases hi : i = 0
      · subst hi
        have hrow := higham9_11_bandActiveSharp_entry_abs_le hM hA r j
        simpa [luFirstStepU, higham9_2_rowPermutedMatrix,
          higham9_7_firstPivotRowSwap] using hrow
      · by_cases hj : j = 0
        · subst hj
          have hzero : luFirstStepU
              (higham9_2_rowPermutedMatrix A (higham9_7_firstPivotRowSwap r))
              U₁ i 0 = 0 := by
            simp [luFirstStepU, hi]
          rw [hzero]
          simp only [abs_zero]
          exact mul_nonneg (higham9_11_bohteBaux_nonneg p _ _) hM
        · have hA' := higham9_11_bandActiveSharp_schur_preserved hM hA
            hchoice hpivot
          have hrec := ih p M hM hA' (i.pred hi) (j.pred hj)
          simpa [luFirstStepU, hi, hj] using hrec

/-- **Theorem 9.11** (Higham, 2nd ed., §9.5, Theorem 9.11; Bohte [146, 1975],
Theorem §5), sharp banded GEPP entry bound: for a matrix of lower and upper
bandwidth `p >= 1`, every entry of the exact partial-pivoting upper factor is
bounded by `(2^(2p-1) - (p-1)·2^(p-2))` times the max-entry norm of `A`. -/
theorem higham9_11_banded_GEPPUTrace_entry_abs_le_bohteBound_mul {n : ℕ}
    (hn : 0 < n) (A U : Fin n → Fin n → ℝ) (p : ℕ) (hp : 1 ≤ p)
    (hA_band : IsBanded n p p A)
    (htrace : higham9_7_PartialPivotGEPPUTrace n A U)
    (i j : Fin n) :
    |U i j| ≤ higham9_11_bohteBound p * maxEntryNorm hn A := by
  rw [← higham9_11_bohteBaux_top_eq_bohteBound hp]
  apply higham9_11_banded_PartialPivotGEPPUTrace_entry_abs_le_sharp htrace
    p (maxEntryNorm hn A) (maxEntryNorm_nonneg hn A) ?_ i j
  exact higham9_11_bandActiveBoundSharp_of_isBanded (maxEntryNorm_nonneg hn A)
    hA_band (fun a b => entry_le_maxEntryNorm hn A a b)

/-- **Theorem 9.11** (Higham, 2nd ed., §9.5, Theorem 9.11; Bohte [146, 1975]):
the sharp banded GEPP growth-factor bound.  For a matrix with upper and lower
bandwidths `p >= 1`, Gaussian elimination with partial pivoting has max-entry
growth factor at most `2^(2p-1) - (p-1)·2^(p-2)`, independent of the order
`n`.  Together with `higham9_11_bohte_example_growthFactorEntry_ge` (growth
`>= bohteBound 4 - 1` on Higham's explicit `n = 2p + 1` example) this
discharges both claims of the printed theorem. -/
theorem higham9_11_banded_GEPPUTrace_growthFactorEntry_le_bohteBound {n : ℕ}
    (hn : 0 < n) (A U : Fin n → Fin n → ℝ) (p : ℕ) (hp : 1 ≤ p)
    (hAmax : 0 < maxEntryNorm hn A)
    (hA_band : IsBanded n p p A)
    (htrace : higham9_7_PartialPivotGEPPUTrace n A U) :
    growthFactorEntry hn A U hAmax ≤ higham9_11_bohteBound p := by
  apply growthFactorEntry_le_of_entry_bound_factor hn A U
    (higham9_11_bohteBound p) hAmax
  exact fun i j => higham9_11_banded_GEPPUTrace_entry_abs_le_bohteBound_mul
    hn A U p hp hA_band htrace i j

/-- **Theorem 9.11**, pentadiagonal corollary: bandwidth-two GEPP growth is
at most `7`. -/
theorem higham9_11_pentadiagonal_GEPPUTrace_growthFactorEntry_le_seven
    {n : ℕ} (hn : 0 < n) (A U : Fin n → Fin n → ℝ)
    (hAmax : 0 < maxEntryNorm hn A)
    (hA_band : IsBanded n 2 2 A)
    (htrace : higham9_7_PartialPivotGEPPUTrace n A U) :
    growthFactorEntry hn A U hAmax ≤ 7 := by
  have h := higham9_11_banded_GEPPUTrace_growthFactorEntry_le_bohteBound
    hn A U 2 (by norm_num) hAmax hA_band htrace
  rwa [higham9_11_bohteBound_pentadiagonal_formula] at h

end NumStability
