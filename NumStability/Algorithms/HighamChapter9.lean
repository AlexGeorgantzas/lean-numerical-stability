    problem7_1_resolvent_componentwise_inequality_bound n M R
      (fun k : Fin n => V k j) (fun k : Fin n => W k j) hR
      (by
        intro k
        simpa [rectMatMul] using hineq k j)
  simpa [rectMatMul] using hcol i

