  obtain ⟨hAinv_bound, hUinv_bound, hLinv_bound⟩ :=
    higham9_15_inverse_product_bounds_of_matrix_inverse_products
      Ainv L U Linv Uinv hAinv hUinv hLinv
  exact higham9_15_chi_condition_chain_of_inverse_product_bounds
    A Ainv L U Linv Uinv hAinv_bound hUinv_bound hLinv_bound

