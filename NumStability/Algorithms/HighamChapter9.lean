lemma higham9_16_log_ratio_ge {N D : ℝ} (hD : 0 < D) (hND : D ≤ N) :
    (N - D) / N ≤ Real.log (N / D) := by
  have hN : (0 : ℝ) < N := lt_of_lt_of_le hD hND
  have h := Real.log_le_sub_one_of_pos (show (0 : ℝ) < D / N by positivity)
  have hlog : Real.log (D / N) = - Real.log (N / D) := by
    rw [← Real.log_inv]
    congr 1
    field_simp
  rw [hlog] at h
  have heq : (N - D) / N = 1 - D / N := by field_simp
  rw [heq]
  linarith

