{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["role", "paper_sha256", "candidate_semantic_sha256", "verdict", "mismatches", "uncertainties", "rationale"],
  "properties": {
    "role": {"enum": ["direct-judge", "roundtrip-judge"]},
    "paper_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_semantic_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "verdict": {"enum": ["faithful", "unfaithful", "unclear"]},
    "mismatches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["paper_requirement", "candidate_mismatch", "severity"],
        "properties": {
          "paper_requirement": {"type": "string", "minLength": 1},
          "candidate_mismatch": {"type": "string", "minLength": 1},
          "severity": {"enum": ["critical", "major", "minor"]}
        }
      }
    },
    "uncertainties": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "rationale": {"type": "string", "minLength": 1}
  }
}
