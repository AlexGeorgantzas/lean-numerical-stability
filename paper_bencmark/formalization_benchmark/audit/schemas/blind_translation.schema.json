{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["role", "semantic_sha256", "translation", "ambiguities", "vacuity_risks"],
  "properties": {
    "role": {"type": "string", "enum": ["blind-translation"]},
    "semantic_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "translation": {"type": "string", "minLength": 1},
    "ambiguities": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "vacuity_risks": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
