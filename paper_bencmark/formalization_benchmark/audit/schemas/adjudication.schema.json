{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "role",
    "paper_sha256",
    "candidate_semantic_sha256",
    "trigger",
    "resolved_items",
    "implications",
    "classification",
    "verdict",
    "mismatches",
    "remaining_uncertainties",
    "rationale"
  ],
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "adjudicator"
      ]
    },
    "paper_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate_semantic_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "trigger": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "resolved_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item",
          "resolution",
          "primary_evidence"
        ],
        "properties": {
          "item": {
            "type": "string",
            "minLength": 1
          },
          "resolution": {
            "type": "string",
            "minLength": 1
          },
          "primary_evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "implications": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_implies_source",
        "source_implies_candidate"
      ],
      "properties": {
        "candidate_implies_source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "verdict",
            "reasoning"
          ],
          "properties": {
            "verdict": {
              "type": "string",
              "enum": [
                "yes",
                "no"
              ]
            },
            "reasoning": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "source_implies_candidate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "verdict",
            "reasoning"
          ],
          "properties": {
            "verdict": {
              "type": "string",
              "enum": [
                "yes",
                "no"
              ]
            },
            "reasoning": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "classification": {
      "type": "string",
      "enum": [
        "faithful-equivalent",
        "faithful-stronger",
        "unfaithful-weaker",
        "unfaithful-different"
      ]
    },
    "verdict": {
      "type": "string",
      "enum": [
        "faithful",
        "unfaithful"
      ]
    },
    "mismatches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "paper_requirement",
          "candidate_mismatch",
          "severity"
        ],
        "properties": {
          "paper_requirement": {
            "type": "string",
            "minLength": 1
          },
          "candidate_mismatch": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "major",
              "minor"
            ]
          }
        }
      }
    },
    "remaining_uncertainties": {
      "type": "array",
      "maxItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    }
  }
}
