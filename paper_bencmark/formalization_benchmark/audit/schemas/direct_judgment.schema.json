{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "role",
    "paper_sha256",
    "candidate_semantic_sha256",
    "dependency_coverage",
    "semantic_checklist",
    "implications",
    "classification",
    "accepted",
    "requires_adjudication",
    "mismatches",
    "uncertainties",
    "rationale"
  ],
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "direct-judge"
      ]
    },
    "paper_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate_semantic_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dependency_coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "interpretation",
          "effect_on_target",
          "paper_match",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^D[0-9]{3}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "interpretation": {
            "type": "string",
            "minLength": 1
          },
          "effect_on_target": {
            "type": "string",
            "minLength": 1
          },
          "paper_match": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "unclear",
              "not-applicable"
            ]
          }
        }
      }
    },
    "semantic_checklist": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "paper_evidence",
          "candidate_evidence",
          "reasoning"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^S[0-9]{2}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "unclear",
              "not-applicable"
            ]
          },
          "paper_evidence": {
            "type": "string",
            "minLength": 1
          },
          "candidate_evidence": {
            "type": "string",
            "minLength": 1
          },
          "reasoning": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "implications": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_implies_source",
        "source_implies_candidate"
      ],
      "properties": {
        "candidate_implies_source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "verdict",
            "reasoning"
          ],
          "properties": {
            "verdict": {
              "type": "string",
              "enum": [
                "yes",
                "no",
                "unclear"
              ]
            },
            "reasoning": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "source_implies_candidate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "verdict",
            "reasoning"
          ],
          "properties": {
            "verdict": {
              "type": "string",
              "enum": [
                "yes",
                "no",
                "unclear"
              ]
            },
            "reasoning": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "classification": {
      "type": "string",
      "enum": [
        "faithful-equivalent",
        "faithful-stronger",
        "unfaithful-weaker",
        "unfaithful-different",
        "undetermined"
      ]
    },
    "accepted": {
      "type": "boolean"
    },
    "requires_adjudication": {
      "type": "boolean"
    },
    "mismatches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "paper_requirement",
          "candidate_mismatch",
          "severity"
        ],
        "properties": {
          "paper_requirement": {
            "type": "string",
            "minLength": 1
          },
          "candidate_mismatch": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "major",
              "minor"
            ]
          }
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    }
  }
}
