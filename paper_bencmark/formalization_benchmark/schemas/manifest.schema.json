{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifest.schema.json",
  "title": "HighamBench formalization pilot frozen manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pilot_id",
    "base_commit",
    "freeze_algorithm",
    "config",
    "schemas",
    "task_count",
    "task_ids",
    "tasks",
    "release_files",
    "repository_files",
    "manifest_payload_sha256"
  ],
  "properties": {
    "schema_version": {"const": "formalization-benchmark-manifest-1"},
    "pilot_id": {"type": "string", "minLength": 1},
    "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "freeze_algorithm": {"type": "string", "minLength": 1},
    "config": {"$ref": "#/$defs/file_ref"},
    "schemas": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/file_ref"}
    },
    "task_count": {"const": 18},
    "task_ids": {
      "type": "array",
      "prefixItems": [
        {"const": "P01-T2"},
        {"const": "P02-T2"},
        {"const": "P03-T2"},
        {"const": "P13-T2"},
        {"const": "P14-T2"},
        {"const": "H22-11"},
        {"const": "H22-5"},
        {"const": "H20-6"},
        {"const": "H7-12"},
        {"const": "H20-9"},
        {"const": "H20-8"},
        {"const": "H23-6"},
        {"const": "H5-5"},
        {"const": "H10-7"},
        {"const": "H12-4"},
        {"const": "H19-5"},
        {"const": "H7-14"},
        {"const": "H15-3"}
      ],
      "items": false
    },
    "tasks": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "source_packet", "source_pdf"],
        "properties": {
          "task_id": {"type": "string", "pattern": "^(P[0-9]{2}-T2|H[0-9]+-[0-9]+)$"},
          "source_packet": {"$ref": "#/$defs/file_ref"},
          "source_pdf": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path_basename", "sha256"],
            "properties": {
              "path_basename": {"type": "string", "minLength": 5},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    },
    "release_files": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/file_ref"}
    },
    "repository_files": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/repository_file_ref"}
    },
    "manifest_payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "file_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "sha256"],
      "properties": {
        "relative_path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "repository_file_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_relative_path", "sha256"],
      "properties": {
        "repository_relative_path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
