{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-packet.schema.json",
  "title": "HighamBench formalization source packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "selected_result",
    "bibliographic_source",
    "paper_pdf",
    "paper_locations",
    "task_clarification",
    "scope_constraints"
  ],
  "properties": {
    "schema_version": {
      "const": "formalization-source-packet-1"
    },
    "task_id": {
      "type": "string",
      "pattern": "^P[0-9]{2}-T[0-9]+$"
    },
    "selected_result": {
      "type": "string",
      "minLength": 1
    },
    "bibliographic_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authors", "title", "venue", "year", "pages", "doi"],
      "properties": {
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "title": {"type": "string", "minLength": 1},
        "venue": {"type": "string", "minLength": 1},
        "volume": {"type": "string", "minLength": 1},
        "issue": {"type": "string", "minLength": 1},
        "year": {"type": "integer", "minimum": 1900},
        "pages": {"type": "string", "minLength": 1},
        "doi": {"type": "string", "minLength": 1}
      }
    },
    "paper_pdf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path_basename", "sha256"],
      "properties": {
        "path_basename": {"type": "string", "minLength": 5},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "paper_locations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section", "printed_pages", "pdf_pages", "anchor"],
        "properties": {
          "section": {"type": "string", "minLength": 1},
          "printed_pages": {"type": "string", "minLength": 1},
          "pdf_pages": {"type": "string", "minLength": 1},
          "anchor": {"type": "string", "minLength": 1}
        }
      }
    },
    "task_clarification": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "scope_constraints": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
