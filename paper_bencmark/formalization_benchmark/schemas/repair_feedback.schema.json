{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "issues"],
  "properties": {
    "status": {"const": "repair-required"},
    "issues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["missing_paper_requirement", "candidate_mismatch"],
        "properties": {
          "missing_paper_requirement": {"type": "string", "minLength": 1},
          "candidate_mismatch": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
