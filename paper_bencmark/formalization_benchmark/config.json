  "measurement_scope": {
    "clock": "The one-time Condition-L library scout is logged separately and excluded. Per-task cumulative contestant-active time begins at task turn delivery and runs through charged background-terminal cleanup/quiescence and candidate freeze/hash. The ordered post-terminal telemetry barrier/drain, compilation, integrity checks, and faithfulness auditing are logged off-clock.",
    "tokens": "The one-time scout usage is logged once and excluded from task totals. Fresh threads use exact raw-response usage cross-checked against cumulative thread telemetry. A warm fork may instead use its ordered per-response thread/tokenUsage/updated notifications only when each exact last usage equals the corresponding cumulative delta, all notifications arrive before turn completion, no context compaction occurs, and the inherited fork baseline is authenticated; otherwise measurement fails closed. Raw events are retained whenever supplied. The primary task-local headline is net-new tokens = uncached input plus output; all exact component totals remain available.",
    "audit": "Audit time and audit tokens are recorded separately and excluded from the contestant measurement."
  },
  "packet_policy": {
    "allowed_content": [
      "Bibliographic source",
      "Exact source PDF path basename and SHA-256 digest",
      "Precise printed and PDF page locations",
      "Faithful neutral clarification of the selected source result",
      "Scope constraints needed to disambiguate that result"
    ],
    "forbidden_content": [
      "Pre-existing formal target or declaration",
      "Shared formal scaffold or old benchmark context",
      "Proof text, proof plan, or proof code",
      "Library declaration names or condition-specific hints"
    ]
  }
