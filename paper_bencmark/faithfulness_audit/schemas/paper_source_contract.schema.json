{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HighamBench paper-level source contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "role",
    "paper_id",
    "paper_sha256",
    "source_locator_sha256",
    "task_ids",
    "contracts"
  ],
  "properties": {
    "schema_version": {"const": "highambench-faithfulness-0.2"},
    "role": {"const": "paper-source-contract"},
    "paper_id": {"type": "string", "pattern": "^P[0-9]{2}$"},
    "paper_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_locator_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "task_ids": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "string", "pattern": "^P[0-9]{2}-T[123]$"}
    },
    "contracts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/contract"}
    }
  },
  "$defs": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "source_evidence",
        "statement",
        "undebatable_constraints",
        "ambiguities",
        "contract_plain_english"
      ],
      "properties": {
        "task_id": {"type": "string", "pattern": "^P[0-9]{2}-T[123]$"},
        "source_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pdf_page", "anchor", "observation"],
            "properties": {
              "pdf_page": {"type": "integer", "minimum": 1},
              "printed_page": {"type": ["string", "null"]},
              "anchor": {"type": "string", "minLength": 1},
              "observation": {"type": "string", "minLength": 1}
            }
          }
        },
        "statement": {"$ref": "#/$defs/statement"},
        "undebatable_constraints": {"$ref": "#/$defs/nonemptyStringArray"},
        "ambiguities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["issue", "evidence", "impact"],
            "properties": {
              "issue": {"type": "string", "minLength": 1},
              "evidence": {"type": "string", "minLength": 1},
              "impact": {"type": "string", "minLength": 1}
            }
          }
        },
        "contract_plain_english": {"type": "string", "minLength": 1}
      }
    },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binders",
        "hypotheses",
        "conclusions",
        "definitions_and_conventions",
        "implicit_context",
        "algorithm_linkage",
        "numerical_model",
        "error_notions",
        "norms",
        "constants_and_indexing",
        "higher_order_terms",
        "exceptional_values"
      ],
      "properties": {
        "binders": {"$ref": "#/$defs/stringArray"},
        "hypotheses": {"$ref": "#/$defs/stringArray"},
        "conclusions": {"$ref": "#/$defs/nonemptyStringArray"},
        "definitions_and_conventions": {"$ref": "#/$defs/stringArray"},
        "implicit_context": {"$ref": "#/$defs/stringArray"},
        "algorithm_linkage": {"type": "string", "minLength": 1},
        "numerical_model": {"$ref": "#/$defs/stringArray"},
        "error_notions": {"$ref": "#/$defs/stringArray"},
        "norms": {"$ref": "#/$defs/stringArray"},
        "constants_and_indexing": {"$ref": "#/$defs/stringArray"},
        "higher_order_terms": {"$ref": "#/$defs/stringArray"},
        "exceptional_values": {"$ref": "#/$defs/stringArray"}
      }
    },
    "stringArray": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "nonemptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
