{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HighamBench round-trip judgment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "role",
    "task_id",
    "paper_sha256",
    "blind_translation_sha256",
    "semantic_checklist",
    "implications",
    "classification",
    "accepted",
    "requires_adjudication",
    "findings",
    "rationale"
  ],
  "properties": {
    "schema_version": {"const": "highambench-faithfulness-0.1"},
    "role": {"const": "roundtrip-judge"},
    "task_id": {"type": "string", "pattern": "^P[0-9]{2}-T[123]$"},
    "paper_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "blind_translation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "semantic_checklist": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "paper_evidence", "translation_evidence", "reasoning"],
        "properties": {
          "id": {"type": "string", "pattern": "^S[0-9]{2}$"},
          "status": {"enum": ["pass", "fail", "unclear", "not-applicable"]},
          "paper_evidence": {"type": "string", "minLength": 1},
          "translation_evidence": {"type": "string", "minLength": 1},
          "reasoning": {"type": "string", "minLength": 1}
        }
      }
    },
    "implications": {
      "type": "object",
      "additionalProperties": false,
      "required": ["translation_implies_paper", "paper_implies_translation"],
      "properties": {
        "translation_implies_paper": {"$ref": "#/$defs/implication"},
        "paper_implies_translation": {"$ref": "#/$defs/implication"}
      }
    },
    "classification": {"$ref": "#/$defs/classification"},
    "accepted": {"type": "boolean"},
    "requires_adjudication": {"type": "boolean"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "category", "paper_evidence", "translation_evidence", "impact"],
        "properties": {
          "severity": {"enum": ["critical", "major", "minor", "note"]},
          "category": {"type": "string", "minLength": 1},
          "paper_evidence": {"type": "string", "minLength": 1},
          "translation_evidence": {"type": "string", "minLength": 1},
          "impact": {"type": "string", "minLength": 1}
        }
      }
    },
    "rationale": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "classification": {"enum": ["faithful-equivalent", "faithful-stronger", "not-faithful-weaker", "not-faithful-different", "undetermined"]},
    "implication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "reasoning"],
      "properties": {
        "verdict": {"enum": ["yes", "no", "unclear"]},
        "reasoning": {"type": "string", "minLength": 1}
      }
    }
  }
}
