{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "highambench-t4-source-inventory-0.3.schema.json",
  "title": "HighamBench T4 source inventory 0.3",
  "description": "Paper-neutral authoring ledger for one atomic, source-ordered T4 corpus.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "paper_id",
    "title",
    "status",
    "inventory_method",
    "source",
    "named_results",
    "local_numbered_equations",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "highambench-t4-source-inventory-0.3"
    },
    "paper_id": {
      "$ref": "#/$defs/paperId"
    },
    "title": {
      "$ref": "#/$defs/nonemptyString"
    },
    "status": {
      "$ref": "#/$defs/nonemptyString"
    },
    "inventory_method": {
      "$ref": "#/$defs/nonemptyString"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "named_results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonemptyString"
      },
      "uniqueItems": true
    },
    "local_numbered_equations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonemptyString"
      },
      "uniqueItems": true
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourceItem"
      }
    }
  },
  "$defs": {
    "nonemptyString": {
      "type": "string",
      "minLength": 1
    },
    "paperId": {
      "type": "string",
      "pattern": "^P[0-9]{2}$"
    },
    "stableId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourceKind": {
      "enum": [
        "named_result",
        "numbered_equation",
        "precise_unnumbered_claim",
        "algorithm",
        "symbolic_example",
        "problem",
        "definition",
        "conjecture",
        "question",
        "heuristic",
        "empirical_claim"
      ]
    },
    "sourceTag": {
      "enum": [
        "THM",
        "LEM",
        "PROP",
        "COR",
        "EQN",
        "TXT",
        "UNL"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_path",
        "sha256"
      ],
      "properties": {
        "local_path": {
          "$ref": "#/$defs/nonemptyString"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "pdf_pages": {
          "type": "integer",
          "minimum": 1
        },
        "printed_pages": {
          "$ref": "#/$defs/nonemptyString"
        },
        "page_map": {
          "$ref": "#/$defs/nonemptyString"
        },
        "lawful_source_locator": {
          "$ref": "#/$defs/nonemptyString"
        },
        "rights_note": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "sourceLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pdf_page",
        "printed_page",
        "section",
        "anchor"
      ],
      "properties": {
        "pdf_page": {
          "type": "integer",
          "minimum": 1
        },
        "printed_page": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "$ref": "#/$defs/nonemptyString"
            },
            {
              "type": "null"
            }
          ]
        },
        "section": {
          "$ref": "#/$defs/nonemptyString"
        },
        "anchor": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "declarationMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declaration_id",
        "role",
        "notes"
      ],
      "properties": {
        "declaration_id": {
          "$ref": "#/$defs/stableId"
        },
        "role": {
          "enum": [
            "primary_carrier",
            "semantic_context",
            "duplicate_anchor"
          ]
        },
        "notes": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "sourceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_order",
        "inventory_id",
        "source_kind",
        "scope",
        "source_locations",
        "disposition",
        "declaration_ids",
        "exclusion_reason",
        "assumptions",
        "source_status",
        "source_tags",
        "author_label",
        "source_issue_notes",
        "declaration_mappings",
        "duplicate_of_source_item_ids",
        "review_unit_id",
        "smallest_group_reason"
      ],
      "properties": {
        "source_order": {
          "type": "integer",
          "minimum": 1
        },
        "inventory_id": {
          "$ref": "#/$defs/stableId"
        },
        "source_kind": {
          "$ref": "#/$defs/sourceKind"
        },
        "scope": {
          "$ref": "#/$defs/nonemptyString"
        },
        "source_locations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceLocation"
          }
        },
        "disposition": {
          "enum": [
            "included",
            "excluded"
          ]
        },
        "declaration_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stableId"
          },
          "uniqueItems": true
        },
        "exclusion_reason": {
          "oneOf": [
            {
              "$ref": "#/$defs/nonemptyString"
            },
            {
              "type": "null"
            }
          ]
        },
        "assumptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonemptyString"
          }
        },
        "source_status": {
          "$ref": "#/$defs/nonemptyString"
        },
        "source_tags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceTag"
          },
          "uniqueItems": true
        },
        "author_label": {
          "oneOf": [
            {
              "$ref": "#/$defs/nonemptyString"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_issue_notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonemptyString"
          }
        },
        "declaration_mappings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/declarationMapping"
          }
        },
        "duplicate_of_source_item_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stableId"
          },
          "uniqueItems": true
        },
        "review_unit_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/stableId"
            },
            {
              "type": "null"
            }
          ]
        },
        "smallest_group_reason": {
          "oneOf": [
            {
              "$ref": "#/$defs/nonemptyString"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "included"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "properties": {
              "declaration_ids": {
                "minItems": 1
              },
              "exclusion_reason": {
                "type": "null"
              },
              "review_unit_id": {
                "$ref": "#/$defs/stableId"
              },
              "smallest_group_reason": {
                "$ref": "#/$defs/nonemptyString"
              },
              "declaration_mappings": {
                "minItems": 1,
                "contains": {
                  "properties": {
                    "role": {
                      "enum": [
                        "primary_carrier",
                        "duplicate_anchor"
                      ]
                    }
                  },
                  "required": [
                    "role"
                  ]
                }
              },
              "source_tags": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "declaration_ids": {
                "maxItems": 0
              },
              "exclusion_reason": {
                "$ref": "#/$defs/nonemptyString"
              },
              "review_unit_id": {
                "type": "null"
              },
              "smallest_group_reason": {
                "type": "null"
              },
              "declaration_mappings": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}
